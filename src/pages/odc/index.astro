---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
---
<BaseLayout title="Semiconductor Engineering ODC | AionSi" description="AionSi dedicated semiconductor engineering ODCs across Design Verification, Physical Design and DFT/DFX, supported by representative engineering engagements and governed delivery.">
  <Header />
  <main>
    <section class="relative overflow-hidden bg-[var(--aionsi-deep-navy)] py-20 text-white md:py-28">
      <div class="absolute inset-0 opacity-30" style="background:radial-gradient(circle at 78% 18%, rgba(39,148,255,.35), transparent 34%), radial-gradient(circle at 18% 82%, rgba(255,122,24,.18), transparent 28%)"></div>
      <Container class="relative">
        <div class="max-w-5xl">
          <TechnicalLabel>AIONSI ENGINEERING ODC</TechnicalLabel>
          <h1 class="mt-5 max-w-5xl text-5xl font-semibold leading-[1.03] tracking-tight md:text-7xl">Dedicated semiconductor engineering. Built around execution.</h1>
          <p class="mt-7 max-w-4xl text-xl leading-9 text-white/70 md:text-2xl">AionSi builds dedicated engineering teams around semiconductor workstreams in <span class="font-semibold text-white">Design Verification, Physical Design and DFT/DFX</span> — combining specialist engineering depth, technical ownership and governed delivery.</p>
          <div class="mt-9 flex flex-wrap gap-3"><Button href="#odc-conversation">Discuss an ODC Requirement</Button><a href="#engineering-evidence" class="inline-flex items-center rounded-md border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/50 focus:outline-none focus:ring-2 focus:ring-white/60">View Engineering Evidence ↓</a></div>
        </div>
        <div class="mt-12 grid gap-3 sm:grid-cols-3">
          {[['01','Design Verification','IP • Subsystem • SoC • UVM • Coverage • Debug'],['02','Physical Design','Implementation • STA • Timing Closure • Sign-off'],['03','DFT / DFX','DFT • Scan • ATPG • DFX • Test Readiness']].map(([num,title,desc]) => <div class="border border-white/10 bg-white/5 p-5 backdrop-blur"><div class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">{num}</div><div class="mt-2 text-lg font-semibold">{title}</div><div class="mt-2 text-sm leading-6 text-white/55">{desc}</div></div>)}
        </div>
      </Container>
    </section>

    <Section>
      <Container><div class="grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-start"><div><TechnicalLabel>THE AIONSI ODC MODEL</TechnicalLabel><h2 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">An ODC is more than engineering headcount.</h2><p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">The AionSi model is designed around technical ownership of defined engineering workstreams — with specialist engineers, technical leadership, delivery governance and milestones aligned to the customer's program.</p></div><div class="grid gap-4 sm:grid-cols-3">{[['Engineering ownership','Defined technical workstreams and deliverables.'],['Specialist depth','Teams built around semiconductor engineering disciplines.'],['Scalable execution','Proven workstreams can grow into dedicated pods.']].map(([title,desc]) => <article class="border border-slate-200 bg-white p-6 shadow-sm"><h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{desc}</p></article>)}</div></div></Container>
    </Section>

    <Section id="engineering-evidence" class="bg-[var(--aionsi-surface-alt)]"><Container><TechnicalLabel>THREE ENGINEERING PILLARS</TechnicalLabel><h2 class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Specialist engineering depth where AionSi has evidence to show.</h2><div class="mt-9 grid gap-5 md:grid-cols-3">{[['01','Design Verification','Verify IP, subsystems and SoCs with structured, coverage-driven execution.',['SystemVerilog','UVM','Assertions','Functional coverage','Regression','Debug']],['02','Physical Design','Support the implementation and sign-off path from RTL/netlist through timing closure.',['Synthesis','Physical implementation','STA','Timing closure','ECO','Physical verification']],['03','DFT / DFX','Support design-for-test and design-for-X engineering for complex semiconductor programs.',['DFT engineering','Scan','ATPG','DFX','DFT verification','Test readiness']]].map(([num,title,desc,items]) => <article class="border border-slate-200 bg-white p-7 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">{num}</span><h3 class="mt-3 text-2xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{desc}</p><div class="mt-5 flex flex-wrap gap-2">{(items as string[]).map((item) => <span class="border border-slate-200 bg-[var(--aionsi-surface-alt)] px-3 py-1.5 text-xs font-semibold text-slate-600">{item}</span>)}</div></article>)}</div></Container></Section>

    <Section><Container><TechnicalLabel>REPRESENTATIVE ENGINEERING ENGAGEMENTS</TechnicalLabel><h2 class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">ODC experience across real semiconductor engineering work.</h2><div class="mt-9 grid gap-6 lg:grid-cols-2">
      <article class="border border-slate-200 bg-white p-7 shadow-sm"><div class="flex items-start justify-between gap-4"><div><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">ODC 01</span><h3 class="mt-3 text-2xl font-semibold text-[var(--aionsi-navy)]">Automotive Semiconductor — DFT / DFX Engineering</h3></div><span class="rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-500">Confidential</span></div><div class="mt-6 grid gap-3 sm:grid-cols-2"><div><div class="text-xs font-semibold uppercase tracking-[.14em] text-slate-400">Domain</div><div class="mt-1 text-sm font-semibold text-slate-700">Automotive semiconductor</div></div><div><div class="text-xs font-semibold uppercase tracking-[.14em] text-slate-400">Engagement</div><div class="mt-1 text-sm font-semibold text-slate-700">Dedicated engineering ODC</div></div></div><div class="mt-6 border-t border-slate-200 pt-6"><div class="text-sm font-semibold text-[var(--aionsi-navy)]">Representative scope</div><p class="mt-2 text-sm leading-7 text-slate-600">DFX / DFT engineering, test-oriented design support and customer-aligned semiconductor execution.</p></div><div class="mt-6 border-t border-slate-200 pt-6"><div class="text-sm font-semibold text-[var(--aionsi-navy)]">What the engagement demonstrates</div><ul class="mt-2 space-y-2 text-sm leading-6 text-slate-600"><li>Specialist DFT / DFX engineering capacity</li><li>Dedicated technical ownership of defined workstreams</li><li>Structured execution inside a semiconductor development environment</li><li>Governed milestone-based delivery</li></ul></div></article>
      <article class="border border-slate-200 bg-white p-7 shadow-sm"><div class="flex items-start justify-between gap-4"><div><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">ODC 02</span><h3 class="mt-3 text-2xl font-semibold text-[var(--aionsi-navy)]">Transceiver IP &amp; Subsystem — Design Verification</h3></div><span class="rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-500">Confidential</span></div><div class="mt-6 grid gap-3 sm:grid-cols-2"><div><div class="text-xs font-semibold uppercase tracking-[.14em] text-slate-400">Domain</div><div class="mt-1 text-sm font-semibold text-slate-700">Semiconductor IP / subsystem</div></div><div><div class="text-xs font-semibold uppercase tracking-[.14em] text-slate-400">Engagement</div><div class="mt-1 text-sm font-semibold text-slate-700">Dedicated engineering ODC</div></div></div><div class="mt-6 border-t border-slate-200 pt-6"><div class="text-sm font-semibold text-[var(--aionsi-navy)]">Representative scope</div><p class="mt-2 text-sm leading-7 text-slate-600">IP and subsystem verification with planning, environment development, stimulus/checking, regression, coverage and debug.</p></div><div class="mt-6 border-t border-slate-200 pt-6"><div class="text-sm font-semibold text-[var(--aionsi-navy)]">What the engagement demonstrates</div><ul class="mt-2 space-y-2 text-sm leading-6 text-slate-600"><li>IP-level and subsystem-level verification execution</li><li>Coverage-driven regression and closure</li><li>Debug and issue-resolution ownership</li><li>Dedicated team execution against defined milestones</li></ul></div></article>
    </div><p class="mt-5 text-xs leading-6 text-slate-500">Customer names, product names and confidential implementation details are intentionally omitted where disclosure is restricted. The examples describe representative engineering scope and delivery characteristics without exposing customer-sensitive information.</p></Container></Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white"><Container><div class="grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-start"><div><TechnicalLabel>PHYSICAL DESIGN EVIDENCE</TechnicalLabel><h2 class="mt-4 text-3xl font-semibold md:text-5xl">Implementation, timing and sign-off engineering.</h2><p class="mt-5 text-lg leading-8 text-white/65">AionSi's physical-design positioning is focused on the engineering path from RTL/netlist through implementation, timing closure and physical verification.</p></div><div class="grid gap-4 sm:grid-cols-3">{[['Implementation','Synthesis, floorplanning, placement, CTS and routing.'],['Timing','STA, constraint analysis, optimization and ECO-driven closure.'],['Sign-off','Physical verification and sign-off readiness.']].map(([title,desc],i) => <div class="border border-white/10 bg-white/5 p-6"><span class="text-xs font-semibold text-[var(--aionsi-orange)]">0{i+1}</span><h3 class="mt-3 text-xl font-semibold">{title}</h3><p class="mt-3 text-sm leading-7 text-white/60">{desc}</p></div>)}</div></div></Container></Section>

    <!-- Infrastructure visual provision: replace the abstract panels below with licensed, real AionSi facility/engineering photographs when approved assets are available. Do not present outside/stock imagery as AionSi infrastructure. -->
    <Section class="bg-[var(--aionsi-surface-alt)]"><Container><div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-center"><div><TechnicalLabel>ENGINEERING ENVIRONMENT</TechnicalLabel><h2 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Infrastructure ready for dedicated semiconductor execution.</h2><p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">AionSi can support dedicated engineering workstreams with controlled access, customer-aligned workflows, technical collaboration and governed delivery. This section is intentionally designed to accommodate approved infrastructure photography as the visual evidence matures.</p><div class="mt-6 flex flex-wrap gap-2">{['Dedicated engineering workspace','Controlled access','Customer-aligned workflows','Technical collaboration'].map((item) => <span class="border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600">{item}</span>)}</div></div><div class="grid gap-4 sm:grid-cols-3"><div class="relative min-h-64 overflow-hidden border border-slate-200 bg-[var(--aionsi-deep-navy)] p-5 text-white shadow-sm"><div class="absolute inset-0 opacity-40" style="background:linear-gradient(135deg, transparent 0 42%, rgba(39,148,255,.35) 43% 44%, transparent 45%), linear-gradient(45deg, transparent 0 57%, rgba(255,122,24,.25) 58% 59%, transparent 60%)"></div><div class="relative mt-auto pt-40"><div class="text-xs font-semibold tracking-[.14em] text-[var(--aionsi-orange)]">01</div><h3 class="mt-2 text-lg font-semibold">Engineering workspace</h3></div></div><div class="relative min-h-64 overflow-hidden border border-slate-200 bg-white p-5 shadow-sm"><div class="absolute inset-5 border border-slate-200" style="background:repeating-linear-gradient(90deg, transparent 0 22px, rgba(15,31,74,.08) 23px 24px), repeating-linear-gradient(0deg, transparent 0 22px, rgba(15,31,74,.08) 23px 24px)"></div><div class="relative mt-auto pt-40"><div class="text-xs font-semibold tracking-[.14em] text-[var(--aionsi-orange)]">02</div><h3 class="mt-2 text-lg font-semibold text-[var(--aionsi-navy)]">Verification environment</h3></div></div><div class="relative min-h-64 overflow-hidden border border-slate-200 bg-white p-5 shadow-sm"><div class="absolute inset-5 rounded-sm border border-slate-200" style="background:radial-gradient(circle at 30% 30%, rgba(39,148,255,.12), transparent 28%), radial-gradient(circle at 70% 70%, rgba(255,122,24,.12), transparent 28%)"></div><div class="relative mt-auto pt-40"><div class="text-xs font-semibold tracking-[.14em] text-[var(--aionsi-orange)]">03</div><h3 class="mt-2 text-lg font-semibold text-[var(--aionsi-navy)]">Secure collaboration</h3></div></div></div></div></Container></Section>

    <Section><Container><div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-center"><div><TechnicalLabel>ODC OPERATING MODEL</TechnicalLabel><h2 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Customer control. AionSi execution.</h2><p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">Customers retain product architecture, roadmap and final technical decisions. AionSi owns defined engineering workstreams, delivery execution and agreed milestones.</p></div><div class="overflow-hidden border border-slate-200 bg-white shadow-sm"><div class="grid grid-cols-2 bg-[var(--aionsi-surface-alt)] text-sm font-semibold text-[var(--aionsi-navy)]"><div class="p-4">Customer retains</div><div class="border-l border-slate-200 p-4">AionSi owns</div></div>{[['Product architecture','Assigned engineering workstreams'],['Product roadmap','Engineering execution'],['Final technical decisions','Milestone delivery'],['Acceptance criteria','Engineering deliverables'],['IP / product ownership','Team management & governance']].map(([left,right]) => <div class="grid grid-cols-2 border-t border-slate-200 text-sm leading-6 text-slate-600"><div class="p-4">{left}</div><div class="border-l border-slate-200 p-4">{right}</div></div>)}</div></div></Container></Section>

    <Section class="bg-[var(--aionsi-surface-alt)]"><Container><TechnicalLabel>HOW AIONSI BUILDS AN ENGINEERING ODC</TechnicalLabel><h2 class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">From one measurable workstream to a dedicated engineering pod.</h2><div class="mt-9 grid gap-4 md:grid-cols-3 lg:grid-cols-6">{[['01','Technical discovery'],['02','Engineering scope'],['03','Team formation'],['04','Technical onboarding'],['05','Workstream execution'],['06','Scale']].map(([num,title]) => <div class="border border-slate-200 bg-white p-5 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">{num}</span><h3 class="mt-3 text-base font-semibold leading-6 text-[var(--aionsi-navy)]">{title}</h3></div>)}</div></Container></Section>

    <Section><Container><div class="grid gap-8 lg:grid-cols-2"><div class="border border-slate-200 bg-white p-7 shadow-sm"><TechnicalLabel>ENGINEERING GOVERNANCE</TechnicalLabel><h2 class="mt-4 text-3xl font-semibold text-[var(--aionsi-navy)] md:text-4xl">Governance designed for semiconductor programs.</h2><div class="mt-5 grid gap-3 sm:grid-cols-2">{['Technical lead ownership','Milestone tracking','Deliverable ownership','Issue and risk tracking','Quality / closure metrics','Customer reporting'].map((item) => <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-4 text-sm font-semibold text-slate-700">{item}</div>)}</div></div><div class="border border-slate-200 bg-white p-7 shadow-sm"><TechnicalLabel>SECURITY &amp; CONFIDENTIALITY</TechnicalLabel><h2 class="mt-4 text-3xl font-semibold text-[var(--aionsi-navy)] md:text-4xl">Built for confidential semiconductor engineering.</h2><p class="mt-5 text-lg leading-8 text-slate-600">NDA-first engagement, customer-aligned tools and processes, controlled engineering access and deliberate anonymization of customer-sensitive program information.</p></div></div></Container></Section>

    <section id="odc-conversation" class="bg-[var(--aionsi-surface-alt)] py-16 md:py-24"><Container><div class="mx-auto max-w-4xl border border-slate-200 bg-white p-7 shadow-sm md:p-10"><TechnicalLabel>ODC ENGINEERING CONVERSATION</TechnicalLabel><h2 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Have a semiconductor workstream that needs dedicated engineering capacity?</h2><p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">Start with one defined engineering problem. Validate execution. Scale into a dedicated ODC when the engineering case is proven.</p><div class="mt-8 flex flex-wrap gap-3"><Button href="/contact">Discuss an ODC Requirement</Button><a href="/capabilities" class="inline-flex items-center rounded-md border border-slate-300 px-6 py-3 font-semibold text-[var(--aionsi-navy)] transition hover:border-slate-500 focus:outline-none focus:ring-2 focus:ring-[var(--aionsi-blue)]">Explore Engineering Capabilities →</a></div><p class="mt-5 text-xs leading-5 text-slate-500">Representative engagements are presented at a high level. Customer and product details remain confidential where restricted by NDA.</p></div></Container></section>
  </main>
  <Footer />
</BaseLayout>
