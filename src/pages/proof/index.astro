---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { engineeringProof } from '../../data/proof';
---
<BaseLayout title="Representative Engineering Experience | AionSi" description="Approved representative engineering experience across Physical Design, Design Verification and Protocol Verification.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>ENGINEERING PROOF</TechnicalLabel>
        <div class="grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-end">
          <div>
            <h1 class="text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Representative engineering experience.</h1>
            <p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">Evidence-led examples of engineering scope, methodology and delivery areas that support AionSi capability positioning.</p>
          </div>
          <div class="border border-slate-200 bg-white p-7">
            <TechnicalLabel>EVIDENCE DISCIPLINE</TechnicalLabel>
            <p class="mt-5 text-base leading-7 text-[var(--aionsi-navy)]">Customer-confidential information is excluded. Public content is limited to approved engineering evidence and representative experience.</p>
          </div>
        </div>
      </Container>
    </Section>

    <Section>
      <Container>
        <div class="grid gap-5 lg:grid-cols-3">
          {engineeringProof.map((item) => (
            <article class="border border-slate-200 bg-white p-8">
              <div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">{item.type.replace('-', ' ')}</div>
              <h2 class="mt-5 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{item.title}</h2>
              <div class="mt-4 text-sm font-semibold text-slate-500">{item.capability}</div>
              <p class="mt-4 text-base leading-7 text-slate-600">{item.summary}</p>
              <div class="mt-6 grid gap-2">
                {item.scope.map((scope) => <div class="border-l-2 border-[var(--aionsi-orange)] pl-3 text-sm leading-6 text-slate-600">{scope}</div>)}
              </div>
              <a href={item.href} class="mt-8 inline-flex text-sm font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">View evidence →</a>
            </article>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container class="text-center">
        <TechnicalLabel>ENGINEERING DISCOVERY</TechnicalLabel>
        <h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-6xl">Need evidence around a specific workstream?</h2>
        <p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-slate-600">Tell us the capability, technology, milestone or engineering bottleneck. We can map the discussion to the relevant AionSi evidence and delivery model.</p>
        <div class="mt-9"><Button href="/contact">Discuss Your Engineering Requirement</Button></div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
