---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';

const leadership = [
  { number: '01', name: 'Jayaprakash Polimetla', role: 'Chief Executive Officer', focus: 'Corporate strategy, customer relationships, growth and long-term company direction.', image: '/images/leadership/jayaprakash-polimetla-ceo.svg' },
  { number: '02', name: 'Indrasena Reddy Maru', role: 'Chief Technology Officer', focus: 'Technology strategy, semiconductor engineering depth, IP and SoC architecture.', image: '/images/leadership/indrasena-reddy-maru-cto.svg' },
  { number: '03', name: 'Paul Adams', role: 'Chief Strategy Officer', focus: 'Market strategy, strategic partnerships, business development and global expansion.', image: '/images/leadership/paul-adams-cso.svg' },
  { number: '04', name: 'Shri K. V. Chowdary', role: 'Director', focus: 'Engineering delivery, capability development, quality and technical execution.', image: '/images/leadership/shri-k-v-chowdary.svg' },
  { number: '05', name: 'Shri Ravi Prasad. P', role: 'Director', focus: 'People, operating systems, delivery governance and organizational scale.', image: '/images/leadership/shri-ravi-prasad-p.svg' },
];
---
<BaseLayout title="Leadership | AionSi" description="AionSi leadership team and executive responsibilities across semiconductor engineering, technology, strategy and operations.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-14 lg:py-16">
      <Container>
        <TechnicalLabel>LEADERSHIP</TechnicalLabel>
        <h1 class="mt-4 max-w-5xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Leadership built around engineering depth.</h1>
        <p class="mt-5 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">A focused leadership structure connecting technology, customer growth, strategy, engineering execution and operational scale.</p>
      </Container>
    </Section>

    <Section class="py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {leadership.map((leader) => (
            <article class="overflow-hidden border border-slate-200 bg-white shadow-sm">
              <div class="aspect-[4/5] overflow-hidden bg-slate-100"><img src={leader.image} alt={`${leader.name} — ${leader.role}`} class="h-full w-full object-cover object-top" loading="lazy" decoding="async" /></div>
              <div class="p-7">
                <div class="flex items-center justify-between"><span class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{leader.number}</span><span class="h-2 w-2 rounded-full bg-[var(--aionsi-orange)]"></span></div>
                <h2 class="mt-5 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{leader.name}</h2>
                <p class="mt-2 text-sm font-semibold uppercase tracking-[.12em] text-[var(--aionsi-blue)]">{leader.role}</p>
                <p class="mt-4 text-sm leading-7 text-slate-600">{leader.focus}</p>
              </div>
            </article>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white">
      <Container class="grid gap-10 lg:grid-cols-[1.1fr_.9fr] lg:items-center">
        <div><TechnicalLabel>LEADERSHIP PRINCIPLE</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">Technology leadership must stay close to the engineering problem.</h2><p class="mt-5 max-w-2xl text-lg leading-8 text-white/70">AionSi leadership is structured to keep technical accountability, customer outcomes and operating discipline connected as programs scale.</p></div>
        <div class="border border-white/10 p-7"><div class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">LEADERSHIP TEAM</div><div class="mt-5 grid gap-3 text-sm text-white/70">{leadership.map((leader) => <div class="border-b border-white/10 pb-3 last:border-b-0"><span class="font-semibold text-white">{leader.name}</span> · {leader.role}</div>)}</div></div>
      </Container>
    </Section>

    <Section><Container class="flex flex-col gap-6 border border-slate-200 bg-[var(--aionsi-surface-alt)] p-8 md:flex-row md:items-center md:justify-between"><div><TechnicalLabel>CONNECT WITH AIONSI</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)]">Have a strategic engineering requirement?</h2></div><Button href="/contact">Contact AionSi</Button></Container></Section>
  </main>
  <Footer />
</BaseLayout>
