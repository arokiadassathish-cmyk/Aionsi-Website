---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';

const leadership = [
  { number: '01', name: 'Jayaprakash Polimetla', role: 'Chief Executive Officer', focus: 'Corporate strategy, customer relationships, growth and long-term company direction.', image: '/images/leadership/jayaprakash-polimetla-ceo.svg' },
  { number: '02', name: 'Indrasena Reddy Maru', role: 'Chief Technology Officer', focus: 'Technology strategy, semiconductor engineering depth, IP and SoC architecture.', image: '/images/leadership/indrasena-reddy-maru-cto.svg' },
  { number: '03', name: 'Paul Adams', role: 'Chief Strategy Officer', focus: 'Market strategy, strategic partnerships, business development and global expansion.', image: '/images/leadership/paul-adams-cso.svg' },
  { number: '04', name: 'Shri K. V. Chowdary', role: 'Director', focus: 'Engineering delivery, capability development, quality and technical execution.', image: '/images/leadership/shri-k-v-chowdary.svg' },
  { number: '05', name: 'Shri Ravi Prasad. P', role: 'Director', focus: 'People, operating systems, delivery governance and organizational scale.', image: '/images/leadership/shri-ravi-prasad-p.svg' },
];
---
<BaseLayout title="Leadership | AionSi" description="AionSi leadership team and executive responsibilities across semiconductor engineering, technology, strategy and operations.">
  <Header />
  <main>
    <Section class="relative overflow-hidden bg-[var(--aionsi-surface-alt)] py-14 md:py-16 lg:py-20">
      <Container>
        <div class="max-w-5xl">
          <TechnicalLabel>LEADERSHIP</TechnicalLabel>
          <h1 class="mt-4 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Leadership built around engineering depth.</h1>
          <p class="mt-5 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">A focused leadership structure connecting technology, customer growth, strategy, engineering execution and operational scale.</p>
        </div>
      </Container>
    </Section>

    <Section class="py-14 md:py-16 lg:py-20">
      <Container>
        <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
          <div>
            <TechnicalLabel>EXECUTIVE TEAM</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">One team. Clear ownership.</h2>
          </div>
          <p class="max-w-xl text-sm leading-7 text-slate-500">Technology, strategy, engineering delivery and operating scale are represented directly at leadership level.</p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-12">
          {leadership.map((leader, index) => (
            <article class:list={[
              'group overflow-hidden border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg',
              index < 2 ? 'lg:col-span-6' : 'lg:col-span-4'
            ]}>
              <div class="relative aspect-[16/11] overflow-hidden bg-slate-100">
                <img src={leader.image} alt={`${leader.name} — ${leader.role}`} class="block h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.02]" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
                <div class="absolute left-4 top-4 rounded-full border border-white/60 bg-white/90 px-3 py-1 text-[11px] font-semibold tracking-[.18em] text-[var(--aionsi-blue)] backdrop-blur">{leader.number}</div>
              </div>
              <div class="p-6 md:p-7">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{leader.name}</h3>
                    <p class="mt-2 text-xs font-semibold uppercase tracking-[.12em] text-[var(--aionsi-blue)]">{leader.role}</p>
                  </div>
                  <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-[var(--aionsi-orange)]"></span>
                </div>
                <p class="mt-4 text-sm leading-7 text-slate-600">{leader.focus}</p>
              </div>
            </article>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-16 lg:py-20">
      <Container class="grid gap-10 lg:grid-cols-[1.05fr_.95fr] lg:items-center">
        <div>
          <TechnicalLabel>LEADERSHIP PRINCIPLE</TechnicalLabel>
          <h2 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">Technology leadership must stay close to the engineering problem.</h2>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-white/70">AionSi leadership is structured to keep technical accountability, customer outcomes and operating discipline connected as programs scale.</p>
        </div>
        <div class="border border-white/10 bg-white/[0.03] p-7 md:p-8">
          <div class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">LEADERSHIP TEAM</div>
          <div class="mt-5 grid gap-3 text-sm text-white/70">
            {leadership.map((leader) => (
              <div class="flex items-start justify-between gap-4 border-b border-white/10 pb-3 last:border-b-0">
                <span class="font-semibold text-white">{leader.name}</span>
                <span class="text-right">{leader.role}</span>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <Section>
      <Container class="flex flex-col gap-6 border border-slate-200 bg-[var(--aionsi-surface-alt)] p-8 md:flex-row md:items-center md:justify-between">
        <div>
          <TechnicalLabel>CONNECT WITH AIONSI</TechnicalLabel>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)]">Have a strategic engineering requirement?</h2>
        </div>
        <Button href="/contact">Contact AionSi</Button>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
