---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';

const pageTitle = 'ScioTeq Engineering Services | FPGA, Verification & Embedded Engineering | AionSi';
const pageDescription = 'AionSi engineering support for ScioTeq across FPGA, RTL, SystemVerilog/UVM verification, high-speed interfaces and embedded compute for mission-critical platforms.';
const pageUrl = 'https://aionsi.com/scioteq/';
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDescription,
  url: pageUrl,
  isPartOf: { '@type': 'WebSite', name: 'AionSi', url: 'https://aionsi.com' },
  about: [
    { '@type': 'Thing', name: 'FPGA engineering' },
    { '@type': 'Thing', name: 'Design verification' },
    { '@type': 'Thing', name: 'Embedded systems' },
    { '@type': 'Thing', name: 'High-speed interfaces' },
    { '@type': 'Thing', name: 'Mission-critical visualization' },
  ],
};
---
<BaseLayout title={pageTitle} description={pageDescription} canonical={pageUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)}></script>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-20">
      <Container>
        <nav class="mb-6 text-xs font-medium text-slate-500" aria-label="Breadcrumb">
          <a class="hover:text-[var(--aionsi-blue)]" href="/">AionSi</a><span class="mx-2">/</span><span>ScioTeq Engineering</span>
        </nav>
        <TechnicalLabel>SCIO TEQ · ENGINEERING PARTNERSHIP</TechnicalLabel>
        <div class="mt-5 grid gap-10 lg:grid-cols-[1.25fr_.75fr] lg:items-center">
          <div>
            <h1 class="max-w-5xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Engineering capability for ScioTeq’s next-generation platforms.</h1>
            <p class="mt-6 max-w-4xl text-xl leading-9 text-slate-600 md:text-2xl">AionSi brings semiconductor, FPGA, verification and embedded engineering expertise to help accelerate complex mission-critical programs—from focused technical work packages to dedicated engineering teams.</p>
            <div class="mt-8 flex flex-wrap gap-3"><Button href="#capabilities">Explore engineering capabilities →</Button><a href="#engagement" class="inline-flex items-center border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-[var(--aionsi-navy)]">Explore the engagement model</a></div>
          </div>
          <div class="border border-slate-200 border-t-2 border-t-[var(--aionsi-blue)] bg-white p-6 shadow-sm">
            <TechnicalLabel>ENGINEERING FOCUS</TechnicalLabel>
            <div class="mt-3 text-5xl font-semibold text-[var(--aionsi-blue)]">01</div>
            <h2 class="mt-2 text-2xl font-semibold text-[var(--aionsi-navy)]">Mission-critical engineering support</h2>
            <p class="mt-3 text-sm leading-7 text-slate-600">Specialized engineering across FPGA, RTL, verification, high-speed interfaces and embedded compute—with disciplined execution for complex product environments.</p>
            <div class="mt-6 grid grid-cols-3 gap-3 border-t border-slate-200 pt-5 text-center"><div><strong class="block text-xl text-[var(--aionsi-navy)]">FPGA</strong><span class="text-xs text-slate-500">Engineering</span></div><div><strong class="block text-xl text-[var(--aionsi-navy)]">DV</strong><span class="text-xs text-slate-500">Verification</span></div><div><strong class="block text-xl text-[var(--aionsi-navy)]">ODC</strong><span class="text-xs text-slate-500">Scale</span></div></div>
          </div>
        </div>
      </Container>
    </Section>

    <section class="border-y border-slate-200 bg-white"><Container class="grid gap-0 md:grid-cols-3">{[['Engineering scope','FPGA · RTL · verification · embedded engineering'],['Technical focus','High-speed interfaces · PCIe · SystemVerilog / UVM'],['Delivery options','Focused work package · extended team · dedicated engineering']].map(([title,desc]) => <div class="border-x border-slate-200 px-5 py-5 first:border-l-0 last:border-r-0"><TechnicalLabel>{title}</TechnicalLabel><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></div>)}</Container></section>

    <Section id="capabilities">
      <Container>
        <TechnicalLabel>ENGINEERING CAPABILITIES</TechnicalLabel>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Focused expertise for complex systems.</h2>
        <p class="mt-3 max-w-3xl text-lg leading-8 text-slate-600">AionSi can support engineering teams across the hardware and verification stack, with scope aligned to the needs of each program.</p>
        <div class="mt-8 grid gap-5 lg:grid-cols-3">
          {[['01','FPGA & DIGITAL ENGINEERING','FPGA design and verification, RTL development, integration and regression automation.',['VHDL / RTL','FPGA verification','Regression automation']],['02','VERIFICATION & VALIDATION','SystemVerilog and UVM-based verification with structured planning, coverage and traceability.',['SystemVerilog / UVM','Functional verification','Coverage & traceability']],['03','HIGH-SPEED & EMBEDDED','Engineering for high-speed interfaces and FPGA-to-compute integration in embedded platforms.',['PCIe & interfaces','FPGA integration','Embedded compute']]].map(([num,title,desc,items]) => <article class="border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)]"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">{num}</span><h3 class="mt-4 text-2xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-3 min-h-[92px] text-sm leading-7 text-slate-600">{desc}</p><div class="mt-4 border-t border-slate-200 pt-3">{items.map(item => <div class="py-1 text-xs font-medium text-slate-600">→ {item}</div>)}</div></article>)}
        </div>
      </Container>
    </Section>

    <section id="engagement" class="border-y border-slate-800 bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-20"><Container><div class="grid gap-10 lg:grid-cols-2 lg:items-center"><div><TechnicalLabel>ENGINEERING ENGAGEMENT</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold md:text-5xl">Start with the engineering challenge.</h2><p class="mt-5 max-w-2xl text-lg leading-8 text-white/70">AionSi can align to a defined technical scope, extend an existing team or establish a dedicated engineering capability around a program.</p></div><div class="border-l border-white/10 pl-5">{[['01','Understand','Align on the product, architecture, interfaces and engineering objectives.'],['02','Define','Agree on scope, responsibilities, interfaces and measurable deliverables.'],['03','Execute','Bring the right engineering expertise into the program with clear ownership.'],['04','Scale','Extend the team or scope as program requirements evolve.']].map(([num,title,desc]) => <div class="grid grid-cols-[40px_1fr] gap-4 border-b border-white/10 py-4"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">{num}</span><div><strong>{title}</strong><p class="mt-1 text-sm text-white/60">{desc}</p></div></div>)}</div></div></Container></section>

    <Section>
      <Container>
        <TechnicalLabel>ENGINEERING ALIGNMENT</TechnicalLabel>
        <h2 class="mt-3 text-3xl font-semibold text-[var(--aionsi-navy)] md:text-5xl">Where AionSi can contribute.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">{[['FPGA ENGINEERING','RTL, FPGA integration and verification'],['DIGITAL VERIFICATION','SystemVerilog, UVM, regression and coverage'],['INTERFACES','PCIe, protocol verification and high-speed connectivity'],['EMBEDDED SYSTEMS','FPGA-to-compute integration and platform validation']].map(([title,desc]) => <article class="border border-slate-200 bg-white p-5 shadow-sm"><TechnicalLabel>{title}</TechnicalLabel><p class="mt-3 text-sm leading-7 text-slate-600">{desc}</p></article>)}</div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr]">
          <div><TechnicalLabel>ENGINEERING VALUE</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold text-[var(--aionsi-navy)] md:text-4xl">Built around engineering outcomes.</h2><p class="mt-4 text-lg leading-8 text-slate-600">AionSi combines semiconductor depth with structured delivery so engineering teams can focus on product milestones, verification quality and predictable execution.</p></div>
          <div class="grid gap-4 sm:grid-cols-2">{[['Technical depth','RTL · FPGA · IP · SystemVerilog · UVM'],['Verification discipline','Planning · automation · coverage · traceability'],['Integration focus','Interfaces · FPGA · embedded compute'],['Scalable delivery','Focused scope · extended team · dedicated engineering']].map(([title,desc]) => <div class="border border-slate-200 bg-white p-5"><h3 class="font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-7 text-slate-600">{desc}</p></div>)}</div>
        </div>
      </Container>
    </Section>

    <Section>
      <Container><TechnicalLabel>LET’S TALK ENGINEERING</TechnicalLabel><div class="mt-4 flex flex-col gap-6 border border-slate-200 bg-white p-7 shadow-sm md:flex-row md:items-center md:justify-between"><div><h2 class="text-3xl font-semibold text-[var(--aionsi-navy)]">Have a ScioTeq engineering challenge?</h2><p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600">Share the technical challenge, target milestone or engineering scope. AionSi will map it to the appropriate semiconductor and embedded engineering capability.</p></div><Button href="/contact">Talk to Our Engineering Team</Button></div></Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-10 md:py-12">
      <Container>
        <div class="flex flex-col gap-5 border-t border-slate-200 pt-8 md:flex-row md:items-center md:justify-between">
          <div><TechnicalLabel>RELATED ENGINEERING INSIGHT</TechnicalLabel><h2 class="mt-3 text-2xl font-semibold text-[var(--aionsi-navy)]">When a Display Becomes a Computing Platform.</h2><p class="mt-2 max-w-3xl text-sm leading-7 text-slate-600">Explore how FPGA processing, high-speed interfaces, embedded compute, AI and system-level verification change the engineering boundary.</p></div>
          <a href="/insights/when-a-display-becomes-a-computing-platform" class="inline-flex shrink-0 items-center border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-[var(--aionsi-navy)]">Read the engineering perspective →</a>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'AionSi', item: 'https://aionsi.com/' },
      { '@type': 'ListItem', position: 2, name: 'ScioTeq Engineering', item: pageUrl },
    ],
  })}></script>
</BaseLayout>
