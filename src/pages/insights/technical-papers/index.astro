---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/global/Header.astro';
import Footer from '../../../components/global/Footer.astro';
import Container from '../../../components/global/Container.astro';
import Section from '../../../components/global/Section.astro';
import TechnicalLabel from '../../../components/global/TechnicalLabel.astro';
import Button from '../../../components/global/Button.astro';
const resources = [
  { number:'01', type:'Technical Paper', title:'Advanced-Node Physical Design: Timing, Congestion & Sign-Off Closure', description:'A focused engineering reference covering implementation, timing closure, congestion and physical sign-off practices.', href:'/evidence/advanced-node-physical-design-timing-congestion-signoff' },
  { number:'02', type:'Verification Methodology', title:'Reusable UVM Verification Architecture', description:'A reusable verification architecture reference spanning agents, monitors, scoreboards, coverage, assertions and regression workflows.', href:'/evidence/reusable-uvm-verification-architecture' },
  { number:'03', type:'Protocol Verification', title:'PCIe 5.0 Data Link Layer Verification', description:'Protocol-focused engineering evidence covering flow control, replay behavior, error injection and coverage.', href:'/evidence/pcie-5-data-link-layer-verification' },
];
---
<BaseLayout title="Technical Papers | AionSi" description="Technical engineering papers and methodology references from AionSi.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>TECHNICAL PAPERS</TechnicalLabel>
        <h1 class="text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Engineering references for complex silicon programs.</h1>
        <p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">Explore approved technical references covering physical implementation, verification methodology and protocol engineering.</p>
      </Container>
    </Section>
    <Section>
      <Container>
        <div class="grid gap-5 lg:grid-cols-3">
          {resources.map((resource) => (
            <article class="border border-slate-200 bg-white p-8">
              <div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">{resource.number}</div>
              <div class="mt-5 text-xs font-semibold uppercase tracking-[.16em] text-slate-400">{resource.type}</div>
              <h2 class="mt-3 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{resource.title}</h2>
              <p class="mt-4 text-base leading-7 text-slate-600">{resource.description}</p>
              <a href={resource.href} class="mt-8 inline-flex text-sm font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">Read reference →</a>
            </article>
          ))}
        </div>
      </Container>
    </Section>
    <Section class="bg-[var(--aionsi-deep-navy)] text-white">
      <Container class="text-center">
        <TechnicalLabel>ENGINEERING DISCOVERY</TechnicalLabel>
        <h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Have a related engineering challenge?</h2>
        <p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Bring the technical problem, program stage or capacity gap and start a scoped engineering conversation.</p>
        <div class="mt-9"><Button href="/contact">Discuss Your Engineering Requirement</Button></div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
