---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';

const questions = [
  ['01','ARCHITECTURE','What should live in deterministic hardware?','FPGA and embedded compute are complementary. Decide what belongs where based on latency, throughput, determinism, power and future change.'],
  ['02','VERIFICATION','Where does verification meet integration?','A block can pass simulation and still fail at a clock, interface, software or system boundary. Verification has to follow the behavior the operator actually experiences.'],
  ['03','VALIDATION','How do you verify the complete data path?','The important path is not one component in isolation. It is the chain from input and interface through FPGA, memory, compute, software and visualization.'],
];

const path = [
  ['01','INPUT','Sensor / video'],
  ['02','INTERFACE','High-speed I/O'],
  ['03','FPGA','Deterministic processing'],
  ['04','MEMORY','Data movement'],
  ['05','COMPUTE','CPU / GPU / AI'],
  ['06','SOFTWARE','System logic'],
  ['07','OUTPUT','Visualization'],
];

const boundaryCards = [
  ['01','TIMING & SYNCHRONIZATION','Clock domains, buffering and latency have to remain predictable across the data path.'],
  ['02','DATA MOVEMENT','Bandwidth and interface behavior can become system constraints long before an individual block fails.'],
  ['03','HW / SW INTEGRATION','The final behavior emerges from the interaction between hardware, compute and software.'],
];

const practical = [
  ['01','FPGA / RTL','Architecture, RTL implementation and deterministic data paths.'],
  ['02','DESIGN VERIFICATION','UVM environments, assertions, coverage, regressions and closure.'],
  ['03','HIGH-SPEED INTERFACES','Interface verification, synchronization, data movement and validation.'],
  ['04','EMBEDDED COMPUTE','FPGA + CPU/GPU integration and software interaction.'],
  ['05','SYSTEM VALIDATION','End-to-end behavior across hardware, interfaces, compute and software.'],
  ['06','ENGINEERING ODC','A dedicated engineering pod for a clearly owned technical work package.'],
];

const pageTitle = 'When a Display Becomes a Computing Platform | FPGA, Embedded Compute & Verification | AionSi';
const pageDescription = 'Engineering perspective on mission-critical visualization, FPGA processing, high-speed interfaces, embedded compute, AI and system-level verification.';
const pageUrl = 'https://aionsi.com/insights/when-a-display-becomes-a-computing-platform';
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: 'When a Display Becomes a Computing Platform',
  description: pageDescription,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  url: pageUrl,
  author: { '@type': 'Organization', name: 'AionSi India Pvt. Ltd.', url: 'https://aionsi.com' },
  publisher: { '@type': 'Organization', name: 'AionSi India Pvt. Ltd.', url: 'https://aionsi.com', logo: { '@type': 'ImageObject', url: 'https://aionsi.com/favicon.svg' } },
  articleSection: 'Engineering Insights',
  keywords: 'FPGA engineering, embedded compute, design verification, high-speed interfaces, mission-critical visualization, AI systems',
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'AionSi', item: 'https://aionsi.com/' },
    { '@type': 'ListItem', position: 2, name: 'Insights', item: 'https://aionsi.com/insights' },
    { '@type': 'ListItem', position: 3, name: 'When a Display Becomes a Computing Platform', item: pageUrl },
  ],
};
---
<BaseLayout title={pageTitle} description={pageDescription} canonical={pageUrl} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-10 md:py-16 lg:py-20">
      <Container>
        <nav class="mb-6 text-xs font-medium text-slate-500" aria-label="Breadcrumb">
          <a class="hover:text-[var(--aionsi-blue)]" href="/">AionSi</a><span class="mx-2">/</span><a class="hover:text-[var(--aionsi-blue)]" href="/insights">Insights</a><span class="mx-2">/</span><span>Engineering Perspective</span>
        </nav>
        <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
          <div>
            <TechnicalLabel>ENGINEERING INSIGHT · FPGA · EMBEDDED · VERIFICATION</TechnicalLabel>
            <h1 class="mt-5 max-w-3xl text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-6xl lg:text-7xl">When a Display Becomes a Computing Platform</h1>
            <p class="mt-6 max-w-2xl text-xl leading-9 text-slate-600 md:text-2xl">The engineering challenge behind next-generation visualization is no longer simply displaying information. It is engineering the boundaries between compute, FPGA, software and verification.</p>
            <div class="mt-7 flex flex-wrap gap-2 text-xs font-semibold tracking-wide text-slate-500"><span class="border border-slate-200 bg-white px-3 py-2">Mission-critical systems</span><span class="border border-slate-200 bg-white px-3 py-2">FPGA & RTL</span><span class="border border-slate-200 bg-white px-3 py-2">Embedded compute</span><span class="border border-slate-200 bg-white px-3 py-2">Verification</span></div>
          </div>
          <div class="relative overflow-hidden border border-slate-200 bg-white p-5 shadow-sm md:p-7">
            <div class="absolute right-0 top-0 h-1 w-28 bg-[var(--aionsi-orange)]"></div>
            <div class="flex items-center justify-between"><TechnicalLabel>SYSTEM ARCHITECTURE</TechnicalLabel><span class="text-[10px] font-semibold tracking-[.18em] text-slate-400">BOUNDARIES MATTER</span></div>
            <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {path.map(([num,label,desc]) => <div class:list={["border p-4", label === 'FPGA' ? 'border-[var(--aionsi-orange)] bg-[var(--aionsi-deep-navy)]' : 'border-slate-200 bg-white']}>
                <span class="text-[10px] font-semibold tracking-[.15em] text-[var(--aionsi-orange)]">{num} · {label}</span>
                <p class:list={["mt-3 text-sm font-semibold", label === 'FPGA' ? 'text-white' : 'text-[var(--aionsi-navy)]']}>{desc}</p>
                {label === 'FPGA' && <p class="mt-2 text-xs leading-5 text-white/65">Low latency + data-path control</p>}
              </div>)}
            </div>
            <div class="mt-5 flex items-start gap-3 border-t border-slate-200 pt-5"><span class="mt-1 h-2.5 w-2.5 shrink-0 bg-[var(--aionsi-orange)]"></span><p class="text-sm leading-7 text-slate-500"><strong class="text-[var(--aionsi-navy)]">The difficult engineering problems are often between the components.</strong></p></div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-white py-14 md:py-18">
      <Container>
        <div class="mx-auto max-w-4xl text-center">
          <TechnicalLabel>THE QUESTION</TechnicalLabel>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Where should the intelligence of the system live?</h2>
          <p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-slate-600">The answer is rarely “FPGA” or “CPU”. The engineering problem is deciding what belongs where—and proving that the complete path behaves predictably.</p>
        </div>
        <div class="mx-auto mt-10 grid max-w-6xl gap-4 sm:grid-cols-3">
          {questions.map(([num,label,title,desc]) => <article class="border border-slate-200 bg-white p-6 shadow-sm"><div class="flex items-center justify-between"><span class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-orange)]">{num}</span><span class="text-[10px] font-semibold tracking-[.15em] text-slate-400">{label}</span></div><h3 class="mt-5 text-xl font-semibold leading-tight text-[var(--aionsi-navy)]">{title}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{desc}</p></article>)}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-20">
      <Container>
        <div class="mx-auto max-w-5xl">
          <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-center">
            <div>
              <TechnicalLabel>THE ENGINEERING BOUNDARY</TechnicalLabel>
              <h2 class="mt-4 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-6xl">The difficult work often happens at the boundaries.</h2>
              <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">The highest-risk interactions are often where one engineering discipline hands a behavior to another.</p>
            </div>
            <div class="grid gap-4">
              {boundaryCards.map(([num,title,desc]) => <article class="border border-slate-200 bg-white p-5 shadow-sm"><div class="flex gap-4"><span class="shrink-0 text-xs font-semibold tracking-[.18em] text-[var(--aionsi-orange)]">{num}</span><div><h3 class="text-lg font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-7 text-slate-600">{desc}</p></div></div></article>)}
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-white py-14 md:py-20">
      <Container>
        <div class="mx-auto max-w-5xl">
          <div class="max-w-3xl"><TechnicalLabel>VERIFY THE SYSTEM</TechnicalLabel><h2 class="mt-4 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Verification has to follow the system—not just the block.</h2><p class="mt-5 text-lg leading-8 text-slate-600">A block can pass simulation and still fail at a system boundary. The verification strategy has to follow the behavior the operator actually experiences.</p></div>
          <div class="mt-10 overflow-hidden border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5 md:p-7">
            <div class="grid gap-3 md:grid-cols-[1fr_auto_1fr_1fr] md:items-stretch">
              <div class="border border-slate-200 bg-white p-5"><span class="text-[10px] font-semibold tracking-[.15em] text-[var(--aionsi-orange)]">BLOCK</span><h3 class="mt-2 font-semibold text-[var(--aionsi-navy)]">RTL intent</h3><p class="mt-2 text-sm leading-6 text-slate-500">Does the logic behave as specified?</p></div>
              <div class="hidden items-center justify-center text-2xl text-[var(--aionsi-blue)] md:flex">→</div>
              <div class="border border-[var(--aionsi-orange)] bg-[var(--aionsi-deep-navy)] p-5 text-white"><span class="text-[10px] font-semibold tracking-[.15em] text-[var(--aionsi-orange)]">BOUNDARY</span><h3 class="mt-2 font-semibold">Interface behavior</h3><p class="mt-2 text-sm leading-6 text-white/65">Does the handoff remain correct?</p></div>
              <div class="border border-slate-200 bg-white p-5"><span class="text-[10px] font-semibold tracking-[.15em] text-[var(--aionsi-orange)]">SYSTEM</span><h3 class="mt-2 font-semibold text-[var(--aionsi-navy)]">Operator outcome</h3><p class="mt-2 text-sm leading-6 text-slate-500">Does the complete path behave correctly?</p></div>
            </div>
            <div class="mt-6 grid gap-3 sm:grid-cols-3"><div class="border border-slate-200 bg-white p-4 text-center text-sm font-semibold text-[var(--aionsi-navy)]">Reusable environments</div><div class="border border-slate-200 bg-white p-4 text-center text-sm font-semibold text-[var(--aionsi-navy)]">Coverage + assertions</div><div class="border border-slate-200 bg-white p-4 text-center text-sm font-semibold text-[var(--aionsi-navy)]">Regression + closure</div></div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-20">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
          <div><TechnicalLabel>COMPUTE CONVERGENCE</TechnicalLabel><h2 class="mt-4 text-4xl font-semibold tracking-tight md:text-5xl">AI adds another compute domain.</h2><p class="mt-5 max-w-xl text-lg leading-8 text-white/70">The engineering challenge is the handoff between deterministic hardware, embedded compute and software—and proving that the combined system remains predictable, testable and maintainable.</p></div>
          <div>
            <div class="grid gap-4 sm:grid-cols-3">
              <article class="border border-white/10 bg-white/5 p-5"><span class="text-[10px] font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">01</span><h3 class="mt-3 text-lg font-semibold">FPGA</h3><p class="mt-2 text-sm leading-6 text-white/60">Latency, determinism and data-path control.</p></article>
              <article class="border border-white/10 bg-white/5 p-5"><span class="text-[10px] font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">02</span><h3 class="mt-3 text-lg font-semibold">CPU / GPU / AI</h3><p class="mt-2 text-sm leading-6 text-white/60">Programmability, application flexibility and intelligent compute.</p></article>
              <article class="border border-white/10 bg-white/5 p-5"><span class="text-[10px] font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">03</span><h3 class="mt-3 text-lg font-semibold">SOFTWARE</h3><p class="mt-2 text-sm leading-6 text-white/60">Control, orchestration and system integration.</p></article>
            </div>
            <div class="mt-5 flex flex-wrap items-center gap-3 text-xs font-semibold tracking-[.15em] text-white/55"><span>FPGA</span><span class="text-[var(--aionsi-orange)]">→</span><span>CPU / GPU / AI</span><span class="text-[var(--aionsi-orange)]">→</span><span>SOFTWARE</span></div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-white py-14 md:py-20">
      <Container>
        <div class="mx-auto max-w-5xl">
          <div class="max-w-3xl"><TechnicalLabel>ENGINEERING OWNERSHIP</TechnicalLabel><h2 class="mt-4 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">The better question is where the technical constraint sits.</h2><p class="mt-5 text-lg leading-8 text-slate-600">The right engineering model follows the problem: a focused work package, a specialist engineering pod or a dedicated team with clear ownership.</p></div>
          <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{practical.map(([num,title,desc]) => <article class="border border-slate-200 bg-white p-5 shadow-sm"><span class="text-[10px] font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">{num}</span><h3 class="mt-3 text-base font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></article>)}</div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-10 md:py-12">
      <Container>
        <div class="mx-auto max-w-4xl text-center"><TechnicalLabel>A THOUGHT FOR ENGINEERING LEADERS</TechnicalLabel><blockquote class="mt-5 text-3xl font-semibold leading-tight tracking-tight text-[var(--aionsi-navy)] md:text-5xl">“Are we designing better components—or designing better connections between them?”</blockquote><p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-slate-600">As visualization platforms evolve into integrated compute platforms, the advantage may increasingly come from how well the engineering disciplines connect.</p></div>
      </Container>
    </Section>

    <Section class="bg-white py-10 md:py-12">
      <Container>
        <div class="flex flex-col items-start justify-between gap-5 border border-slate-200 bg-white p-7 shadow-sm md:flex-row md:items-center"><div><TechnicalLabel>LET’S TALK ENGINEERING</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold text-[var(--aionsi-navy)]">Have an engineering boundary worth discussing?</h2><p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600">Architecture, verification, interface behavior or the HW/SW boundary—start with the technical constraint.</p></div><Button href="/contact">Discuss the Engineering Challenge</Button></div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
