---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';

const perspectives = [
  {
    number: '01',
    type: 'Engineering Perspective',
    title: 'Advanced-Node Physical Design: Timing, Congestion & Sign-Off Closure',
    description: 'An engineering perspective built from the physical-design evidence base, focused on closure strategy, implementation trade-offs and the path from congestion to sign-off.',
    href: '/evidence/advanced-node-physical-design-timing-congestion-signoff',
  },
  {
    number: '02',
    type: 'Verification Perspective',
    title: 'Reusable UVM Architectures for Scalable Verification Programs',
    description: 'A practical perspective on reusable verification environments, checking strategy, coverage, assertions and regression closure, with supporting technical evidence.',
    href: '/evidence/reusable-uvm-verification-architecture',
  },
  {
    number: '03',
    type: 'Protocol Perspective',
    title: 'PCIe Data Link Verification: Where Protocol Complexity Concentrates',
    description: 'A protocol-focused perspective on flow control, replay, error handling and verification closure, grounded in the supporting PCIe engineering reference.',
    href: '/evidence/pcie-5-data-link-layer-verification',
  },
];

const channels = [
  ['/news', 'News', 'Company announcements, engineering milestones and approved public updates.'],
  ['/blogs', 'Engineering Blogs', 'Technical perspectives, methodologies and practical lessons from AionSi engineering teams.'],
];
---
<BaseLayout title="Insights | AionSi" description="Engineering perspectives, technical blogs and public technical thinking from AionSi semiconductor engineering teams.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-16 lg:py-20">
      <Container>
        <TechnicalLabel>INSIGHTS</TechnicalLabel>
        <h1 class="max-w-5xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Engineering thinking behind complex silicon programs.</h1>
        <p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">Insights interprets AionSi engineering experience and technical evidence into perspectives, methodologies and practical viewpoints. It is not a duplicate of the Evidence library.</p>
      </Container>
    </Section>

    <Section>
      <Container>
        <TechnicalLabel>ENGINEERING PERSPECTIVES</TechnicalLabel>
        <div class="mt-8 grid gap-5 lg:grid-cols-3">
          {perspectives.map((resource) => (
            <article class="flex h-full flex-col border border-slate-200 bg-white p-8">
              <div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">{resource.number}</div>
              <div class="mt-5 text-xs font-semibold uppercase tracking-[.16em] text-slate-400">{resource.type}</div>
              <h2 class="mt-3 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{resource.title}</h2>
              <p class="mt-4 text-base leading-7 text-slate-600">{resource.description}</p>
              <div class="mt-auto flex flex-wrap gap-4 pt-8">
                <a href={resource.href} class="inline-flex text-sm font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">Read supporting evidence →</a>
              </div>
            </article>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <div class="grid gap-8 lg:grid-cols-2 lg:items-start">
          <div>
            <TechnicalLabel>WHAT BELONGS IN INSIGHTS</TechnicalLabel>
            <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Interpretation, not duplication.</h2>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {[
              'Engineering perspectives derived from evidence',
              'Methodology and lessons learned',
              'Technology and architecture analysis',
              'Practical viewpoints from engineering teams',
            ].map((item, index) => <div class="border border-slate-200 bg-white p-6"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">0{index + 1}</div><p class="mt-4 font-semibold leading-6 text-[var(--aionsi-navy)]">{item}</p></div>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section>
      <Container>
        <TechnicalLabel>CONTENT CHANNELS</TechnicalLabel>
        <div class="mt-6 grid gap-5 md:grid-cols-2">
          {channels.map(([href, title, description]) => <a href={href} class="group border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]"><h2 class="text-2xl font-semibold text-[var(--aionsi-navy)]">{title}</h2><p class="mt-3 text-sm leading-7 text-slate-600">{description}</p><span class="mt-7 inline-flex text-sm font-semibold text-[var(--aionsi-blue)]">Explore →</span></a>)}
        </div>
      </Container>
    </Section>

    <Section class="bg-white">
      <Container class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
        <div><TechnicalLabel>DISCOVER MORE</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Looking for execution proof?</h2><p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Move from insight to representative engineering experience and the authoritative evidence behind it.</p></div>
        <div class="flex flex-wrap gap-4 lg:justify-end"><Button href="/experience" variant="technical">Explore Representative Experience</Button><Button href="/evidence" variant="technical">Explore Engineering Evidence</Button></div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white">
      <Container class="text-center"><TechnicalLabel>CONTENT → CONVERSION</TechnicalLabel><h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Have an engineering problem to discuss?</h2><p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Turn a technical question, workstream or capacity requirement into a scoped engineering discovery conversation.</p><div class="mt-9"><Button href="/contact">Discuss Your Engineering Requirement</Button></div></Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
