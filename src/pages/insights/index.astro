---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
const resources = [
  { number:'01', type:'Technical Paper', title:'Advanced-Node Physical Design: Timing, Congestion & Sign-Off Closure', description:'A focused engineering reference covering implementation, timing closure, congestion and physical sign-off practices.', href:'/evidence/advanced-node-physical-design-timing-congestion-signoff' },
  { number:'02', type:'Verification Methodology', title:'Reusable UVM Verification Architecture', description:'A reusable verification architecture reference spanning agents, monitors, scoreboards, coverage, assertions and regression workflows.', href:'/evidence/reusable-uvm-verification-architecture' },
  { number:'03', type:'Protocol Verification', title:'PCIe 5.0 Data Link Layer Verification', description:'Protocol-focused engineering evidence covering flow control, replay behavior, error injection and coverage.', href:'/evidence/pcie-5-data-link-layer-verification' },
];
const channels = [
  ['/news', 'News', 'Company announcements, engineering milestones and approved public updates.'],
  ['/blogs', 'Engineering Blogs', 'Technical perspectives, methodologies and practical lessons from AionSi engineering teams.'],
];
---
<BaseLayout title="Insights | AionSi" description="Technical papers, engineering blogs and public technical perspectives from AionSi semiconductor engineering teams.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-16 lg:py-20"><Container><TechnicalLabel>INSIGHTS</TechnicalLabel><h1 class="max-w-5xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Technical thinking behind complex silicon programs.</h1><p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">Explore approved technical references, engineering perspectives and company updates that explain how AionSi approaches difficult semiconductor problems.</p></Container></Section>

    <Section><Container><TechnicalLabel>TECHNICAL KNOWLEDGE</TechnicalLabel><div class="mt-8 grid gap-5 lg:grid-cols-3">{resources.map((resource) => <article class="flex h-full flex-col border border-slate-200 bg-white p-8"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">{resource.number}</div><div class="mt-5 text-xs font-semibold uppercase tracking-[.16em] text-slate-400">{resource.type}</div><h2 class="mt-3 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{resource.title}</h2><p class="mt-4 text-base leading-7 text-slate-600">{resource.description}</p><a href={resource.href} class="mt-auto pt-8 inline-flex text-sm font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">Read technical reference →</a></article>)}</div></Container></Section>

    <Section class="bg-[var(--aionsi-surface-alt)]"><Container><TechnicalLabel>CONTENT CHANNELS</TechnicalLabel><div class="mt-6 grid gap-5 md:grid-cols-2">{channels.map(([href, title, description]) => <a href={href} class="group border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]"><h2 class="text-2xl font-semibold text-[var(--aionsi-navy)]">{title}</h2><p class="mt-3 text-sm leading-7 text-slate-600">{description}</p><span class="mt-7 inline-flex text-sm font-semibold text-[var(--aionsi-blue)]">Explore →</span></a>)}</div></Container></Section>

    <Section class="bg-white"><Container class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-center"><div><TechnicalLabel>DISCOVER MORE</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Looking for evidence of engineering execution?</h2><p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Move from technical thinking to representative engineering experience and approved supporting evidence.</p></div><div class="flex flex-wrap gap-4 lg:justify-end"><Button href="/experience" variant="technical">Explore Representative Experience</Button><Button href="/proof" variant="technical">Explore Engineering Evidence</Button></div></Container></Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white"><Container class="text-center"><TechnicalLabel>CONTENT → CONVERSION</TechnicalLabel><h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Have an engineering problem to discuss?</h2><p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Turn a technical question, workstream or capacity requirement into a scoped engineering discovery conversation.</p><div class="mt-9"><Button href="/contact">Discuss Your Engineering Requirement</Button></div></Container></Section>
  </main>
  <Footer />
</BaseLayout>
