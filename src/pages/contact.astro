---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Container from '../components/global/Container.astro';
import Section from '../components/global/Section.astro';
import TechnicalLabel from '../components/global/TechnicalLabel.astro';
import Button from '../components/global/Button.astro';
---
<BaseLayout title="Contact | AionSi" description="Discuss your semiconductor engineering requirement with AionSi.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-16 md:py-20">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[1.05fr_.95fr] lg:items-start">
          <div class="max-w-4xl">
            <div class="flex items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]">
              <span>ENGINEERING ENGAGEMENT</span><span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span><span>CONTACT AIONSI</span>
            </div>
            <h1 class="mt-6 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Discuss Your Engineering Requirement.</h1>
            <p class="mt-5 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">Bring the semiconductor engineering problem, delivery stage or capability gap. We can map it to the appropriate AionSi engineering model.</p>
            <div class="mt-8 grid gap-4 sm:grid-cols-2">
              <div class="border border-slate-200 bg-white p-6"><TechnicalLabel>Typical discussion</TechnicalLabel><p class="mt-3 text-sm leading-6 text-slate-600">RTL, Design Verification, Physical Design, DFT, protocol verification, SoC/IP engineering or ODC requirements.</p></div>
              <div class="border border-slate-200 bg-white p-6"><TechnicalLabel>What to share</TechnicalLabel><p class="mt-3 text-sm leading-6 text-slate-600">Engineering stage, scope, bottleneck, team capacity, target milestone and required engagement model.</p></div>
            </div>
          </div>

          <div class="border border-slate-200 bg-white p-7 shadow-sm md:p-8">
            <TechnicalLabel>Direct enquiry</TechnicalLabel>
            <h2 class="mt-3 text-2xl font-semibold text-[var(--aionsi-navy)]">Start the conversation.</h2>
            <p class="mt-3 text-sm leading-6 text-slate-600">Use the details below to contact AionSi directly. We can follow up with the appropriate engineering or business development owner.</p>
            <div class="mt-6 space-y-4">
              <a href="mailto:business@aionsi.com" class="block border border-slate-200 p-4 hover:border-[var(--aionsi-blue)]"><span class="block text-xs font-semibold uppercase tracking-[.14em] text-[var(--aionsi-blue)]">Business Development</span><span class="mt-2 block text-base font-semibold text-[var(--aionsi-navy)]">business@aionsi.com</span></a>
              <a href="mailto:info@aionsi.com" class="block border border-slate-200 p-4 hover:border-[var(--aionsi-blue)]"><span class="block text-xs font-semibold uppercase tracking-[.14em] text-[var(--aionsi-blue)]">General Enquiry</span><span class="mt-2 block text-base font-semibold text-[var(--aionsi-navy)]">info@aionsi.com</span></a>
            </div>
            <div class="mt-6"><Button href="mailto:business@aionsi.com">Email AionSi Business Development</Button></div>
          </div>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
