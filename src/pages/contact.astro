---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Container from '../components/global/Container.astro';
import Section from '../components/global/Section.astro';
import TechnicalLabel from '../components/global/TechnicalLabel.astro';
---

<BaseLayout
  title="Talk to Our Engineering Team | AionSi"
  description="Share your semiconductor engineering requirement with AionSi's engineering team."
>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] pb-14 pt-32 md:pb-18 md:pt-40 lg:pb-20 lg:pt-44">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start lg:gap-16">
          <div>
            <div class="flex items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]">
              <span>CONTACT</span><span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span><span>ENGINEERING DISCOVERY</span>
            </div>
            <h1 class="mt-6 max-w-3xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-6xl lg:text-7xl">Bring the engineering problem.</h1>
            <p class="mt-5 max-w-2xl text-xl leading-9 text-slate-600 md:text-2xl">Tell us where the program is constrained. We will map the requirement to the appropriate AionSi engineering capability and engagement model.</p>

            <div class="mt-8 grid gap-3 sm:grid-cols-2">
              <div class="border border-slate-200 bg-white p-5">
                <TechnicalLabel>Useful context</TechnicalLabel>
                <p class="mt-3 text-sm leading-6 text-slate-600">Interface or technology, program stage, current bottleneck, required engineering scope and expected timeline.</p>
              </div>
              <div class="border border-slate-200 bg-white p-5">
                <TechnicalLabel>Direct contact</TechnicalLabel>
                <a class="mt-3 block text-sm font-semibold text-[var(--aionsi-blue)] hover:underline" href="mailto:contact@aionsi.com">contact@aionsi.com</a>
                <a class="mt-2 block text-sm text-slate-600 hover:text-[var(--aionsi-navy)]" href="tel:+917893526310">+91 78935 26310</a>
              </div>
            </div>
          </div>

          <div class="border border-slate-200 bg-white p-6 shadow-sm md:p-8">
            <TechnicalLabel>Engineering Requirement</TechnicalLabel>
            <form class="mt-6 grid gap-5" action="mailto:contact@aionsi.com" method="post" enctype="text/plain">
              <div class="grid gap-5 sm:grid-cols-2">
                <label class="grid gap-2 text-sm font-medium text-[var(--aionsi-navy)]">
                  First name
                  <input name="first_name" required class="border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 outline-none transition focus:border-[var(--aionsi-blue)]" />
                </label>
                <label class="grid gap-2 text-sm font-medium text-[var(--aionsi-navy)]">
                  Last name
                  <input name="last_name" required class="border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 outline-none transition focus:border-[var(--aionsi-blue)]" />
                </label>
              </div>
              <div class="grid gap-5 sm:grid-cols-2">
                <label class="grid gap-2 text-sm font-medium text-[var(--aionsi-navy)]">
                  Business email
                  <input type="email" name="email" required class="border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 outline-none transition focus:border-[var(--aionsi-blue)]" />
                </label>
                <label class="grid gap-2 text-sm font-medium text-[var(--aionsi-navy)]">
                  Company
                  <input name="company" required class="border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 outline-none transition focus:border-[var(--aionsi-blue)]" />
                </label>
              </div>
              <label class="grid gap-2 text-sm font-medium text-[var(--aionsi-navy)]">
                Engineering requirement
                <textarea name="requirement" required rows="6" placeholder="Example: PCIe / UVM verification, current verification stage, bottleneck, required team capacity and timeline." class="resize-y border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 outline-none transition focus:border-[var(--aionsi-blue)]"></textarea>
              </label>
              <div class="flex flex-wrap items-center gap-4 pt-1">
                <button type="submit" class="inline-flex items-center justify-center rounded-full bg-[var(--aionsi-orange)] px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:brightness-105">Send Engineering Requirement <span class="ml-2" aria-hidden="true">→</span></button>
                <span class="text-xs leading-5 text-slate-500">Your email client will open with the requirement details.</span>
              </div>
            </form>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-4 md:grid-cols-3">
          <div class="border border-slate-200 bg-white p-6"><TechnicalLabel>Specialist</TechnicalLabel><p class="mt-3 text-sm leading-6 text-slate-600">Targeted engineering capacity for a defined protocol or technical need.</p></div>
          <div class="border border-slate-200 bg-white p-6"><TechnicalLabel>Workstream</TechnicalLabel><p class="mt-3 text-sm leading-6 text-slate-600">A defined scope with milestones, deliverables and verification closure objectives.</p></div>
          <div class="border border-slate-200 bg-white p-6"><TechnicalLabel>ODC</TechnicalLabel><p class="mt-3 text-sm leading-6 text-slate-600">A dedicated engineering team aligned to the customer roadmap and operating model.</p></div>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
