---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Container from '../components/global/Container.astro';
import Section from '../components/global/Section.astro';
import TechnicalLabel from '../components/global/TechnicalLabel.astro';
---

<BaseLayout title="Talk to AionSi Engineering | AionSi" description="Discuss a semiconductor verification, IP, SoC, physical design or DFT engineering requirement with AionSi.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-16 lg:py-20">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
          <div class="max-w-xl">
            <TechnicalLabel>Engineering Contact</TechnicalLabel>
            <h1 class="mt-4 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-6xl">Discuss an engineering requirement with AionSi.</h1>
            <p class="mt-5 text-xl leading-9 text-slate-600">Bring a verification, IP, SoC, physical design or DFT requirement. We will route the discussion to the appropriate engineering and business development team.</p>
            <div class="mt-8 grid gap-3 sm:grid-cols-2">
              <div class="border border-slate-200 bg-white p-5"><div class="font-semibold text-[var(--aionsi-navy)]">Verification programs</div><p class="mt-2 text-sm leading-6 text-slate-600">UVM, protocol, subsystem, SoC and verification-closure workstreams.</p></div>
              <div class="border border-slate-200 bg-white p-5"><div class="font-semibold text-[var(--aionsi-navy)]">Scalable delivery</div><p class="mt-2 text-sm leading-6 text-slate-600">Specialist augmentation, managed workstreams, project delivery and dedicated ODC models.</p></div>
            </div>
          </div>

          <form class="border border-slate-200 bg-white p-7 shadow-sm md:p-8" action="https://formspree.io/f/your-form-id" method="POST">
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="grid gap-2 text-sm font-medium text-[var(--aionsi-navy)]">Name<input required name="name" type="text" autocomplete="name" class="border border-slate-300 px-4 py-3 font-normal outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="grid gap-2 text-sm font-medium text-[var(--aionsi-navy)]">Job title<input name="job_title" type="text" autocomplete="organization-title" class="border border-slate-300 px-4 py-3 font-normal outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="grid gap-2 text-sm font-medium text-[var(--aionsi-navy)]">Work email<input required name="email" type="email" autocomplete="email" class="border border-slate-300 px-4 py-3 font-normal outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="grid gap-2 text-sm font-medium text-[var(--aionsi-navy)]">Company<input required name="company" type="text" autocomplete="organization" class="border border-slate-300 px-4 py-3 font-normal outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="grid gap-2 text-sm font-medium text-[var(--aionsi-navy)]">Engineering area<select required name="engineering_area" class="border border-slate-300 px-4 py-3 font-normal outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select an area</option><option>Design Verification</option><option>Protocol Verification</option><option>SoC / IP</option><option>Physical Design</option><option>DFT</option><option>Other</option></select></label>
              <label class="grid gap-2 text-sm font-medium text-[var(--aionsi-navy)]">Engagement path<select required name="engagement_path" class="border border-slate-300 px-4 py-3 font-normal outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select a path</option><option>Specialist engineering augmentation</option><option>Managed engineering workstream</option><option>Project / turnkey delivery</option><option>Dedicated engineering ODC</option></select></label>
              <label class="grid gap-2 text-sm font-medium text-[var(--aionsi-navy)] sm:col-span-2">Expected start date<input name="start_date" type="text" placeholder="e.g. Q4 2026 or within 4 weeks" class="border border-slate-300 px-4 py-3 font-normal outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="grid gap-2 text-sm font-medium text-[var(--aionsi-navy)] sm:col-span-2">Requirement summary<textarea required name="message" rows="6" placeholder="Briefly describe the engineering scope, protocols/technologies, expected team shape and milestones." class="border border-slate-300 px-4 py-3 font-normal outline-none focus:border-[var(--aionsi-blue)]"></textarea></label>
            </div>
            <p class="mt-5 text-xs leading-5 text-slate-500">Please do not include confidential design files, source code, customer information or export-controlled data in this form. Share sensitive technical material only after an appropriate NDA and secure exchange process is established.</p>
            <button type="submit" class="mt-6 inline-flex rounded-full bg-[var(--aionsi-orange)] px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:brightness-105">Discuss Your Engineering Program →</button>
          </form>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
