---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/global/Header.astro';
import Footer from '../../../components/global/Footer.astro';
import Container from '../../../components/global/Container.astro';
import Section from '../../../components/global/Section.astro';
import TechnicalLabel from '../../../components/global/TechnicalLabel.astro';
import Button from '../../../components/global/Button.astro';
import { careerRoles, careerDisciplines } from '../../../data/careers';
---
<BaseLayout title="Experienced Engineers | Careers at AionSi" description="Join AionSi as an experienced semiconductor engineer and work across SoC verification, emulation, physical verification, physical design and DFT.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-20 lg:py-24">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-end">
          <div>
            <TechnicalLabel>CAREERS — EXPERIENCED ENGINEERS</TechnicalLabel>
            <h1 class="mt-4 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Build the silicon. Own the problem. Grow with AionSi.</h1>
            <p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">We are building experienced engineering teams for technically demanding semiconductor programs. Bring depth in your discipline and take ownership from engineering execution through closure.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <Button href="#open-roles">View Open Roles</Button>
              <a href="/careers/apply" class="inline-flex items-center gap-3 rounded-full border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-[var(--aionsi-navy)] transition hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)]">Share Your Profile <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <div class="border border-slate-200 bg-white p-7 md:p-8">
            <div class="mb-7 h-1 w-11 bg-[var(--aionsi-orange)]"></div>
            <p class="text-lg font-semibold leading-8 text-[var(--aionsi-navy)]">Experienced engineers can own defined workstreams, technical decisions and delivery outcomes across the semiconductor lifecycle.</p>
            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              {['Senior Engineers', 'Technical Leads', 'Principal Engineers', 'Engineering Managers'].map((item) => <div class="border border-slate-200 px-4 py-3 text-sm font-semibold text-slate-700">{item}</div>)}
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-14 md:py-16 lg:py-20">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr]">
          <div>
            <TechnicalLabel>ENGINEERING DOMAINS</TechnicalLabel>
            <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Deep engineering, not generic delivery.</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">AionSi teams work on real silicon engineering problems across verification, implementation, test and system integration.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {careerDisciplines.map((item, index) => <div class="border border-slate-200 bg-white p-5"><div class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">0{index + 1}</div><p class="mt-3 font-semibold text-[var(--aionsi-navy)]">{item}</p></div>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-16 lg:py-20">
      <Container>
        <TechnicalLabel>WHAT YOU CAN OWN</TechnicalLabel>
        <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {[
            ['01', 'Technical workstreams', 'Own defined engineering scope, milestones and closure.'],
            ['02', 'Customer programs', 'Work directly on demanding semiconductor programs and deliverables.'],
            ['03', 'Architecture & methodology', 'Shape engineering decisions, flows, reviews and quality practices.'],
            ['04', 'Technical leadership', 'Mentor engineers and raise execution quality across the team.'],
          ].map(([number, title, description]) => <article class="border border-slate-200 bg-white p-6"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{number}</div><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{description}</p></article>)}
        </div>
      </Container>
    </Section>

    <Section id="open-roles" class="py-14 md:py-16 lg:py-20">
      <Container>
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div><TechnicalLabel>OPEN POSITIONS</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Current engineering opportunities.</h2></div>
          <p class="max-w-xl text-sm leading-6 text-slate-500">These roles reflect the current approved hiring requirements. AionSi may update openings as the engineering roadmap evolves.</p>
        </div>
        <div class="mt-9 grid gap-5 lg:grid-cols-2">
          {careerRoles.map((role) => <article class="border border-slate-200 bg-white p-7 md:p-8">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div><div class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{role.experience}</div><h3 class="mt-3 text-2xl font-semibold text-[var(--aionsi-navy)]">{role.title}</h3></div>
              {role.priority && <span class="border border-[var(--aionsi-orange)] px-3 py-1 text-xs font-semibold text-[var(--aionsi-orange)]">{role.priority}</span>}
            </div>
            <p class="mt-3 text-sm font-semibold text-slate-600">{role.location}</p>
            <p class="mt-5 text-sm leading-7 text-slate-600">{role.summary}</p>
            <div class="mt-6 grid gap-6 md:grid-cols-2">
              <div><p class="text-xs font-semibold tracking-[.14em] text-[var(--aionsi-navy)]">CORE RESPONSIBILITIES</p><ul class="mt-3 space-y-2 text-sm leading-6 text-slate-600">{role.responsibilities.map((item) => <li class="flex gap-2"><span class="text-[var(--aionsi-orange)]">•</span><span>{item}</span></li>)}</ul></div>
              <div><p class="text-xs font-semibold tracking-[.14em] text-[var(--aionsi-navy)]">REQUIRED / PREFERRED</p><div class="mt-3 flex flex-wrap gap-2">{role.skills.map((skill) => <span class="border border-slate-200 px-3 py-1.5 text-xs text-slate-600">{skill}</span>)}</div></div>
            </div>
            <div class="mt-7 flex flex-wrap gap-3"><a href={`/careers/apply?job=${role.slug}`} class="inline-flex items-center gap-3 rounded-full bg-[var(--aionsi-orange)] px-6 py-3.5 text-sm font-semibold text-white transition hover:-translate-y-0.5">Apply for this role <span aria-hidden="true">→</span></a><a href="/careers/apply" class="inline-flex items-center gap-3 rounded-full border border-slate-300 px-6 py-3.5 text-sm font-semibold text-[var(--aionsi-navy)]">Share profile</a></div>
          </article>)}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-16 lg:py-20">
      <Container class="text-center">
        <TechnicalLabel>CAREER CONVERSATION</TechnicalLabel>
        <h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Bring your engineering depth.</h2>
        <p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Tell us your semiconductor discipline, experience level and the kind of engineering problems you want to work on.</p>
        <div class="mt-9"><Button href="/careers/apply">Start a Career Conversation</Button></div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
