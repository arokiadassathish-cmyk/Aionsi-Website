---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
const paths = [
  ['early-careers','01','Early Careers','Build semiconductor fundamentals, learn engineering methodologies and grow with experienced teams.'],
  ['experienced-engineers','02','Experienced Engineers','Bring technical depth across RTL, verification, physical design, DFT, protocols and SoC engineering.'],
];
---
<BaseLayout title="Careers | AionSi" description="Build a semiconductor engineering career at AionSi across RTL, verification, physical design, DFT, protocol verification and SoC & IP engineering.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>CAREERS AT AIONSI</TechnicalLabel>
        <div class="grid gap-12 lg:grid-cols-[1fr_.85fr] lg:items-center">
          <div><h1 class="text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Build what’s next in silicon.</h1><p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">Join an engineering organization working across complex semiconductor programs, from RTL and verification through physical implementation, DFT and SoC integration.</p><div class="mt-8"><Button href="/contact">Explore Opportunities</Button></div></div>
          <div class="border border-slate-200 bg-white p-7"><TechnicalLabel>ENGINEERING GROWTH</TechnicalLabel><div class="mt-6 grid gap-3 sm:grid-cols-2"><div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">01</div><div class="mt-3 font-semibold text-[var(--aionsi-navy)]">Technical Depth</div></div><div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">02</div><div class="mt-3 font-semibold text-[var(--aionsi-navy)]">Mentorship</div></div><div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">03</div><div class="mt-3 font-semibold text-[var(--aionsi-navy)]">Program Exposure</div></div><div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">04</div><div class="mt-3 font-semibold text-[var(--aionsi-navy)]">Engineering Ownership</div></div></div></div>
        </div>
      </Container>
    </Section>

    <Section><Container><TechnicalLabel>CAREER PATHS</TechnicalLabel><div class="mt-8 grid gap-5 md:grid-cols-2">{paths.map(([slug,number,title,description]) => <a href={`/careers/${slug}`} class="border border-slate-200 bg-white p-8 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">{number}</div><h2 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{title}</h2><p class="mt-4 text-base leading-7 text-slate-600">{description}</p><div class="mt-8 text-sm font-semibold text-[var(--aionsi-navy)]">Explore Path →</div></a>)}</div></Container></Section>

    <Section class="bg-[var(--aionsi-surface-alt)]"><Container class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><TechnicalLabel>ENGINEERING DOMAINS</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Grow across the silicon lifecycle.</h2></div><div class="grid gap-3 sm:grid-cols-2"><div class="border border-slate-200 bg-white p-6">RTL Design</div><div class="border border-slate-200 bg-white p-6">Design Verification</div><div class="border border-slate-200 bg-white p-6">Physical Design</div><div class="border border-slate-200 bg-white p-6">DFT</div><div class="border border-slate-200 bg-white p-6">Protocol Verification</div><div class="border border-slate-200 bg-white p-6">SoC & IP Engineering</div></div></Container></Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white"><Container class="text-center"><TechnicalLabel>JOIN AIONSI</TechnicalLabel><h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Bring your engineering depth to complex silicon programs.</h2><p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Tell us about your background, engineering domain and the kind of semiconductor work you want to build.</p><div class="mt-9"><Button href="/contact">Start a Career Conversation</Button></div></Container></Section>
  </main><Footer />
</BaseLayout>
