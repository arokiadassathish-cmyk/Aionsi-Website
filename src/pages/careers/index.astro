---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { careerRoles } from '../../data/careers';
---
<BaseLayout title="Careers at AionSi | Semiconductor Engineering" description="Build the engineering behind complex silicon programs. Explore approved AionSi openings across semiconductor engineering, verification, physical design, DFT and marketing.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-20 lg:py-24">
      <Container>
        <TechnicalLabel>CAREERS AT AIONSI</TechnicalLabel>
        <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-end">
          <div>
            <h1 class="text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Build the engineering behind the next generation of silicon.</h1>
            <p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">AionSi is building an engineering organization for complex semiconductor programs across verification, physical design, RTL, DFT, protocol engineering and SoC integration.</p>
            <div class="mt-8 flex flex-wrap gap-3"><Button href="/careers/experienced-engineers">Experienced Engineers</Button><a href="/careers/apply" class="inline-flex items-center gap-3 rounded-full border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-[var(--aionsi-navy)]">Share Your Profile <span aria-hidden="true">→</span></a></div>
          </div>
          <div class="border border-slate-200 bg-white p-7 md:p-8">
            <TechnicalLabel>ENGINEERING ENVIRONMENT</TechnicalLabel>
            <p class="mt-5 text-lg leading-8 text-[var(--aionsi-navy)]">Work on technically demanding silicon problems with ownership, disciplined engineering practices and opportunities to grow across the semiconductor lifecycle.</p>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-14 md:py-16 lg:py-20">
      <Container class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
        <div>
          <TechnicalLabel>WHY AIONSI</TechnicalLabel>
          <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Engineering depth. Technical ownership. Continuous learning.</h2>
          <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Join a semiconductor-focused team where the work is grounded in engineering problems rather than generic technology delivery.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {[
            ['01','Semiconductor-first work','Build expertise around real silicon engineering disciplines and development flows.'],
            ['02','Technical ownership','Take responsibility for defined workstreams, engineering decisions and deliverables.'],
            ['03','Cross-lifecycle exposure','Learn how IP, verification, implementation, DFT and SoC integration connect.'],
            ['04','Growth with experienced teams','Develop engineering depth through structured execution, reviews and collaboration.'],
          ].map(([number,title,description]) => <article class="border border-slate-200 bg-white p-6 md:p-7"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{number}</div><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{description}</p></article>)}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-16 lg:py-20">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div>
            <TechnicalLabel>ENGINEERING AREAS</TechnicalLabel>
            <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Deep engineering, not generic delivery.</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Our teams work across verification, implementation, test and system integration.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {[
              ['01','RTL / IP Design','Microarchitecture, RTL development and design integration.'],
              ['02','Design Verification','SystemVerilog, UVM, assertions, coverage and verification closure.'],
              ['03','Physical Design','Implementation, timing, congestion, physical verification and sign-off.'],
              ['04','DFT','Test architecture, scan, ATPG and manufacturing-test readiness.'],
              ['05','Protocol Verification','PCIe, USB, DDR, HBM and AMBA interface verification.'],
              ['06','SoC & IP Engineering','Processor, interconnect, memory, protocol IP and SoC integration.'],
            ].map(([number,title,description]) => <article class="border border-slate-200 bg-white p-6"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{number}</div><h3 class="mt-3 text-lg font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{description}</p></article>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section id="open-positions" class="py-14 md:py-16 lg:py-20">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div>
            <TechnicalLabel>OPEN POSITIONS</TechnicalLabel>
            <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Current engineering opportunities.</h2>
          </div>
          <p class="max-w-3xl text-lg leading-8 text-slate-600">These roles reflect the current approved hiring requirements. AionSi may update openings as the engineering roadmap evolves.</p>
        </div>

        <div class="mt-10 grid gap-5 lg:grid-cols-2">
          {careerRoles.map((role) => (
            <article class="border border-slate-200 bg-white p-7 md:p-8">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <div class="text-sm font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{role.experience}</div>
                  <h3 class="mt-3 text-2xl font-semibold text-[var(--aionsi-navy)]">{role.title}</h3>
                  <p class="mt-2 font-medium text-[var(--aionsi-navy)]">{role.location}</p>
                </div>
                {role.immediateJoiners && <span class="border border-[var(--aionsi-orange)] px-3 py-1.5 text-xs font-semibold text-[var(--aionsi-orange)]">Immediate joiners preferred</span>}
              </div>
              <p class="mt-6 text-sm leading-7 text-slate-600">{role.summary}</p>
              <div class="mt-7 grid gap-7 md:grid-cols-[1fr_.9fr]">
                <div>
                  <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-navy)]">CORE RESPONSIBILITIES</div>
                  <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-600">
                    {role.responsibilities.slice(0, 3).map((item) => <li class="relative pl-4 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:-translate-y-1/2 before:rounded-full before:bg-[var(--aionsi-orange)]">{item}</li>)}
                  </ul>
                </div>
                <div>
                  <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-navy)]">REQUIRED / PREFERRED</div>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {role.skills.map((skill) => <span class="border border-slate-200 px-3 py-2 text-xs text-slate-600">{skill}</span>)}
                  </div>
                </div>
              </div>
              <div class="mt-8 flex flex-wrap gap-3">
                <Button href={`/careers/apply?job=${role.slug}`}>Apply for this role</Button>
                <a href={`/careers/apply?job=${role.slug}`} class="inline-flex items-center gap-3 rounded-full border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-[var(--aionsi-navy)]">Share profile <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-16 lg:py-20">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div><TechnicalLabel>EXPERIENCED ENGINEERS</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">We are building the team.</h2></div>
          <div class="border border-slate-200 bg-white p-8 md:p-10">
            <p class="text-lg leading-8 text-slate-600">AionSi is building experienced engineering teams for technically demanding semiconductor programs. Explore open roles for experienced engineers, or share your profile for future opportunities.</p>
            <div class="mt-7 flex flex-wrap gap-3">
              <Button href="/careers/experienced-engineers">View Experienced Engineers</Button>
              <Button href="/careers/apply" variant="secondary">Share Your Profile</Button>
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-16 lg:py-20">
      <Container class="text-center">
        <TechnicalLabel>CAREER CONVERSATION</TechnicalLabel>
        <h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Bring your engineering depth.</h2>
        <p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Tell us your semiconductor discipline, experience level and the kind of engineering problems you want to work on.</p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <Button href="#open-positions">View Open Positions</Button>
          <Button href="/careers/apply" variant="secondary">Share Your Profile</Button>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
