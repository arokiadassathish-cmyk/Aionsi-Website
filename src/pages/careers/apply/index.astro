---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/global/Header.astro';
import Footer from '../../../components/global/Footer.astro';
import Container from '../../../components/global/Container.astro';
import Section from '../../../components/global/Section.astro';
import TechnicalLabel from '../../../components/global/TechnicalLabel.astro';
import { careerRoles } from '../../../data/careers';
---
<BaseLayout title="Apply to AionSi | Careers" description="Apply to current AionSi semiconductor engineering opportunities or share your profile for future roles.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-20 lg:py-24">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:items-start">
          <div>
            <TechnicalLabel>CAREERS — CANDIDATE APPLICATION</TechnicalLabel>
            <h1 class="mt-4 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Build your next chapter in silicon engineering.</h1>
            <p class="mt-6 max-w-2xl text-xl leading-9 text-slate-600">Tell us about your engineering experience, the role you are interested in and where you can create the most impact. Your profile will be routed to the AionSi recruitment team.</p>
            <div class="mt-10 border-l-2 border-[var(--aionsi-orange)] pl-5 text-sm leading-7 text-slate-600">
              <p class="font-semibold text-[var(--aionsi-navy)]">Application path</p>
              <p class="mt-2">Profile submission → Recruitment screening → Technical discussion → Hiring process</p>
            </div>
            <div class="mt-10 border border-slate-200 bg-white p-6">
              <p class="text-sm font-semibold text-[var(--aionsi-navy)]">Prefer email?</p>
              <p class="mt-2 text-sm leading-6 text-slate-600">You can also send your updated CV to <a class="font-semibold text-[var(--aionsi-blue)]" href="mailto:careers@aionsi.com">careers@aionsi.com</a>.</p>
            </div>
          </div>

          <form id="career-application-form" class="border border-slate-200 bg-white p-7 shadow-[0_16px_50px_rgba(2,11,39,.05)] md:p-9" enctype="multipart/form-data">
            <div class="mb-7 h-1 w-11 bg-[var(--aionsi-orange)]"></div>
            <div class="grid gap-6 md:grid-cols-2">
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">First name *</span><input name="firstName" required autocomplete="given-name" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Last name *</span><input name="lastName" required autocomplete="family-name" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Email *</span><input type="email" name="email" required autocomplete="email" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Phone *</span><input type="tel" name="phone" required autocomplete="tel" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block md:col-span-2"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Role of interest *</span><select id="job" name="jobSlug" required class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select role</option>{careerRoles.map((role) => <option value={role.slug}>{role.title} — {role.location}</option>)}<option value="general">General / Future Opportunity</option></select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Total experience *</span><select name="experience" required class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select experience</option><option>0–2 years</option><option>3–5 years</option><option>5–8 years</option><option>8–12 years</option><option>12+ years</option></select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Current location *</span><input name="currentLocation" required placeholder="e.g. Bengaluru" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Current company</span><input name="currentCompany" autocomplete="organization" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Current designation</span><input name="currentTitle" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Preferred location</span><select name="preferredLocation" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select location</option><option>Bengaluru</option><option>Hyderabad</option><option>Open to both</option><option>Other</option></select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Notice period</span><select name="noticePeriod" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select notice period</option><option>Immediate</option><option>15 days</option><option>30 days</option><option>60 days</option><option>90 days</option><option>Other</option></select></label>
              <label class="block md:col-span-2"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Resume / CV *</span><input type="file" name="resume" required accept=".pdf,.doc,.docx" class="mt-2 block w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm file:mr-4 file:border-0 file:bg-white file:px-3 file:py-2 file:text-xs file:font-semibold" /><span class="mt-2 block text-xs text-slate-500">PDF, DOC or DOCX. Maximum 4 MB.</span></label>
              <label class="block md:col-span-2"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Profile / portfolio link</span><input type="url" name="profileUrl" placeholder="LinkedIn, GitHub or portfolio URL" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block md:col-span-2"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Short note</span><textarea name="candidateNote" rows="5" placeholder="Tell us briefly about your strongest semiconductor engineering experience and the problems you want to work on." class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-4 text-sm leading-6 outline-none focus:border-[var(--aionsi-blue)]"></textarea></label>
              <label class="hidden" aria-hidden="true"><span>Website</span><input name="website" tabindex="-1" autocomplete="off" /></label>
              <label class="flex items-start gap-3 md:col-span-2"><input type="checkbox" name="consent" value="yes" required class="mt-1 h-4 w-4" /><span class="text-xs leading-5 text-slate-600">I consent to AionSi using the information and resume submitted here for recruitment and related hiring communication.</span></label>
            </div>
            <div class="mt-7 flex flex-wrap items-center gap-5">
              <button id="submit-button" type="submit" class="group inline-flex items-center gap-3 rounded-full bg-[var(--aionsi-orange)] px-6 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:brightness-105">Submit Application <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span></button>
              <p class="text-xs leading-5 text-slate-500">Your application is routed to the AionSi recruitment workflow.</p>
            </div>
            <p id="career-form-status" class="mt-4 hidden text-sm font-semibold" role="status"></p>
          </form>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
<script is:inline>
  const form = document.getElementById('career-application-form');
  const status = document.getElementById('career-form-status');
  const button = document.getElementById('submit-button');
  const params = new URLSearchParams(window.location.search);
  const requestedJob = params.get('job');
  const jobSelect = document.getElementById('job');
  if (requestedJob && jobSelect) jobSelect.value = requestedJob;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !button) return;
    status.classList.remove('hidden');
    status.classList.remove('text-red-600', 'text-green-700');
    status.classList.add('text-[var(--aionsi-navy)]');
    status.textContent = 'Submitting your profile…';
    button.disabled = true;

    try {
      const response = await fetch('/api/careers/apply', { method: 'POST', body: new FormData(form) });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.message || 'We could not submit the application.');
      status.classList.remove('text-[var(--aionsi-navy)]');
      status.classList.add('text-green-700');
      status.textContent = result.message || 'Application received. Thank you for your interest in AionSi.';
      form.reset();
    } catch (error) {
      status.classList.remove('text-[var(--aionsi-navy)]');
      status.classList.add('text-red-600');
      status.textContent = error instanceof Error ? error.message : 'We could not submit the application. Please email careers@aionsi.com with your CV.';
    } finally {
      button.disabled = false;
    }
  });
</script>
