---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
const paths = {
  'early-careers': {
    title: 'Early Careers', number: '01', summary: 'Start your semiconductor engineering journey with structured learning, mentorship and exposure to real engineering workflows.', points: ['Semiconductor fundamentals and methodology', 'Mentorship from experienced engineers', 'Hands-on engineering workflow exposure', 'Structured growth across technical domains'], cta: 'Explore Early Career Opportunities'
  },
  'experienced-engineers': {
    title: 'Experienced Engineers', number: '02', summary: 'Bring your engineering depth to complex silicon programs and take ownership of defined technical workstreams.', points: ['RTL, verification, physical design, DFT and protocol depth', 'Ownership of defined engineering scope', 'Cross-functional SoC program exposure', 'Growth through technical leadership and delivery responsibility'], cta: 'Discuss Experienced Opportunities'
  }
};
export function getStaticPaths() {
  return Object.entries(paths).map(([slug, career]) => ({ params: { slug }, props: { career } }));
}
const { career } = Astro.props;
---
<BaseLayout title={`${career.title} | Careers | AionSi`} description={career.summary}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)]"><Container><TechnicalLabel>CAREER PATH</TechnicalLabel><div class="grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center"><div><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">{career.number}</div><h1 class="mt-5 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">{career.title}</h1><p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">{career.summary}</p></div><div class="border border-slate-200 bg-white p-7"><TechnicalLabel>WHAT YOU BUILD</TechnicalLabel><div class="mt-5 grid gap-3">{career.points.map((point, index) => <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">0{index+1}</div><p class="mt-3 text-sm leading-6 text-[var(--aionsi-navy)]">{point}</p></div>)}</div></div></div></Container></Section>
    <Section><Container class="text-center"><TechnicalLabel>CAREER CONVERSATION</TechnicalLabel><h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-6xl">{career.cta}</h2><p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-slate-600">Share your engineering background, technical domain and career goals. The AionSi team can connect your profile to relevant opportunities.</p><div class="mt-9"><Button href="/contact">Start a Career Conversation</Button></div></Container></Section>
  </main><Footer />
</BaseLayout>
