---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Container from '../components/global/Container.astro';
import Section from '../components/global/Section.astro';
import TechnicalLabel from '../components/global/TechnicalLabel.astro';
import Button from '../components/global/Button.astro';

const metrics = [
  ['01', 'Search visibility', 'Impressions, clicks, CTR and average position from Search Console.'],
  ['02', 'Landing-page intent', 'Which capability, evidence and target-account pages attract organic discovery.'],
  ['03', 'Engineering intent', 'Evidence-page engagement and engineering requirement interactions.'],
  ['04', 'Commercial outcome', 'Qualified engineering enquiries attributable to organic discovery.'],
];

const priority = [
  ['Physical Design', '3nm / advanced-node implementation, timing closure, congestion, CTS, STA and sign-off.'],
  ['Verification', 'SystemVerilog/UVM, formal, PCIe, GLS, protocol and SoC verification.'],
  ['SoC / IP', 'RISC-V, AMBA CHI, PCIe Gen6, HBM, DDR5 and USB4.'],
];
---
<BaseLayout title="SEO Measurement Framework | AionSi" description="AionSi SEO measurement framework linking search visibility to engineering evidence and qualified semiconductor demand.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-deep-navy)] py-16 text-white md:py-24">
      <Container>
        <TechnicalLabel>SEO MEASUREMENT</TechnicalLabel>
        <h1 class="mt-4 max-w-5xl text-5xl font-semibold tracking-tight md:text-7xl">Measure organic discovery against engineering demand.</h1>
        <p class="mt-6 max-w-4xl text-xl leading-9 text-white/70 md:text-2xl">The AionSi SEO system connects search visibility to capabilities, technical evidence, strategic-account relevance and engineering enquiries.</p>
        <div class="mt-8 flex flex-wrap gap-3"><Button href="/capabilities">Explore capabilities</Button><Button href="/evidence">Review engineering evidence</Button></div>
      </Container>
    </Section>

    <Section>
      <Container>
        <TechnicalLabel>Measurement Funnel</TechnicalLabel>
        <h2 class="mt-3 max-w-4xl text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Search query → engineering requirement.</h2>
        <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {metrics.map(([number, title, description]) => (
            <div class="border border-slate-200 bg-white p-7 shadow-sm">
              <span class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{number}</span>
              <h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-600">{description}</p>
            </div>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>Search Console</TechnicalLabel>
        <div class="mt-4 grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
          <div><h2 class="text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Verification before optimization.</h2><p class="mt-4 text-lg leading-8 text-slate-600">Use the exact Google-provided verification method, submit <code class="font-mono text-sm">/sitemap.xml</code>, and establish the baseline before expanding the content universe.</p></div>
          <div class="grid gap-3 sm:grid-cols-2">
            {['Verify aionsi.com', 'Submit /sitemap.xml', 'Confirm robots.txt', 'Record baseline metrics'].map((item, index) => <div class="border border-slate-200 bg-white p-6"><span class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">0{index + 1}</span><h3 class="mt-3 font-semibold text-[var(--aionsi-navy)]">{item}</h3></div>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section>
      <Container>
        <TechnicalLabel>Priority Search Clusters</TechnicalLabel>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {priority.map(([title, description]) => <div class="border border-slate-200 bg-white p-7"><h3 class="text-2xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{description}</p></div>)}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>Opportunity Rules</TechnicalLabel>
        <div class="mt-8 grid gap-3 md:grid-cols-2">
          {[
            ['High impressions + low CTR', 'Improve title, meta description and search-intent framing.'],
            ['Position 8–20', 'Improve depth and internal linking before creating another page.'],
            ['High clicks + low enquiries', 'Strengthen evidence, qualification path and CTA.'],
            ['Target-account impressions', 'Expand the account page only when search data confirms demand.'],
          ].map(([title, description]) => <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{description}</p></div>)}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-20">
      <Container>
        <TechnicalLabel>Next Action</TechnicalLabel>
        <h2 class="mt-3 max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Complete Search Console verification, then optimize from real query data.</h2>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-white/70">Do not expand the SEO page universe blindly. Use Search Console and GA4 to determine which semiconductor topics and account pages are earning discovery and engineering intent.</p>
        <div class="mt-8"><Button href="/contact">Discuss an Engineering Requirement</Button></div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
