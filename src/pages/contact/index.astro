---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import GlobalPresence from '../../components/contact/GlobalPresence.astro';
import { engineeringDiscoveryOptions, engineeringDiscoveryRouting } from '../../data/engineering-discovery';
---
<BaseLayout title="Engineering Discovery | AionSi" description="Start an engineering discovery conversation with AionSi for semiconductor engineering, verification, physical implementation, DFT and SoC requirements.">
  <Header />
  <main>
    <Section class="relative overflow-hidden bg-white py-6 md:py-8 lg:py-10">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_34%,rgba(37,99,235,.10),transparent_40%),linear-gradient(180deg,#ffffff_0%,#f6faff_100%)]"></div>
        <div class="absolute inset-0 opacity-[.09]" style="background-image:linear-gradient(rgba(37,99,235,.16) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.16) 1px,transparent 1px);background-size:48px 48px;"></div>
      </div>
      <Container>
        <div class="relative grid gap-6 lg:grid-cols-[.78fr_1.22fr] lg:items-stretch">
          <div class="relative z-10 flex flex-col py-5 lg:py-7">
            <div>
              <TechnicalLabel>GLOBAL SEMICONDUCTOR ENGINEERING</TechnicalLabel>
              <h1 class="mt-5 max-w-2xl text-5xl font-semibold leading-[1.02] tracking-tight text-[var(--aionsi-navy)] md:text-6xl lg:text-[3.85rem] xl:text-[4.05rem]">Get in Touch.<br /><span class="text-[var(--aionsi-blue)]">Let’s Build<br />What’s Next.</span></h1>
              <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600 md:text-xl md:leading-8">Partner with AionSi for high-performance semiconductor engineering. Our global teams support programs from IP to silicon across verification, RTL/SoC, physical design, DFT and timing closure.</p>
            </div>
            <div class="mt-6 grid gap-3 sm:grid-cols-3">
              <a href="tel:+14422074472" class="flex min-h-[92px] items-center gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-[0_10px_30px_rgba(2,11,39,.06)] transition hover:-translate-y-0.5 hover:shadow-md">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-blue-50 text-[var(--aionsi-blue)]" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M6.6 3.5l3 3.1-1.9 2.6a14.7 14.7 0 0 0 7.1 7.1l2.6-1.9 3.1 3c-.7 1.5-2.1 2.5-3.8 2.5C10.9 19.9 4.1 13.1 4.1 5.3c0-1.7 1-3.1 2.5-3.8Z" /></svg></span>
                <span><span class="block text-sm font-bold text-[var(--aionsi-navy)]">Call Us</span><span class="mt-1 block text-[11px] leading-5 text-slate-600">US&nbsp; +1 (442) 207-4472<br />India&nbsp; +91 8618679681</span></span>
              </a>
              <a href="mailto:dass.kishore@aionsi.com" class="flex min-h-[92px] items-center gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-[0_10px_30px_rgba(2,11,39,.06)] transition hover:-translate-y-0.5 hover:shadow-md">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-blue-50 text-[var(--aionsi-blue)]" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4.5 7 7.5 6 7.5-6" /></svg></span>
                <span><span class="block text-sm font-bold text-[var(--aionsi-navy)]">Email Us</span><span class="mt-1 block break-all text-[11px] font-semibold text-[var(--aionsi-blue)]">dass.kishore@aionsi.com</span></span>
              </a>
              <a href="#engineering-discovery-form" class="flex min-h-[92px] items-center gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-[0_10px_30px_rgba(2,11,39,.06)] transition hover:-translate-y-0.5 hover:shadow-md">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-blue-50 text-[var(--aionsi-blue)]" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4m8-4v4M4 9h16M8 14h3m-3 3h2m3-3h3" /></svg></span>
                <span><span class="block text-sm font-bold text-[var(--aionsi-navy)]">Start a Discussion</span><span class="mt-1 block text-[11px] font-semibold text-[var(--aionsi-blue)]">Tell us your requirement&nbsp; →</span></span>
              </a>
            </div>
          </div>

          <div class="relative min-h-[28rem] overflow-hidden rounded-[2rem] bg-[#0b3b78] shadow-[0_24px_70px_rgba(2,11,39,.12)] lg:min-h-[29rem]">
            <img src="/images/contact-global-network.svg" alt="Global semiconductor engineering network" class="absolute inset-0 h-full w-full object-cover opacity-95" />
            <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,31,66,.14),rgba(5,31,66,.02)),linear-gradient(180deg,rgba(5,31,66,.02),rgba(4,26,56,.12))]"></div>
            <div class="absolute right-7 top-6 z-10 max-w-[120px] text-[10px] font-semibold uppercase leading-5 tracking-[.32em] text-white/75 md:right-8 md:top-7"><div class="mb-3 h-[3px] w-8 bg-[var(--aionsi-orange)]"></div>Engineering<br />Tomorrow<br />Together</div>
            <svg viewBox="0 0 820 520" class="absolute inset-0 h-full w-full" role="img" aria-label="AionSi six-country global engineering network">
              <defs>
                <linearGradient id="networkArc" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#f59e0b" /><stop offset="100%" stop-color="#e1440b" /></linearGradient>
                <radialGradient id="pinGlow"><stop offset="0%" stop-color="#f59e0b" stop-opacity=".45" /><stop offset="100%" stop-color="#f59e0b" stop-opacity="0" /></radialGradient>
              </defs>
              <path d="M112 250 C255 126 386 142 430 174 C468 201 482 197 510 190 C552 180 570 189 616 220 C668 254 698 291 726 324" fill="none" stroke="url(#networkArc)" stroke-width="3" stroke-linecap="round" opacity=".92" />
              <path d="M238 294 C320 222 378 188 430 174 C494 157 557 196 616 220 C665 241 691 289 726 324" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" opacity=".6" />
              <path d="M430 174 C462 143 488 124 522 112" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" opacity=".55" />
              <path d="M616 220 C640 219 660 211 681 197" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" opacity=".52" />
              {[{x:112,y:250,label:'USA',align:'start'},{x:238,y:294,label:'UK',align:'middle'},{x:430,y:174,label:'SWEDEN',align:'middle'},{x:616,y:220,label:'SPAIN',align:'middle'},{x:681,y:292,label:'INDIA',align:'middle'},{x:726,y:324,label:'MALAYSIA',align:'end'}].map((point) => (
                <g>
                  <circle cx={point.x} cy={point.y} r="28" fill="url(#pinGlow)" />
                  <circle cx={point.x} cy={point.y} r="8" fill="#ffffff" stroke="#e1440b" stroke-width="4" />
                  <circle cx={point.x} cy={point.y} r="3" fill="#e1440b" />
                  <text x={point.x} y={point.y + 28} text-anchor={point.align} font-size="16" font-weight="700" fill="#ffffff" stroke="#061A35" stroke-width="4" paint-order="stroke" letter-spacing="1">{point.label}</text>
                </g>
              ))}
              <text x="410" y="454" text-anchor="middle" font-size="15" font-weight="600" fill="#E8F2FF" letter-spacing="2">CONNECTED ENGINEERING ACROSS SIX COUNTRIES</text>
            </svg>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="pt-0 pb-7 md:pb-9 lg:pb-10">
      <Container>
        <GlobalPresence />
      </Container>
    </Section>

    <Section id="engineering-discovery-form" class="bg-[var(--aionsi-surface-alt)] py-10 md:py-12 lg:py-14">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.78fr_1.22fr] lg:items-start">
          <div>
            <TechnicalLabel>ENGINEERING REQUIREMENTS</TechnicalLabel>
            <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Let’s define the engineering requirement.</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Tell us where the program is constrained. We will map the requirement to the appropriate AionSi engineering capability and engagement model.</p>
            <div class="mt-7 border border-slate-200 bg-white p-6 shadow-sm">
              <div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">Engineering requirements contact</div>
              <div class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">Dass Kishore</div>
              <div class="mt-1 text-sm font-semibold text-slate-500">Head of Business Development</div>
              <div class="mt-4 grid gap-2 text-sm leading-6 text-slate-600">
                <a href="tel:+14422074472" class="font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">US: +1 (442) 207-4472</a>
                <a href="tel:+918618679681" class="font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">India: +91 8618679681</a>
                <a href="mailto:dass.kishore@aionsi.com" class="font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">dass.kishore@aionsi.com</a>
              </div>
              <p class="mt-4 text-sm leading-6 text-slate-500">For semiconductor engineering, verification, physical design, DFT, SoC/IP and dedicated engineering requirements.</p>
            </div>
          </div>
          <form id="engineering-discovery-form-inner" class="border border-slate-200 bg-white p-7 shadow-[0_16px_50px_rgba(2,11,39,.05)] md:p-8">
            <div class="mb-6 h-1 w-11 bg-[var(--aionsi-orange)]"></div>
            <div class="grid gap-5 md:grid-cols-2">
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">First name</span><input name="firstName" required class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Last name</span><input name="lastName" required class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Business email</span><input type="email" name="businessEmail" required class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Company</span><input name="company" required class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Program / project type</span><select name="programType" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select program type</option>{engineeringDiscoveryOptions.programType.map((item: string) => <option value={item}>{item}</option>)}</select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Protocol / interface</span><input name="protocolInterface" placeholder="e.g. PCIe, USB, DDR, HBM, AMBA" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Engineering stage</span><select name="verificationStage" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select stage</option>{engineeringDiscoveryOptions.verificationStage.map((item: string) => <option value={item}>{item}</option>)}</select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Primary bottleneck</span><select name="primaryBottleneck" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select bottleneck</option>{engineeringDiscoveryOptions.primaryBottleneck.map((item: string) => <option value={item}>{item}</option>)}</select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Engagement model</span><select name="engagementModel" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select model</option>{engineeringDiscoveryOptions.engagementModel.map((item: string) => <option value={item}>{item}</option>)}</select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">NDA / technical review status</span><select name="ndaStatus" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select status</option>{engineeringDiscoveryOptions.ndaStatus.map((item: string) => <option value={item}>{item}</option>)}</select></label>
              <label class="block md:col-span-2"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Requirement summary</span><textarea name="requirementSummary" rows="5" placeholder="What needs to be delivered, and where is the program constrained?" class="mt-2 w-full resize-y border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"></textarea></label>
            </div>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-xs leading-5 text-slate-500">We use the information to route the requirement to the appropriate engineering team.</p>
              <button type="submit" class="inline-flex items-center justify-center bg-[var(--aionsi-blue)] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[var(--aionsi-navy)]">Start Engineering Discussion →</button>
            </div>
            <p id="engineering-discovery-status" class="mt-4 hidden text-sm font-semibold text-[var(--aionsi-blue)]"></p>
          </form>
        </div>
      </Container>
    </Section>

    <Section class="py-9 md:py-10 lg:py-12">
      <Container>
        <div class="grid gap-5 md:grid-cols-3">
          <a href="/capabilities" class="border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">IP → SOC</div><h3 class="mt-5 text-2xl font-semibold text-[var(--aionsi-navy)]">Verification & RTL</h3><p class="mt-4 text-base leading-7 text-slate-600">Bring a block, subsystem or SoC verification requirement into an engineering-led discovery.</p><span class="mt-5 inline-flex text-sm font-semibold text-[var(--aionsi-blue)]">Explore capability →</span></a>
          <a href="/capabilities" class="border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">NETLIST → SIGNOFF</div><h3 class="mt-5 text-2xl font-semibold text-[var(--aionsi-navy)]">Physical & Timing</h3><p class="mt-4 text-base leading-7 text-slate-600">Discuss physical implementation, synthesis, STA, timing closure, ECO and signoff constraints.</p><span class="mt-5 inline-flex text-sm font-semibold text-[var(--aionsi-blue)]">Explore capability →</span></a>
          <a href="/solutions/odc" class="border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">DEDICATED POD</div><h3 class="mt-5 text-2xl font-semibold text-[var(--aionsi-navy)]">ODC / Engineering Pod</h3><p class="mt-4 text-base leading-7 text-slate-600">Define the engineering scope, governance model, ramp plan and measurable delivery outcomes.</p><span class="mt-5 inline-flex text-sm font-semibold text-[var(--aionsi-blue)]">Explore engagement →</span></a>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const form = document.querySelector('#engineering-discovery-form-inner');
  const status = document.querySelector('#engineering-discovery-status');
  if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());
      const params = new URLSearchParams({
        subject: `AionSi Engineering Discovery — ${String(payload.company || 'New Requirement')}`,
        body: [
          `Name: ${payload.firstName || ''} ${payload.lastName || ''}`,
          `Business email: ${payload.businessEmail || ''}`,
          `Company: ${payload.company || ''}`,
          `Program / project type: ${payload.programType || ''}`,
          `Protocol / interface: ${payload.protocolInterface || ''}`,
          `Engineering stage: ${payload.verificationStage || ''}`,
          `Primary bottleneck: ${payload.primaryBottleneck || ''}`,
          `Engagement model: ${payload.engagementModel || ''}`,
          `NDA / technical review status: ${payload.ndaStatus || ''}`,
          `Requirement summary: ${payload.requirementSummary || ''}`,
        ].join('\n')
      });
      status.textContent = 'Opening your email client with the engineering requirement…';
      status.classList.remove('hidden');
      window.location.href = `mailto:dass.kishore@aionsi.com?${params.toString()}`;
    });
  }
</script>
