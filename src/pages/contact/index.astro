---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import GlobalPresence from '../../components/contact/GlobalPresence.astro';
import { engineeringDiscoveryOptions, engineeringDiscoveryRouting } from '../../data/engineering-discovery';
---
<BaseLayout title="Engineering Discovery | AionSi" description="Start an engineering discovery conversation with AionSi for semiconductor engineering, verification, physical implementation, DFT and SoC requirements.">
  <Header />
  <main>
    <Section class="relative overflow-hidden bg-[var(--aionsi-surface-alt)] py-10 md:py-12 lg:py-14">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute inset-y-0 right-0 w-[62%] opacity-70 bg-[radial-gradient(circle_at_60%_42%,rgba(37,99,235,.12),transparent_48%),linear-gradient(90deg,transparent,rgba(237,246,255,.85))]"></div>
        <div class="absolute inset-0 opacity-[.18]" style="background-image:linear-gradient(rgba(37,99,235,.14) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.14) 1px,transparent 1px);background-size:48px 48px;"></div>
      </div>
      <Container>
        <div class="relative grid gap-8 lg:grid-cols-[.86fr_1.14fr] lg:items-center">
          <div class="relative z-10">
            <TechnicalLabel>GLOBAL TEAMS. LOCAL IMPACT.</TechnicalLabel>
            <h1 class="mt-5 max-w-3xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-6xl lg:text-7xl">Get in Touch.<br /><span class="text-[var(--aionsi-blue)]">Let’s Build What’s Next.</span></h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 md:text-xl md:leading-9">Partner with AionSi for high-performance semiconductor engineering. Our global teams support programs from IP to silicon across verification, RTL/SoC, physical design, DFT and timing closure.</p>
            <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-2">
              <a href="tel:+14422074472" class="rounded-2xl border border-slate-200 bg-white/95 p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <div class="text-xs font-semibold uppercase tracking-[.14em] text-[var(--aionsi-blue)]">Call — US</div>
                <div class="mt-2 text-base font-bold text-[var(--aionsi-navy)]">+1 (442) 207-4472</div>
              </a>
              <a href="tel:+918618679681" class="rounded-2xl border border-slate-200 bg-white/95 p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <div class="text-xs font-semibold uppercase tracking-[.14em] text-[var(--aionsi-blue)]">Call — India</div>
                <div class="mt-2 text-base font-bold text-[var(--aionsi-navy)]">+91 8618679681</div>
              </a>
              <a href="mailto:dass.kishore@aionsi.com" class="rounded-2xl border border-slate-200 bg-white/95 p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md sm:col-span-2">
                <div class="text-xs font-semibold uppercase tracking-[.14em] text-[var(--aionsi-blue)]">Email Us</div>
                <div class="mt-2 break-words text-base font-bold text-[var(--aionsi-navy)]">dass.kishore@aionsi.com</div>
              </a>
            </div>
          </div>

          <div class="relative min-h-[24rem] overflow-hidden rounded-[2rem] border border-blue-100 bg-slate-950 shadow-[0_24px_80px_rgba(2,11,39,.12)] lg:min-h-[32rem]">
            <img src="/images/contact-global-network.svg" alt="Global semiconductor engineering network" class="absolute inset-0 h-full w-full object-cover" />
            <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(3,24,52,.18),rgba(3,24,52,.04))]"></div>
            <div class="absolute inset-0 opacity-[.12]" aria-hidden="true" style="background-image:linear-gradient(rgba(130,190,255,.32) 1px,transparent 1px),linear-gradient(90deg,rgba(130,190,255,.32) 1px,transparent 1px);background-size:32px 32px;"></div>
            <svg viewBox="0 0 820 520" class="absolute inset-0 h-full w-full" role="img" aria-label="AionSi six-country global engineering network">
              <defs>
                <linearGradient id="networkArc" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#f59e0b" /><stop offset="100%" stop-color="#e1440b" /></linearGradient>
                <radialGradient id="pinGlow"><stop offset="0%" stop-color="#f59e0b" stop-opacity=".45" /><stop offset="100%" stop-color="#f59e0b" stop-opacity="0" /></radialGradient>
              </defs>
              <path d="M112 250 C255 126 386 142 430 174 C468 201 482 197 510 190 C552 180 570 189 616 220 C668 254 698 291 726 324" fill="none" stroke="url(#networkArc)" stroke-width="3" stroke-linecap="round" opacity=".92" />
              <path d="M238 294 C320 222 378 188 430 174 C494 157 557 196 616 220 C665 241 691 289 726 324" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" opacity=".6" />
              <path d="M430 174 C462 143 488 124 522 112" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" opacity=".55" />
              <path d="M616 220 C640 219 660 211 681 197" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" opacity=".52" />
              <g opacity=".18" fill="#9CD2FF">
                <circle cx="82" cy="128" r="3"/><circle cx="126" cy="110" r="2"/><circle cx="172" cy="146" r="3"/><circle cx="226" cy="114" r="2"/><circle cx="286" cy="132" r="3"/><circle cx="344" cy="96" r="2"/>
                <circle cx="470" cy="102" r="2"/><circle cx="534" cy="86" r="3"/><circle cx="604" cy="104" r="2"/><circle cx="684" cy="124" r="3"/><circle cx="748" cy="154" r="2"/>
                <circle cx="176" cy="380" r="2"/><circle cx="238" cy="406" r="3"/><circle cx="318" cy="374" r="2"/><circle cx="414" cy="420" r="3"/><circle cx="520" cy="390" r="2"/><circle cx="620" cy="420" r="3"/><circle cx="716" cy="382" r="2"/>
              </g>
              {[{x:112,y:250,label:'USA',align:'start'},{x:238,y:294,label:'UK',align:'middle'},{x:430,y:174,label:'SWEDEN',align:'middle'},{x:616,y:220,label:'SPAIN',align:'middle'},{x:681,y:292,label:'INDIA',align:'middle'},{x:726,y:324,label:'MALAYSIA',align:'end'}].map((point) => (
                <g>
                  <circle cx={point.x} cy={point.y} r="26" fill="url(#pinGlow)" />
                  <circle cx={point.x} cy={point.y} r="8" fill="#ffffff" stroke="#e1440b" stroke-width="4" />
                  <circle cx={point.x} cy={point.y} r="3" fill="#e1440b" />
                  <text x={point.x} y={point.y + 28} text-anchor={point.align} font-size="16" font-weight="700" fill="#ffffff" stroke="#061A35" stroke-width="3" paint-order="stroke" letter-spacing="1">{point.label}</text>
                </g>
              ))}
              <text x="410" y="454" text-anchor="middle" font-size="15" font-weight="600" fill="#D4E8FF" letter-spacing="2">CONNECTED ENGINEERING ACROSS SIX COUNTRIES</text>
            </svg>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-8 md:py-10 lg:py-12">
      <Container>
        <GlobalPresence />
      </Container>
    </Section>

    <Section id="engineering-discovery-form" class="bg-[var(--aionsi-surface-alt)] py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
          <div>
            <TechnicalLabel>ENGINEERING REQUIREMENTS</TechnicalLabel>
            <h2 class="mt-5 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Let’s define the engineering requirement.</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Tell us where the program is constrained. We will map the requirement to the appropriate AionSi engineering capability and engagement model.</p>
            <div class="mt-8 border border-slate-200 bg-white p-6 shadow-sm">
              <div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">Engineering requirements contact</div>
              <div class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">Dass Kishore</div>
              <div class="mt-1 text-sm font-semibold text-slate-500">Head of Business Development</div>
              <div class="mt-4 grid gap-2 text-sm leading-6 text-slate-600">
                <a href="tel:+14422074472" class="font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">US: +1 (442) 207-4472</a>
                <a href="tel:+918618679681" class="font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">India: +91 8618679681</a>
                <a href="mailto:dass.kishore@aionsi.com" class="font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">dass.kishore@aionsi.com</a>
              </div>
              <p class="mt-4 text-sm leading-6 text-slate-500">For semiconductor engineering, verification, physical design, DFT, SoC/IP and dedicated engineering requirements.</p>
            </div>
          </div>
          <form id="engineering-discovery-form-inner" class="border border-slate-200 bg-white p-7 shadow-[0_16px_50px_rgba(2,11,39,.05)] md:p-9">
            <div class="mb-7 h-1 w-11 bg-[var(--aionsi-orange)]"></div>
            <div class="grid gap-6 md:grid-cols-2">
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">First name</span><input name="firstName" required class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Last name</span><input name="lastName" required class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Business email</span><input type="email" name="businessEmail" required class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Company</span><input name="company" required class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Program / project type</span><select name="programType" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select program type</option>{engineeringDiscoveryOptions.programType.map((item: string) => <option value={item}>{item}</option>)}</select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Protocol / interface</span><input name="protocolInterface" placeholder="e.g. PCIe, USB, DDR, HBM, AMBA" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Engineering stage</span><select name="verificationStage" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select stage</option>{engineeringDiscoveryOptions.verificationStage.map((item: string) => <option value={item}>{item}</option>)}</select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Primary bottleneck</span><select name="primaryBottleneck" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select bottleneck</option>{engineeringDiscoveryOptions.primaryBottleneck.map((item: string) => <option value={item}>{item}</option>)}</select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Engagement model</span><select name="engagementModel" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select model</option>{engineeringDiscoveryOptions.engagementModel.map((item: string) => <option value={item}>{item}</option>)}</select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">NDA / technical review status</span><select name="ndaStatus" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select status</option>{engineeringDiscoveryOptions.ndaStatus.map((item: string) => <option value={item}>{item}</option>)}</select></label>
              <label class="block md:col-span-2"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Engineering requirement</span><textarea name="requirement" rows="5" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" placeholder="Share the block, interface, stage, schedule or bottleneck you want to review."></textarea></label>
            </div>
            <div class="mt-7 flex flex-col gap-4 border-t border-slate-100 pt-7 sm:flex-row sm:items-center sm:justify-between">
              <div class="text-sm leading-6 text-slate-500">Your submission will be routed to the appropriate AionSi engineering discussion path.</div>
              <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-[var(--aionsi-navy)] px-6 py-3 text-sm font-bold text-white transition hover:bg-[var(--aionsi-blue)]">Start Engineering Discussion</button>
            </div>
            <div id="engineering-discovery-status" class="mt-4 hidden text-sm font-semibold" aria-live="polite"></div>
          </form>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-14">
      <Container>
        <div class="grid gap-5 md:grid-cols-3">
          <div class="border border-slate-200 bg-white p-6 shadow-sm"><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">IP → SoC</div><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">Verification & RTL</h3><p class="mt-3 text-sm leading-6 text-slate-600">Bring a block, subsystem or SoC verification requirement into an engineering-led discovery.</p></div>
          <div class="border border-slate-200 bg-white p-6 shadow-sm"><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">NETLIST → SIGNOFF</div><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">Physical & Timing</h3><p class="mt-3 text-sm leading-6 text-slate-600">Discuss physical implementation, synthesis, STA, timing closure, ECO and signoff constraints.</p></div>
          <div class="border border-slate-200 bg-white p-6 shadow-sm"><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">DEDICATED POD</div><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">ODC / Engineering Pod</h3><p class="mt-3 text-sm leading-6 text-slate-600">Define the engineering scope, governance model, ramp plan and measurable delivery outcomes.</p></div>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />

  <script>
    const form = document.getElementById('engineering-discovery-form-inner');
    const status = document.getElementById('engineering-discovery-status');
    const routing = JSON.parse('{JSON.stringify(engineeringDiscoveryRouting)}');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status) return;
      status.classList.remove('hidden');
      status.classList.remove('text-red-600', 'text-green-600');
      status.classList.add('text-slate-600');
      status.textContent = 'Preparing your engineering discussion…';

      const data = Object.fromEntries(new FormData(form).entries());
      const subject = `AionSi Engineering Discovery — ${data.company || 'New Requirement'}`;
      const body = [
        `Contact: ${data.firstName || ''} ${data.lastName || ''}`,
        `Business Email: ${data.businessEmail || ''}`,
        `Company: ${data.company || ''}`,
        `Program / Project Type: ${data.programType || ''}`,
        `Protocol / Interface: ${data.protocolInterface || ''}`,
        `Engineering Stage: ${data.verificationStage || ''}`,
        `Primary Bottleneck: ${data.primaryBottleneck || ''}`,
        `Engagement Model: ${data.engagementModel || ''}`,
        `NDA / Technical Review Status: ${data.ndaStatus || ''}`,
        `Engineering Requirement:\n${data.requirement || ''}`,
        `Routing: ${routing?.default || 'Engineering Discovery'}`,
      ].join('\n\n');

      window.location.href = `mailto:dass.kishore@aionsi.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      status.classList.remove('text-slate-600');
      status.classList.add('text-green-600');
      status.textContent = 'Opening your email client with the engineering requirement prepared.';
    });
  </script>
</BaseLayout>
