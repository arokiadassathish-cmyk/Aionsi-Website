---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import GlobalPresence from '../../components/contact/GlobalPresence.astro';
import { engineeringDiscoveryOptions, engineeringDiscoveryRouting } from '../../data/engineering-discovery';
---
<BaseLayout title="Engineering Discovery | AionSi" description="Start an engineering discovery conversation with AionSi for semiconductor engineering, verification, physical implementation, DFT and SoC requirements.">
  <Header />
  <main>
    <Section class="relative overflow-hidden bg-white py-8 md:py-10 lg:py-12">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_35%,rgba(37,99,235,.12),transparent_42%),linear-gradient(180deg,#ffffff_0%,#f5f9ff_100%)]"></div>
        <div class="absolute inset-0 opacity-[.12]" style="background-image:linear-gradient(rgba(37,99,235,.18) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.18) 1px,transparent 1px);background-size:48px 48px;"></div>
      </div>
      <Container>
        <div class="relative grid gap-7 lg:grid-cols-[.82fr_1.18fr] lg:items-stretch">
          <div class="relative z-10 flex flex-col justify-between py-5 lg:py-8">
            <div>
              <TechnicalLabel>GLOBAL SEMICONDUCTOR ENGINEERING</TechnicalLabel>
              <h1 class="mt-5 max-w-2xl text-5xl font-semibold leading-[1.03] tracking-tight text-[var(--aionsi-navy)] md:text-6xl lg:text-[4rem]">Get in Touch.<br /><span class="text-[var(--aionsi-blue)]">Let’s Build<br />What’s Next.</span></h1>
              <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600 md:text-xl md:leading-9">Partner with AionSi for high-performance semiconductor engineering. Our global teams support programs from IP to silicon across verification, RTL/SoC, physical design, DFT and timing closure.</p>
            </div>
            <div class="mt-7 grid gap-3 sm:grid-cols-3 lg:max-w-4xl">
              <a href="tel:+14422074472" class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-[0_12px_35px_rgba(2,11,39,.07)] transition hover:-translate-y-0.5 hover:shadow-md">
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-blue-50 text-[var(--aionsi-blue)]" aria-hidden="true"><span class="text-xl">⌕</span></span>
                <span><span class="block text-sm font-bold text-[var(--aionsi-navy)]">Call Us</span><span class="mt-1 block text-xs leading-5 text-slate-600">US&nbsp; +1 (442) 207-4472<br />India&nbsp; +91 8618679681</span></span>
              </a>
              <a href="mailto:dass.kishore@aionsi.com" class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-[0_12px_35px_rgba(2,11,39,.07)] transition hover:-translate-y-0.5 hover:shadow-md">
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-blue-50 text-[var(--aionsi-blue)]" aria-hidden="true"><span class="text-xl">✉</span></span>
                <span><span class="block text-sm font-bold text-[var(--aionsi-navy)]">Email Us</span><span class="mt-1 block break-words text-xs font-semibold text-[var(--aionsi-blue)]">dass.kishore@aionsi.com</span></span>
              </a>
              <a href="#engineering-discovery-form" class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-[0_12px_35px_rgba(2,11,39,.07)] transition hover:-translate-y-0.5 hover:shadow-md">
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-blue-50 text-[var(--aionsi-blue)]" aria-hidden="true"><span class="text-xl">▣</span></span>
                <span><span class="block text-sm font-bold text-[var(--aionsi-navy)]">Start a Discussion</span><span class="mt-1 block text-xs font-semibold text-[var(--aionsi-blue)]">Tell us your requirement&nbsp; →</span></span>
              </a>
            </div>
          </div>

          <div class="relative min-h-[31rem] overflow-hidden rounded-[2rem] bg-[#edf5ff] shadow-[0_24px_80px_rgba(2,11,39,.10)] lg:min-h-[33rem]">
            <img src="/images/contact-global-network.svg" alt="Global semiconductor engineering network" class="absolute inset-0 h-full w-full object-cover opacity-90" />
            <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(255,255,255,.30),rgba(255,255,255,.04)),linear-gradient(180deg,rgba(255,255,255,.10),rgba(234,243,255,.18))]"></div>
            <div class="absolute right-8 top-7 hidden max-w-[120px] text-[10px] font-semibold uppercase leading-5 tracking-[.32em] text-slate-500 md:block"><div class="mb-3 h-[3px] w-8 bg-[var(--aionsi-orange)]"></div>Engineering<br />Tomorrow<br />Together</div>
            <svg viewBox="0 0 820 520" class="absolute inset-0 h-full w-full" role="img" aria-label="AionSi six-country global engineering network">
              <defs>
                <linearGradient id="networkArc" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#f59e0b" /><stop offset="100%" stop-color="#e1440b" /></linearGradient>
                <radialGradient id="pinGlow"><stop offset="0%" stop-color="#f59e0b" stop-opacity=".45" /><stop offset="100%" stop-color="#f59e0b" stop-opacity="0" /></radialGradient>
              </defs>
              <path d="M112 250 C255 126 386 142 430 174 C468 201 482 197 510 190 C552 180 570 189 616 220 C668 254 698 291 726 324" fill="none" stroke="url(#networkArc)" stroke-width="3" stroke-linecap="round" opacity=".92" />
              <path d="M238 294 C320 222 378 188 430 174 C494 157 557 196 616 220 C665 241 691 289 726 324" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" opacity=".6" />
              <path d="M430 174 C462 143 488 124 522 112" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" opacity=".55" />
              <path d="M616 220 C640 219 660 211 681 197" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" opacity=".52" />
              {[{x:112,y:250,label:'USA',align:'start'},{x:238,y:294,label:'UK',align:'middle'},{x:430,y:174,label:'SWEDEN',align:'middle'},{x:616,y:220,label:'SPAIN',align:'middle'},{x:681,y:292,label:'INDIA',align:'middle'},{x:726,y:324,label:'MALAYSIA',align:'end'}].map((point) => (
                <g>
                  <circle cx={point.x} cy={point.y} r="28" fill="url(#pinGlow)" />
                  <circle cx={point.x} cy={point.y} r="8" fill="#ffffff" stroke="#e1440b" stroke-width="4" />
                  <circle cx={point.x} cy={point.y} r="3" fill="#e1440b" />
                  <text x={point.x} y={point.y + 28} text-anchor={point.align} font-size="16" font-weight="700" fill="#123b6a" stroke="#ffffff" stroke-width="4" paint-order="stroke" letter-spacing="1">{point.label}</text>
                </g>
              ))}
              <text x="410" y="454" text-anchor="middle" font-size="15" font-weight="600" fill="#64748b" letter-spacing="2">CONNECTED ENGINEERING ACROSS SIX COUNTRIES</text>
            </svg>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="pt-0 pb-8 md:pb-10 lg:pb-12">
      <Container>
        <GlobalPresence />
      </Container>
    </Section>

    <Section id="engineering-discovery-form" class="bg-[var(--aionsi-surface-alt)] py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
          <div>
            <TechnicalLabel>ENGINEERING REQUIREMENTS</TechnicalLabel>
            <h2 class="mt-5 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Let’s define the engineering requirement.</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Tell us where the program is constrained. We will map the requirement to the appropriate AionSi engineering capability and engagement model.</p>
            <div class="mt-8 border border-slate-200 bg-white p-6 shadow-sm">
              <div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">Engineering requirements contact</div>
              <div class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">Dass Kishore</div>
              <div class="mt-1 text-sm font-semibold text-slate-500">Head of Business Development</div>
              <div class="mt-4 grid gap-2 text-sm leading-6 text-slate-600">
                <a href="tel:+14422074472" class="font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">US: +1 (442) 207-4472</a>
                <a href="tel:+918618679681" class="font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">India: +91 8618679681</a>
                <a href="mailto:dass.kishore@aionsi.com" class="font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">dass.kishore@aionsi.com</a>
              </div>
              <p class="mt-4 text-sm leading-6 text-slate-500">For semiconductor engineering, verification, physical design, DFT, SoC/IP and dedicated engineering requirements.</p>
            </div>
          </div>
          <form id="engineering-discovery-form-inner" class="border border-slate-200 bg-white p-7 shadow-[0_16px_50px_rgba(2,11,39,.05)] md:p-9">
            <div class="mb-7 h-1 w-11 bg-[var(--aionsi-orange)]"></div>
            <div class="grid gap-6 md:grid-cols-2">
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">First name</span><input name="firstName" required class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Last name</span><input name="lastName" required class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Business email</span><input type="email" name="businessEmail" required class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Company</span><input name="company" required class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Program / project type</span><select name="programType" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select program type</option>{engineeringDiscoveryOptions.programType.map((item: string) => <option value={item}>{item}</option>)}</select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Protocol / interface</span><input name="protocolInterface" placeholder="e.g. PCIe, USB, DDR, HBM, AMBA" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]" /></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Engineering stage</span><select name="verificationStage" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select stage</option>{engineeringDiscoveryOptions.verificationStage.map((item: string) => <option value={item}>{item}</option>)}</select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Primary bottleneck</span><select name="primaryBottleneck" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select bottleneck</option>{engineeringDiscoveryOptions.primaryBottleneck.map((item: string) => <option value={item}>{item}</select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Engagement model</span><select name="engagementModel" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select model</option>{engineeringDiscoveryOptions.engagementModel.map((item: string) => <option value={item}>{item}</option>)}</select></label>
              <label class="block"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">NDA / technical review status</span><select name="ndaStatus" class="mt-2 w-full border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"><option value="">Select status</option>{engineeringDiscoveryOptions.ndaStatus.map((item: string) => <option value={item}>{item}</option>)}</select></label>
              <label class="block md:col-span-2"><span class="text-sm font-semibold text-[var(--aionsi-navy)]">Requirement summary</span><textarea name="requirementSummary" rows="5" placeholder="Describe the block, interface, verification scope, implementation challenge or required engineering capacity." class="mt-2 w-full resize-y border border-slate-200 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm outline-none focus:border-[var(--aionsi-blue)]"></textarea></label>
              <div class="md:col-span-2 flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 pt-5"><p class="max-w-2xl text-xs leading-5 text-slate-500">Engineering requirements are routed for technical review. AionSi will use the information to frame the appropriate engineering discussion.</p><button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-[var(--aionsi-blue)] px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">Submit requirement <span aria-hidden="true">→</span></button></div>
            </div>
            <p id="engineering-discovery-status" class="mt-4 hidden text-sm font-semibold"></p>
          </form>
        </div>
      </Container>
    </Section>

    <Section class="py-10 md:py-12 lg:py-14">
      <Container>
        <div class="grid gap-5 md:grid-cols-3">
          <div class="border border-slate-200 bg-white p-6 shadow-sm"><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">Engineering-first</div><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">Talk to the people who can scope the work.</h3><p class="mt-3 text-sm leading-6 text-slate-600">Frame the requirement with engineering context before a commercial engagement model is proposed.</p></div>
          <div class="border border-slate-200 bg-white p-6 shadow-sm"><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">Global delivery</div><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">Build a distributed team around the program.</h3><p class="mt-3 text-sm leading-6 text-slate-600">Use AionSi's six-country network for customer proximity, collaboration and scalable engineering capacity.</p></div>
          <div class="border border-slate-200 bg-white p-6 shadow-sm"><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">Execution discipline</div><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">Move from technical discussion to measurable outcomes.</h3><p class="mt-3 text-sm leading-6 text-slate-600">Align scope, ownership, milestones and quality gates before the engagement starts.</p></div>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>

<script define:vars={{ engineeringDiscoveryRouting }}>
  const form = document.querySelector('#engineering-discovery-form-inner');
  const status = document.querySelector('#engineering-discovery-status');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    const data = new FormData(form);
    const values = Object.fromEntries(data.entries());
    const subject = encodeURIComponent(`AionSi Engineering Discovery — ${values.company || 'New requirement'}`);
    const body = encodeURIComponent([
      `Name: ${values.firstName || ''} ${values.lastName || ''}`,
      `Business email: ${values.businessEmail || ''}`,
      `Company: ${values.company || ''}`,
      `Program / project type: ${values.programType || ''}`,
      `Protocol / interface: ${values.protocolInterface || ''}`,
      `Engineering stage: ${values.verificationStage || ''}`,
      `Primary bottleneck: ${values.primaryBottleneck || ''}`,
      `Engagement model: ${values.engagementModel || ''}`,
      `NDA / technical review status: ${values.ndaStatus || ''}`,
      '',
      `Requirement summary:`,
      `${values.requirementSummary || ''}`,
      '',
      `Routing: ${engineeringDiscoveryRouting}`
    ].join('\n'));
    window.location.href = `mailto:dass.kishore@aionsi.com?subject=${subject}&body=${body}`;
    if (status) {
      status.textContent = 'Your requirement is ready to send to AionSi.';
      status.classList.remove('hidden');
      status.classList.add('text-[var(--aionsi-blue)]');
    }
  });
</script>
