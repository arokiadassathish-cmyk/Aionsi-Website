---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { implementationExperiences } from '../../data/implementation';

export const prerender = true;

export function getStaticPaths() {
  return implementationExperiences.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---
<BaseLayout title={`${item.title} | AionSi`} description={`${item.context} Representative engineering experience from AionSi.`}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>REPRESENTATIVE EXPERIENCE</TechnicalLabel>
        <div class="grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
          <div>
            <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{item.capability}</div>
            <h1 class="mt-5 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">{item.title}</h1>
            <p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">{item.context}</p>
          </div>
          <div class="border border-slate-200 bg-white p-8">
            <TechnicalLabel>PUBLICATION SCOPE</TechnicalLabel>
            <p class="mt-5 text-base leading-7 text-[var(--aionsi-navy)]">This page presents representative engineering scope only. Customer names, confidential project details and unsupported performance claims are intentionally excluded.</p>
          </div>
        </div>
      </Container>
    </Section>

    <Section>
      <Container class="grid gap-10 lg:grid-cols-[.75fr_1.25fr]">
        <div><TechnicalLabel>ENGINEERING SCOPE</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Workstream coverage.</h2><p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">The representative scope illustrates the engineering activities that can be structured into a focused workstream or larger delivery model.</p></div>
        <div class="grid gap-4 sm:grid-cols-2">{item.engineeringScope.map((scope, index) => <div class="border border-slate-200 bg-white p-7"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">0{index + 1}</div><h3 class="mt-4 text-lg font-semibold text-[var(--aionsi-navy)]">{scope}</h3></div>)}</div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container class="grid gap-6 md:grid-cols-3">
        <a href={item.evidenceHref} class="border border-slate-200 bg-white p-7 transition hover:border-[var(--aionsi-blue)]"><TechnicalLabel>PROOF</TechnicalLabel><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">Supporting technical evidence</h3><p class="mt-3 text-sm leading-6 text-slate-600">Read the approved evidence underlying this representative experience.</p><div class="mt-6 text-sm font-semibold text-[var(--aionsi-blue)]">View evidence →</div></a>
        <a href="/solutions" class="border border-slate-200 bg-white p-7 transition hover:border-[var(--aionsi-blue)]"><TechnicalLabel>DELIVERY</TechnicalLabel><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">Choose a delivery model</h3><p class="mt-3 text-sm leading-6 text-slate-600">Map the workstream to specialist, project, dedicated or ODC engagement.</p><div class="mt-6 text-sm font-semibold text-[var(--aionsi-blue)]">Explore solutions →</div></a>
        <a href="/contact" class="border border-slate-200 bg-white p-7 transition hover:border-[var(--aionsi-blue)]"><TechnicalLabel>DISCOVERY</TechnicalLabel><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">Discuss a similar requirement</h3><p class="mt-3 text-sm leading-6 text-slate-600">Bring your technology, milestone or capacity gap for an engineering discussion.</p><div class="mt-6 text-sm font-semibold text-[var(--aionsi-blue)]">Start discovery →</div></a>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white"><Container class="text-center"><TechnicalLabel>ENGINEERING DISCOVERY</TechnicalLabel><h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Build the next workstream from evidence.</h2><p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Tell us the engineering problem, expected scope and timeline. We can turn the discussion into a defined next step.</p><div class="mt-9"><Button href="/contact">Discuss Your Engineering Requirement</Button></div></Container></Section>
  </main>
  <Footer />
</BaseLayout>
