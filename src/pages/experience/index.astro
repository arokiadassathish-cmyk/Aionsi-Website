---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { implementationExperiences } from '../../data/implementation';
---
<BaseLayout title="Representative Engineering Experience | AionSi" description="Structured representative engineering experience across Physical Design, Design Verification and Protocol Verification.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>REPRESENTATIVE ENGINEERING EXPERIENCE</TechnicalLabel>
        <h1 class="mt-3 max-w-5xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">See the kind of engineering work AionSi is built to deliver.</h1>
        <p class="mt-6 max-w-4xl text-xl leading-9 text-slate-600">Public experience is intentionally presented as representative scope rather than customer-attributed case studies. Each reference is tied to approved technical evidence.</p>
      </Container>
    </Section>

    <Section>
      <Container>
        <div class="grid gap-5 lg:grid-cols-3">
          {implementationExperiences.map((item, index) => (
            <article class="border border-slate-200 bg-white p-8">
              <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">0{index + 1} · {item.capability}</div>
              <h2 class="mt-5 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{item.title}</h2>
              <p class="mt-4 text-sm leading-6 text-slate-600">{item.context}</p>
              <div class="mt-7 grid gap-2">
                {item.engineeringScope.map((scope) => <div class="border-l-2 border-[var(--aionsi-orange)] pl-3 text-sm leading-6 text-slate-600">{scope}</div>)}
              </div>
              <a href={item.evidenceHref} class="mt-8 inline-flex text-sm font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">View supporting evidence →</a>
            </article>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container class="grid gap-8 lg:grid-cols-[.75fr_1.25fr] lg:items-start">
        <div><TechnicalLabel>HOW TO USE THIS PROOF</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Move from evidence to a scoped engineering conversation.</h2></div>
        <div class="grid gap-4 sm:grid-cols-2">
          {['Identify the relevant capability','Review the representative engineering scope','Map the problem to an engagement model','Define the next engineering discovery step'].map((item, index) => <div class="border border-slate-200 bg-white p-6"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">0{index + 1}</div><p class="mt-4 font-semibold leading-6 text-[var(--aionsi-navy)]">{item}</p></div>)}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white"><Container class="text-center"><TechnicalLabel>ENGINEERING DISCOVERY</TechnicalLabel><h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Need a deeper view of a specific workstream?</h2><p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Bring the technology, milestone or capacity gap. We can connect it to the relevant evidence and engineering delivery model.</p><div class="mt-9"><Button href="/contact">Discuss Your Engineering Requirement</Button></div></Container></Section>
  </main>
  <Footer />
</BaseLayout>
