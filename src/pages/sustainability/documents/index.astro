---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/global/Header.astro';
import Footer from '../../../components/global/Footer.astro';
import Container from '../../../components/global/Container.astro';
import Section from '../../../components/global/Section.astro';
import TechnicalLabel from '../../../components/global/TechnicalLabel.astro';
import { esgDocuments } from '../../../data/esgDocuments';
---

<BaseLayout title="ESG Document Center | AionSi" description="AionSi sustainability, ethics, human rights, environmental, supplier and information security frameworks." canonical="https://aionsi.com/sustainability/documents">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-20 lg:py-24"><Container><div class="max-w-4xl"><TechnicalLabel>SUSTAINABILITY &amp; ESG / DOCUMENT CENTER</TechnicalLabel><h1 class="mt-5 text-4xl font-semibold tracking-tight md:text-6xl">Policies, statements and disclosure.</h1><p class="mt-6 max-w-3xl text-lg leading-8 text-white/75">A centralized evidence library for AionSi customers, suppliers, employees and due-diligence teams.</p></div></Container></Section>
    <Section class="py-14 md:py-18 lg:py-20"><Container><div class="grid gap-4 md:grid-cols-2">{esgDocuments.map((document, index) => (<a href={`/sustainability/documents/${document.slug}`} class="group border border-slate-200 p-7 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</div><h2 class="mt-3 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)] group-hover:text-[var(--aionsi-blue)]">{document.title}</h2><p class="mt-3 text-sm leading-7 text-slate-600">{document.summary}</p><span class="mt-5 inline-block text-sm font-semibold text-[var(--aionsi-blue)]">Read framework →</span></a>))}</div></Container></Section>
  </main>
  <Footer />
</BaseLayout>
