---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { technologyEvidence, getTechnologyEvidence } from '../../data/technologyEvidence';

export function getStaticPaths() {
  return technologyEvidence.map((technology) => ({
    params: { slug: technology.slug },
    props: { technology },
  }));
}

const { technology: suppliedTechnology } = Astro.props;
const technology = suppliedTechnology ?? getTechnologyEvidence(Astro.params.slug ?? '');
if (!technology) throw new Error(`Unknown technology evidence slug: ${Astro.params.slug}`);
---
<BaseLayout title={`${technology.title} | AionSi`} description={technology.summary}>
  <Header theme="light" />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>Technology Evidence</TechnicalLabel>
        <div class="grid gap-12 lg:grid-cols-[.85fr_1.15fr] lg:items-center">
          <div>
            <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{technology.number} · EVIDENCE READY</div>
            <h1 class="mt-6 text-5xl font-semibold tracking-tight md:text-7xl">{technology.title}</h1>
            <p class="mt-6 max-w-2xl text-xl leading-9 text-slate-600">{technology.summary}</p>
          </div>
          <div class="border border-slate-200 bg-white p-8">
            <div class="text-xs font-semibold tracking-[.16em] text-slate-400">SOURCE REFERENCE</div>
            <p class="mt-4 text-lg font-semibold text-[var(--aionsi-navy)]">{technology.sourceLabel}</p>
            <p class="mt-4 text-sm leading-6 text-slate-500">This page intentionally uses the supplied technical capability evidence as its source of truth.</p>
          </div>
        </div>
      </Container>
    </Section>

    <Section>
      <Container>
        <TechnicalLabel>Representative Proof</TechnicalLabel>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {technology.proofPoints.map((point, index) => (
            <div class="border border-slate-200 bg-white p-7">
              <div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">0{index + 1}</div>
              <p class="mt-5 text-lg font-semibold leading-7">{point}</p>
            </div>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
        <div>
          <TechnicalLabel>Engineering Context</TechnicalLabel>
          <h2 class="text-4xl font-semibold tracking-tight md:text-5xl">Technology connected to engineering delivery.</h2>
          <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">The evidence is intended to support technical discussions around architecture, RTL/IP, verification, integration and defined engineering workstreams.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {['Architecture','RTL / IP','Verification','SoC Integration'].map((item, index) => (
            <div class="border border-slate-200 bg-white p-7"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">0{index + 1}</div><h3 class="mt-5 text-xl font-semibold">{item}</h3><p class="mt-3 text-sm leading-6 text-slate-600">Use the supplied evidence to anchor the technical discussion before expanding scope.</p></div>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white">
      <Container class="text-center">
        <TechnicalLabel>Engineering Requirement</TechnicalLabel>
        <h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Need this technology as an engineering workstream?</h2>
        <p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Bring your scope, interface, subsystem or SoC requirement. AionSi can map it to the appropriate engineering model.</p>
        <div class="mt-9"><Button href="/contact">Discuss Your Engineering Requirement</Button></div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
