---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Container from '../components/global/Container.astro';
import Section from '../components/global/Section.astro';
import TechnicalLabel from '../components/global/TechnicalLabel.astro';
import Button from '../components/global/Button.astro';
---
<BaseLayout title="Semiconductor Engineering Services for Oppstar | AionSi" description="AionSi complements Oppstar with focused semiconductor engineering capacity across RTL, Design Verification, Physical Design, DFT, SoC Integration and project engineering.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-20 lg:py-24">
      <Container>
        <div class="grid gap-12 lg:grid-cols-[1.08fr_.72fr] lg:items-center">
          <div>
            <TechnicalLabel>OPPSTAR × AIONSI</TechnicalLabel>
            <h1 class="mt-4 max-w-5xl text-5xl font-semibold leading-[1.02] tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Engineering capacity for complex semiconductor programs.</h1>
            <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">Extend engineering execution capacity with focused AionSi teams aligned to defined work packages, milestones and technical ownership.</p>
            <div class="mt-9 flex flex-wrap gap-4">
              <Button href="/contact">Discuss an Engineering Requirement</Button>
              <a href="/capabilities" class="inline-flex items-center justify-center border border-slate-300 px-6 py-3 text-sm font-semibold text-[var(--aionsi-navy)] transition hover:border-[var(--aionsi-blue)]">Explore Capabilities</a>
            </div>
          </div>
          <div class="border border-slate-200 bg-white p-7 shadow-sm">
            <TechnicalLabel>PARTNERSHIP MODEL</TechnicalLabel>
            <h2 class="mt-4 text-2xl font-semibold text-[var(--aionsi-navy)]">Add execution capacity without disrupting the core team.</h2>
            <p class="mt-4 text-base leading-7 text-slate-600">Start with a defined engineering requirement and scale the team as the program demands.</p>
            <div class="mt-7 grid grid-cols-2 gap-3 text-sm font-semibold text-[var(--aionsi-navy)]">
              <div class="border border-slate-200 p-4">Defined scope</div>
              <div class="border border-slate-200 p-4">Technical ownership</div>
              <div class="border border-slate-200 p-4">Milestone driven</div>
              <div class="border border-slate-200 p-4">Scalable teams</div>
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-18">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
          <div>
            <TechnicalLabel>WHY AIONSI</TechnicalLabel>
            <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Complement existing engineering capability.</h2>
          </div>
          <div class="grid gap-4 sm:grid-cols-3">
            <div class="border border-slate-200 p-6"><div class="text-xs tracking-[.18em] text-[var(--aionsi-orange)]">01</div><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">Capacity</h3><p class="mt-3 text-sm leading-6 text-slate-600">Add experienced engineers around schedule-critical workload and program ramp-up.</p></div>
            <div class="border border-slate-200 p-6"><div class="text-xs tracking-[.18em] text-[var(--aionsi-orange)]">02</div><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">Specialization</h3><p class="mt-3 text-sm leading-6 text-slate-600">Bring focused expertise where a project needs deeper technical bandwidth.</p></div>
            <div class="border border-slate-200 p-6"><div class="text-xs tracking-[.18em] text-[var(--aionsi-orange)]">03</div><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">Ownership</h3><p class="mt-3 text-sm leading-6 text-slate-600">Structure teams around measurable work packages instead of generic headcount.</p></div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-white py-12 md:py-18">
      <Container>
        <TechnicalLabel>ENGINEERING COVERAGE</TechnicalLabel>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div class="border border-slate-200 p-7"><h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">RTL & SoC Integration</h3><p class="mt-3 text-sm leading-6 text-slate-600">RTL development, integration and implementation support across IP and subsystem work.</p></div>
          <div class="border border-slate-200 p-7"><h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">Design Verification</h3><p class="mt-3 text-sm leading-6 text-slate-600">IP, subsystem and SoC verification, UVM, coverage closure, regressions and debug.</p></div>
          <div class="border border-slate-200 p-7"><h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">Physical Design</h3><p class="mt-3 text-sm leading-6 text-slate-600">Synthesis, STA, physical implementation, timing closure, ECO and signoff support.</p></div>
          <div class="border border-slate-200 p-7"><h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">DFT</h3><p class="mt-3 text-sm leading-6 text-slate-600">DFT implementation, scan, ATPG, memory test and closure-oriented engineering support.</p></div>
          <div class="border border-slate-200 p-7"><h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">System & Embedded</h3><p class="mt-3 text-sm leading-6 text-slate-600">FPGA prototyping, firmware, drivers, board bring-up and system integration support.</p></div>
          <div class="border border-slate-200 p-7"><h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">Engineering Automation</h3><p class="mt-3 text-sm leading-6 text-slate-600">Flow automation and engineering productivity improvements around customer methodologies.</p></div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-18">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr]">
          <div>
            <TechnicalLabel>DELIVERY MODEL</TechnicalLabel>
            <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">From requirement to delivered work package.</h2>
          </div>
          <div class="grid gap-3">
            <div class="grid grid-cols-[64px_1fr] gap-5 border-b border-slate-200 py-5"><div class="text-sm font-semibold text-[var(--aionsi-orange)]">01</div><div><h3 class="font-semibold text-[var(--aionsi-navy)]">Understand</h3><p class="mt-1 text-sm leading-6 text-slate-600">Clarify program objective, technical constraints and bottleneck.</p></div></div>
            <div class="grid grid-cols-[64px_1fr] gap-5 border-b border-slate-200 py-5"><div class="text-sm font-semibold text-[var(--aionsi-orange)]">02</div><div><h3 class="font-semibold text-[var(--aionsi-navy)]">Define</h3><p class="mt-1 text-sm leading-6 text-slate-600">Agree scope, skills, tools, milestones, deliverables and ownership.</p></div></div>
            <div class="grid grid-cols-[64px_1fr] gap-5 border-b border-slate-200 py-5"><div class="text-sm font-semibold text-[var(--aionsi-orange)]">03</div><div><h3 class="font-semibold text-[var(--aionsi-navy)]">Build</h3><p class="mt-1 text-sm leading-6 text-slate-600">Assemble engineers around the actual requirement and working model.</p></div></div>
            <div class="grid grid-cols-[64px_1fr] gap-5 border-b border-slate-200 py-5"><div class="text-sm font-semibold text-[var(--aionsi-orange)]">04</div><div><h3 class="font-semibold text-[var(--aionsi-navy)]">Execute</h3><p class="mt-1 text-sm leading-6 text-slate-600">Work against technical milestones and agreed engineering KPIs.</p></div></div>
            <div class="grid grid-cols-[64px_1fr] gap-5 py-5"><div class="text-sm font-semibold text-[var(--aionsi-orange)]">05</div><div><h3 class="font-semibold text-[var(--aionsi-navy)]">Validate & Handoff</h3><p class="mt-1 text-sm leading-6 text-slate-600">Close deliverables, review acceptance criteria and transition ownership.</p></div></div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-18">
      <Container>
        <TechnicalLabel>ENGAGEMENT OPTIONS</TechnicalLabel>
        <div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <div class="border border-slate-200 p-6"><h3 class="text-lg font-semibold text-[var(--aionsi-navy)]">Extended Engineering</h3><p class="mt-2 text-sm leading-6 text-slate-600">Add specialist capacity to an existing team.</p></div>
          <div class="border border-slate-200 p-6"><h3 class="text-lg font-semibold text-[var(--aionsi-navy)]">Dedicated Team</h3><p class="mt-2 text-sm leading-6 text-slate-600">Build a focused team around a longer-running program.</p></div>
          <div class="border border-slate-200 p-6"><h3 class="text-lg font-semibold text-[var(--aionsi-navy)]">Project Engineering</h3><p class="mt-2 text-sm leading-6 text-slate-600">AionSi owns a defined engineering work package.</p></div>
          <div class="border border-slate-200 p-6"><h3 class="text-lg font-semibold text-[var(--aionsi-navy)]">Engineering ODC</h3><p class="mt-2 text-sm leading-6 text-slate-600">Create scalable offshore engineering capacity aligned to the roadmap.</p></div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-20">
      <Container>
        <div class="mx-auto max-w-4xl text-center">
          <TechnicalLabel>START WITH THE REQUIREMENT</TechnicalLabel>
          <h2 class="mt-4 text-4xl font-semibold tracking-tight md:text-6xl">Have an engineering requirement?</h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/70">Share the project stage, engineering discipline, required skills and target milestone. We will come prepared with a relevant engineering approach.</p>
          <div class="mt-8"><Button href="/contact">Discuss Your Requirement</Button></div>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
