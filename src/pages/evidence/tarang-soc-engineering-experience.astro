---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
---
<BaseLayout title="Tarang SoC Engineering Experience | AionSi" description="Representative AionSi Tarang SoC engineering experience spanning high-speed interfaces, memory, security, RISC-V, FPGA prototyping and embedded software.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-20">
      <Container>
        <TechnicalLabel>REPRESENTATIVE ENGINEERING EXPERIENCE</TechnicalLabel>
        <h1 class="mt-5 max-w-5xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Tarang SoC Engineering Experience</h1>
        <p class="mt-6 max-w-4xl text-xl leading-9 text-slate-600 md:text-2xl">Representative SoC engineering evidence spanning compute, high-speed connectivity, memory, security, FPGA prototyping and embedded software.</p>
        <div class="mt-7 border-l-2 border-[var(--aionsi-orange)] bg-white px-5 py-4 text-sm leading-7 text-slate-600"><strong class="text-[var(--aionsi-navy)]">Positioning:</strong> This page presents approved Tarang-related engineering material as representative experience. It does not imply customer attribution or ownership of third-party IP unless explicitly stated.</div>
      </Container>
    </Section>
    <Section>
      <Container>
        <TechnicalLabel>SoC Scope</TechnicalLabel>
        <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {[
            ['Compute','RISC-V based SoC platform and subsystem integration'],
            ['High-Speed I/O','PCIe Gen6, USB3 and Ethernet connectivity'],
            ['Memory','DDR4 / LPDDR4 and HBM subsystem integration'],
            ['Security','Security subsystem integration and validation'],
            ['Prototyping','FPGA prototyping and hardware/software bring-up'],
            ['Software','Embedded software integration and system validation'],
          ].map(([title,desc],index) => <article class="border border-slate-200 bg-white p-6 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><h2 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h2><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></article>)}
        </div>
      </Container>
    </Section>
    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-18">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
          <div><TechnicalLabel>Engineering Flow</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold md:text-4xl">Architecture to system validation.</h2><p class="mt-4 text-lg leading-8 text-white/70">A representative SoC flow connecting architecture, integration, verification, prototyping and software bring-up.</p></div>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {['Architecture','IP / Subsystem Integration','RTL & Verification','FPGA Prototyping','Embedded Software','System Validation'].map((item,index) => <div class="border border-white/10 bg-white/5 p-5"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">{String(index+1).padStart(2,'0')}</span><h3 class="mt-3 font-semibold">{item}</h3></div>)}
          </div>
        </div>
      </Container>
    </Section>
    <Section>
      <Container>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {[
            ['PCIe Gen6','High-speed connectivity path for SoC integration and verification.'],
            ['DDR4 / LPDDR4','Mainstream memory-controller and subsystem integration scope.'],
            ['HBM','High-bandwidth memory subsystem integration for demanding compute paths.'],
            ['USB3','Peripheral connectivity and system integration.'],
            ['Ethernet','Network connectivity within the SoC/system integration scope.'],
            ['Security Subsystem','Security-focused subsystem integration and validation.'],
          ].map(([title,desc]) => <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-6"><h2 class="font-semibold text-[var(--aionsi-navy)]">{title}</h2><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></div>)}
        </div>
      </Container>
    </Section>
    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div><TechnicalLabel>Where AionSi Contributes</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Cross-domain SoC engineering.</h2></div>
          <div class="grid gap-4 sm:grid-cols-2">
            {[
              ['SoC Integration','Coordinate processor, interface, memory and security subsystem integration around defined architecture requirements.'],
              ['Verification','Support block, subsystem and SoC verification across functional, protocol and system-level requirements.'],
              ['Prototype & Bring-Up','Use FPGA prototyping and embedded software to accelerate hardware/software validation.'],
              ['Scalable Engineering','Start with a focused subsystem and expand into a managed workstream or dedicated engineering team.'],
            ].map(([title,desc],index) => <article class="border border-slate-200 bg-white p-6"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><h3 class="mt-3 font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></article>)}
          </div>
        </div>
      </Container>
    </Section>
    <Section class="bg-[var(--aionsi-deep-navy)] text-white">
      <Container class="text-center"><TechnicalLabel>ENGINEERING DISCOVERY</TechnicalLabel><h2 class="mx-auto mt-3 max-w-4xl text-4xl font-semibold tracking-tight md:text-5xl">Have a SoC or IP integration requirement?</h2><p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Bring the architecture, subsystem, interface or verification requirement. AionSi can map it to the appropriate engineering capability and engagement model.</p><div class="mt-8"><Button href="/contact">Discuss Your Engineering Requirement</Button></div></Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
