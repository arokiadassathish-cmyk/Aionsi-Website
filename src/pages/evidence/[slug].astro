---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { capabilities } from '../../data/capabilities';
import { getEvidenceDetail } from '../../data/evidence';
import { getEvidencePresentation } from '../../data/evidenceContent';

export function getStaticPaths() {
  const paths = [];
  for (const capability of capabilities) {
    for (const item of capability.evidence ?? []) {
      if (!item.href) continue;
      const parts = item.href.split('/').filter(Boolean);
      const slug = parts[parts.length - 1];
      const detail = slug ? getEvidenceDetail(slug) : undefined;
      if (!slug || !detail) continue;
      paths.push({ params: { slug }, props: { evidence: { ...item, capability }, detail } });
    }
  }
  return paths;
}

const { evidence, detail } = Astro.props;
const presentation = getEvidencePresentation(evidence.capability.title);
const pageTitle = `${evidence.title} | AionSi`;
const pageDescription = detail.positioning;
const architectureImage = '/images/evidence/reusable-uvm-verification-architecture.png';
const isUvmArchitecture = evidence.href === '/evidence/reusable-uvm-verification-architecture';
const isPhysicalDesign = evidence.capability.title === 'Physical Design';
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-16 lg:py-18">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[1.02fr_.98fr] lg:items-center">
          <div class="max-w-4xl">
            <div class="flex flex-wrap items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]"><span>{evidence.capability.number}</span><span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span><span>ENGINEERING EVIDENCE</span><span class="border border-slate-200 bg-white px-3 py-2 uppercase tracking-[.14em] text-slate-500">{evidence.type}</span></div>
            <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-6xl">{evidence.title}</h1>
            <p class="mt-5 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">{detail.positioning}</p>
            <div class="mt-6 flex flex-wrap gap-3"><span class="border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700">Revision {detail.revision}</span><span class="border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700">{detail.classification}</span></div>
          </div>
          <aside class="hidden border border-slate-200 bg-white p-6 shadow-sm lg:block"><TechnicalLabel>{presentation.architectureLabel === 'Physical implementation architecture' ? 'Physical Implementation Flow' : presentation.architectureLabel}</TechnicalLabel><div class="mt-4 space-y-1">{detail.architecture.map((item, index) => <div class="flex items-center gap-3 border-b border-slate-100 py-2.5 last:border-b-0"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-blue-200 text-xs font-semibold text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span><span class="text-sm font-medium leading-6 text-[var(--aionsi-navy)]">{item}</span></div>)}</div></aside>
        </div>
      </Container>
    </Section>

    <Section class="py-10 md:py-12 lg:py-14"><Container><div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start"><div><TechnicalLabel>Engineering Context</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">{presentation.contextTitle}</h2></div><div class="grid gap-4 md:grid-cols-2"><div class="border-l-2 border-[var(--aionsi-orange)] pl-5 text-lg leading-8 text-slate-600"><p>{detail.context[0]}</p></div><div class="border-l-2 border-[var(--aionsi-blue)]/30 pl-5 text-lg leading-8 text-slate-600"><p>{detail.context[1]}</p></div></div></div></Container></Section>

    {isUvmArchitecture && <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-16 lg:py-20"><Container><div class="grid gap-8 lg:grid-cols-[.4fr_1.6fr] lg:items-center"><div class="max-w-xl"><TechnicalLabel>Technical Architecture</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">Reference UVM architecture.</h2><p class="mt-4 text-lg leading-8 text-white/70">A technical reference showing reusable test, environment, agent, DUT, checking, coverage, assertion and analysis relationships.</p><div class="mt-5 grid gap-2 text-sm text-white/70 sm:grid-cols-2"><div class="border border-white/10 bg-white/5 px-4 py-3">Stimulus → DUT interaction</div><div class="border border-white/10 bg-white/5 px-4 py-3">Agents → monitors → checking</div><div class="border border-white/10 bg-white/5 px-4 py-3">Coverage + assertions</div><div class="border border-white/10 bg-white/5 px-4 py-3">Regression + analysis</div></div><p class="mt-5 text-xs leading-6 text-white/45">Reference architecture derived from approved AionSi engineering material.</p></div><figure class="overflow-hidden border border-white/15 bg-white p-2 shadow-2xl shadow-black/10"><div class="flex min-h-64 items-center justify-center bg-slate-50 md:min-h-80"><img src={architectureImage} alt="Reusable UVM verification architecture" class="block h-auto max-h-[820px] w-full object-contain" loading="lazy" decoding="async" /></div><figcaption class="flex items-center justify-between gap-4 px-2 pb-1 pt-3 text-xs leading-5 text-slate-500"><span>Approved architecture reference</span><a href={architectureImage} target="_blank" rel="noreferrer" class="font-semibold text-[var(--aionsi-blue)] hover:underline">Open full-size →</a></figcaption></figure></div></Container></Section>}

    <Section class="bg-[var(--aionsi-surface-alt)] py-10 md:py-12 lg:py-14"><Container><div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start"><div><TechnicalLabel>Architecture Summary</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">{isPhysicalDesign ? 'Physical Design closure is an iterative engineering problem.' : 'What the architecture enables.'}</h2><p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">{presentation.architectureSummary}</p></div><div class="grid gap-3 sm:grid-cols-2">{presentation.architectureBenefits.map((item) => <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">{item.title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p></div>)}</div></div></Container></Section>

    <Section class="py-8 md:py-10 lg:py-12"><Container><div class="grid gap-8 lg:grid-cols-2"><div class="border border-slate-200 bg-white p-7 shadow-sm md:p-8"><TechnicalLabel>{presentation.methodologyLabel}</TechnicalLabel><div class="mt-6 flex flex-wrap items-center gap-2 text-xs font-semibold tracking-[.05em] text-[var(--aionsi-navy)]">{presentation.methodologyStages.map((stage, index) => <div class="flex items-center gap-2"><div class="border border-blue-200 bg-[var(--aionsi-surface-alt)] px-3 py-2">{String(index + 1).padStart(2, '0')} {stage}</div>{index < presentation.methodologyStages.length - 1 && <span class="text-slate-300">→</span>}</div>)}</div><div class="mt-5 grid gap-3 sm:grid-cols-2">{detail.methodology.map((item) => <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-4 text-sm font-medium leading-6 text-[var(--aionsi-navy)]">{item}</div>)}</div></div><div class="border border-slate-200 bg-white p-7 shadow-sm md:p-8"><TechnicalLabel>{presentation.assetsLabel}</TechnicalLabel><div class="mt-6 grid gap-3 sm:grid-cols-2">{detail.components.map((item) => <div class="border border-slate-200 p-5 text-sm font-medium text-[var(--aionsi-navy)]">{item}</div>)}</div></div></div></Container></Section>

    <Section class="py-8 md:py-10 lg:py-12"><Container><div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start"><div><TechnicalLabel>Where AionSi contributes</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">{presentation.contributionTitle}</h2><p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">{presentation.contributionSummary}</p></div><div class="grid gap-3 sm:grid-cols-2">{presentation.contributionItems.map((item, index) => <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-6"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span><h3 class="mt-3 font-semibold text-[var(--aionsi-navy)]">{item.title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p></div>)}</div></div></Container></Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-8 md:py-10 lg:py-12"><Container><div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start"><div><TechnicalLabel>Engineering Scale</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">{presentation.scaleTitle}</h2><p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">{presentation.scaleSummary}</p></div><div class="grid gap-3 sm:grid-cols-2">{presentation.scaleItems.map((item) => <div class="border border-slate-200 bg-white p-6"><span class="text-2xl font-semibold text-[var(--aionsi-blue)]">{item.value}</span><h3 class="mt-2 font-semibold text-[var(--aionsi-navy)]">{item.title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p></div>)}</div></div></Container></Section>

    <Section class="py-8 md:py-10 lg:py-12"><Container><div class="border border-slate-200 bg-white p-7 shadow-sm md:p-8"><TechnicalLabel>Engineering Basis</TechnicalLabel><div class="mt-5 grid gap-5 md:grid-cols-2">{detail.evidenceNotes.map((item) => <div class="border-l-2 border-[var(--aionsi-orange)] pl-5 text-lg leading-8 text-slate-600">{item}</div>)}</div></div></Container></Section>

    <Section class="py-8 md:py-10 lg:py-12"><Container><div class="border border-slate-200 bg-white p-7 shadow-sm md:p-8"><TechnicalLabel>Engineering Evidence</TechnicalLabel><h2 class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">AionSi Engineering Evidence — {evidence.title}</h2><p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">Get the detailed AionSi {evidence.capability.title} reference architecture, implementation flow and engineering methodology.</p><div class="mt-6"><Button href="/contact">{presentation.ctaButton}</Button></div></div></Container></Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-16"><Container><div class="grid gap-8 lg:grid-cols-[1.2fr_.8fr] lg:items-start"><div class="max-w-4xl"><TechnicalLabel>{presentation.ctaTitle}</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-5xl">{presentation.ctaTitle}</h2><p class="mt-5 text-lg leading-8 text-white/70">{presentation.ctaDescription}</p></div><div class="lg:flex lg:justify-end"><Button href="/contact">{presentation.ctaButton}</Button></div></div></Container></Section>
  </main>
  <Footer />
</BaseLayout>
