---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { capabilities } from '../../data/capabilities';
import { getEvidenceDetail } from '../../data/evidence';

export function getStaticPaths() {
  const paths = [];

  for (const capability of capabilities) {
    for (const item of capability.evidence ?? []) {
      if (!item.href) continue;

      const parts = item.href.split('/').filter(Boolean);
      const slug = parts[parts.length - 1];
      if (!slug || !getEvidenceDetail(slug)) continue;

      paths.push({
        params: { slug },
        props: {
          evidence: {
            ...item,
            capability,
          },
          detail: getEvidenceDetail(slug),
        },
      });
    }
  }

  return paths;
}

const { evidence, detail } = Astro.props;
const pageTitle = `${evidence.title} | AionSi`;
const pageDescription = detail.positioning;
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-16 md:py-18 lg:py-20">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[1.15fr_.85fr] lg:items-center">
          <div class="max-w-4xl">
            <div class="flex flex-wrap items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]">
              <span>{evidence.capability.number}</span>
              <span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span>
              <span>ENGINEERING EVIDENCE</span>
              <span class="border border-slate-200 bg-white px-3 py-2 uppercase tracking-[.14em] text-slate-500">{evidence.type}</span>
            </div>
            <h1 class="mt-6 max-w-4xl text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-6xl">{evidence.title}</h1>
            <p class="mt-5 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">{detail.positioning}</p>
            <div class="mt-7 flex flex-wrap gap-3">
              <span class="border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700">Revision {detail.revision}</span>
              <span class="border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700">{detail.classification}</span>
            </div>
          </div>

          <aside class="hidden border border-slate-200 bg-white p-7 lg:block">
            <TechnicalLabel>Verification architecture</TechnicalLabel>
            <div class="mt-5 space-y-2">
              {detail.architecture.map((item, index) => (
                <div class="flex items-center gap-3 border-b border-slate-100 py-3 last:border-b-0">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-blue-200 text-xs font-semibold text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span>
                  <span class="text-sm font-medium leading-6 text-[var(--aionsi-navy)]">{item}</span>
                </div>
              ))}
            </div>
          </aside>
        </div>
      </Container>
    </Section>

    <Section class="py-14 md:py-18 lg:py-20">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
          <div>
            <TechnicalLabel>Engineering Context</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Built for reusable verification at scale.</h2>
          </div>
          <div class="space-y-5 text-lg leading-8 text-slate-600">
            {detail.context.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18 lg:py-20">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
          <div>
            <TechnicalLabel>Architecture</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Reusable components across the verification flow.</h2>
            <p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">A structured architecture spanning stimulus, observation, checking, coverage and regression analysis.</p>
          </div>
          <div class="border border-slate-200 bg-white p-5 md:p-7">
            {detail.architecture.map((item, index) => (
              <div class="flex items-center gap-4 border-b border-slate-100 py-4 last:border-b-0">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-blue-200 text-xs font-semibold text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span>
                <span class="text-base font-semibold text-[var(--aionsi-navy)]">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-14 md:py-18 lg:py-20">
      <Container>
        <div class="grid gap-8 lg:grid-cols-2">
          <div class="border border-slate-200 bg-white p-7 md:p-8">
            <TechnicalLabel>Verification Methodology</TechnicalLabel>
            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              {detail.methodology.map((item) => (
                <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5 text-sm font-medium leading-6 text-[var(--aionsi-navy)]">{item}</div>
              ))}
            </div>
          </div>
          <div class="border border-slate-200 bg-white p-7 md:p-8">
            <TechnicalLabel>Reusable Components</TechnicalLabel>
            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              {detail.components.map((item) => (
                <div class="border border-slate-200 p-5 text-sm font-medium text-[var(--aionsi-navy)]">{item}</div>
              ))}
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18 lg:py-20">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
          <div>
            <TechnicalLabel>Evidence before claims</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">What the approved source material supports.</h2>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {detail.evidenceNotes.map((note) => (
              <div class="border border-slate-200 bg-white p-6 text-base leading-7 text-slate-600">{note}</div>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-14 md:py-18 lg:py-20">
      <Container>
        <div class="grid gap-8 border border-slate-200 p-7 md:p-9 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <TechnicalLabel>Source Material</TechnicalLabel>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-3xl">{detail.sourceLabel}</h2>
            <p class="mt-3 max-w-2xl text-slate-600">The website presents the engineering summary. The approved whitepaper remains the detailed technical artifact.</p>
          </div>
          <Button href="/contact">Request the Whitepaper</Button>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-16 md:py-20 lg:py-22 text-white">
      <Container class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <TechnicalLabel>Engineering Engagement</TechnicalLabel>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">Need deeper technical context?</h2>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-white/70">Bring the engineering problem, program stage or verification requirement. We can connect it to the appropriate AionSi team.</p>
        </div>
        <Button href="/contact">Talk to Our Engineering Team</Button>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
