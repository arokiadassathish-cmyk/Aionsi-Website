---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { capabilities } from '../../data/capabilities';
import { getEvidenceDetail } from '../../data/evidence';

export function getStaticPaths() {
  const paths = [];

  for (const capability of capabilities) {
    for (const item of capability.evidence ?? []) {
      if (!item.href) continue;

      const parts = item.href.split('/').filter(Boolean);
      const slug = parts[parts.length - 1];
      const detail = slug ? getEvidenceDetail(slug) : undefined;
      if (!slug || !detail) continue;

      paths.push({
        params: { slug },
        props: {
          evidence: {
            ...item,
            capability,
          },
          detail,
        },
      });
    }
  }

  return paths;
}

const { evidence, detail } = Astro.props;
const pageTitle = `${evidence.title} | AionSi`;
const pageDescription = detail.positioning;
const architectureImage = '/images/evidence/reusable-uvm-verification-architecture.png';
const isUvmArchitecture =
  evidence.href === '/evidence/reusable-uvm-verification-architecture';
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-16 lg:py-18">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-center">
          <div class="max-w-4xl">
            <div class="flex flex-wrap items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]">
              <span>{evidence.capability.number}</span>
              <span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span>
              <span>ENGINEERING EVIDENCE</span>
              <span class="border border-slate-200 bg-white px-3 py-2 uppercase tracking-[.14em] text-slate-500">{evidence.type}</span>
            </div>
            <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-6xl">{evidence.title}</h1>
            <p class="mt-5 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">{detail.positioning}</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <span class="border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700">Revision {detail.revision}</span>
              <span class="border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700">{detail.classification}</span>
            </div>
          </div>

          <aside class="hidden border border-slate-200 bg-white p-6 lg:block">
            <TechnicalLabel>Verification architecture</TechnicalLabel>
            <div class="mt-4 space-y-1">
              {detail.architecture.map((item, index) => (
                <div class="flex items-center gap-3 border-b border-slate-100 py-2.5 last:border-b-0">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-blue-200 text-xs font-semibold text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span>
                  <span class="text-sm font-medium leading-6 text-[var(--aionsi-navy)]">{item}</span>
                </div>
              ))}
            </div>
          </aside>
        </div>
      </Container>
    </Section>

    <Section class="py-10 md:py-12 lg:py-14">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div>
            <TechnicalLabel>Engineering Context</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Built for reusable verification at scale.</h2>
          </div>
          <div class="space-y-4 text-lg leading-8 text-slate-600">
            {detail.context.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </Container>
    </Section>

    {isUvmArchitecture && (
      <Section class="bg-[var(--aionsi-deep-navy)] py-14 md:py-16 lg:py-20 text-white">
        <Container>
          <div class="grid gap-8 lg:grid-cols-[.4fr_1.6fr] lg:items-center">
            <div class="max-w-xl">
              <TechnicalLabel>Technical Architecture</TechnicalLabel>
              <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">Reusable UVM verification architecture.</h2>
              <p class="mt-4 text-lg leading-8 text-white/70">A reference architecture showing reusable test, environment, agent, DUT, checking, coverage, assertion and analysis relationships.</p>
              <div class="mt-5 grid gap-2 text-sm text-white/70 sm:grid-cols-2">
                <div class="border border-white/10 bg-white/5 px-4 py-3">Stimulus → DUT interaction</div>
                <div class="border border-white/10 bg-white/5 px-4 py-3">Agents → monitors → checking</div>
                <div class="border border-white/10 bg-white/5 px-4 py-3">Coverage + assertions</div>
                <div class="border border-white/10 bg-white/5 px-4 py-3">Regression + analysis</div>
              </div>
              <p class="mt-5 text-xs leading-6 text-white/45">Reference architecture derived from approved AionSi engineering material.</p>
            </div>
            <figure class="overflow-hidden border border-white/15 bg-white p-2 shadow-2xl shadow-black/10">
              <div class="flex min-h-64 items-center justify-center bg-slate-50 md:min-h-80">
                <img src={architectureImage} alt="Reusable UVM verification architecture showing UVM test, virtual sequencer, reusable agents, DUT, scoreboard, predictor, coverage collector, SVA assertions and reporting analysis" class="block h-auto max-h-[820px] w-full object-contain" loading="lazy" decoding="async" />
              </div>
              <figcaption class="flex items-center justify-between gap-4 px-2 pb-1 pt-3 text-xs leading-5 text-slate-500">
                <span>Approved architecture reference</span>
                <a href={architectureImage} target="_blank" rel="noreferrer" class="font-semibold text-[var(--aionsi-blue)] hover:underline">Open full-size →</a>
              </figcaption>
            </figure>
          </div>
        </Container>
      </Section>
    )}

    <Section class="bg-[var(--aionsi-surface-alt)] py-10 md:py-12 lg:py-14">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div>
            <TechnicalLabel>Architecture Summary</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">What the architecture enables.</h2>
            <p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">The architecture connects reusable verification infrastructure to execution, checking and verification-closure workflows.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Accelerate environment development</h3><p class="mt-2 text-sm leading-6 text-slate-600">Reusable verification infrastructure reduces repeated environment development across interfaces, blocks and SoC-level programs.</p></div>
            <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Increase verification reuse</h3><p class="mt-2 text-sm leading-6 text-slate-600">Common agents, sequences, monitors and checkers can be extended across verification programs while preserving consistent patterns.</p></div>
            <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Improve verification closure</h3><p class="mt-2 text-sm leading-6 text-slate-600">Coverage, assertions, scoreboards and regression analysis provide structured mechanisms for closure activities.</p></div>
            <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Scale engineering capacity</h3><p class="mt-2 text-sm leading-6 text-slate-600">AionSi engineers can extend an established verification organization as an integrated engineering workstream.</p></div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-10 md:py-12 lg:py-14">
      <Container>
        <div class="grid gap-8 lg:grid-cols-2">
          <div class="border border-slate-200 bg-white p-7 md:p-8">
            <TechnicalLabel>Verification Methodology</TechnicalLabel>
            <div class="mt-6 flex flex-wrap items-center gap-2 text-xs font-semibold tracking-[.05em] text-[var(--aionsi-navy)]">
              {['Plan', 'Develop', 'Stimulate', 'Monitor', 'Check', 'Measure', 'Close'].map((stage, index) => (
                <div class="flex items-center gap-2">
                  <span class="border border-blue-200 bg-[var(--aionsi-surface-alt)] px-3 py-2">{String(index + 1).padStart(2, '0')} {stage}</span>
                  {index < 6 && <span class="text-slate-300">→</span>}
                </div>
              ))}
            </div>
            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              {detail.methodology.map((item) => (
                <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-4 text-sm font-medium leading-6 text-[var(--aionsi-navy)]">{item}</div>
              ))}
            </div>
          </div>
          <div class="border border-slate-200 bg-white p-7 md:p-8">
            <TechnicalLabel>Reusable Verification Assets</TechnicalLabel>
            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              {detail.components.map((item) => (
                <div class="border border-slate-200 p-5 text-sm font-medium text-[var(--aionsi-navy)]">{item}</div>
              ))}
            </div>
          </div>
        </div>
      </Container>
    </Section>

    {isUvmArchitecture && (
      <Section class="py-10 md:py-12 lg:py-14">
        <Container>
          <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
            <div>
              <TechnicalLabel>Where AionSi contributes</TechnicalLabel>
              <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Verification execution where engineering capacity matters.</h2>
              <p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">AionSi can contribute within an existing verification program or as a dedicated engineering workstream.</p>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-6"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">01</span><h3 class="mt-3 font-semibold text-[var(--aionsi-navy)]">Environment development</h3><p class="mt-2 text-sm leading-6 text-slate-600">Build or extend UVM environments, agents, drivers, monitors and infrastructure around defined verification requirements.</p></div>
              <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-6"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">02</span><h3 class="mt-3 font-semibold text-[var(--aionsi-navy)]">Protocol verification</h3><p class="mt-2 text-sm leading-6 text-slate-600">Execute interface-level verification across defined protocol requirements using drivers, monitors, checkers and coverage.</p></div>
              <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-6"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">03</span><h3 class="mt-3 font-semibold text-[var(--aionsi-navy)]">Verification closure</h3><p class="mt-2 text-sm leading-6 text-slate-600">Support coverage, assertions, scoreboard analysis, debug and regression closure activities.</p></div>
              <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-6"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">04</span><h3 class="mt-3 font-semibold text-[var(--aionsi-navy)]">Dedicated engineering team</h3><p class="mt-2 text-sm leading-6 text-slate-600">Operate as an integrated extension of an established verification organization around a defined workstream.</p></div>
            </div>
          </div>
        </Container>
      </Section>
    )}

    {isUvmArchitecture && (
      <Section class="bg-[var(--aionsi-surface-alt)] py-10 md:py-12 lg:py-14">
        <Container>
          <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
            <div>
              <TechnicalLabel>Why AionSi</TechnicalLabel>
              <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Engineering capacity designed to integrate.</h2>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Semiconductor-first engineering</h3><p class="mt-2 text-sm leading-6 text-slate-600">Focused engineering around IP, SoC, verification and silicon development workflows.</p></div>
              <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Reusable methodology</h3><p class="mt-2 text-sm leading-6 text-slate-600">Structured verification environments and reusable assets designed for consistent execution across programs.</p></div>
              <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Integrated engineering teams</h3><p class="mt-2 text-sm leading-6 text-slate-600">Engineers can operate within an established customer verification organization and its workflows.</p></div>
              <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Execution-oriented engagement</h3><p class="mt-2 text-sm leading-6 text-slate-600">Engagements can align around defined engineering deliverables and workstreams rather than profile-only staffing.</p></div>
            </div>
          </div>
        </Container>
      </Section>
    )}

    <Section class="bg-[var(--aionsi-surface-alt)] py-10 md:py-12 lg:py-14">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div>
            <TechnicalLabel>Engineering Basis</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Engineering basis for the architecture.</h2>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {detail.evidenceNotes.map((note) => (
              <div class="border border-slate-200 bg-white p-6 text-base leading-7 text-slate-600">{note}</div>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-10 md:py-12 lg:py-14">
      <Container>
        <div class="grid gap-8 border border-slate-200 p-7 md:p-9 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <TechnicalLabel>Source Material</TechnicalLabel>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-3xl">{detail.sourceLabel}</h2>
            <p class="mt-3 max-w-2xl text-slate-600">Get the detailed AionSi reference architecture and verification methodology.</p>
          </div>
          <Button href="/contact">Request the Whitepaper</Button>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 md:py-16 lg:py-18 text-white">
      <Container class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <TechnicalLabel>Engineering Engagement</TechnicalLabel>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">Need deeper technical context?</h2>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-white/70">Bring an interface, block, subsystem or SoC verification requirement. We can connect it to the appropriate AionSi engineering team.</p>
        </div>
        <Button href="/contact">Talk to Our Engineering Team</Button>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
