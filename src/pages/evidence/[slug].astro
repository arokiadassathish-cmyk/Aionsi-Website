---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { capabilities } from '../../data/capabilities';
import { getEvidenceDetail } from '../../data/evidence';

export function getStaticPaths() {
  const paths = [];

  for (const capability of capabilities) {
    for (const item of capability.evidence ?? []) {
      if (!item.href) continue;
      const slug = item.href.split('/').filter(Boolean).pop();
      if (!slug) continue;
      paths.push({
        params: { slug },
        props: { evidence: { ...item, capability } },
      });
    }
  }

  return paths;
}

const { evidence } = Astro.props;
const detail = getEvidenceDetail(evidence.href?.split('/').filter(Boolean).pop() ?? '');
const isUvm = detail?.slug === 'reusable-uvm-verification-architecture';
const pageTitle = `${evidence.title} | AionSi`;
const pageDescription = `${evidence.title}. Technical evidence from AionSi ${evidence.capability.title.toLowerCase()} engineering.`;
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-18 md:py-22 lg:py-24">
      <Container>
        <div class="max-w-5xl">
          <div class="flex flex-wrap items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]">
            <span>{evidence.capability.number}</span>
            <span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span>
            <span>ENGINEERING EVIDENCE</span>
            <span class="border border-slate-200 bg-white px-3 py-2 tracking-[.14em] text-slate-500">{evidence.type}</span>
          </div>
          <h1 class="mt-7 max-w-4xl text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-6xl">{evidence.title}</h1>
          <p class="mt-5 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">{detail?.positioning ?? evidence.description}</p>
          {isUvm && detail && (
            <div class="mt-8 flex flex-wrap gap-2">
              <span class="border border-slate-200 bg-white px-3 py-2 text-xs font-semibold tracking-[.08em] text-slate-600">Revision {detail.revision}</span>
              <span class="border border-slate-200 bg-white px-3 py-2 text-xs font-semibold tracking-[.08em] text-slate-600">{detail.classification}</span>
            </div>
          )}
        </div>
      </Container>
    </Section>

    {isUvm && detail ? (
      <>
        <Section class="py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
              <div>
                <TechnicalLabel>Engineering Context</TechnicalLabel>
                <h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Built for reusable verification at scale.</h2>
              </div>
              <div class="space-y-5 text-lg leading-8 text-slate-600">
                {detail.context.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </div>
          </Container>
        </Section>

        <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-8 lg:grid-cols-[.75fr_1.25fr] lg:items-start">
              <div>
                <TechnicalLabel>Verification Architecture</TechnicalLabel>
                <h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Reusable components across the verification flow.</h2>
                <p class="mt-4 max-w-md text-slate-600">A structured architecture spanning stimulus, observation, checking, coverage and regression analysis.</p>
              </div>
              <div class="border border-slate-200 bg-white p-6 md:p-8">
                <div class="space-y-0">
                  {detail.architecture.map((item, index) => (
                    <div class="flex items-center gap-4 border-b border-slate-100 py-4 last:border-b-0">
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[var(--aionsi-blue)]/30 text-[10px] font-semibold text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span>
                      <span class="text-sm font-medium text-[var(--aionsi-navy)]">{item}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </Container>
        </Section>

        <Section class="py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-6 md:grid-cols-2">
              <div class="border border-slate-200 bg-white p-7 md:p-8">
                <TechnicalLabel>Verification Methodology</TechnicalLabel>
                <div class="mt-5 grid gap-3 sm:grid-cols-2">
                  {detail.methodology.map((item) => <div class="border border-slate-100 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm font-medium leading-6 text-slate-600">{item}</div>)}
                </div>
              </div>
              <div class="border border-slate-200 bg-white p-7 md:p-8">
                <TechnicalLabel>Reusable Components</TechnicalLabel>
                <div class="mt-5 grid grid-cols-2 gap-3">
                  {detail.components.map((item) => <div class="border border-slate-100 px-4 py-3 text-sm font-medium text-[var(--aionsi-navy)]">{item}</div>)}
                </div>
              </div>
            </div>
          </Container>
        </Section>

        <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
              <div>
                <TechnicalLabel>Evidence Discipline</TechnicalLabel>
                <h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Evidence before claims.</h2>
              </div>
              <div class="space-y-4">
                {detail.evidenceNotes.map((item) => <div class="border border-slate-200 bg-white p-6 text-lg leading-8 text-slate-600">{item}</div>)}
              </div>
            </div>
          </Container>
        </Section>

        <Section class="py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center border border-slate-200 p-8 md:p-10">
              <div>
                <TechnicalLabel>Source Material</TechnicalLabel>
                <h2 class="mt-3 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-3xl">{detail.sourceLabel}</h2>
                <p class="mt-3 max-w-2xl text-slate-600">The website presents the engineering summary; the approved whitepaper remains the detailed technical source document.</p>
              </div>
              <Button href="/contact">Request the Whitepaper</Button>
            </div>
          </Container>
        </Section>
      </>
    ) : (
      <Section class="py-16 md:py-20 lg:py-24">
        <Container>
          <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
            <div>
              <TechnicalLabel>Technical Evidence</TechnicalLabel>
              <h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Engineering context, architecture and methodology.</h2>
            </div>
            <div class="space-y-5 text-lg leading-8 text-slate-600">
              <p>This evidence item documents AionSi engineering work within the {evidence.capability.title.toLowerCase()} capability.</p>
              <p>The approved technical source will be used to populate the detailed evidence sections.</p>
            </div>
          </div>
        </Container>
      </Section>
    )}

    <Section class="bg-[var(--aionsi-deep-navy)] py-16 md:py-20 lg:py-22 text-white">
      <Container class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <TechnicalLabel>Engineering Engagement</TechnicalLabel>
          <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Need deeper technical context?</h2>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-white/70">Bring the engineering problem, program stage or verification requirement. We can connect it to the appropriate AionSi team.</p>
        </div>
        <Button href="/contact">Talk to Our Engineering Team</Button>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
