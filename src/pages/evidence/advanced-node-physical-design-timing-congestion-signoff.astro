---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
---
<BaseLayout
  title="Advanced-Node Physical Design: Timing, Congestion & Sign-Off Closure | AionSi"
  description="AionSi engineering methodology for advanced-node physical design, including floorplanning, placement, CTS, routing, timing closure, congestion optimization and physical sign-off."
>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[1.04fr_.96fr] lg:items-center lg:gap-14">
          <div class="max-w-5xl">
            <div class="flex flex-wrap items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]">
              <span>PHYSICAL DESIGN</span><span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span><span>TECHNICAL REFERENCE</span>
            </div>
            <h1 class="mt-6 text-[3.6rem] font-semibold leading-[1.04] tracking-[-0.035em] text-[var(--aionsi-navy)] md:text-[4.35rem]">Advanced-Node Physical Design: Timing, Congestion & Sign-Off Closure</h1>
            <p class="mt-5 max-w-4xl text-xl leading-9 text-slate-600 md:text-2xl">A practical engineering methodology for complex ASIC and SoC implementation where physical architecture, timing, congestion, power intent and sign-off must converge.</p>
            <div class="mt-7 border-l-2 border-[var(--aionsi-orange)] bg-white px-5 py-4 text-sm leading-7 text-slate-600 shadow-sm"><strong class="text-[var(--aionsi-navy)]">Positioning:</strong> This page summarizes representative engineering practices and evidence supplied to AionSi. It does not imply customer attribution or a guarantee of a specific implementation outcome.</div>
          </div>
          <div class="border border-slate-200 bg-white p-6 shadow-sm md:p-7">
            <div class="h-1 w-12 bg-[var(--aionsi-orange)]"></div>
            <div class="mt-5 grid gap-1">
              {[
                ['01','Netlist'],['02','Floorplan'],['03','Placement'],['04','Clock-tree synthesis'],['05','Routing'],['06','Timing / physical verification'],['07','Sign-off'],
              ].map(([num,title]) => <div class="flex items-center gap-4 border-b border-slate-200 py-4 last:border-b-0"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-blue-200 text-xs font-semibold text-[var(--aionsi-blue)]">{num}</span><span class="text-base font-semibold text-[var(--aionsi-navy)]">{title}</span></div>)}
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-14 lg:py-16">
      <Container>
        <TechnicalLabel>Representative Engineering Evidence</TechnicalLabel>
        <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {[
            ['3nm–28nm','Representative process range'],
            ['8M+','Representative cell scale'],
            ['352','Representative macro scale'],
            ['2.8 GHz','Representative high-frequency experience'],
          ].map(([value,label]) => <div class="border border-slate-200 bg-white p-6 shadow-sm"><div class="text-3xl font-semibold text-[var(--aionsi-blue)]">{value}</div><p class="mt-2 text-sm leading-6 text-slate-600">{label}</p></div>)}
        </div>
      </Container>
    </Section>

    <Section class="bg-white py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div>
            <TechnicalLabel>ENGINEERING PRINCIPLE</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Why disciplined physical implementation matters.</h2>
          </div>
          <div class="grid gap-5 md:grid-cols-2">
            <div class="border-l-2 border-[var(--aionsi-orange)] pl-5"><p class="text-base leading-7 text-slate-600">Representative AionSi Physical Design evidence covers implementation planning, floorplanning, placement, CTS, routing, timing closure, physical verification and sign-off.</p></div>
            <div class="border-l-2 border-blue-200 pl-5"><p class="text-sm leading-7 text-slate-500">The evidence is limited to the approved engineering description; customer attribution and unsupported implementation or performance claims are not implied.</p></div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div>
            <TechnicalLabel>CLOSURE METHODOLOGY</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Physical Design closure is an iterative engineering problem.</h2>
            <p class="mt-4 text-lg leading-8 text-slate-600">The implementation path connects netlist handoff to floorplanning, placement, CTS, routing, timing closure, physical verification and sign-off.</p>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {[
              ['Accelerate implementation convergence','Structured floorplanning, placement, CTS and routing iterations help identify physical constraints early and reduce downstream rework.'],
              ['Improve PPA and congestion trade-offs','Implementation decisions are evaluated against area, power, timing and congestion objectives throughout closure.'],
              ['Drive timing closure','Static timing analysis, clock-tree refinement and implementation feedback support systematic setup, hold and path-closure activities.'],
              ['Support sign-off readiness','Physical verification, ECO iteration and downstream checks provide a structured path toward implementation release and sign-off readiness.'],
            ].map(([title,desc]) => <article class="border border-slate-200 bg-white p-6 shadow-sm"><h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{desc}</p></article>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-8 lg:grid-cols-2 lg:items-start">
          <div class="border border-slate-200 bg-white p-7 shadow-sm">
            <TechnicalLabel>END-TO-END FLOW</TechnicalLabel>
            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              {[
                ['01','Planning','Implementation planning aligned to hierarchy, power, clocking and physical constraints'],
                ['02','Floorplanning','Floorplanning, placement, CTS and routing refinement driven by congestion and timing objectives'],
                ['03','Placement / CTS / Routing','Density, clocking, routing and physical-resource closure across implementation stages'],
                ['04','Timing / Sign-off','Static timing, physical verification, ECO iteration and sign-off readiness checks supporting closure'],
              ].map(([num,title,desc]) => <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{num}</span><h3 class="mt-3 text-lg font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></div>)}
            </div>
          </div>
          <div class="border border-slate-200 bg-white p-7 shadow-sm">
            <TechnicalLabel>CLOSURE DEPENDENCIES</TechnicalLabel>
            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              {[
                ['Floorplanning','Macro placement · power domains · hierarchy'],
                ['Placement','Utilization · density · congestion · timing'],
                ['CTS','Skew · latency · transition · clock balance'],
                ['Routing','Congestion · physical rules · signal integrity'],
                ['Timing closure','Setup · hold · constraints · ECO'],
                ['Sign-off','STA · DRC/LVS · physical verification · release readiness'],
              ].map(([title,desc]) => <div class="border border-slate-200 p-5"><h3 class="text-base font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></div>)}
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-14 lg:py-16">
      <Container>
        <TechnicalLabel>REPRESENTATIVE ENGINEERING EXPERIENCE</TechnicalLabel>
        <div class="mt-6 grid gap-5 lg:grid-cols-3">
          <article class="border border-slate-200 bg-white p-7"><div class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">3NM</div><h2 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">High-Complexity Block</h2><p class="mt-3 text-sm leading-6 text-slate-600">Representative profile evidence includes approximately 8M cells, 352 macros, 3 power domains, 17 metal layers and a 2.4 GHz primary clock, with ownership across floorplan, placement, CTS, routing, timing, congestion and sign-off.</p></article>
          <article class="border border-slate-200 bg-white p-7"><div class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">3NM</div><h2 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">Multi-Power-Domain Block</h2><p class="mt-3 text-sm leading-6 text-slate-600">Representative experience includes approximately 4.3M cells, 189 macros, 7 power domains, 15 metal layers and a 2.8 GHz main clock across implementation and sign-off activities.</p></article>
          <article class="border border-slate-200 bg-white p-7"><div class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">HIGH-DENSITY</div><h2 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">Congestion & Timing Closure</h2><p class="mt-3 text-sm leading-6 text-slate-600">Representative closure work uses blockages, cell padding, density screens, path groups, repeater bounds and manual ECOs to systematically address physical bottlenecks.</p></article>
        </div>
        <p class="mt-6 text-xs leading-5 text-slate-500">Figures shown here are representative engineering evidence from approved profiles and should be treated as program-specific examples, not a single combined design.</p>
      </Container>
    </Section>

    <Section class="py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
          <div><TechnicalLabel>Tooling Environment</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Implementation and sign-off across industry-standard flows.</h2></div>
          <div class="grid gap-3 sm:grid-cols-2">
            {['Synopsys Fusion Compiler / ICC2','Cadence Innovus','Synopsys Design Compiler','Synopsys PrimeTime / Tweaker','Synopsys Star-RC','Calibre / ICV','Tcl / Shell automation'].map((item) => <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-4 text-sm font-medium text-slate-600">{item}</div>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div>
            <TechnicalLabel>CROSS-FUNCTIONAL CLOSURE</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Physical closure depends on engineering feedback across the flow.</h2>
            <p class="mt-4 text-lg leading-8 text-slate-600">Implementation decisions are connected to constraints and feedback from adjacent engineering functions.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {[
              ['PD','Physical Design','Floorplan → placement → CTS → routing'],
              ['STA','Timing','Constraints → analysis → closure → ECO'],
              ['DFT','Test','Test structures → implementation constraints → sign-off'],
              ['RTL / DV','Design & Verification','Functional intent → integration feedback → closure'],
            ].map(([label,title,desc]) => <article class="border border-slate-200 bg-white p-6 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{label}</span><h3 class="mt-3 text-lg font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></article>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-14 lg:py-16">
      <Container>
        <TechnicalLabel>ENGINEERING DISCUSSION</TechnicalLabel>
        <div class="mt-4 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <h2 class="max-w-4xl text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Continue the technical discussion.</h2>
            <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">A deeper discussion can focus on the implementation stage, technical constraints and closure methodology relevant to the program.</p>
          </div>
          <Button href="/contact">Continue the Discussion</Button>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
