---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
---
<BaseLayout title="OpenTitan-Based Secure SoC Engineering | AionSi" description="Representative AionSi engineering experience in OpenTitan-based secure SoC integration, hardware cryptography, secure boot, key management, RTL verification and system validation.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-20">
      <Container>
        <TechnicalLabel>SECURE SOC ENGINEERING</TechnicalLabel>
        <h1 class="mt-5 max-w-5xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">OpenTitan-Based Secure SoC Engineering</h1>
        <p class="mt-6 max-w-4xl text-xl leading-9 text-slate-600 md:text-2xl">Representative engineering experience spanning secure SoC integration, hardware cryptography, secure boot, key management and security-oriented verification using OpenTitan technologies.</p>
        <div class="mt-7 border-l-2 border-[var(--aionsi-orange)] bg-white px-5 py-4 text-sm leading-7 text-slate-600"><strong class="text-[var(--aionsi-navy)]">Representative Engineering Experience:</strong> This page presents AionSi engineering capability involving OpenTitan technologies and related secure-SoC concepts. OpenTitan, Ibex, OTBN, TileLink and associated technologies remain subject to their respective project, organization and licensing terms. This page does not imply ownership of third-party IP or affiliation with the OpenTitan project.</div>
      </Container>
    </Section>

    <Section>
      <Container>
        <TechnicalLabel>Earl Grey Top-Level Context</TechnicalLabel>
        <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {[
            ['Compute','RV32IMC Ibex 32-bit RISC-V core'],
            ['Cryptography','AES-256, SHA-256/HMAC, KMAC and OTBN-based cryptographic processing'],
            ['Interconnect','TileLink-UL based system interconnect'],
            ['Security Controls','OTP controller, lifecycle controller and security-oriented state management'],
            ['Memory & Peripherals','SRAM and supported SPI, I2C, UART and USB device interfaces'],
            ['Secure SoC Validation','Secure boot, key management, power/reset and security subsystem validation'],
          ].map(([title,desc],index) => <article class="border border-slate-200 bg-white p-6 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><h2 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h2><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></article>)}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-18">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
          <div><TechnicalLabel>Verification Challenges</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold md:text-4xl">Security verification across multiple domains.</h2><p class="mt-4 text-lg leading-8 text-white/70">Representative security-verification considerations spanning security state, cryptography, interconnect, memory and power/reset behavior.</p></div>
          <div class="grid gap-3 sm:grid-cols-2">
            {[
              ['01','Security lifecycle','Validate security-state transitions and hardware-enforced access controls.'],
              ['02','Cryptographic behavior','Verify cryptographic engines, key flows and security-policy behavior.'],
              ['03','Interconnect & memory','Exercise TileLink-based transactions, memory protection and subsystem interactions.'],
              ['04','Power & reset','Validate power-manager, clock-manager and reset-manager transitions.'],
            ].map(([num,title,desc]) => <div class="border border-white/10 bg-white/5 p-5"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">{num}</span><h3 class="mt-3 font-semibold">{title}</h3><p class="mt-2 text-sm leading-6 text-white/65">{desc}</p></div>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section>
      <Container>
        <TechnicalLabel>Secure SoC Engineering Scope</TechnicalLabel>
        <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {[
            ['Secure Compute','RISC-V processor integration and security-aware execution environments.'],
            ['Cryptographic Subsystems','Hardware cryptography, key-management flows and security primitives within defined scope.'],
            ['Security Control Plane','OTP, lifecycle controls, secure boot and security state management.'],
            ['Verification','SystemVerilog/UVM, assertions, register-level checking and formal planning around defined security requirements.'],
            ['Regression & Traceability','Structured regression analysis, coverage tracking and traceability aligned to verification objectives.'],
            ['System Validation','Power/reset lifecycle and system-level validation around defined secure-SoC requirements.'],
          ].map(([title,desc]) => <article class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-6"><h2 class="font-semibold text-[var(--aionsi-navy)]">{title}</h2><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></article>)}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div><TechnicalLabel>Engineering Lifecycle</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Secure SoC engineering from architecture through validation.</h2><p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">A representative lifecycle connecting secure architecture, RTL, verification, integration, timing-oriented review and system validation.</p></div>
          <div class="flex flex-wrap items-center gap-2 text-xs font-semibold tracking-[.05em] text-[var(--aionsi-navy)]">
            {['Architecture','RTL','Verification','Integration','PPA / Timing','System Validation','Release'].map((stage,index) => <div class="flex items-center gap-2"><div class="border border-blue-200 bg-white px-3 py-2">{String(index+1).padStart(2,'0')} {stage}</div>{index < 6 && <span class="text-slate-300">→</span>}</div>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section>
      <Container>
        <div class="grid gap-5 md:grid-cols-2">
          {[
            ['Security-aware SoC integration','Integrate defined security subsystems and interfaces into broader SoC architectures.'],
            ['Cryptography verification','Exercise hardware cryptography and security policies through simulation and formal planning.'],
            ['Power / reset validation','Verify security-relevant lifecycle behavior across power, clock and reset transitions.'],
            ['Scalable engineering workstream','Start with focused security verification and expand into a managed or dedicated engineering workstream.'],
          ].map(([title,desc],index) => <article class="border border-slate-200 bg-white p-6 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><h2 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h2><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></article>)}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white">
      <Container class="text-center"><TechnicalLabel>ENGINEERING DISCOVERY</TechnicalLabel><h2 class="mx-auto mt-3 max-w-4xl text-4xl font-semibold tracking-tight md:text-5xl">Building a security-critical SoC?</h2><p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Bring your security subsystem, cryptography, lifecycle, verification or integration requirement. AionSi can map it to the appropriate engineering capability and engagement model.</p><div class="mt-8"><Button href="/contact">Discuss Your Security Engineering Requirement</Button></div></Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
