---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { evidenceDetails } from '../../data/evidence';

const groups = [
  {
    label: 'Physical Design',
    intro: 'Representative implementation evidence spanning SoC physical integration, timing, congestion, clocking and sign-off.',
    slugs: [
      'physical-design-representative-engineering-experience',
      'advanced-node-physical-design-timing-congestion-signoff',
    ],
  },
  {
    label: 'Design Verification',
    intro: 'Verification evidence across reusable UVM infrastructure, protocols, memory subsystems, processor-driven verification, formal planning and SoC closure.',
    slugs: [
      'pcie-5-data-link-layer-verification',
      'hbm4e-memory-subsystem-verification',
      'reusable-uvm-verification-architecture',
      'processor-based-verification-arm-cortex-m7',
      'formal-verification-cadence-jaspergold',
      '5g-radio-on-chip-functional-verification',
      'end-to-end-iot-soc-verification',
      'ufs-4-low-power-verification',
    ],
  },
];

const externalSources: Record<string, string> = {
  'physical-design-representative-engineering-experience': 'https://aionsi.com/case-study/advanced-soc-physical-design-case-study-2',
};
---
<BaseLayout title="Engineering Evidence | AionSi" description="AionSi engineering evidence across Physical Design and Design Verification, presented as technical references, methodologies and public case studies.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-16 lg:py-18">
      <Container>
        <div class="max-w-4xl">
          <div class="flex items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]">
            <span>ENGINEERING EVIDENCE</span><span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span><span>EVIDENCE LIBRARY</span>
          </div>
          <h1 class="mt-6 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Evidence before claims.</h1>
          <p class="mt-5 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">Technical evidence across verification and physical implementation — showing the engineering problems, methods and execution patterns AionSi is prepared to contribute to.</p>
          <div class="mt-7 border-l-2 border-[var(--aionsi-orange)] pl-5 text-sm leading-7 text-slate-600">Technical evidence is presented from approved AionSi engineering material and public case-study sources. Customer attribution, proprietary implementation details and performance claims are not implied unless explicitly supported by approved source material.</div>
        </div>
      </Container>
    </Section>

    {groups.map((group) => (
      <Section class="py-12 md:py-14 lg:py-16">
        <Container>
          <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
            <div>
              <TechnicalLabel>{group.label}</TechnicalLabel>
              <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Engineering evidence.</h2>
              <p class="mt-4 max-w-md text-lg leading-8 text-slate-600">{group.intro}</p>
            </div>
            <div class="grid gap-4 md:grid-cols-2">
              {group.slugs.map((slug) => {
                const item = evidenceDetails[slug];
                if (!item) return null;
                return (
                  <article class="border border-slate-200 bg-white p-6 shadow-sm">
                    <div class="flex items-center justify-between gap-3">
                      <span class="text-xs font-semibold uppercase tracking-[.14em] text-[var(--aionsi-blue)]">{item.type}</span>
                      <span class="text-[10px] font-semibold uppercase tracking-[.12em] text-slate-400">{item.classification}</span>
                    </div>
                    <h3 class="mt-4 text-xl font-semibold leading-7 text-[var(--aionsi-navy)]">{item.title}</h3>
                    <p class="mt-3 text-sm leading-6 text-slate-600">{item.positioning}</p>
                    <div class="mt-5 flex flex-wrap gap-2">
                      {item.components.slice(0, 4).map((component) => <span class="border border-slate-200 bg-[var(--aionsi-surface-alt)] px-3 py-2 text-xs font-medium text-slate-600">{component}</span>)}
                    </div>
                    <div class="mt-6 flex flex-wrap items-center gap-4">
                      <a href={`/evidence/${item.slug}`} class="text-sm font-semibold text-[var(--aionsi-blue)] hover:underline">View engineering evidence →</a>
                      {externalSources[item.slug] && <a href={externalSources[item.slug]} target="_blank" rel="noreferrer" class="text-sm font-semibold text-slate-500 hover:text-[var(--aionsi-navy)] hover:underline">View public source →</a>}
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        </Container>
      </Section>
    ))}

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 md:py-16">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <TechnicalLabel>Engineering Engagement</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-4xl">Have an engineering bottleneck?</h2>
            <p class="mt-4 max-w-2xl text-lg leading-8 text-white/70">Bring the verification, physical implementation or closure problem. We can map the requirement to the appropriate AionSi engineering model.</p>
          </div>
          <Button href="/contact">Discuss Your Engineering Requirement</Button>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
