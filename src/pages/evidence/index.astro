---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { technologyEvidence } from '../../data/technologyEvidence';

const representativeEvidence = [
  {
    number: '07',
    title: 'Tarang SoC Engineering Experience',
    summary: 'Representative SoC engineering evidence spanning RISC-V, PCIe Gen6, DDR4 / LPDDR4, HBM, USB3, Ethernet, security, FPGA prototyping and embedded software.',
    detailHref: '/evidence/tarang-soc-engineering-experience',
    label: 'REPRESENTATIVE SOC EXPERIENCE',
  },
  {
    number: '08',
    title: 'OpenTitan Cryptography & Secure SoC Integration',
    summary: 'Technical reference covering OpenTitan Darjeeling-based secure SoC integration, Earl Grey context, hardware cryptography, security lifecycle and security-focused verification.',
    detailHref: '/evidence/opentitan-cryptography-secure-soc',
    label: 'SECURE SOC EXPERIENCE',
  },
];
---
<BaseLayout title="Engineering Evidence | AionSi" description="AionSi engineering evidence across semiconductor design, verification, IP, protocols, memory, compute, secure SoC integration and representative engineering experience.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-deep-navy)] py-16 text-white md:py-24">
      <Container>
        <TechnicalLabel>ENGINEERING EVIDENCE</TechnicalLabel>
        <h1 class="mt-4 max-w-5xl text-5xl font-semibold tracking-tight md:text-7xl">Evidence behind the engineering proposition.</h1>
        <p class="mt-6 max-w-3xl text-xl leading-9 text-white/70 md:text-2xl">A structured view of AionSi technical references across IP, protocols, memory, compute, verification and representative SoC engineering experience.</p>
      </Container>
    </Section>
    <Section>
      <Container>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {technologyEvidence.map((item) => (
            <a href={item.detailHref} class="group border border-slate-200 bg-white p-7 transition hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)]">
              <span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{item.number}</span>
              <h2 class="mt-4 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{item.title}</h2>
              <p class="mt-3 text-sm leading-7 text-slate-600">{item.summary}</p>
              <span class="mt-6 inline-block text-sm font-semibold text-[var(--aionsi-navy)] group-hover:text-[var(--aionsi-blue)]">View evidence →</span>
            </a>
          ))}
          {representativeEvidence.map((item) => (
            <a href={item.detailHref} class="group border border-slate-200 bg-white p-7 transition hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)]">
              <span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{item.number}</span>
              <div class="mt-3 text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">{item.label}</div>
              <h2 class="mt-3 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{item.title}</h2>
              <p class="mt-3 text-sm leading-7 text-slate-600">{item.summary}</p>
              <span class="mt-6 inline-block text-sm font-semibold text-[var(--aionsi-navy)] group-hover:text-[var(--aionsi-blue)]">View evidence →</span>
            </a>
          ))}
        </div>
      </Container>
    </Section>
    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-16"><Container><TechnicalLabel>CONNECT THE EVIDENCE</TechnicalLabel><div class="mt-5 grid gap-4 md:grid-cols-3"><a href="/capabilities/design-verification" class="border border-slate-200 bg-white p-6 transition hover:border-[var(--aionsi-blue)]"><h2 class="text-lg font-semibold text-[var(--aionsi-navy)]">Design Verification</h2><p class="mt-2 text-sm leading-6 text-slate-600">Map verification evidence to UVM, subsystem and SoC engineering capability.</p></a><a href="/capabilities/protocol-verification" class="border border-slate-200 bg-white p-6 transition hover:border-[var(--aionsi-blue)]"><h2 class="text-lg font-semibold text-[var(--aionsi-navy)]">Protocol Verification</h2><p class="mt-2 text-sm leading-6 text-slate-600">Explore protocol-focused engineering across PCIe, DDR, USB and related interfaces.</p></a><a href="/experience" class="border border-slate-200 bg-white p-6 transition hover:border-[var(--aionsi-blue)]"><h2 class="text-lg font-semibold text-[var(--aionsi-navy)]">Representative Experience</h2><p class="mt-2 text-sm leading-6 text-slate-600">Review representative workstreams alongside the supporting evidence.</p></a></div><div class="mt-10"><TechnicalLabel>TECHNICAL SEARCH PATHS</TechnicalLabel><div class="mt-5 grid gap-4 md:grid-cols-3"><a href="/evidence/hbm2e-hbm3-memory-controllers" class="border border-slate-200 bg-white p-6 transition hover:border-[var(--aionsi-blue)]"><h3 class="text-lg font-semibold text-[var(--aionsi-navy)]">HBM2e / HBM3 Memory Controllers</h3><p class="mt-2 text-sm leading-6 text-slate-600">Explore memory-controller engineering for AI, GPU and HPC systems.</p></a><a href="/evidence/ddr4-ddr5-memory-controllers" class="border border-slate-200 bg-white p-6 transition hover:border-[var(--aionsi-blue)]"><h3 class="text-lg font-semibold text-[var(--aionsi-navy)]">DDR4 / DDR5 Memory Controllers</h3><p class="mt-2 text-sm leading-6 text-slate-600">Explore scheduling, refresh, ECC/RAS, timing and SoC integration.</p></a><a href="/evidence/pcie-gen6-data-link-layer" class="border border-slate-200 bg-white p-6 transition hover:border-[var(--aionsi-blue)]"><h3 class="text-lg font-semibold text-[var(--aionsi-navy)]">PCIe Gen6 Data Link Layer</h3><p class="mt-2 text-sm leading-6 text-slate-600">Explore link training, flow control, error recovery and protocol verification.</p></a></div></div></Container></Section>
    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container class="text-center">
        <TechnicalLabel>FROM EVIDENCE TO ENGINEERING</TechnicalLabel>
        <h2 class="mx-auto mt-3 max-w-4xl text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Have a requirement that is not represented here?</h2>
        <p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-slate-600">Share the IP, subsystem, verification or SoC requirement and AionSi can map the appropriate engineering scope.</p>
        <div class="mt-8"><Button href="/contact">Discuss a Requirement</Button></div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
