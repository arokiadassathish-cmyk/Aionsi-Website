---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
---
<BaseLayout title="Representative Physical Design Engineering Experience | AionSi" description="Profile-derived Physical Design engineering evidence spanning advanced-node implementation, timing closure, congestion optimization, physical verification and sign-off.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-16 lg:py-20">
      <Container>
        <div class="max-w-5xl">
          <div class="flex flex-wrap items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]"><span>PHYSICAL DESIGN</span><span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span><span>REPRESENTATIVE ENGINEERING EXPERIENCE</span></div>
          <h1 class="mt-6 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Physical Design evidence from advanced-node engineering profiles.</h1>
          <p class="mt-5 max-w-4xl text-xl leading-9 text-slate-600 md:text-2xl">A profile-derived view of Physical Design implementation, STA, physical verification, congestion optimization and sign-off experience across complex ASIC and SoC programs.</p>
          <div class="mt-7 border-l-2 border-[var(--aionsi-orange)] bg-white px-5 py-4 text-sm leading-7 text-slate-600 shadow-sm"><strong class="text-[var(--aionsi-navy)]">Publication note:</strong> This page summarizes engineering profiles supplied to AionSi. Client names and program details reflect the profiles' reported experience and <strong class="text-[var(--aionsi-navy)]">do not imply that those organizations are AionSi customers</strong>.</div>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {[['27+','combined years','13+ and 14.1 years in the supplied profiles'],['3nm–28nm','advanced-node range','Janardhan profile explicitly lists 3nm through 28nm'],['PNR → GDS','implementation ownership','Floorplan, placement, CTS, routing and closure'],['STA + PV','sign-off depth','PrimeTime/Tempus, Calibre/ICV and ECO closure']].map(([value,title,description]) => <div class="border border-slate-200 bg-white p-6 shadow-sm"><div class="text-3xl font-semibold text-[var(--aionsi-blue)]">{value}</div><h2 class="mt-2 font-semibold text-[var(--aionsi-navy)]">{title}</h2><p class="mt-2 text-sm leading-6 text-slate-600">{description}</p></div>)}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-12 text-white md:py-16">
      <Container>
        <TechnicalLabel>Profile 01 — Janardhan Reddy V</TechnicalLabel>
        <div class="mt-3 grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div><h2 class="text-3xl font-semibold tracking-tight md:text-4xl">13+ years of Physical Design Implementation.</h2><p class="mt-4 text-base leading-7 text-white/70">The profile describes senior-lead experience across Physical Design Implementation, STA and physical verification, with industry-standard Synopsys, Cadence and Calibre/ICV flows.</p></div>
          <div class="grid gap-3 sm:grid-cols-2">
            {['3nm / 5nm / 7nm / 10nm / 14nm / 16nm / 28nm experience','Fusion Compiler, ICC2, Innovus, Design Compiler','PrimeTime, Tweaker, Star-RC, Calibre and ICV','Floorplanning, placement, CTS, routing and sign-off','Congestion analysis and timing/design-violation fixing','DRC/LVS analysis, ECOs and physical-verification closure'].map((item) => <div class="border border-white/10 bg-white/5 p-4 text-sm leading-6 text-white/80">{item}</div>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-6 lg:grid-cols-2">
          <div class="border border-slate-200 bg-white p-7 shadow-sm md:p-8">
            <TechnicalLabel>AMD — profile-reported examples</TechnicalLabel>
            <div class="mt-5 space-y-4">
              {[
                ['3nm high-complexity block','352 macros / 8M cells / 2.4GHz; floorplan, placement, CTS, route, timing, congestion and sign-off using Fusion Compiler and PrimeTime.'],
                ['3nm high-complexity block','97 macros / 2.3M cells / 2.4GHz; same implementation and sign-off ownership described in the profile.'],
                ['7nm high-complexity block','67 macros / 2.3M cells / 1.8GHz; Fusion Compiler, PrimeTime and Calibre through implementation and sign-off.'],
              ].map(([title,desc]) => <div class="border-l-2 border-[var(--aionsi-blue)] pl-4"><h3 class="font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-1 text-sm leading-6 text-slate-600">{desc}</p></div>)}
            </div>
          </div>
          <div class="border border-slate-200 bg-white p-7 shadow-sm md:p-8">
            <TechnicalLabel>Intel / Qualcomm — profile-reported examples</TechnicalLabel>
            <div class="mt-5 space-y-4">
              {[
                ['Intel 10nm','430 macros / 3.6M cells / 3.2GHz; ICC2, Design Compiler, PrimeTime and ICV.'],
                ['Intel 7nm','78 macros / 4.1M cells / 1.2GHz and another 7nm project with 64 macros / 1.2GHz; implementation and sign-off ownership.'],
                ['Qualcomm 10nm','Two block-level designs with floorplan, placement, CTS, routing, timing and congestion closure.'],
                ['Qualcomm 28nm','STA ownership, full-chip-to-block ECO generation, PnR/sign-off timing correlation and additional APR/sign-off work.'],
              ].map(([title,desc]) => <div class="border-l-2 border-[var(--aionsi-orange)] pl-4"><h3 class="font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-1 text-sm leading-6 text-slate-600">{desc}</p></div>)}
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-14 lg:py-16">
      <Container>
        <TechnicalLabel>Profile 02 — Ramesh K</TechnicalLabel>
        <div class="mt-3 grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div><h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">14.1 years across PD, STA, PV and backend methodology.</h2><p class="mt-4 text-lg leading-8 text-slate-600">The profile spans 4nm, 5nm, 6nm, 7LP, 14LPP, 22nm, 28nm and 180nm programs across TSMC, Samsung, GlobalFoundries, UMC and TowerJazz.</p></div>
          <div class="grid gap-3 sm:grid-cols-2">
            {['Complete subsystem/block ownership from synthesis to GDS','Advanced timing, DMSA/Tweaker ECO and dynamic timing analysis','Custom DRC/LVS rule checks using Calibre SVRF/TVF','Hierarchical implementation, partitioning, bus planning and budgeting','IO/bump planning, RDL routing and multi-voltage flows','TCL, Perl, Python, Shell, AWK, SED and methodology automation'].map((item) => <div class="border border-slate-200 bg-white p-4 text-sm leading-6 text-slate-600">{item}</div>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-6 lg:grid-cols-3">
          {[
            ['AMD — TSMC N3E','AIGC RPT IP, 24 tiles, 2GHz','Lead ownership; custom SHQBIT feedthrough planning, dynamic mesh root-buffer insertion, double-pump support, constraints/budget closure, CAD/flow closure and tile sign-off; team of 12.'],
            ['AMD — TSMC 5nm','ISP subsystem, 14 tiles, 1.2GHz','Floorplan-to-GDS ownership; timing-exception and uncertainty feedback, STA/PhyV/Formality/VSI sign-off and SAIF-based PNR methodology for dynamic power.'],
            ['Tenstorrent — Samsung SF4','GPU subsystem blocks, 2.6GHz','Ownership from synthesis to GDS for Shared-Cache-L2 Cluster, PMSS, IOMMU, SS, NW and debug blocks; custom pipeline planning, multi-point CTS and sign-off closure.'],
            ['Micron — TSMC 5nm/6nm','CXL / PCIe / DDR / Cache tiles','Technical lead for critical tiles; flow setup, timing closure, Cerebrus AI-ML PNR setup, full-chip STA and latency/skew optimization.'],
            ['Micron — methodology','6nm/7nm backend flows','Single-handed flow development covering PNR, STA, DRC/LVS/ANT, LEC, EMIR and functional ECO automation.'],
            ['Standard-cell automation','GF7LP / GF14LPP / GF22FDX','Library layout automation, PV/QA, extraction and EMIR; a C++ standard-cell generation tool for 750 unique cells was presented at DAC according to the profile.'],
          ].map(([title,scope,desc]) => <div class="border border-slate-200 bg-white p-6 shadow-sm"><div class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">PROFILE EVIDENCE</div><h3 class="mt-3 text-lg font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm font-semibold text-slate-700">{scope}</p><p class="mt-3 text-sm leading-6 text-slate-600">{desc}</p></div>)}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
          <div><TechnicalLabel>Evidence Map</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Where this evidence is commercially useful.</h2><p class="mt-4 text-lg leading-8 text-slate-600">The profiles provide credible technical anchors for customer conversations around implementation bottlenecks, advanced-node closure and specialist engineering capacity.</p></div>
          <div class="grid gap-3 sm:grid-cols-2">
            {[
              ['Advanced-node PNR','Floorplan → placement → CTS → route → timing/physical sign-off'],
              ['Timing closure','Setup/hold, uncertainty, skew/latency, ECO and partition/interface correlation'],
              ['Congestion optimization','Blockages, cell padding, density screens, feedthrough planning and routing-resource analysis'],
              ['Physical verification','DRC, LVS, antenna/DFM-related checks, extraction and sign-off closure'],
              ['Power / PPA','Power-domain planning, IR/EM work, SAIF-based optimization and library selection'],
              ['Engineering ODC','Specialist ownership, managed workstreams, methodology/CAD and team leadership'],
            ].map(([title,desc]) => <div class="border border-slate-200 bg-white p-5"><h3 class="font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></div>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-14 lg:py-16">
      <Container>
        <div class="border border-slate-200 bg-white p-7 shadow-sm md:p-9">
          <TechnicalLabel>How AionSi should use this evidence</TechnicalLabel>
          <div class="mt-5 grid gap-5 md:grid-cols-3">
            <div><h3 class="font-semibold text-[var(--aionsi-navy)]">1. Qualification</h3><p class="mt-2 text-sm leading-6 text-slate-600">Use the evidence to demonstrate that a defined PD bottleneck can be mapped to experienced engineering ownership.</p></div>
            <div><h3 class="font-semibold text-[var(--aionsi-navy)]">2. Pilot</h3><p class="mt-2 text-sm leading-6 text-slate-600">Start with a bounded block, timing/congestion problem or sign-off package with explicit acceptance criteria.</p></div>
            <div><h3 class="font-semibold text-[var(--aionsi-navy)]">3. Scale</h3><p class="mt-2 text-sm leading-6 text-slate-600">Expand proven execution into specialist pods, managed workstreams or a dedicated Physical Design ODC.</p></div>
          </div>
          <div class="mt-7"><Button href="/contact">Discuss a Physical Design Workstream</Button></div>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
