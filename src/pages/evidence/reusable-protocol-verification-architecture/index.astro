---
import { getEvidenceDetail } from '../../../data/evidence';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/global/Header.astro';
import Footer from '../../../components/global/Footer.astro';
import Container from '../../../components/global/Container.astro';
import Section from '../../../components/global/Section.astro';
import TechnicalLabel from '../../../components/global/TechnicalLabel.astro';
import Button from '../../../components/global/Button.astro';

const detail = getEvidenceDetail('reusable-protocol-verification-architecture');
if (!detail) throw new Error('Evidence detail not found.');
---
<BaseLayout title={`${detail.title} | AionSi`} description={detail.positioning}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-16 lg:py-20">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[1.05fr_.95fr] lg:items-center">
          <div>
            <div class="flex flex-wrap items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]">
              <span>05</span><span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span><span>ENGINEERING EVIDENCE</span><span class="border border-slate-200 bg-white px-3 py-2 uppercase tracking-[.14em] text-slate-500">{detail.type}</span>
            </div>
            <h1 class="mt-5 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-6xl">{detail.title}</h1>
            <p class="mt-5 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">{detail.positioning}</p>
            <div class="mt-6 flex flex-wrap gap-3"><span class="border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700">Revision {detail.revision}</span><span class="border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700">{detail.classification}</span></div>
          </div>
          <aside class="border border-slate-200 bg-white p-6 shadow-sm"><TechnicalLabel>Architecture</TechnicalLabel><div class="mt-4 space-y-1">{detail.architecture.map((item, index) => <div class="flex items-center gap-3 border-b border-slate-100 py-2.5 last:border-b-0"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-blue-200 text-xs font-semibold text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><span class="text-sm font-medium leading-6 text-[var(--aionsi-navy)]">{item}</span></div>)}</div></aside>
        </div>
      </Container>
    </Section>

    <Section class="py-10 md:py-12 lg:py-14">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div><TechnicalLabel>Engineering Context</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Protocol-aware reuse across interface programs.</h2></div>
          <div class="grid gap-4 md:grid-cols-2"><div class="border-l-2 border-[var(--aionsi-orange)] pl-5 text-lg leading-8 text-slate-600"><p>{detail.context[0]}</p></div><div class="border-l-2 border-[var(--aionsi-blue)]/30 pl-5 text-lg leading-8 text-slate-600"><p>{detail.context[1]}</p></div></div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 md:py-16 lg:py-20 text-white">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.4fr_1.6fr] lg:items-center">
          <div><TechnicalLabel>Technical Architecture</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">Reusable protocol verification architecture.</h2><p class="mt-4 text-lg leading-8 text-white/70">A reference architecture connecting UVM tests, virtual sequencing, reusable protocol agents, DUT interaction, scoreboarding, prediction, coverage, assertions and reporting.</p></div>
          <figure class="overflow-hidden border border-white/15 bg-white p-6 shadow-2xl shadow-black/10"><div class="grid gap-3 sm:grid-cols-5">{['UVM Test','Virtual Sequencer','Protocol Agents','DUT','Scoreboard / Predictor','Coverage + SVA','Reporting'].map((item,index)=><div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5 text-center text-sm font-semibold text-[var(--aionsi-navy)]"><span class="block text-[10px] tracking-[.16em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><span class="mt-2 block">{item}</span></div>)}</div><figcaption class="mt-5 text-xs leading-5 text-slate-500">Reference methodology based on approved AionSi engineering architecture material.</figcaption></figure>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-10 md:py-12 lg:py-14">
      <Container>
        <div class="grid gap-8 lg:grid-cols-2">
          <div class="border border-slate-200 bg-white p-7 shadow-sm md:p-8"><TechnicalLabel>Verification Methodology</TechnicalLabel><div class="mt-6 flex flex-wrap items-center gap-2 text-xs font-semibold text-[var(--aionsi-navy)]">{['Plan','Model','Stimulate','Monitor','Check','Measure','Close'].map((stage,index)=><div class="flex items-center gap-2"><div class="border border-blue-200 bg-[var(--aionsi-surface-alt)] px-3 py-2">{String(index+1).padStart(2,'0')} {stage}</div>{index<6&&<span class="text-slate-300">→</span>}</div>)}</div><div class="mt-6 grid gap-3 sm:grid-cols-2">{detail.methodology.map((item)=><div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-4 text-sm font-medium leading-6 text-[var(--aionsi-navy)]">{item}</div>)}</div></div>
          <div class="border border-slate-200 bg-white p-7 shadow-sm md:p-8"><TechnicalLabel>Reusable Verification Assets</TechnicalLabel><div class="mt-6 grid gap-3 sm:grid-cols-2">{detail.components.map((item)=><div class="border border-slate-200 p-5 text-sm font-medium text-[var(--aionsi-navy)]">{item}</div>)}</div></div>
        </div>
      </Container>
    </Section>

    <Section class="py-10 md:py-12 lg:py-14">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div><TechnicalLabel>Technology Evidence</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Protocols supported by the AionSi portfolio.</h2><p class="mt-4 text-slate-600">Approved corporate material identifies high-speed interface and memory verification across PCIe, USB, DDR/LPDDR, HBM, AMBA and adjacent interfaces.</p></div><div class="grid gap-3 sm:grid-cols-2">{[['PCIe 5/6','Protocol and data-link verification'],['USB 3.0 / USB4','Packet, link, recovery and compliance scenarios'],['DDR5 / LPDDR6','Timing, command sequencing and DFI/protocol verification'],['HBM4e','Multi-channel interface, training, calibration and reliability'],['AMBA / AXI','Reusable master/slave verification environments'],['UFS / MIPI / Ethernet','Broader high-speed interface capability portfolio']].map(([title,desc])=><div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></div>)}</div></div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-10 md:py-12 lg:py-14"><Container><div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div><TechnicalLabel>Evidence Notes</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">How the evidence is used.</h2></div><div class="space-y-3">{detail.evidenceNotes.map((note)=><div class="border border-slate-200 bg-white p-6 text-sm leading-7 text-slate-600">{note}</div>)}</div></div></Container></Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-16 md:py-20 text-white"><Container class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center"><div><TechnicalLabel>Engineering Engagement</TechnicalLabel><h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Need a protocol verification workstream?</h2><p class="mt-4 max-w-2xl text-lg leading-8 text-white/70">Bring the interface, protocol, subsystem or SoC verification requirement. We can connect it to the appropriate AionSi engineering team.</p></div><Button href="/contact">Discuss Your Verification Program</Button></Container></Section>
  </main>
  <Footer />
</BaseLayout>
