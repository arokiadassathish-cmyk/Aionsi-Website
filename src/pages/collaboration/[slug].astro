---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import { outreachLandingPages } from '../../data/outreachLandingPages';

export const prerender = true;

export function getStaticPaths() {
  return outreachLandingPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
---
<BaseLayout
  title={`${page.company} × AionSi | Engineering Collaboration`}
  description={`${page.headline} A focused AionSi engineering collaboration path for ${page.company}.`}
  robots="noindex,nofollow,noarchive"
>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-16 lg:py-24">
      <Container>
        <div class="grid gap-12 lg:grid-cols-[1.15fr_.85fr] lg:items-end">
          <div>
            <TechnicalLabel>{page.eyebrow}</TechnicalLabel>
            <div class="mt-5 text-sm font-semibold uppercase tracking-[.16em] text-slate-400">{page.company} · {page.region}</div>
            <h1 class="mt-4 max-w-5xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">{page.headline}</h1>
            <p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">{page.intro}</p>
          </div>
          <div class="border border-slate-200 bg-white p-7 lg:p-8">
            <TechnicalLabel>WHY THIS PAGE</TechnicalLabel>
            <p class="mt-4 text-base leading-8 text-slate-600">This page keeps the conversation focused on the engineering area relevant to {page.company}, rather than a broad services overview.</p>
          </div>
        </div>
      </Container>
    </Section>

    <Section>
      <Container class="grid gap-10 lg:grid-cols-[.72fr_1.28fr]">
        <div>
          <TechnicalLabel>CAPABILITY MATCH</TechnicalLabel>
          <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Where the engineering fit may be.</h2>
        </div>
        <div>
          <p class="text-lg leading-8 text-slate-600">{page.relevance}</p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {page.capabilities.map((capability, index) => (
              <div class="border border-slate-200 bg-white p-7">
                <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">0{index + 1}</div>
                <h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">{capability.title}</h3>
                <p class="mt-3 text-sm leading-7 text-slate-600">{capability.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr]">
          <div>
            <TechnicalLabel>PILOT</TechnicalLabel>
            <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">{page.pilot.title}</h2>
          </div>
          <div>
            <p class="max-w-3xl text-lg leading-8 text-slate-600">{page.pilot.detail}</p>
            <div class="mt-8 grid gap-3 md:grid-cols-2">
              {page.pilot.scope.map((item, index) => (
                <div class="flex gap-4 border border-slate-200 bg-white p-5">
                  <span class="text-sm font-semibold text-[var(--aionsi-blue)]">0{index + 1}</span>
                  <span class="text-sm font-semibold leading-6 text-[var(--aionsi-navy)]">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section>
      <Container class="grid gap-10 lg:grid-cols-[.72fr_1.28fr]">
        <div>
          <TechnicalLabel>ENGAGEMENT MODEL</TechnicalLabel>
          <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Start small. Scale with the program.</h2>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {page.engagementModel.map((model, index) => (
            <div class="border border-slate-200 p-6">
              <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">0{index + 1}</div>
              <p class="mt-4 font-semibold leading-6 text-[var(--aionsi-navy)]">{model}</p>
            </div>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>TECHNICAL EVIDENCE</TechnicalLabel>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {page.evidence.map((item) => (
            <a href={item.href} class="border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]">
              <h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-600">{item.detail}</p>
              <span class="mt-6 inline-flex text-sm font-semibold text-[var(--aionsi-blue)]">Review →</span>
            </a>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white">
      <Container>
        <div class="mx-auto max-w-4xl text-center">
          <TechnicalLabel>{page.meetingLabel}</TechnicalLabel>
          <h2 class="mt-4 text-4xl font-semibold tracking-tight md:text-6xl">A short engineering conversation first.</h2>
          <p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">{page.meetingDetail}</p>
          <div class="mt-9 flex flex-wrap justify-center gap-3">
            <a href="/contact" class="inline-flex rounded-full bg-[var(--aionsi-orange)] px-6 py-3.5 text-sm font-semibold text-white">Discuss the requirement →</a>
            <a href="/capabilities" class="inline-flex rounded-full border border-white/20 px-6 py-3.5 text-sm font-semibold text-white">View AionSi capabilities</a>
          </div>
        </div>
        <p class="mx-auto mt-12 max-w-4xl border-t border-white/10 pt-6 text-xs leading-6 text-white/50">{page.disclosure}</p>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
