---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { industries } from '../../data/industries';
---
<BaseLayout title="Industries | AionSi" description="Semiconductor engineering across semiconductor, AI and HPC, automotive semiconductor, and networking and connectivity programs.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-16 lg:py-20">
      <Container>
        <TechnicalLabel>INDUSTRY ENGINEERING</TechnicalLabel>
        <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-end">
          <div><h1 class="text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Engineering depth where silicon programs get complex.</h1><p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">AionSi connects semiconductor engineering capabilities, technology depth and delivery models to the specific challenges of complex silicon programs.</p></div>
          <div class="border border-slate-200 bg-white p-7"><TechnicalLabel>CUSTOMER PATH</TechnicalLabel><div class="mt-5 text-sm uppercase tracking-[.14em] text-slate-500">Challenge → Capability → Evidence → Engagement</div><p class="mt-4 text-base leading-7 text-[var(--aionsi-navy)]">Start with the engineering problem. We map it to the appropriate AionSi capability and delivery model.</p></div>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-16 lg:py-20"><Container><TechnicalLabel>INDUSTRIES</TechnicalLabel><div class="mt-8 grid gap-5 md:grid-cols-2">{industries.map((industry) => <article class="border border-slate-200 bg-white p-8"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{industry.number}</div><h2 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{industry.title}</h2><p class="mt-4 text-base leading-7 text-slate-600">{industry.summary}</p><div class="mt-7"><div class="text-xs font-semibold tracking-[.16em] text-slate-400">CUSTOMER CHALLENGES</div><ul class="mt-4 grid gap-2 sm:grid-cols-2">{industry.challenges.map((item) => <li class="border-l-2 border-[var(--aionsi-orange)] pl-3 text-sm leading-6 text-slate-600">{item}</li>)}</ul></div><a href={`/industries/${industry.slug}`} class="mt-8 inline-flex text-sm font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">Explore Industry →</a></article>)}</div></Container></Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-16"><Container class="grid gap-8 lg:grid-cols-[.8fr_1.2fr]"><div><TechnicalLabel>ENGINEERING RESPONSE</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">From industry pressure to engineering ownership.</h2><p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">AionSi connects industry-specific problems to technical capabilities, representative engineering experience and an appropriate delivery model.</p></div><div class="grid gap-4 sm:grid-cols-2"><div class="border border-slate-200 bg-white p-6"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">01</div><div class="mt-3 font-semibold text-[var(--aionsi-navy)]">Engineering capability</div><p class="mt-2 text-sm leading-6 text-slate-600">Map the bottleneck to the right technical discipline.</p></div><div class="border border-slate-200 bg-white p-6"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">02</div><div class="mt-3 font-semibold text-[var(--aionsi-navy)]">Representative evidence</div><p class="mt-2 text-sm leading-6 text-slate-600">Review approved examples of engineering scope and methodology.</p></div><div class="border border-slate-200 bg-white p-6"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">03</div><div class="mt-3 font-semibold text-[var(--aionsi-navy)]">Delivery model</div><p class="mt-2 text-sm leading-6 text-slate-600">Choose specialist, project, dedicated or ODC ownership.</p></div><div class="border border-slate-200 bg-white p-6"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">04</div><div class="mt-3 font-semibold text-[var(--aionsi-navy)]">Engineering discovery</div><p class="mt-2 text-sm leading-6 text-slate-600">Translate the program need into a defined next step.</p></div></div></Container></Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-12 text-white md:py-16"><Container class="text-center"><TechnicalLabel>ENGINEERING CONVERSATION</TechnicalLabel><h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Have an industry-specific silicon challenge?</h2><p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Bring the program context, engineering bottleneck or capacity requirement. We will connect it to the relevant AionSi engineering model.</p><div class="mt-9"><Button href="/contact">Discuss Your Engineering Requirement</Button></div></Container></Section>
  </main>
  <Footer />
</BaseLayout>
