---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';

const strengths = [
  ['01','Design Verification','UVM / SystemVerilog, assertions, functional coverage, regression automation, IP/subsystem/SoC verification and debug.'],
  ['02','RTL & SoC Engineering','Complex digital RTL, IP development, subsystem integration, timing-aware design and verification-driven handoff.'],
  ['03','Physical Design','Floorplanning, synthesis, placement & routing, timing closure and implementation execution.'],
  ['04','STA & Synthesis','Logic synthesis, MCMM timing analysis, timing-driven optimization and closure support across RTL and implementation.'],
  ['05','DFT','Scan/ATPG-oriented DFT execution, coverage analysis, test timing and silicon-readiness support.'],
  ['06','Analog / AMS','Analog layout and AMS verification capability for mixed-signal workstreams where the scope is clearly defined.'],
];

const fit = [
  ['RTL / SoC','Strong','RTL implementation, IP integration and subsystem execution.'],
  ['Functional Verification','Strong','UVM/SystemVerilog, coverage, regression, debug and IP-to-SoC verification.'],
  ['Physical Design','Strong','Synthesis, P&R, timing closure and signoff-oriented execution.'],
  ['DFT / DFX','Strong','DFT implementation and verification support around defined work packages.'],
  ['STA / Synthesis','Strong','Timing analysis, synthesis and closure support.'],
  ['Analog / AMS','Targeted','Analog layout and AMS verification where requirements align with AionSi capability.'],
  ['Post-Silicon','Selective','Potential validation/debug support; scope should be confirmed against the specific program.'],
];

const evidence = [
  ['DV','IoT SoC Verification','Representative SoC-level verification experience.'],
  ['PD','Advanced SoC Physical Design','Representative high-complexity physical implementation experience.'],
  ['PD','Physical Design Turnkey Project','Defined-scope physical design delivery experience.'],
  ['DV','Subsystem Verification + MATLAB','Subsystem verification with integration/analysis workflow.'],
  ['Analog','Turnkey Analog Front-End','Representative analog front-end layout/design experience.'],
];

const delivery = [
  ['01','Scope','Understand the block, subsystem, program stage, tools, interfaces and milestone.'],
  ['02','Define','Agree deliverables, ownership boundaries, team composition and acceptance criteria.'],
  ['03','Execute','Run the work package with engineering reviews, quality gates and milestone cadence.'],
  ['04','Validate','Review outcomes, close gaps and decide whether the scope should expand.'],
];

const engagement = [
  ['Project Engineering','Defined work package','AionSi owns agreed scope, milestones and deliverables.'],
  ['Extended Engineering','Specialist capacity','AionSi engineers work as an extension of the Infinecs organization.'],
  ['Dedicated Team','Recurring workstream','A dedicated team aligned to a longer-running technical roadmap.'],
  ['Engineering ODC','Scaled capacity','A governed engineering organization when the model is proven.'],
];
---

<BaseLayout
  title="Infinecs × AionSi | Semiconductor Engineering Alignment"
  description="AionSi's strongest engineering alignment with Infinecs across Design Verification, RTL/SoC, Physical Design, STA/Synthesis, DFT and targeted Analog/AMS workstreams."
>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-20 lg:py-24">
      <Container>
        <div class="grid gap-12 lg:grid-cols-[1.12fr_.68fr] lg:items-center">
          <div>
            <TechnicalLabel>INFINECS × AIONSI · ENGINEERING ALIGNMENT</TechnicalLabel>
            <h1 class="mt-4 max-w-5xl text-5xl font-semibold leading-[1.02] tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Extending silicon engineering capacity across critical workstreams.</h1>
            <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">AionSi complements Infinecs with focused semiconductor engineering execution across Design Verification, RTL/SoC, Physical Design, STA/Synthesis and DFT — with targeted Analog/AMS capability where the scope fits.</p>
            <div class="mt-9 flex flex-wrap gap-4">
              <Button href="/contact">Discuss an Engineering Requirement</Button>
              <a href="/capabilities" class="inline-flex items-center justify-center border border-slate-300 px-6 py-3 text-sm font-semibold text-[var(--aionsi-navy)] transition hover:border-[var(--aionsi-blue)]">Explore AionSi Capabilities</a>
            </div>
          </div>
          <div class="border border-slate-200 bg-white p-7 shadow-sm">
            <TechnicalLabel>THE FIT</TechnicalLabel>
            <h2 class="mt-4 text-2xl font-semibold text-[var(--aionsi-navy)]">Complement the existing engineering organization. Do not duplicate it.</h2>
            <p class="mt-4 text-base leading-7 text-slate-600">The strongest opportunity is a bounded technical workstream where additional execution capacity can be measured through deliverables and milestones.</p>
            <div class="mt-7 grid grid-cols-2 gap-3 text-sm font-semibold text-[var(--aionsi-navy)]">
              <div class="border border-slate-200 p-4">Technical scope</div>
              <div class="border border-slate-200 p-4">Clear ownership</div>
              <div class="border border-slate-200 p-4">Milestone delivery</div>
              <div class="border border-slate-200 p-4">Scale after proof</div>
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-18">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div>
            <TechnicalLabel>UNDERSTANDING INFINECS</TechnicalLabel>
            <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">A silicon-to-systems organization with broad internal engineering depth.</h2>
          </div>
          <div class="space-y-5 text-base leading-8 text-slate-600">
            <p>Infinecs publicly describes end-to-end engineering across IC, SoC, embedded software and system platforms, with work spanning architecture, RTL, verification, physical design, silicon validation and embedded software.</p>
            <p>Its published design-services scope includes RTL development and functional verification, IP integration, synthesis and timing optimization, physical design through GDSII, sign-off and tape-out support. Infinecs also describes post-silicon bring-up, characterization and failure analysis.</p>
            <p class="font-semibold text-[var(--aionsi-navy)]">That makes the relevant AionSi proposition specific: add execution capacity around selected semiconductor workstreams while Infinecs retains program, architecture and customer ownership.</p>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-white py-12 md:py-18">
      <Container>
        <TechnicalLabel>AIONSI'S STRONGEST ENGINEERING AREAS</TechnicalLabel>
        <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">These are the disciplines where AionSi has the clearest public capability evidence and where an Infinecs conversation can be technically specific.</p>
        <div class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {strengths.map(([num,title,desc]) => (
            <article class="border border-slate-200 p-7">
              <div class="text-xs tracking-[.18em] text-[var(--aionsi-orange)]">{num}</div>
              <h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-slate-600">{desc}</p>
            </article>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-18">
      <Container>
        <TechnicalLabel>INFINECS → AIONSI FIT MAP</TechnicalLabel>
        <div class="mt-6 overflow-hidden border border-slate-200 bg-white">
          <div class="grid grid-cols-[1fr_.7fr_1.6fr] border-b border-slate-200 bg-slate-50 px-5 py-4 text-xs font-semibold uppercase tracking-[.12em] text-slate-500">
            <div>Infinecs workstream</div><div>AionSi fit</div><div>Potential complement</div>
          </div>
          {fit.map(([area,level,desc]) => (
            <div class="grid grid-cols-[1fr_.7fr_1.6fr] gap-4 border-b border-slate-200 px-5 py-5 last:border-b-0">
              <div class="font-semibold text-[var(--aionsi-navy)]">{area}</div>
              <div class="text-sm font-semibold text-[var(--aionsi-orange)]">{level}</div>
              <div class="text-sm leading-6 text-slate-600">{desc}</div>
            </div>
          ))}
        </div>
        <p class="mt-4 text-xs leading-5 text-slate-500">Fit labels describe AionSi's current capability evidence, not an assumption about Infinecs' resource gaps or roadmap.</p>
      </Container>
    </Section>

    <Section class="py-12 md:py-18">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.68fr_1.32fr] lg:items-start">
          <div>
            <TechnicalLabel>REPRESENTATIVE EVIDENCE</TechnicalLabel>
            <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Show the engineering before proposing the engagement.</h2>
            <p class="mt-5 text-base leading-7 text-slate-600">AionSi's public portfolio includes representative verification, physical-design, subsystem and analog engineering examples that can anchor a technical discussion.</p>
          </div>
          <div class="grid gap-3">
            {evidence.map(([discipline,title,desc]) => (
              <div class="grid gap-4 border-b border-slate-200 py-5 md:grid-cols-[110px_1fr]">
                <div class="text-xs font-semibold tracking-[.14em] text-[var(--aionsi-orange)]">{discipline}</div>
                <div><h3 class="font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-1 text-sm leading-6 text-slate-600">{desc}</p></div>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-18">
      <Container>
        <TechnicalLabel>POTENTIAL FIRST WORK PACKAGE</TechnicalLabel>
        <h2 class="mt-4 max-w-5xl text-4xl font-semibold tracking-tight md:text-5xl">Start where an engineering milestone is measurable.</h2>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-white/70">Examples: IP/subsystem verification, SoC verification closure, RTL/IP integration, physical-design execution, STA/timing closure or DFT work. The exact scope should be defined jointly with the Infinecs engineering team.</p>
        <div class="mt-8 grid gap-3 md:grid-cols-4">
          <div class="border border-white/10 bg-white/5 p-5"><span class="text-xs tracking-[.18em] text-[var(--aionsi-orange)]">01</span><p class="mt-3 font-semibold">Requirement</p></div>
          <div class="border border-white/10 bg-white/5 p-5"><span class="text-xs tracking-[.18em] text-[var(--aionsi-orange)]">02</span><p class="mt-3 font-semibold">Work Package</p></div>
          <div class="border border-white/10 bg-white/5 p-5"><span class="text-xs tracking-[.18em] text-[var(--aionsi-orange)]">03</span><p class="mt-3 font-semibold">Milestone Delivery</p></div>
          <div class="border border-white/10 bg-white/5 p-5"><span class="text-xs tracking-[.18em] text-[var(--aionsi-orange)]">04</span><p class="mt-3 font-semibold">Review & Scale</p></div>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-18">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr]">
          <div>
            <TechnicalLabel>DELIVERY MODEL</TechnicalLabel>
            <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">A controlled path from requirement to engineering ownership.</h2>
          </div>
          <div class="grid gap-2">
            {delivery.map(([num,title,desc]) => (
              <div class="grid grid-cols-[64px_1fr] gap-5 border-b border-slate-200 py-5">
                <div class="text-sm font-semibold text-[var(--aionsi-orange)]">{num}</div>
                <div><h3 class="font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-1 text-sm leading-6 text-slate-600">{desc}</p></div>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-18">
      <Container>
        <TechnicalLabel>ENGAGEMENT OPTIONS</TechnicalLabel>
        <h2 class="mt-4 max-w-4xl text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Choose the operating model after the technical need is clear.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {engagement.map(([title,subtitle,desc]) => (
            <div class="border border-slate-200 bg-white p-6">
              <div class="text-xs tracking-[.16em] text-[var(--aionsi-orange)]">{subtitle}</div>
              <h3 class="mt-4 text-lg font-semibold text-[var(--aionsi-navy)]">{title}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p>
            </div>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-navy)] py-14 text-white md:py-20">
      <Container>
        <div class="max-w-4xl">
          <TechnicalLabel>INFINECS × AIONSI</TechnicalLabel>
          <h2 class="mt-4 text-4xl font-semibold tracking-tight md:text-5xl">Let’s identify one engineering workstream worth exploring together.</h2>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-300">Bring the program stage, technical bottleneck or capacity requirement. AionSi can map it to the relevant engineering discipline, evidence and delivery model.</p>
          <div class="mt-8 flex flex-wrap gap-4">
            <Button href="/contact">Discuss an Engineering Requirement</Button>
            <a href="mailto:info@aionsi.com" class="inline-flex items-center justify-center border border-slate-600 px-6 py-3 text-sm font-semibold text-white transition hover:border-white">Email AionSi</a>
          </div>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
