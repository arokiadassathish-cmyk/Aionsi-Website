---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Container from '../components/global/Container.astro';
import Section from '../components/global/Section.astro';
import TechnicalLabel from '../components/global/TechnicalLabel.astro';
import Button from '../components/global/Button.astro';
import EngineeringCard from '../components/capabilities/EngineeringCard.astro';
import EngineeringTrace from '../components/lifecycle/EngineeringTrace.astro';
import SiliconHero from '../components/hero/SiliconHero.astro';
import { capabilities } from '../data/capabilities';
---
<BaseLayout title="AionSi | Semiconductor Engineering from IP to Silicon" description="AionSi semiconductor engineering from IP to Silicon across RTL Design, Design Verification, Physical Design, DFT, Protocol Verification and SoC & IP Engineering.">
  <Header theme="dark" />
  <main>
    <SiliconHero />

    <Section>
      <Container>
        <TechnicalLabel>AionSi Engineering Lifecycle</TechnicalLabel>
        <div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
          <div>
            <h2 class="max-w-3xl text-4xl font-semibold tracking-tight md:text-5xl">From IP to Silicon.</h2>
            <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-600">Engineering expertise across the semiconductor development lifecycle.</p>
          </div>
          <p class="max-w-xl text-sm font-medium uppercase tracking-[.12em] text-slate-400 lg:justify-self-end">Explore each stage to see where AionSi engineering contributes.</p>
        </div>
        <div class="mt-10"><EngineeringTrace /></div>
        <div class="mt-10 flex flex-col gap-4 border-t border-slate-200 pt-7 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-base text-slate-600">Need engineering capacity at any stage of the silicon lifecycle?</p>
          <Button href="/contact" variant="technical">Talk to Our Engineering Team</Button>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>Engineering Capabilities</TechnicalLabel>
        <div class="mb-10 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <h2 class="max-w-3xl text-4xl font-semibold tracking-tight md:text-5xl">Engineering depth across the silicon lifecycle.</h2>
            <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">From RTL design through verification, physical implementation, DFT, protocol verification and SoC integration—AionSi engineering capabilities are built around complex silicon programs.</p>
          </div>
          <a href="/capabilities" class="group inline-flex items-center gap-2 pb-1 text-sm font-semibold text-[var(--aionsi-navy)]">Explore the full engineering portfolio <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span></a>
        </div>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {capabilities.map((capability) => (
            <EngineeringCard
              number={capability.number}
              title={capability.title}
              description={capability.description}
              technologies={capability.technologies?.join(' · ')}
              outcome={capability.outcome}
              href={`/capabilities/${capability.slug}`}
            />
          ))}
        </div>
      </Container>
    </Section>

    <Section>
      <Container>
        <TechnicalLabel>Representative Engineering Experience</TechnicalLabel>
        <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
          <div>
            <h2 class="max-w-3xl text-4xl font-semibold tracking-tight md:text-5xl">Engineering evidence before claims.</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Explore representative engineering experience and approved technical references across verification and physical implementation.</p>
          </div>
          <div class="grid gap-5 md:grid-cols-3">
            <a href="/evidence/physical-design-representative-engineering-experience" class="group border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]">
              <div class="text-[10px] font-semibold tracking-[.18em] text-[var(--aionsi-orange)]">CASE STUDY</div>
              <h3 class="mt-5 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">Representative Physical Design Experience</h3>
              <p class="mt-3 text-sm leading-6 text-slate-600">Advanced-node implementation experience spanning floorplanning, placement, CTS, routing, timing closure, physical verification and sign-off.</p>
              <div class="mt-7 text-sm font-semibold text-[var(--aionsi-navy)]">View engineering evidence →</div>
            </a>
            <a href="/evidence/reusable-uvm-verification-architecture" class="group border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]">
              <div class="text-[10px] font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">TECHNICAL REFERENCE</div>
              <h3 class="mt-5 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">Reusable UVM Verification Architecture</h3>
              <p class="mt-3 text-sm leading-6 text-slate-600">Reusable SystemVerilog/UVM architecture connecting stimulus, checking, coverage and regression workflows.</p>
              <div class="mt-7 text-sm font-semibold text-[var(--aionsi-navy)]">View engineering evidence →</div>
            </a>
            <a href="/evidence" class="group border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]">
              <div class="text-[10px] font-semibold tracking-[.18em] text-slate-400">EVIDENCE LIBRARY</div>
              <h3 class="mt-5 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">Explore the Engineering Evidence Library</h3>
              <p class="mt-3 text-sm leading-6 text-slate-600">Browse approved case studies, methodology references and engineering evidence across AionSi capabilities.</p>
              <div class="mt-7 text-sm font-semibold text-[var(--aionsi-navy)]">Explore evidence →</div>
            </a>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>Leadership &amp; Engineering Depth</TechnicalLabel>
        <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div>
            <h2 class="max-w-3xl text-4xl font-semibold tracking-tight md:text-5xl">Proof is carried by engineering depth.</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">The supplied leadership and engineering profiles show senior verification depth, technical leadership and hands-on delivery across IP, subsystem and SoC programs.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <article class="border border-slate-200 bg-white p-7">
              <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">LEADERSHIP</div>
              <h3 class="mt-5 text-xl font-semibold text-[var(--aionsi-navy)]">15+ years in ASIC verification</h3>
              <p class="mt-3 text-sm leading-6 text-slate-600">Jayaprakash Polimetla's profile describes 15+ years in ASIC verification, SoC/subsystem/IP verification, UVM/VMM, assertions, coverage closure and processor-based verification, alongside his role as CEO of AionSi.</p>
              <div class="mt-6 text-xs font-medium leading-5 text-slate-400">Profile source: Jayaprakash Polimetla, pp. 1–5</div>
            </article>
            <article class="border border-slate-200 bg-white p-7">
              <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">ARCHITECTURE</div>
              <h3 class="mt-5 text-xl font-semibold text-[var(--aionsi-navy)]">25+ years of verification leadership</h3>
              <p class="mt-3 text-sm leading-6 text-slate-600">Paul Kaunds' profile describes 25+ years across the ASIC flow, verification architecture, IP/subsystem/SoC delivery and leadership of teams, including PCIe Gen6 and AI-chip verification assignments.</p>
              <div class="mt-6 text-xs font-medium leading-5 text-slate-400">Profile source: Paul Kaunds, pp. 1–5</div>
            </article>
            <article class="border border-slate-200 bg-white p-7">
              <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">PROTOCOL</div>
              <h3 class="mt-5 text-xl font-semibold text-[var(--aionsi-navy)]">USB, PCIe and SoC verification</h3>
              <p class="mt-3 text-sm leading-6 text-slate-600">Bharath P's profile documents 12+ years in ASIC/FPGA verification, reusable layered USB 3.0 UVM VIP architecture, LTSSM verification, SoC integration and power-aware simulation.</p>
              <div class="mt-6 text-xs font-medium leading-5 text-slate-400">Profile source: Bharath P, pp. 1–5</div>
            </article>
            <article class="border border-slate-200 bg-white p-7">
              <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">SOC / CLOSURE</div>
              <h3 class="mt-5 text-xl font-semibold text-[var(--aionsi-navy)]">Coverage, formal and SoC closure</h3>
              <p class="mt-3 text-sm leading-6 text-slate-600">The supplied Selvakumar and Shailesh profiles add PCIe 5.0, AXI, USB, RISC-V, JasperGold, SoC-level verification, functional coverage and multi-site technical leadership examples.</p>
              <div class="mt-6 text-xs font-medium leading-5 text-slate-400">Profile sources: Selvakumar A and Shailesh Vasekar</div>
            </article>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white">
      <Container class="grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
        <div>
          <TechnicalLabel>Built Around Your Engineering Problem</TechnicalLabel>
          <h2 class="text-4xl font-semibold tracking-tight md:text-5xl">What are you trying to accelerate?</h2>
          <p class="mt-5 max-w-xl text-lg leading-8 text-white/70">Bring a verification, implementation or engineering-capacity challenge. We will connect it to the right AionSi capability.</p>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          <a href="/capabilities/design-verification" class="group border border-white/10 p-6 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-orange)]">01</div><h3 class="mt-8 text-xl font-semibold">Accelerate Verification</h3><p class="mt-3 text-sm leading-6 text-white/60">Extend verification capacity without losing engineering discipline.</p><span class="mt-8 inline-block text-sm font-semibold">Explore DV →</span></a>
          <a href="/solutions/dedicated-engineering" class="group border border-white/10 p-6 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-orange)]">02</div><h3 class="mt-8 text-xl font-semibold">Scale Engineering</h3><p class="mt-3 text-sm leading-6 text-white/60">Add specialized RTL, DV, PD, DFT and protocol engineering capacity.</p><span class="mt-8 inline-block text-sm font-semibold">Build a Team →</span></a>
          <a href="/solutions/odc" class="group border border-white/10 p-6 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-orange)]">03</div><h3 class="mt-8 text-xl font-semibold">Build an ODC</h3><p class="mt-3 text-sm leading-6 text-white/60">Create a dedicated engineering organization aligned to your program.</p><span class="mt-8 inline-block text-sm font-semibold">Explore ODC →</span></a>
        </div>
      </Container>
    </Section>

    <Section>
      <Container>
        <TechnicalLabel>Technology Depth</TechnicalLabel>
        <div class="grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-start">
          <div>
            <h2 class="text-4xl font-semibold tracking-tight md:text-5xl">Technology depth for complex silicon.</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Technology-specific expertise across high-speed protocols, memory subsystems, SoC integration and silicon engineering.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {['PCIe','USB','DDR / LPDDR','HBM','AMBA','RISC-V','AI Accelerators','Heterogeneous SoC'].map((item, index) => <a href="/technology" class="group flex items-center justify-between border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)]"><div><div class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">0{index + 1}</div><div class="mt-3 text-lg font-semibold">{item}</div></div><span class="text-slate-400 transition group-hover:translate-x-1 group-hover:text-[var(--aionsi-blue)]">→</span></a>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-navy)] text-white">
      <Container class="grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
        <div><TechnicalLabel>AIV</TechnicalLabel><h2 class="text-4xl font-semibold tracking-tight md:text-5xl">AI-Accelerated Verification.</h2><p class="mt-5 max-w-xl text-lg leading-8 text-white/70">Engineering productivity accelerated with human validation, security-conscious workflows and controlled deployment models.</p><div class="mt-8"><Button href="/solutions/aiv">Explore AIV</Button></div></div>
        <div class="relative border border-white/10 bg-white/[.025] p-8 sm:p-10"><div class="mx-auto flex max-w-md flex-col items-center gap-4 text-center"><div class="flex h-28 w-28 items-center justify-center border border-[var(--aionsi-orange)]/70 text-2xl font-semibold tracking-[.12em] text-[var(--aionsi-orange)]">AIV</div><div class="h-10 w-px bg-[var(--aionsi-blue)]"></div><div class="grid w-full gap-3 sm:grid-cols-3"><div class="border border-white/10 p-4 text-xs uppercase tracking-[.14em] text-white/65">AI Assisted</div><div class="border border-white/10 p-4 text-xs uppercase tracking-[.14em] text-white/65">Human Validated</div><div class="border border-white/10 p-4 text-xs uppercase tracking-[.14em] text-white/65">Secure</div></div></div></div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
        <div><TechnicalLabel>Engineering Teams</TechnicalLabel><h2 class="text-4xl font-semibold tracking-tight md:text-5xl">Scale your silicon engineering team.</h2><p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Dedicated engineering teams, extended engineering and project delivery models designed around semiconductor programs.</p><div class="mt-8"><Button href="/solutions/odc">Discuss an ODC</Button></div></div>
        <div class="grid gap-4 sm:grid-cols-2"><a href="/solutions/dedicated-engineering" class="border border-slate-200 bg-white p-7 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">01</div><h3 class="mt-5 text-2xl font-semibold">Dedicated Engineering</h3></a><a href="/solutions/extended-engineering" class="border border-slate-200 bg-white p-7 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">02</div><h3 class="mt-5 text-2xl font-semibold">Extended Engineering</h3></a><a href="/solutions/odc" class="border border-slate-200 bg-white p-7 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">03</div><h3 class="mt-5 text-2xl font-semibold">ODC</h3></a><a href="/solutions/project-engineering" class="border border-slate-200 bg-white p-7 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">04</div><h3 class="mt-5 text-2xl font-semibold">Project Engineering</h3></a></div>
      </Container>
    </Section>

    <Section>
      <Container>
        <TechnicalLabel>Engineering Delivery &amp; Trust</TechnicalLabel>
        <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div><h2 class="text-4xl font-semibold tracking-tight md:text-5xl">Built for engineering collaboration.</h2><p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">AionSi engagements are structured around defined scope, engineering ownership, controlled access and evidence-led delivery.</p></div><div class="grid gap-4 sm:grid-cols-2"><div class="border border-slate-200 bg-white p-7"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">01</div><h3 class="mt-5 text-xl font-semibold">Defined Engineering Scope</h3><p class="mt-3 text-sm leading-6 text-slate-600">Clear workstream ownership, milestones and engineering deliverables.</p></div><div class="border border-slate-200 bg-white p-7"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">02</div><h3 class="mt-5 text-xl font-semibold">Controlled Collaboration</h3><p class="mt-3 text-sm leading-6 text-slate-600">Customer-aligned workflows for technical reviews, access and delivery.</p></div><div class="border border-slate-200 bg-white p-7"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">03</div><h3 class="mt-5 text-xl font-semibold">Evidence-Led Delivery</h3><p class="mt-3 text-sm leading-6 text-slate-600">Representative engineering evidence supports capability positioning without unsupported customer claims.</p></div><div class="border border-slate-200 bg-white p-7"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">04</div><h3 class="mt-5 text-xl font-semibold">Scalable Engagement</h3><p class="mt-3 text-sm leading-6 text-slate-600">Specialist engineering can expand into managed workstreams, projects or dedicated ODC models.</p></div></div></div>
      </Container>
    </Section>

    <Section class="bg-white"><Container><TechnicalLabel>Talent at AionSi</TechnicalLabel><div class="grid gap-8 lg:grid-cols-[.9fr_1.1fr] lg:items-end"><h2 class="text-4xl font-semibold tracking-tight md:text-5xl">Build what's next. With us.</h2><p class="max-w-xl text-lg leading-8 text-slate-600">AionSi is building an engineering organization for complex silicon programs. Explore opportunities for early-career and experienced semiconductor engineers.</p></div><div class="mt-10 grid gap-5 md:grid-cols-2"><a href="/careers/early-careers" class="group border border-slate-200 p-8 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.18em] text-[var(--aionsi-orange)]">EARLY CAREERS</div><h3 class="mt-5 text-2xl font-semibold">Start Your Silicon Journey</h3><p class="mt-3 max-w-lg text-slate-600">Build semiconductor fundamentals, learn engineering methodologies and grow with experienced teams.</p><div class="mt-8 text-sm font-semibold">Explore Early Careers →</div></a><a href="/careers/experienced-engineers" class="group border border-slate-200 p-8 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.18em] text-[var(--aionsi-orange)]">EXPERIENCED ENGINEERS</div><h3 class="mt-5 text-2xl font-semibold">Bring Your Engineering Depth</h3><p class="mt-3 max-w-lg text-slate-600">Work on challenging semiconductor programs across verification, physical design, RTL, DFT and protocol engineering.</p><div class="mt-8 text-sm font-semibold">Explore Experienced Roles →</div></a></div></Container></Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white"><Container class="text-center"><TechnicalLabel>Engineering Excellence</TechnicalLabel><h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Have a silicon challenge?</h2><p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/70">Let's engineer it together.</p><div class="mt-9"><Button href="/contact">Talk to Our Engineering Team</Button></div></Container></Section>
  </main>
  <Footer />
</BaseLayout>
