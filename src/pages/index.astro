---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Container from '../components/global/Container.astro';
import Section from '../components/global/Section.astro';
import TechnicalLabel from '../components/global/TechnicalLabel.astro';
import Button from '../components/global/Button.astro';
import EngineeringCard from '../components/capabilities/EngineeringCard.astro';
import EngineeringTrace from '../components/lifecycle/EngineeringTrace.astro';
import SiliconHero from '../components/hero/SiliconHero.astro';
import { capabilities } from '../data/capabilities';
import { technologyEvidence } from '../data/technologyEvidence';
import { enterpriseProof } from '../data/enterpriseProof';
---
<BaseLayout title="AionSi | Semiconductor Engineering from IP to Silicon" description="AionSi semiconductor engineering from IP to Silicon across RTL Design, Design Verification, Physical Design, DFT, Protocol Verification and SoC & IP Engineering.">
  <Header theme="dark" />
  <main>
    <SiliconHero />

    <Section>
      <Container>
        <TechnicalLabel>AionSi Engineering Lifecycle</TechnicalLabel>
        <div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
          <div><h2 class="max-w-3xl text-4xl font-semibold tracking-tight md:text-5xl">From IP to Silicon.</h2><p class="mt-4 max-w-2xl text-lg leading-8 text-slate-600">Engineering expertise across the semiconductor development lifecycle.</p></div>
          <p class="max-w-xl text-sm font-medium uppercase tracking-[.12em] text-slate-400 lg:justify-self-end">Explore each stage to see where AionSi engineering contributes.</p>
        </div>
        <div class="mt-10"><EngineeringTrace /></div>
        <div class="mt-10 flex flex-col gap-4 border-t border-slate-200 pt-7 sm:flex-row sm:items-center sm:justify-between"><p class="text-base text-slate-600">Need engineering capacity at any stage of the silicon lifecycle?</p><Button href="/contact" variant="technical">Talk to Our Engineering Team</Button></div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-14 lg:py-16">
      <Container>
        <TechnicalLabel>Engineering Capabilities</TechnicalLabel>
        <div class="mb-8 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end"><div><h2 class="max-w-3xl text-4xl font-semibold tracking-tight md:text-5xl">Engineering depth across the silicon lifecycle.</h2><p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">From RTL design through verification, physical implementation, DFT, protocol verification and SoC integration—AionSi engineering capabilities are built around complex silicon programs.</p></div><a href="/capabilities" class="group inline-flex items-center gap-2 pb-1 text-sm font-semibold text-[var(--aionsi-navy)]">Explore the full engineering portfolio <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span></a></div>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">{capabilities.map((capability) => <EngineeringCard number={capability.number} title={capability.title} description={capability.description} technologies={capability.technologies?.join(' · ')} outcome={capability.outcome} href={`/capabilities/${capability.slug}`} />)}</div>
      </Container>
    </Section>

    <Section class="bg-white py-12 md:py-14 lg:py-16">
      <Container>
        <TechnicalLabel>Enterprise Engineering Credibility</TechnicalLabel>
        <div class="grid gap-8 lg:grid-cols-[.82fr_1.18fr] lg:items-end"><div><h2 class="max-w-4xl text-4xl font-semibold tracking-tight md:text-5xl">Evidence, delivery model and technical depth in one view.</h2><p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">AionSi presents representative engineering experience, evidence-backed technology domains and scalable delivery models without introducing unsupported customer or performance claims.</p></div><div class="text-sm uppercase tracking-[.14em] text-slate-400">Problem → Capability → Evidence → Engagement</div></div>
        <div class="mt-9 grid gap-5 lg:grid-cols-3">{enterpriseProof.map((item) => <a href={item.href ?? '/contact'} class="group border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{item.number}</div><h3 class="mt-5 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{item.title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{item.description}</p><div class="mt-6 space-y-2 text-sm text-slate-700">{item.items.slice(0, 4).map((point) => <div class="border-l-2 border-[var(--aionsi-orange)] pl-3">{point}</div>)}</div><div class="mt-7 text-sm font-semibold text-[var(--aionsi-navy)]">Explore evidence →</div></a>)}</div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-12 text-white md:py-14 lg:py-16">
      <Container class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-center"><div><TechnicalLabel>Built Around Your Engineering Problem</TechnicalLabel><h2 class="text-4xl font-semibold tracking-tight md:text-5xl">What are you trying to accelerate?</h2><p class="mt-5 max-w-xl text-lg leading-8 text-white/70">Bring a verification, implementation or engineering-capacity challenge. We will connect it to the right AionSi capability and delivery model.</p></div><div class="grid gap-4 md:grid-cols-3"><a href="/capabilities/design-verification" class="group border border-white/10 p-6 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-orange)]">01</div><h3 class="mt-8 text-xl font-semibold">Accelerate Verification</h3><p class="mt-3 text-sm leading-6 text-white/60">Extend verification capacity without losing engineering discipline.</p><span class="mt-8 inline-block text-sm font-semibold">Explore DV →</span></a><a href="/solutions/dedicated-engineering" class="group border border-white/10 p-6 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-orange)]">02</div><h3 class="mt-8 text-xl font-semibold">Scale Engineering</h3><p class="mt-3 text-sm leading-6 text-white/60">Add specialized RTL, DV, PD, DFT and protocol engineering capacity.</p><span class="mt-8 inline-block text-sm font-semibold">Build a Team →</span></a><a href="/solutions/odc" class="group border border-white/10 p-6 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]"><div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-orange)]">03</div><h3 class="mt-8 text-xl font-semibold">Build an ODC</h3><p class="mt-3 text-sm leading-6 text-white/60">Create a dedicated engineering organization aligned to your program.</p><span class="mt-8 inline-block text-sm font-semibold">Explore ODC →</span></a></div></Container>
    </Section>

    <Section class="py-12 md:py-14 lg:py-16"><Container><TechnicalLabel>Technology Depth</TechnicalLabel><div class="grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-start"><div><h2 class="text-4xl font-semibold tracking-tight md:text-5xl">Technology depth for complex silicon.</h2><p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">A focused set of technology domains backed by supplied AionSi technical capability evidence.</p><p class="mt-4 max-w-xl text-sm leading-6 text-slate-500">Each technology card maps to an evidence-backed reference. Unsupported or lower-confidence technology claims are intentionally excluded.</p></div><div class="grid gap-3 sm:grid-cols-2">{technologyEvidence.map((item) => <a href={item.detailHref} class="group flex items-center justify-between border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)]"><div><div class="flex items-center gap-2 text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]"><span>{item.number}</span><span class="rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[10px] tracking-[.12em] text-emerald-700">EVIDENCE READY</span></div><div class="mt-3 text-lg font-semibold">{item.title}</div><p class="mt-2 text-sm leading-6 text-slate-600">{item.summary}</p></div><span class="ml-4 shrink-0 text-slate-400 transition group-hover:translate-x-1 group-hover:text-[var(--aionsi-blue)]">→</span></a>)}</div></div></Container></Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-14 lg:py-16"><Container class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-center"><div><TechnicalLabel>Engineering Delivery Models</TechnicalLabel><h2 class="text-4xl font-semibold tracking-tight md:text-5xl">Choose the level of ownership your program needs.</h2><p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Start with a specialist bottleneck, expand into a managed workstream, or build a dedicated engineering organization around your roadmap.</p><div class="mt-8"><Button href="/solutions">Explore Delivery Models</Button></div></div><div class="grid gap-4 sm:grid-cols-2"><a href="/solutions/dedicated-engineering" class="border border-slate-200 bg-white p-7"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">01</div><h3 class="mt-5 text-2xl font-semibold">Dedicated Engineering</h3><p class="mt-3 text-sm leading-6 text-slate-600">Dedicated semiconductor engineering capacity aligned to a defined roadmap.</p></a><a href="/solutions/extended-engineering" class="border border-slate-200 bg-white p-7"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">02</div><h3 class="mt-5 text-2xl font-semibold">Extended Engineering</h3><p class="mt-3 text-sm leading-6 text-slate-600">Extend an existing engineering organization with focused capability and continuity.</p></a><a href="/solutions/project-engineering" class="border border-slate-200 bg-white p-7"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">03</div><h3 class="mt-5 text-2xl font-semibold">Project Engineering</h3><p class="mt-3 text-sm leading-6 text-slate-600">Defined scope, milestones, deliverables and technical ownership.</p></a><a href="/solutions/odc" class="border border-slate-200 bg-white p-7"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">04</div><h3 class="mt-5 text-2xl font-semibold">Engineering ODC</h3><p class="mt-3 text-sm leading-6 text-slate-600">A dedicated engineering organization aligned to program governance and scale-up.</p></a></div></Container></Section>

    <Section class="bg-[var(--aionsi-navy)] py-12 text-white md:py-14 lg:py-16"><Container class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-center"><div><TechnicalLabel>AIV</TechnicalLabel><h2 class="text-4xl font-semibold tracking-tight md:text-5xl">AI-Accelerated Verification.</h2><p class="mt-5 max-w-xl text-lg leading-8 text-white/70">Engineering productivity accelerated with human validation, security-conscious workflows and controlled deployment models.</p><div class="mt-8"><Button href="/solutions/aiv">Explore AIV</Button></div></div><div class="relative border border-white/10 bg-white/[.025] p-8 sm:p-10"><div class="mx-auto flex max-w-md flex-col items-center gap-4 text-center"><div class="flex h-28 w-28 items-center justify-center border border-[var(--aionsi-orange)]/70 text-2xl font-semibold tracking-[.12em] text-[var(--aionsi-orange)]">AIV</div><div class="h-10 w-px bg-[var(--aionsi-blue)]"></div><div class="grid w-full gap-3 sm:grid-cols-3"><div class="border border-white/10 p-4 text-xs uppercase tracking-[.14em] text-white/65">AI Assisted</div><div class="border border-white/10 p-4 text-xs uppercase tracking-[.14em] text-white/65">Human Validated</div><div class="border border-white/10 p-4 text-xs uppercase tracking-[.14em] text-white/65">Secure</div></div></div></div></Container></Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-16 lg:py-20"><Container class="text-center"><TechnicalLabel>Enterprise Engineering Discovery</TechnicalLabel><h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Start with the engineering problem you need to solve.</h2><p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/70">Share the engineering bottleneck, program stage, required expertise and target timeline. We can map it to the right AionSi delivery model.</p><div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row"><Button href="/contact">Discuss an Engineering Requirement</Button><Button href="/solutions" variant="technical">Explore Delivery Models</Button></div></Container></Section>
  </main>
  <Footer />
</BaseLayout>
