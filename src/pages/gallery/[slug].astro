---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { getGalleryEvent } from '../../lib/galleryStorage';

export const prerender = false;
const event = await getGalleryEvent(String(Astro.params.slug || ''));
if (!event || !event.published) return Astro.redirect('/gallery');
---
<BaseLayout title={`${event.title} | AionSi`} description={event.description}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-16 md:py-20 lg:py-24"><Container><TechnicalLabel>{event.category}</TechnicalLabel><h1 class="mt-4 max-w-5xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">{event.title}</h1><p class="mt-5 text-sm font-semibold uppercase tracking-[.12em] text-slate-500">{event.location} · {event.date}</p><p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">{event.description}</p></Container></Section>
    <Section><Container><div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {event.media.map((media) => (
        <figure class="overflow-hidden border border-slate-200 bg-white">
          {media.type === 'video' ? <video class="aspect-video w-full bg-black object-cover" controls preload="metadata"><source src={media.src} /></video> : <img src={media.src} alt={media.alt} class="aspect-video w-full object-cover" loading="lazy" decoding="async" />}
          {media.caption && <figcaption class="p-4 text-sm leading-6 text-slate-600">{media.caption}</figcaption>}
        </figure>
      ))}
    </div>{event.media.length === 0 && <div class="border border-dashed border-slate-300 p-10 text-center text-slate-500">Media for this event will appear here once published.</div>}</Container></Section>
    <Section class="bg-[var(--aionsi-surface-alt)]"><Container class="flex flex-col gap-6 border border-slate-200 bg-white p-8 md:flex-row md:items-center md:justify-between"><div><TechnicalLabel>ENGINEERING CONVERSATION</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)]">Connect this event to an engineering requirement.</h2></div><Button href="/contact">Talk to AionSi Engineering</Button></Container></Section>
  </main>
  <Footer />
</BaseLayout>
