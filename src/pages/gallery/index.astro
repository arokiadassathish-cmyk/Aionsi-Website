---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { galleryEvents } from '../../data/eventGallery';
---
<BaseLayout title="Events & Engineering Moments | AionSi" description="AionSi events, conferences, exhibitions, technical forums, engineering moments and media gallery.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-16 md:py-20 lg:py-24"><Container><TechnicalLabel>EVENTS & ENGINEERING MOMENTS</TechnicalLabel><h1 class="mt-4 max-w-5xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">A visual library of AionSi events, engineering and people.</h1><p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">Explore conferences, exhibitions, technical events and company moments. Published event galleries can contain photos, videos, captions and engineering context.</p></Container></Section>
    <Section><Container>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {galleryEvents.filter((event) => event.published).map((event) => (
          <a href={`/gallery/${event.slug}`} class="group overflow-hidden border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]">
            <div class="aspect-[16/9] overflow-hidden bg-slate-100"><img src={event.cover} alt={`${event.title} — AionSi`} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]" loading="lazy" decoding="async" /></div>
            <div class="p-7"><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">{event.category}</div><h2 class="mt-3 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{event.title}</h2><p class="mt-2 text-xs font-semibold uppercase tracking-[.12em] text-slate-400">{event.location} · {event.date}</p><p class="mt-4 text-sm leading-7 text-slate-600">{event.description}</p><div class="mt-5 text-sm font-semibold text-[var(--aionsi-blue)]">View event gallery →</div></div>
          </a>
        ))}
      </div>
      {galleryEvents.filter((event) => event.published).length === 0 && <div class="border border-dashed border-slate-300 p-12 text-center"><h2 class="text-2xl font-semibold text-[var(--aionsi-navy)]">Event galleries are being prepared.</h2><p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-slate-600">New conference, exhibition and engineering-event galleries will appear here as they are published.</p></div>}
    </Container></Section>
    <Section class="bg-[var(--aionsi-surface-alt)]"><Container><div class="grid gap-5 md:grid-cols-3"><a href="/leadership" class="border border-slate-200 bg-white p-7 transition hover:border-[var(--aionsi-blue)]"><TechnicalLabel>LEADERSHIP</TechnicalLabel><p class="mt-3 text-sm leading-7 text-slate-600">Meet the AionSi leadership team and executive functions.</p><div class="mt-5 text-sm font-semibold text-[var(--aionsi-navy)]">View leadership →</div></a><a href="/experience" class="border border-slate-200 bg-white p-7 transition hover:border-[var(--aionsi-blue)]"><TechnicalLabel>ENGINEERING</TechnicalLabel><p class="mt-3 text-sm leading-7 text-slate-600">Review representative engineering ownership and technical evidence.</p><div class="mt-5 text-sm font-semibold text-[var(--aionsi-navy)]">View experience →</div></a><a href="/news" class="border border-slate-200 bg-white p-7 transition hover:border-[var(--aionsi-blue)]"><TechnicalLabel>NEWS</TechnicalLabel><p class="mt-3 text-sm leading-7 text-slate-600">Follow company announcements and industry activity.</p><div class="mt-5 text-sm font-semibold text-[var(--aionsi-navy)]">View news →</div></a></div></Container></Section>
    <Section><Container class="flex flex-col gap-6 border border-slate-200 bg-white p-8 md:flex-row md:items-center md:justify-between"><div><TechnicalLabel>ENGINEERING CONVERSATION</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)]">Have an engineering requirement to discuss?</h2><p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600">Talk to AionSi about semiconductor engineering, verification, physical design, DFT, SoC/IP or dedicated engineering requirements.</p></div><Button href="/contact">Talk to AionSi Engineering</Button></Container></Section>
  </main>
  <Footer />
</BaseLayout>
