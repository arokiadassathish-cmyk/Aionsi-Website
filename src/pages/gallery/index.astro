---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';

const gallery = [
  { category: 'Semiconductor Engineering', title: 'From IP to Silicon', image: '/images/hero/aionsi-semiconductor-hero.jpg', description: 'AionSi engineering across the semiconductor development lifecycle.' },
  { category: 'Verification Architecture', title: 'Reusable UVM Verification Architecture', image: '/images/evidence/reusable-uvm-verification-architecture.png', description: 'Reference architecture covering reusable agents, stimulus, checking, assertions, coverage and regression.' },
];
---
<BaseLayout title="Gallery | AionSi" description="AionSi engineering, technology and company gallery.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-16 md:py-20 lg:py-24"><Container><TechnicalLabel>GALLERY</TechnicalLabel><h1 class="mt-4 max-w-5xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Engineering, technology and people.</h1><p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">A visual library for AionSi engineering work, technical references, company events and leadership stories.</p></Container></Section>
    <Section><Container><div class="grid gap-6 md:grid-cols-2">{gallery.map((item) => <figure class="overflow-hidden border border-slate-200 bg-white shadow-sm"><div class="aspect-[16/9] overflow-hidden bg-slate-100"><img src={item.image} alt={item.title} class="h-full w-full object-cover" loading="lazy" decoding="async" /></div><figcaption class="p-7"><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">{item.category}</div><h2 class="mt-3 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{item.title}</h2><p class="mt-3 text-sm leading-7 text-slate-600">{item.description}</p></figcaption></figure>)}</div></Container></Section>
    <Section class="bg-[var(--aionsi-surface-alt)]"><Container><div class="grid gap-5 md:grid-cols-3"><a href="/leadership" class="border border-slate-200 bg-white p-7 transition hover:border-[var(--aionsi-blue)]"><TechnicalLabel>LEADERSHIP</TechnicalLabel><p class="mt-3 text-sm leading-7 text-slate-600">Meet the AionSi leadership team and executive functions.</p><div class="mt-5 text-sm font-semibold text-[var(--aionsi-navy)]">View leadership →</div></a><div class="border border-slate-200 bg-white p-7"><TechnicalLabel>EVENTS</TechnicalLabel><p class="mt-3 text-sm leading-7 text-slate-600">AionSi participation across semiconductor conferences, technology forums and industry events.</p><div class="mt-5 text-xs font-semibold uppercase tracking-[.14em] text-slate-400">More stories coming soon</div></div><div class="border border-slate-200 bg-white p-7"><TechnicalLabel>ENGINEERING</TechnicalLabel><p class="mt-3 text-sm leading-7 text-slate-600">A visual view of AionSi engineering environments, technical work and team collaboration.</p><div class="mt-5 text-xs font-semibold uppercase tracking-[.14em] text-slate-400">More visuals coming soon</div></div></div></Container></Section>
    <Section><Container class="flex flex-col gap-6 border border-slate-200 bg-white p-8 md:flex-row md:items-center md:justify-between"><div><TechnicalLabel>ENGINEERING CONVERSATION</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)]">Have an engineering requirement to discuss?</h2><p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600">Talk to AionSi about semiconductor engineering, verification, physical design, DFT, SoC/IP or dedicated engineering requirements.</p></div><Button href="/contact">Talk to AionSi Engineering</Button></Container></Section>
  </main>
  <Footer />
</BaseLayout>
