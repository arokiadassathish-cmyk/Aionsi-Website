---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';

const engineeringCapabilities = [
  ['01','Design Verification','SystemVerilog, UVM, SVA, functional verification, coverage, regression and debug across IP, subsystem and SoC levels.'],
  ['02','RTL & SoC Engineering','RTL implementation, subsystem integration and engineering support across the semiconductor lifecycle.'],
  ['03','Physical Design & Signoff','Floorplanning, placement, CTS, routing, STA, PPA optimization, ECO and physical signoff support.'],
  ['04','DFT & Silicon','DFT coordination, silicon bring-up, validation and structured debug within defined program scope.'],
  ['05','Protocol & Interface Verification','Verification support for complex interfaces, integration dependencies and system-level protocol behavior.'],
  ['06','Verification Closure','Regression execution, failure analysis, coverage closure and structured debug toward milestone readiness.'],
];

const deliveryModel = [
  ['01','Technical qualification','Understand the program context, engineering methodology, tools, scope and expected outcomes.'],
  ['02','Bounded workstream','Deploy a focused team against a clearly defined engineering problem and measurable deliverables.'],
  ['03','Milestone ownership','Operate against agreed checkpoints, reviews and engineering quality expectations.'],
  ['04','Scale','Expand the workstream into a project team, specialist pod or dedicated engineering capacity when proven.'],
];

const collaborationAreas = [
  ['Verification capacity extension','Add specialist DV bandwidth for IP, subsystem or SoC verification programs.'],
  ['Specialist workstream ownership','Take responsibility for defined verification, implementation, DFT or signoff activities.'],
  ['Schedule-driven execution','Provide focused engineering capacity around coverage closure, integration, tape-out or other milestone pressure.'],
  ['Dedicated semiconductor pod','Build a sustained AionSi engineering pod aligned to a TCS delivery requirement or portfolio.'],
];

const audienceOutcomes = [
  ['Delivery Leadership','Extend semiconductor delivery capacity without immediately converting every requirement into a long-term staffing model.'],
  ['Engineering Leadership','Access specialist ownership for a defined DV, RTL, implementation, DFT or validation workstream.'],
  ['Technical Leads','Evaluate engineering depth against the actual methodology, tools, scope and milestone requirements.'],
  ['Program & Delivery Management','Align a bounded, measurable engagement to delivery priorities and scale when engineering value is demonstrated.'],
];
---

<BaseLayout title="AionSi × TCS | Semiconductor Engineering Expertise" description="AionSi semiconductor engineering capability aligned to TCS delivery needs across design verification, RTL, physical design, DFT, silicon validation and dedicated engineering capacity.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-10 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[1.02fr_.98fr] lg:items-center lg:gap-14">
          <div class="max-w-[700px]">
            <TechnicalLabel>ACCOUNT ENGINEERING BRIEF</TechnicalLabel>
            <h1 class="mt-5 max-w-[670px] text-[3.1rem] font-semibold leading-[1.06] tracking-[-0.035em] text-[var(--aionsi-navy)] sm:text-[3.5rem] lg:text-[3.8rem] xl:text-[4rem]">Strengthening semiconductor delivery with engineering ownership.</h1>
            <p class="mt-5 max-w-[650px] text-lg leading-8 text-slate-600 lg:text-[1.18rem]">AionSi complements semiconductor delivery organizations with specialist engineering capability across Design Verification, RTL, Physical Design, DFT and Silicon — starting with a defined workstream and scaling with demonstrated delivery.</p>
            <div class="mt-7 flex max-w-[660px] flex-wrap gap-3">
              {['Design Verification','RTL & SoC','Physical Design','DFT & Silicon'].map((tag) => <span class="border border-blue-200 bg-white px-4 py-2 text-sm font-semibold text-[var(--aionsi-navy)]">{tag}</span>)}
              <span class="border border-[var(--aionsi-orange)] bg-white px-4 py-2 text-sm font-semibold text-[var(--aionsi-navy)]">Dedicated Engineering</span>
            </div>
          </div>
          <div class="w-full max-w-[550px] justify-self-end border border-slate-200 bg-white p-6 shadow-sm md:p-7">
            <div class="h-1 w-12 bg-[var(--aionsi-orange)]"></div>
            <h2 class="mt-5 text-2xl font-semibold leading-tight text-[var(--aionsi-navy)] md:text-[1.75rem]">A specialist semiconductor engineering partner</h2>
            <p class="mt-3 text-base leading-7 text-slate-600">A focused proposition for extending delivery capacity, owning specialist workstreams and scaling engineering execution when program demand increases.</p>
            <div class="mt-5 border-l-2 border-[var(--aionsi-blue)] pl-4 text-sm leading-6 text-slate-500">Prepared for discussion based on publicly available information and AionSi's representative engineering experience.</div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-14 md:py-18">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr]">
          <div>
            <TechnicalLabel>BUILT FOR THE DELIVERY ECOSYSTEM</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">One proposition. Four stakeholder outcomes.</h2>
            <p class="mt-4 text-lg leading-8 text-slate-600">The same engineering model can be evaluated from delivery, engineering, technical and program perspectives.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {audienceOutcomes.map(([title,desc],index) => <article class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-6"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></article>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-18">
      <Container>
        <TechnicalLabel>AIONSI SEMICONDUCTOR ENGINEERING</TechnicalLabel>
        <h2 class="mt-4 max-w-4xl text-3xl font-semibold md:text-5xl">Where AionSi can extend TCS semiconductor delivery.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {engineeringCapabilities.map(([num,title,desc]) => <article class="border border-white/10 bg-white/5 p-5"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">{num}</span><h3 class="mt-3 text-xl font-semibold">{title}</h3><p class="mt-3 text-sm leading-6 text-white/65">{desc}</p></article>)}
        </div>
      </Container>
    </Section>

    <Section class="py-14 md:py-18">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.68fr_1.32fr]">
          <div>
            <TechnicalLabel>DESIGN VERIFICATION — OUR DVCON STARTING POINT</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">From verification execution to milestone ownership.</h2>
            <p class="mt-4 text-lg leading-8 text-slate-600">AionSi can support defined DV workstreams across planning, environment development, execution, regression, debug and closure.</p>
            <p class="mt-5 text-sm font-semibold leading-6 text-[var(--aionsi-navy)]">Potential ownership: planning → execution → regression health → debug → coverage closure → milestone reporting.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {['Verification Planning','UVM / SystemVerilog','IP & Subsystem Verification','Protocol / Interface Verification','Regression & Debug','Coverage Closure'].map((item,index) => <div class="border border-slate-200 bg-white p-5 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><h3 class="mt-3 font-semibold text-[var(--aionsi-navy)]">{item}</h3></div>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18">
      <Container>
        <TechnicalLabel>POTENTIAL COLLABORATION MODELS</TechnicalLabel>
        <h2 class="mt-4 max-w-4xl text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Start focused. Scale when the engineering case is proven.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {collaborationAreas.map(([title,desc],index) => <article class="border border-slate-200 bg-white p-6 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></article>)}
        </div>
      </Container>
    </Section>

    <Section class="py-14 md:py-18">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr]">
          <div>
            <TechnicalLabel>REPRESENTATIVE ENGINEERING EXPERIENCE</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Engineering experience across the semiconductor lifecycle.</h2>
            <p class="mt-4 text-lg leading-8 text-slate-600">AionSi customer discussions can be grounded in representative engineering experience rather than generic capability claims.</p>
          </div>
          <div class="grid gap-4 md:grid-cols-3">
            <a href="/evidence/opentitan-cryptography-secure-soc" class="group border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)]"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">SECURE SOC</span><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">Secure SoC Engineering</h3><p class="mt-2 text-sm leading-6 text-slate-600">Representative secure-SoC, cryptography and security-oriented engineering context.</p><span class="mt-5 inline-block text-sm font-semibold text-[var(--aionsi-navy)] group-hover:text-[var(--aionsi-blue)]">View experience →</span></a>
            <a href="/evidence/tarang-soc-engineering-experience" class="group border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)]"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">SOC EXPERIENCE</span><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">Complex SoC Engineering</h3><p class="mt-2 text-sm leading-6 text-slate-600">Representative SoC engineering across interfaces, memory, security, prototyping and embedded integration.</p><span class="mt-5 inline-block text-sm font-semibold text-[var(--aionsi-navy)] group-hover:text-[var(--aionsi-blue)]">View experience →</span></a>
            <a href="/evidence/physical-design-profile-derived-experience" class="group border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)]"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">IMPLEMENTATION</span><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">Physical Design &amp; Signoff</h3><p class="mt-2 text-sm leading-6 text-slate-600">Representative physical-design experience across timing closure, PPA, ECO and signoff.</p><span class="mt-5 inline-block text-sm font-semibold text-[var(--aionsi-navy)] group-hover:text-[var(--aionsi-blue)]">View experience →</span></a>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18">
      <Container>
        <TechnicalLabel>DELIVERY MODEL</TechnicalLabel>
        <h2 class="mt-4 max-w-4xl text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">A practical path from discussion to delivery.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {deliveryModel.map(([num,title,desc]) => <article class="border border-slate-200 bg-white p-6 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{num}</span><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></article>)}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-16">
      <Container class="text-center">
        <TechnicalLabel>ENGINEERING DISCOVERY</TechnicalLabel>
        <h2 class="mx-auto mt-3 max-w-4xl text-4xl font-semibold tracking-tight md:text-5xl">Let's identify one semiconductor engineering workstream.</h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg leading-8 text-white/70">Bring the DV, RTL, implementation, DFT or validation requirement. AionSi can qualify the scope, map the right capability and define a focused next step.</p>
        <div class="mt-7 flex flex-wrap justify-center gap-3"><Button href="/contact">Discuss an Engineering Workstream</Button><a href="/capabilities" class="inline-flex items-center justify-center border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/40">Explore AionSi Capabilities</a></div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
