---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';

const collections = [
  {
    number: '01',
    eyebrow: 'VERIFICATION READINESS',
    title: 'Pre-silicon verification resources',
    description: 'Practical guidance to help verification teams plan coverage, assess closure and prepare sign-off evidence.',
    items: ['Pre-Silicon Verification Sign-off Checklist', 'PCIe Verification Readiness Guide'],
    href: '/resources/verification-readiness',
    action: 'Explore verification resources',
  },
  {
    number: '02',
    eyebrow: 'TECHNICAL INSIGHTS',
    title: 'Engineering perspectives on silicon design',
    description: 'Technical articles examining architecture, design challenges, implementation and verification.',
    items: ['Physical design challenges in GPU and AI systems', 'SoC architecture and high-speed interfaces'],
    href: '/insights',
    action: 'Read technical articles',
  },
  {
    number: '03',
    eyebrow: 'ENGINEERING CAPABILITIES',
    title: 'Design and implementation domains',
    description: 'An overview of semiconductor engineering disciplines, technologies and development workflows.',
    items: ['Protocol and interface engineering', 'Design, verification and implementation'],
    href: '/evidence',
    action: 'View engineering capabilities',
  },
];

const focusAreas = [
  ['RTL & SoC Design', 'Microarchitecture, RTL implementation and integration readiness.'],
  ['Design Verification', 'UVM environments, assertions, functional coverage and regression closure.'],
  ['Physical Design', 'Implementation, timing closure, congestion analysis and sign-off.'],
  ['DFT & Test', 'Design-for-test strategy, implementation and test readiness.'],
  ['Protocol Engineering', 'PCIe, DDR, USB and high-speed interface verification.'],
  ['AI-Accelerated Verification', 'Automation-led workflows that support engineering productivity.'],
];
---
<BaseLayout title="Semiconductor Engineering Resources | AionSi" description="Explore AionSi engineering resources, verification checklists, protocol readiness guides, technical insights and semiconductor engineering evidence." canonical="https://aionsi.com/resources" ogImage="/images/hero/aionsi-semiconductor-hero.jpg">
  <Header />
  <main>
    <section class="relative overflow-hidden bg-[var(--aionsi-deep-navy)] pb-20 pt-32 text-white md:pb-28 md:pt-40">
      <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-[var(--aionsi-blue)]/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-32 left-1/3 h-80 w-80 rounded-full bg-[var(--aionsi-orange)]/10 blur-3xl"></div>
      <Container class="relative">
        <TechnicalLabel>AIONSI · SEMICONDUCTOR ENGINEERING</TechnicalLabel>
        <div class="mt-7 grid gap-10 lg:grid-cols-[1.2fr_.8fr] lg:items-end">
          <div>
            <h1 class="max-w-4xl text-5xl font-semibold leading-[1.04] tracking-tight md:text-7xl">Semiconductor Engineering Resources</h1>
            <p class="mt-7 max-w-2xl text-lg leading-8 text-white/75 md:text-xl">Technical guides, engineering insights and reference material covering design, verification and implementation of complex silicon systems.</p>
          </div>
          <div class="border-l border-white/20 pl-6">
            <p class="text-xs font-semibold uppercase tracking-[.18em] text-[var(--aionsi-orange)]">RESOURCE COLLECTIONS</p>
            <p class="mt-4 text-2xl font-medium leading-snug">Guides, technical articles and engineering reference material.</p>
            <a href="#resource-collections" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-white transition hover:text-[var(--aionsi-orange)]">Browse resources <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </Container>
    </section>

    <Section class="bg-white">
      <Container>
        <a href="/insights/six-physical-design-bottlenecks-gpu-signoff" class="group grid gap-7 overflow-hidden border border-slate-200 bg-[var(--aionsi-deep-navy)] p-7 text-white transition hover:border-[var(--aionsi-orange)] md:grid-cols-[.85fr_1.15fr] md:items-center md:p-10">
          <div>
            <TechnicalLabel>TECHNICAL ARTICLE · GPU PHYSICAL DESIGN</TechnicalLabel>
            <div class="mt-5 text-4xl font-semibold tracking-tight md:text-5xl">GPU Physical Design</div>
          </div>
          <div>
            <h2 class="text-2xl font-semibold leading-tight md:text-3xl">Six Physical Design Bottlenecks That Can Delay GPU Sign-off</h2>
            <p class="mt-4 text-sm leading-7 text-white/70">A technical review of floorplanning and congestion, HBM and advanced packaging, timing and clock distribution, multi-voltage implementation, power integrity and thermal sign-off convergence.</p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[var(--aionsi-orange)]">Read technical article <span aria-hidden="true" class="transition group-hover:translate-x-1">→</span></span>
          </div>
        </a>
      </Container>
    </Section>

    <Section id="resource-collections" class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <div class="max-w-3xl">
          <TechnicalLabel>RESOURCE COLLECTIONS</TechnicalLabel>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Semiconductor Engineering Resources</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">Technical guides, engineering insights and reference material covering design, verification and implementation of complex silicon systems.</p>
        </div>
        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {collections.map((item) => (
            <article class="flex h-full flex-col border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:shadow-lg md:p-8">
              <div class="flex items-center justify-between">
                <span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{item.eyebrow}</span>
                <span class="text-3xl font-light text-slate-300">{item.number}</span>
              </div>
              <h3 class="mt-8 text-2xl font-semibold leading-tight text-[var(--aionsi-navy)]">{item.title}</h3>
              <p class="mt-4 text-sm leading-7 text-slate-600">{item.description}</p>
              <ul class="mt-6 grid gap-3 border-t border-slate-100 pt-5">
                {item.items.map((entry) => <li class="flex gap-3 text-sm leading-6 text-slate-700"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--aionsi-orange)]"></span>{entry}</li>)}
              </ul>
              <a href={item.href} class="mt-auto inline-flex items-center gap-2 pt-8 text-sm font-semibold text-[var(--aionsi-navy)] transition hover:text-[var(--aionsi-blue)]">{item.action} <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-white">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
          <div>
            <TechnicalLabel>ENGINEERING DISCIPLINES</TechnicalLabel>
            <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Engineering disciplines and focus areas.</h2>
            <p class="mt-5 text-base leading-7 text-slate-600">Reference areas across semiconductor design, verification and implementation.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {focusAreas.map(([title, description], index) => (
              <div class="border border-slate-200 p-6">
                <span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">0{index + 1}</span>
                <h3 class="mt-3 text-lg font-semibold text-[var(--aionsi-navy)]">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">{description}</p>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <div class="max-w-4xl">
          <TechnicalLabel>RESOURCE SCOPE</TechnicalLabel>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Using these resources.</h2>
          <p class="mt-5 text-base leading-8 text-slate-600">These materials provide technical context and practical review points across semiconductor design, verification and implementation. Project-specific requirements, design constraints, technology choices and sign-off criteria should always guide engineering decisions.</p>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
