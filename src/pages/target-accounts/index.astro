---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import { targetAccounts } from '../../data/targetAccounts';
---
<BaseLayout title="Semiconductor Engineering for Strategic Technology Programs | AionSi" description="Explore AionSi engineering capabilities relevant to complex semiconductor, AI, automotive, EDA and high-speed interconnect programs.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-16 lg:py-20">
      <Container>
        <TechnicalLabel>STRATEGIC ACCOUNT ENGINEERING</TechnicalLabel>
        <h1 class="mt-5 max-w-5xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Engineering capability mapped to complex semiconductor programs.</h1>
        <p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">AionSi maintains evidence-led capability mappings for strategic technology companies. These pages help engineering teams evaluate where a defined requirement may align with AionSi capability.</p>
        <p class="mt-6 max-w-3xl border-l-2 border-[var(--aionsi-orange)] pl-5 text-sm leading-7 text-slate-500">These are capability-relevance pages, not customer announcements. They do not imply a customer relationship, program engagement or approved association unless explicitly stated elsewhere.</p>
      </Container>
    </Section>

    <Section>
      <Container>
        <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <TechnicalLabel>STRATEGIC TECHNOLOGY ACCOUNTS</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Find an engineering fit</h2>
          </div>
          <label class="block w-full md:max-w-sm">
            <span class="sr-only">Search strategic accounts</span>
            <input id="account-search" type="search" placeholder="Search company or technology" class="w-full rounded-full border border-slate-300 bg-white px-5 py-3 text-sm text-[var(--aionsi-navy)] outline-none transition focus:border-[var(--aionsi-blue)] focus:ring-2 focus:ring-[var(--aionsi-blue)]/10" />
          </label>
        </div>

        <div class="mb-8 flex flex-wrap gap-2" aria-label="Filter strategic accounts">
          {['All', 'AI & Compute', 'Connectivity & Infrastructure', 'Automotive & Embedded', 'EDA & Design Ecosystem', 'Photonics & Optical'].map((filter) => (
            <button type="button" data-account-filter={filter} class="account-filter rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[var(--aionsi-blue)] hover:text-[var(--aionsi-blue)]" aria-pressed={filter === 'All' ? 'true' : 'false'}>{filter}</button>
          ))}
        </div>

        <div id="account-grid" class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {targetAccounts.map((account) => (
            <a href={`/target-accounts/${account.slug}`} data-account-card data-account-name={`${account.name} ${account.category} ${account.headline}`} data-account-category={
              account.category.includes('AI') || account.category.includes('Compute') || account.category.includes('Cloud')
                ? 'AI & Compute'
                : account.category.includes('Connectivity') || account.category.includes('Networking') || account.category.includes('Photon') || account.category.includes('Optical')
                  ? 'Connectivity & Infrastructure'
                  : account.category.includes('Automotive') || account.category.includes('Embedded') || account.category.includes('Industrial') || account.category.includes('Power') || account.category.includes('Sensing')
                    ? 'Automotive & Embedded'
                    : account.category.includes('EDA') || account.category.includes('ASIC')
                      ? 'EDA & Design Ecosystem'
                      : 'AI & Compute'
            } class="group border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]">
              <div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">{account.category}</div>
              <h2 class="mt-4 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{account.name}</h2>
              <p class="mt-3 text-base font-semibold leading-6 text-[var(--aionsi-navy)]">{account.headline}</p>
              <p class="mt-3 text-sm leading-7 text-slate-600">{account.description}</p>
              <span class="mt-7 inline-flex text-sm font-semibold text-[var(--aionsi-blue)]">View engineering fit →</span>
            </a>
          ))}
        </div>

        <p id="account-empty" class="hidden mt-10 text-center text-slate-500">No strategic account matches that search or filter.</p>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white">
      <Container class="text-center">
        <TechnicalLabel>ENGINEERING DISCOVERY</TechnicalLabel>
        <h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Have a defined semiconductor engineering requirement?</h2>
        <p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Bring the problem, interface, lifecycle stage or capacity gap. AionSi will map the requirement to the relevant engineering capability and evidence.</p>
        <div class="mt-9"><a href="/contact" class="inline-flex rounded-full bg-[var(--aionsi-orange)] px-6 py-3.5 text-sm font-semibold text-white">Discuss Your Engineering Requirement →</a></div>
      </Container>
    </Section>
  </main>
  <Footer />
  <script is:inline>
    const search = document.querySelector('#account-search');
    const cards = Array.from(document.querySelectorAll('[data-account-card]'));
    const filters = Array.from(document.querySelectorAll('[data-account-filter]'));
    const empty = document.querySelector('#account-empty');
    let activeFilter = 'All';

    const applyAccountFilter = () => {
      const query = (search?.value || '').trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const matchesQuery = !query || card.dataset.accountName.toLowerCase().includes(query);
        const matchesFilter = activeFilter === 'All' || card.dataset.accountCategory === activeFilter;
        const show = matchesQuery && matchesFilter;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });
      empty?.classList.toggle('hidden', visible !== 0);
    };

    search?.addEventListener('input', applyAccountFilter);
    filters.forEach((button) => {
      button.addEventListener('click', () => {
        activeFilter = button.dataset.accountFilter;
        filters.forEach((item) => item.setAttribute('aria-pressed', item === button ? 'true' : 'false'));
        applyAccountFilter();
      });
    });
  </script>
</BaseLayout>
