---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';

const engineeringAreas = [
  ['01','Protocol Verification','SystemVerilog, UVM, assertions, functional verification, regression, debug and closure for protocol-heavy IP and subsystems.'],
  ['02','High-Speed Interface Verification','Potential alignment across PCIe, USB, UFS, MIPI, I3C and related interface verification and integration workstreams.'],
  ['03','Validation Automation','Python/Linux automation, regression orchestration, log analysis, failure triage and repeatable validation workflows.'],
  ['04','Silicon Validation & Debug','Bring-up support, interface validation, failure reproduction, trace analysis and hardware/software debug within defined scope.'],
  ['05','Verification Closure','Coverage analysis, regression health, failure classification, root-cause analysis and structured milestone closure.'],
];

const workstreams = [
  ['Protocol analyzer / exerciser development','Verification and test-development capacity around protocol behavior, stimulus generation, corner cases and failure analysis.'],
  ['Protocol compliance & corner-case validation','Negative testing, protocol-rule validation, regression and debug for difficult interface scenarios.'],
  ['Validation workflow automation','Reduce repetitive validation analysis through scripting, regression orchestration and structured failure triage.'],
  ['Silicon-facing debug','Extend engineering bandwidth for bring-up, trace interpretation, issue reproduction and root-cause isolation.'],
  ['New protocol adoption','Provide specialist verification capacity when a roadmap introduces a new interface or validation requirement.'],
  ['Customer-specific validation','Deploy bounded engineering capacity around defined requirements, interoperability or system-level debug.'],
];

const experience = [
  ['DESIGN VERIFICATION','UVM/SystemVerilog, IP and subsystem verification, regression, debug and coverage-oriented execution.','/evidence/design-verification-engineering'],
  ['PROTOCOL & INTERFACE','Representative interface-focused engineering context across verification and integration work.','/capabilities/protocol-verification'],
  ['SOC ENGINEERING','Representative SoC engineering across interfaces, memory, security, prototyping and embedded integration.','/evidence/tarang-soc-engineering-experience'],
  ['IMPLEMENTATION','Physical-design experience across timing closure, PPA optimization, ECO and signoff for complex designs.','/evidence/physical-design-profile-derived-experience'],
];

const deliveryModel = [
  ['01','Technical qualification','Understand the engineering context, methodology, tools, validation flow, scope and expected technical outcome.'],
  ['02','Defined workstream','Start with one clearly bounded engineering responsibility and measurable deliverables.'],
  ['03','Engineering ownership','Operate against agreed checkpoints, technical reviews and quality expectations.'],
  ['04','Dedicated capacity','Extend a specialist team around a continuing workstream where the technical requirement warrants it.'],
];
---

<BaseLayout title="AionSi × Prodigy Technovations | Protocol Validation Engineering" description="A technical overview of AionSi semiconductor engineering experience and potential alignment with protocol validation, verification automation and silicon-facing engineering workflows for Prodigy Technovations.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-10 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[1.02fr_.98fr] lg:items-center lg:gap-14">
          <div class="max-w-[700px]">
            <TechnicalLabel>PRODIGY TECHNOVATIONS · ENGINEERING BRIEF</TechnicalLabel>
            <h1 class="mt-5 max-w-[680px] text-[3.05rem] font-semibold leading-[1.06] tracking-[-0.035em] text-[var(--aionsi-navy)] sm:text-[3.45rem] lg:text-[3.75rem] xl:text-[3.95rem]">Protocol validation, verification and silicon engineering.</h1>
            <p class="mt-5 max-w-[650px] text-lg leading-8 text-slate-600 lg:text-[1.18rem]">AionSi engineering experience across Design Verification, protocol and interface verification, validation automation and silicon-facing debug.</p>
            <div class="mt-7 flex max-w-[680px] flex-wrap gap-3">
              {['Protocol Verification','Interface DV','Validation Automation','Silicon Debug'].map((tag) => <span class="border border-blue-200 bg-white px-4 py-2 text-sm font-semibold text-[var(--aionsi-navy)]">{tag}</span>)}
              <span class="border border-[var(--aionsi-orange)] bg-white px-4 py-2 text-sm font-semibold text-[var(--aionsi-navy)]">Engineering Capacity</span>
            </div>
          </div>
          <div class="w-full max-w-[550px] justify-self-end border border-slate-200 bg-white p-6 shadow-sm md:p-7">
            <div class="h-1 w-12 bg-[var(--aionsi-orange)]"></div>
            <h2 class="mt-5 text-2xl font-semibold leading-tight text-[var(--aionsi-navy)] md:text-[1.75rem]">Continuing the DVCon conversation</h2>
            <p class="mt-3 text-base leading-7 text-slate-600">AionSi connected with the Prodigy Technovations team at DVCon. This page consolidates relevant engineering experience and technical areas for further discussion.</p>
            <div class="mt-5 border-l-2 border-[var(--aionsi-blue)] pl-4 text-sm leading-6 text-slate-500">Prepared for discussion based on publicly available information and AionSi's representative engineering experience.</div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-16">
      <Container>
        <TechnicalLabel>RELEVANT ENGINEERING EXPERIENCE</TechnicalLabel>
        <div class="mt-4 grid gap-8 lg:grid-cols-[.68fr_1.32fr] lg:items-start">
          <div>
            <h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Engineering experience first.</h2>
            <p class="mt-4 text-lg leading-8 text-slate-600">A quick view of the engineering areas behind the discussion, with deeper evidence available for technical qualification.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {experience.map(([label,title,href]) => <a href={href} class="group border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)]"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{label}</span><p class="mt-3 text-sm font-semibold leading-6 text-[var(--aionsi-navy)]">{title}</p><span class="mt-5 inline-block text-sm font-semibold text-[var(--aionsi-navy)] group-hover:text-[var(--aionsi-blue)]">View experience →</span></a>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18">
      <Container>
        <TechnicalLabel>ENGINEERING EXPERIENCE</TechnicalLabel>
        <h2 class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Engineering experience across the semiconductor lifecycle.</h2>
        <p class="mt-4 max-w-4xl text-lg leading-8 text-slate-600">Representative experience is presented as technical context for qualification, not as a claim of an existing Prodigy customer or supplier relationship.</p>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {['Design Verification — UVM / SystemVerilog, IP & subsystem verification, regression, debug and coverage-oriented execution','SoC Engineering — interfaces, memory, security, prototyping and embedded integration','Secure SoC — secure silicon and cryptography-oriented engineering context','Physical Implementation — timing closure, PPA optimization, ECO and signoff for complex designs'].map((item,index) => <div class="border border-slate-200 bg-white p-6 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><p class="mt-3 text-sm leading-6 text-[var(--aionsi-navy)]">{item}</p></div>)}
        </div>
      </Container>
    </Section>

    <Section class="py-14 md:py-18">
      <Container>
        <TechnicalLabel>FROM PROTOCOL BEHAVIOR TO SILICON DEBUG</TechnicalLabel>
        <div class="mt-4 grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div>
            <h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Protocol-product engineering spans multiple validation layers.</h2>
            <p class="mt-4 text-lg leading-8 text-slate-600">Protocol-intensive products connect verification, exercising, validation, interoperability and system-level debug. The engineering challenge is not only generating tests, but turning failures and traces into actionable closure.</p>
          </div>
          <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-6 md:p-8">
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {['Architecture','IP / SoC Verification','Protocol Exercising','Interface Validation','Silicon Validation','System-Level Debug'].map((item,index) => <div class="border border-slate-200 bg-white p-5"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><h3 class="mt-3 text-lg font-semibold text-[var(--aionsi-navy)]">{item}</h3></div>)}
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-18">
      <Container>
        <TechnicalLabel>POTENTIAL TECHNICAL ALIGNMENT</TechnicalLabel>
        <h2 class="mt-4 max-w-5xl text-3xl font-semibold md:text-5xl">Protocol, validation and debug engineering areas.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {engineeringAreas.map(([num,title,desc]) => <article class="border border-white/10 bg-white/5 p-5"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">{num}</span><h3 class="mt-3 text-xl font-semibold">{title}</h3><p class="mt-3 text-sm leading-6 text-white/65">{desc}</p></article>)}
        </div>
      </Container>
    </Section>

    <Section class="py-14 md:py-18">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.68fr_1.32fr]">
          <div>
            <TechnicalLabel>POTENTIAL TECHNICAL ALIGNMENT</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Concrete areas for an engineering discussion.</h2>
            <p class="mt-4 text-lg leading-8 text-slate-600">These are technical hypotheses for discussion. The Prodigy engineering team can validate, refine or redirect them based on current priorities.</p>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {workstreams.map(([title,desc],index) => <article class="border border-slate-200 bg-white p-6 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></article>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18">
      <Container>
        <TechnicalLabel>POSSIBLE ENGAGEMENT MODELS</TechnicalLabel>
        <h2 class="mt-4 max-w-4xl text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">A practical path from technical discussion to engineering ownership.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {deliveryModel.map(([num,title,desc]) => <article class="border border-slate-200 bg-white p-6 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{num}</span><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></article>)}
        </div>
      </Container>
    </Section>

    <Section class="py-14 text-center md:py-16">
      <Container>
        <TechnicalLabel>ENGINEERING DISCUSSION</TechnicalLabel>
        <h2 class="mx-auto mt-3 max-w-4xl text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Continue the technical discussion.</h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg leading-8 text-slate-600">Further discussion can focus on the relevant protocol, verification, validation or silicon engineering requirements.</p>
        <div class="mt-7 flex flex-wrap justify-center gap-3"><Button href="/contact">Continue the Discussion</Button><a href="/capabilities" class="inline-flex items-center justify-center border border-slate-300 px-5 py-3 text-sm font-semibold text-[var(--aionsi-navy)] transition hover:border-[var(--aionsi-blue)]">Explore Engineering Capabilities</a></div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
