---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { customerLogos, customerStatement } from '../../data/customers';
---
<BaseLayout title="Customers | AionSi" description="Selected AionSi customers and technology organizations supported through engineering engagements.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-16 lg:py-20">
      <Container>
        <TechnicalLabel>CUSTOMER TRUST</TechnicalLabel>
        <div class="grid gap-10 lg:grid-cols-[1fr_.8fr] lg:items-end">
          <div>
            <h1 class="text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Our customers.</h1>
            <p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">AionSi works with semiconductor and technology organizations across complex engineering programs.</p>
          </div>
          <div class="border border-slate-200 bg-white p-7">
            <TechnicalLabel>CONFIRMED CUSTOMER ROSTER</TechnicalLabel>
            <p class="mt-4 text-base leading-7 text-[var(--aionsi-navy)]">The customer roster shown here is based on the approved AionSi list provided for website publication.</p>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-10 md:py-14 lg:py-16">
      <Container>
        <div class="grid grid-cols-2 gap-5 md:grid-cols-4">
          {customerLogos.map((customer) => (
            <div class="flex min-h-32 items-center justify-center border border-slate-200 bg-white p-6 shadow-sm">
              <img src={customer.logo} alt={customer.name} class="max-h-16 max-w-[80%] object-contain" loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
        <p class="mt-8 text-center text-base font-semibold text-[var(--aionsi-navy)]">{customerStatement}</p>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-12 text-white md:py-16">
      <Container class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
        <div>
          <TechnicalLabel>CUSTOMER ENGAGEMENT</TechnicalLabel>
          <h2 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">Engineering ownership for complex silicon programs.</h2>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-white/70">AionSi maps customer engineering challenges to the right capability, evidence and delivery model — from specialist engineering through dedicated teams and ODC programs.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <a href="/capabilities" class="border border-white/10 p-6 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.18em] text-[var(--aionsi-orange)]">01</div><div class="mt-4 text-xl font-semibold">Engineering Capabilities</div></a>
          <a href="/experience" class="border border-white/10 p-6 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.18em] text-[var(--aionsi-orange)]">02</div><div class="mt-4 text-xl font-semibold">Representative Experience</div></a>
          <a href="/solutions/odc" class="border border-white/10 p-6 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.18em] text-[var(--aionsi-orange)]">03</div><div class="mt-4 text-xl font-semibold">Engineering ODC</div></a>
          <a href="/contact" class="border border-white/10 p-6 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.18em] text-[var(--aionsi-orange)]">04</div><div class="mt-4 text-xl font-semibold">Discuss a Requirement</div></a>
        </div>
      </Container>
    </Section>

    <Section class="py-12 md:py-16">
      <Container class="text-center">
        <TechnicalLabel>ENGINEERING BUSINESS DEVELOPMENT</TechnicalLabel>
        <h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-6xl">Have a semiconductor engineering requirement?</h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600">Talk directly with AionSi business development for engineering teams, project delivery and ODC opportunities.</p>
        <div class="mt-8"><Button href="/contact">Talk to AionSi</Button></div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
