---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { capabilities } from '../../data/capabilities';
import { protocolConversionScenarios } from '../../data/conversionMatrix';
import ConversionMatrix from '../../components/conversion/ConversionMatrix.astro';

export function getStaticPaths() {
  return capabilities.map((capability) => ({
    params: { slug: capability.slug },
    props: { capability },
  }));
}

const { capability } = Astro.props;
const pageTitle = `${capability.title} | AionSi`;
const pageDescription = `${capability.description} Explore AionSi engineering scope, methodology, evidence and engineering outcomes.`;
const isProtocol = capability.slug === 'protocol-verification';
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-20 md:py-24 lg:py-26">
      <Container>
        <div class="max-w-5xl">
          <div class="flex items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]">
            <span>{capability.number}</span>
            <span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span>
            <span>ENGINEERING CAPABILITY</span>
          </div>
          <h1 class="mt-6 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">{capability.title}</h1>
          {isProtocol && <p class="mt-3 text-lg font-semibold tracking-[.04em] text-[var(--aionsi-blue)] md:text-xl">Engineering conversion pilot</p>}
          <p class="mt-5 max-w-4xl text-xl leading-9 text-slate-600 md:text-2xl">{capability.description}</p>
          <div class="mt-8 flex flex-wrap gap-2">
            {capability.technologies?.map((technology) => (
              <span class="border border-slate-200 bg-white px-3 py-2 text-xs font-semibold tracking-[.04em] text-slate-600">{technology}</span>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    {isProtocol ? (
      <>
        <Section class="py-10 md:py-12 lg:py-14">
          <Container>
            <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
              <div>
                <TechnicalLabel>Engineering Problems</TechnicalLabel>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Start with the engineering situation, not the service.</h2>
              </div>
              <div class="border-l border-slate-200 pl-6 text-lg leading-8 text-slate-600 md:pl-8">
                <p>Protocol verification programs typically enter through a concrete engineering pressure: additional experienced capacity, a new interface to verify, closure risk, reuse requirements or a need for scalable external execution.</p>
                <p class="mt-4">The conversion path below connects each situation to the evidence, workstream and engagement model that AionSi can discuss.</p>
              </div>
            </div>
          </Container>
        </Section>

        <Section class="bg-[var(--aionsi-surface-alt)] py-10 md:py-12 lg:py-14">
          <Container>
            <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
              <div>
                <TechnicalLabel>Engineering Conversion Matrix</TechnicalLabel>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Choose the problem. Follow the path to engagement.</h2>
              </div>
              <p class="max-w-xl text-sm leading-6 text-slate-500">Each scenario preserves the evidence-before-claims boundary and routes only to an engagement model supported by the approved conversion matrix.</p>
            </div>
            <div class="mt-7">
              <ConversionMatrix scenarios={protocolConversionScenarios} />
            </div>
          </Container>
        </Section>

        <Section class="py-10 md:py-12 lg:py-14">
          <Container>
            <div class="grid gap-6 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
              <div>
                <TechnicalLabel>Account Expansion Path</TechnicalLabel>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Start focused. Expand with the program.</h2>
                <p class="mt-4 max-w-xl text-base leading-7 text-slate-600 md:text-lg md:leading-8">The first engagement does not need to be an ODC. AionSi can enter through a focused engineering need and expand as scope, trust and program requirements grow.</p>
              </div>
              <div class="grid gap-4 sm:grid-cols-4">
                {[
                  ['01', 'Specialist', 'Targeted protocol engineering capacity'],
                  ['02', 'Workstream', 'Defined scope with milestones and closure'],
                  ['03', 'Project', 'Bounded verification package or deliverable'],
                  ['04', 'ODC', 'Dedicated team aligned to the customer roadmap'],
                ].map(([number, title, description], index) => (
                  <div class="border border-slate-200 bg-white p-5">
                    <span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{number}</span>
                    <h3 class="mt-3 font-semibold text-[var(--aionsi-navy)]">{title}</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">{description}</p>
                    {index < 3 && <div class="mt-5 hidden h-px w-8 bg-slate-200 sm:block" aria-hidden="true"></div>}
                  </div>
                ))}
              </div>
            </div>
          </Container>
        </Section>

        <Section class="bg-[var(--aionsi-deep-navy)] py-12 text-white md:py-14 lg:py-16">
          <Container>
            <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
              <div class="max-w-3xl">
                <TechnicalLabel>Engineering Discovery</TechnicalLabel>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">Bring the verification problem. Start the engineering discussion.</h2>
                <p class="mt-4 text-base leading-7 text-white/70 md:text-lg md:leading-8">Share the interface, subsystem or SoC verification pressure, program stage and expected engineering model. The AionSi team can route the discussion to the appropriate technical path.</p>
              </div>
              <Button href="/contact">Start an Engineering Discussion</Button>
            </div>
          </Container>
        </Section>
      </>
    ) : (
      <>
        <Section class="py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:items-start">
              <div>
                <TechnicalLabel>Engineering Scope</TechnicalLabel>
                <h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Where this capability contributes.</h2>
              </div>
              <div class="border-l border-slate-200 pl-6 text-lg leading-8 text-slate-600 md:pl-8">
                <p>{capability.description}</p>
                {capability.slug === 'design-verification' ? (
                  <p class="mt-4">AionSi applies disciplined verification across block, subsystem and SoC levels, combining reusable SystemVerilog/UVM infrastructure with coverage, assertions, protocol checking, processor-driven scenarios, formal planning and regression/debug workflows.</p>
                ) : (
                  <p class="mt-4">Detailed engineering scope, methodologies and program evidence are presented from AionSi's approved technical source material.</p>
                )}
              </div>
            </div>
          </Container>
        </Section>

        <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-6 md:grid-cols-2">
              <div class="border border-slate-200 bg-white p-7 md:p-8">
                <TechnicalLabel>Technology / Methodology</TechnicalLabel>
                {capability.slug === 'design-verification' ? (
                  <div class="mt-5 grid gap-3 sm:grid-cols-2">
                    {['SystemVerilog / UVM', 'Functional & code coverage', 'SVA / assertions', 'Scoreboards & protocol checking', 'Processor-driven verification', 'Formal verification planning'].map((item) => (
                      <div class="border border-slate-100 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm font-medium text-slate-600">{item}</div>
                    ))}
                  </div>
                ) : capability.technologies?.length ? (
                  <div class="mt-5 flex flex-wrap gap-2">
                    {capability.technologies.map((technology) => (
                      <span class="border border-slate-200 px-3 py-2 text-sm text-slate-600">{technology}</span>
                    ))}
                  </div>
                ) : (
                  <p class="mt-5 text-slate-500">Technical methodology will be added when the approved Physical Design source material is available.</p>
                )}
              </div>

              <div class="border border-slate-200 bg-white p-7 md:p-8">
                <TechnicalLabel>Engineering Outcome</TechnicalLabel>
                {capability.slug === 'design-verification' ? (
                  <div class="mt-5 space-y-3">
                    {['Reusable verification infrastructure', 'Functional + code coverage', 'Assertions & protocol checking', 'Regression / debug workflows', 'Coverage-driven closure'].map((item, index, items) => (
                      <div class="flex items-center gap-3 text-sm font-medium text-[var(--aionsi-navy)]">
                        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[var(--aionsi-blue)]/30 text-[10px] font-semibold text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span>
                        <span>{item}</span>
                        {index < items.length - 1 && <span class="ml-auto h-px w-8 bg-slate-200" aria-hidden="true"></span>}
                      </div>
                    ))}
                  </div>
                ) : capability.outcome ? (
                  <p class="mt-5 text-xl font-semibold leading-8 text-[var(--aionsi-navy)]">{capability.outcome}</p>
                ) : (
                  <p class="mt-5 text-slate-500">Engineering outcome will be defined from the approved technical evidence.</p>
                )}
              </div>
            </div>
          </Container>
        </Section>

        {capability.slug === 'design-verification' && capability.evidence?.length ? (
          <Section class="py-16 md:py-20 lg:py-24">
            <Container>
              <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
                <div class="lg:sticky lg:top-28">
                  <TechnicalLabel>Engineering Evidence</TechnicalLabel>
                  <h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Evidence before claims.</h2>
                  <p class="mt-4 max-w-md text-slate-600">Technical evidence drawn from approved AionSi engineering source material.</p>
                </div>
                <div class="grid gap-4 md:grid-cols-2">
                  {capability.evidence.map((item, index) => (
                    item.href ? (
                      <a href={item.href} class="group border border-slate-200 bg-white p-6 transition duration-300 hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)] hover:shadow-[0_14px_40px_rgba(2,11,39,.06)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--aionsi-blue)] focus-visible:ring-offset-2">
                        <div class="flex items-start justify-between gap-4">
                          <span class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span>
                          <span class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">{item.type}</span>
                        </div>
                        <h3 class="mt-6 text-lg font-semibold leading-7 text-[var(--aionsi-navy)]">{item.title}</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">{item.description}</p>
                        <div class="mt-6 text-sm font-semibold text-[var(--aionsi-navy)]">Technical evidence <span class="ml-1 text-[var(--aionsi-blue)]">→</span></div>
                      </a>
                    ) : (
                      <article class="group border border-slate-200 bg-white p-6 transition duration-300 hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)] hover:shadow-[0_14px_40px_rgba(2,11,39,.06)]">
                        <div class="flex items-start justify-between gap-4">
                          <span class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span>
                          <span class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">{item.type}</span>
                        </div>
                        <h3 class="mt-6 text-lg font-semibold leading-7 text-[var(--aionsi-navy)]">{item.title}</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">{item.description}</p>
                        <div class="mt-6 text-sm font-semibold text-[var(--aionsi-navy)]">Technical evidence <span class="ml-1 text-[var(--aionsi-blue)]">→</span></div>
                      </article>
                    )
                  ))}
                </div>
              </div>
            </Container>
          </Section>
        ) : (
          <Section>
            <Container>
              <div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:items-start">
                <div>
                  <TechnicalLabel>Engineering Evidence</TechnicalLabel>
                  <h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Evidence before claims.</h2>
                </div>
                <div class="border border-slate-200 p-7 md:p-9">
                  <p class="text-lg leading-8 text-slate-600">Approved whitepapers, technical case studies, architectures, methodologies and other engineering proof points will be added here as the evidence library is completed.</p>
                  {capability.evidenceStatus === 'pending' && (
                    <p class="mt-6 border-l-2 border-[var(--aionsi-orange)] pl-4 text-sm font-semibold text-[var(--aionsi-navy)]">Physical Design evidence is pending from the engineering team.</p>
                  )}
                </div>
              </div>
            </Container>
          </Section>
        )}

        <Section class="bg-[var(--aionsi-deep-navy)] py-16 md:py-20 lg:py-22 text-white">
          <Container class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
            <div>
              <TechnicalLabel>Engineering Engagement</TechnicalLabel>
              <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Need engineering capacity in {capability.title}?</h2>
              <p class="mt-4 max-w-2xl text-lg leading-8 text-white/70">Bring the engineering problem, program stage or capacity requirement. We can connect it to the appropriate AionSi team.</p>
            </div>
            <Button href="/contact">Talk to Our Engineering Team</Button>
          </Container>
        </Section>
      </>
    )}
  </main>
  <Footer />
</BaseLayout>
