---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import { capabilities } from '../../data/capabilities';

export function getStaticPaths() {
  return capabilities.map((capability) => ({
    params: { slug: capability.slug },
    props: { capability },
  }));
}

const { capability } = Astro.props;
const pageTitle = `${capability.title} | AionSi`;
const pageDescription = `${capability.description} Explore AionSi engineering scope, methodology, evidence and engineering outcomes.`;
const isPhysicalDesign = capability.slug === 'physical-design';
const isProtocolVerification = capability.slug === 'protocol-verification';
const isDesignVerification = capability.slug === 'design-verification';
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-16 md:py-20 lg:py-24">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[1.05fr_.95fr] lg:items-center">
          <div>
            <div class="flex items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]"><span>{capability.number}</span><span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span><span>ENGINEERING CAPABILITY</span></div>
            <h1 class="mt-6 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">{capability.title}</h1>
            {isProtocolVerification && <p class="mt-4 max-w-4xl text-xl font-semibold text-[var(--aionsi-blue)] md:text-2xl">De-risk complex interfaces. Accelerate verification closure.</p>}
            <p class="mt-5 max-w-4xl text-xl leading-9 text-slate-600 md:text-2xl">{capability.description}</p>
            {isProtocolVerification && <p class="mt-3 max-w-4xl text-lg leading-8 text-slate-600">Verification engineering for high-speed interfaces and memory protocols across IP, subsystem and SoC programs — from environment development and stimulus through checking, coverage, debug and closure.</p>}
            <div class="mt-7 flex flex-wrap gap-2">{(isProtocolVerification ? ['PCIe','USB','DDR','HBM','AMBA'] : capability.technologies ?? []).map((technology) => <span class="border border-slate-200 bg-white px-3 py-2 text-xs font-semibold tracking-[.04em] text-slate-600">{technology}</span>)}</div>
            <a href="/contact" class="mt-7 inline-flex items-center gap-3 rounded-full bg-[var(--aionsi-orange)] px-6 py-3.5 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:brightness-105">Discuss Your Engineering Requirement <span aria-hidden="true">→</span></a>
          </div>
          {isProtocolVerification ? (
            <div class="border border-slate-200 bg-white p-7 shadow-[0_16px_50px_rgba(2,11,39,.05)] md:p-8">
              <div class="mb-6 h-1 w-11 bg-[var(--aionsi-orange)]"></div>
              <div class="grid gap-3 sm:grid-cols-2">
                {['Interface specification','UVM environment','Stimulus & scenarios','Checking & assertions','Coverage & regression','Debug & closure'].map((item, index) => <div class="bg-[var(--aionsi-surface-alt)] px-4 py-4 text-sm font-semibold text-[var(--aionsi-navy)]"><span class="mr-3 text-[10px] font-semibold tracking-[.14em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span>{item}</div>)}
              </div>
            </div>
          ) : null}
        </div>
      </Container>
    </Section>

    {isProtocolVerification && <Section class="py-14 md:py-18 lg:py-20"><Container><div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:items-start"><div><TechnicalLabel>Engineering Scope</TechnicalLabel><h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Where this capability contributes.</h2></div><div class="border-l border-slate-200 pl-6 text-lg leading-8 text-slate-600 md:pl-8"><p>Protocol-focused verification for complex semiconductor interfaces.</p><p class="mt-4">AionSi can support protocol verification across interface specification, reusable UVM environment development, stimulus and scenarios, checking and assertions, coverage and regression, and debug/closure workflows.</p></div></div></Container></Section>}

    {isProtocolVerification && <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18 lg:py-20"><Container><div class="grid gap-6 md:grid-cols-2"><div class="border border-slate-200 bg-white p-7 md:p-8"><TechnicalLabel>Engineering Stack</TechnicalLabel><div class="mt-5 grid gap-3 sm:grid-cols-2">{['SystemVerilog / UVM','PCIe · USB · DDR · HBM · AMBA/AXI','Reusable agents and environments','Sequencers · drivers · BFMs','Scoreboards · predictors · assertions','Coverage · regression · debug / closure'].map((item) => <div class="border border-slate-100 bg-[var(--aionsi-surface-alt)] px-4 py-3 text-sm font-medium text-slate-600">{item}</div>)}</div></div><div class="border border-slate-200 bg-white p-7 md:p-8"><TechnicalLabel>Engineering Outcomes</TechnicalLabel><div class="mt-5 space-y-3">{['De-risk complex interfaces','Accelerate verification closure','Reusable verification across programs','Scale from specialist support to dedicated engineering ODC'].map((item,index) => <div class="flex items-start gap-3 text-sm font-medium text-[var(--aionsi-navy)]"><span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[var(--aionsi-blue)]/30 text-[10px] font-semibold text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><span>{item}</span></div>)}</div></div></div></Container></Section>}

    {!isProtocolVerification && <Section class="py-14 md:py-18 lg:py-20"><Container><div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:items-start"><div><TechnicalLabel>Engineering Scope</TechnicalLabel><h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Where this capability contributes.</h2></div><div class="border-l border-slate-200 pl-6 text-lg leading-8 text-slate-600 md:pl-8"><p>{capability.description}</p>{isDesignVerification ? <p class="mt-4">AionSi applies disciplined verification across block, subsystem and SoC levels, combining reusable SystemVerilog/UVM infrastructure with coverage, assertions, protocol checking, processor-driven scenarios, formal planning and regression/debug workflows.</p> : isPhysicalDesign ? <p class="mt-4">Representative engineering experience covers floorplanning, placement, clock-tree synthesis, routing, congestion optimization, timing closure, physical verification and sign-off across advanced-node ASIC and SoC programs.</p> : <p class="mt-4">Detailed engineering scope, methodologies and program evidence are presented from AionSi's approved technical source material.</p>}</div></div></Container></Section>}

    {capability.evidence?.length ? <Section class="py-16 md:py-20 lg:py-24"><Container><div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div class="lg:sticky lg:top-28"><TechnicalLabel>Engineering Evidence</TechnicalLabel><h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Technical proof before commercial scope.</h2><p class="mt-4 max-w-md text-slate-600">Explore approved technical material supporting the engineering capability represented on this page.</p></div><div class="grid gap-4 md:grid-cols-2">{capability.evidence.map((item,index) => item.href ? <a href={item.href} class="group border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)] hover:shadow-[0_14px_40px_rgba(2,11,39,.06)]"><div class="flex items-start justify-between gap-4"><span class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><span class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">{item.type === 'whitepaper' ? 'TECHNICAL WHITEPAPER' : 'TECHNICAL CASE STUDY'}</span></div><h3 class="mt-6 text-lg font-semibold leading-7 text-[var(--aionsi-navy)]">{item.title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{item.description}</p><div class="mt-6 text-sm font-semibold text-[var(--aionsi-navy)]">Technical evidence <span class="ml-1 text-[var(--aionsi-blue)]">→</span></div></a> : <article class="border border-slate-200 bg-white p-6"><h3 class="text-lg font-semibold text-[var(--aionsi-navy)]">{item.title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{item.description}</p></article>)}</div></div></Container></Section> : <Section><Container><div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:items-start"><div><TechnicalLabel>Engineering Evidence</TechnicalLabel><h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Evidence before claims.</h2></div><div class="border border-slate-200 p-7 md:p-9"><p class="text-lg leading-8 text-slate-600">Approved whitepapers, technical case studies, architectures, methodologies and other engineering proof points will be added here as the evidence library is completed.</p></div></div></Container></Section>}

    {isPhysicalDesign && <Section class="bg-white py-14 md:py-18 lg:py-20"><Container><TechnicalLabel>Representative Engineering Experience</TechnicalLabel><div class="mt-4 grid gap-6 md:grid-cols-2 lg:grid-cols-3"><article class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-6"><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">Advanced Node</div><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">3nm High-Complexity Block</h3><p class="mt-3 text-sm leading-6 text-slate-600">Representative experience: 352 macros, ~8M cells, 2.4 GHz, 17 metal layers and 3 power domains; floorplan through sign-off.</p></article><article class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-6"><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">Power-Domain Complexity</div><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">3nm Multi-Power-Domain Block</h3><p class="mt-3 text-sm leading-6 text-slate-600">Representative experience: 189 macros, ~4.3M cells, 2.8 GHz, 15 metal layers and 7 power domains across implementation and sign-off.</p></article><article class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-6"><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">Closure Engineering</div><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">Congestion & Timing Closure</h3><p class="mt-3 text-sm leading-6 text-slate-600">Representative experience using blockages, cell padding, density screens, path groups, repeater bounds and manual ECOs to address physical closure issues.</p></article></div></Container></Section>}

    <Section class="bg-[var(--aionsi-navy)] py-14 md:py-18 lg:py-20"><Container><div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between"><div><TechnicalLabel>Engineering Discussion</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-4xl">Bring the engineering problem.</h2><p class="mt-4 max-w-3xl text-lg leading-8 text-slate-300">Share the interface, engineering stage, current bottleneck and required capacity. We can map the requirement to the appropriate AionSi engineering model.</p></div><a href="/contact" class="inline-flex shrink-0 items-center gap-3 rounded-full bg-[var(--aionsi-orange)] px-6 py-3.5 text-sm font-semibold text-white">Discuss Your Engineering Requirement <span aria-hidden="true">→</span></a></div></Container></Section>
  </main>
  <Footer />
</BaseLayout>
