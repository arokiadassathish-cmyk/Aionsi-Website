---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { capabilities } from '../../data/capabilities';
import { protocolConversionScenarios } from '../../data/conversionMatrix';
import ConversionMatrix from '../../components/conversion/ConversionMatrix.astro';

export function getStaticPaths() {
  return capabilities.map((capability) => ({
    params: { slug: capability.slug },
    props: { capability },
  }));
}

const { capability } = Astro.props;
const pageTitle = `${capability.title} | AionSi`;
const pageDescription = `${capability.description} Explore AionSi engineering scope, methodology, evidence and engineering outcomes.`;
const isProtocol = capability.slug === 'protocol-verification';
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-16 md:py-20 lg:py-24">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[1fr_.72fr] lg:items-end">
          <div>
            <div class="flex items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]">
              <span>{capability.number}</span><span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span><span>ENGINEERING CAPABILITY</span>
            </div>
            <h1 class="mt-6 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">{capability.title}</h1>
            {isProtocol && <p class="mt-4 max-w-3xl text-xl font-semibold tracking-[.02em] text-[var(--aionsi-blue)] md:text-2xl">De-risk complex interfaces. Accelerate verification closure.</p>}
            <p class="mt-5 max-w-4xl text-xl leading-9 text-slate-600 md:text-2xl">{isProtocol ? 'Protocol verification engineering across IP, subsystem and SoC programs.' : capability.description}</p>
            <div class="mt-8 flex flex-wrap gap-2">{capability.technologies?.map((technology) => <span class="border border-slate-200 bg-white px-3 py-2 text-xs font-semibold tracking-[.04em] text-slate-600">{technology}</span>)}</div>
            {isProtocol && <div class="mt-8"><Button href="/contact">Discuss Your Verification Requirement</Button></div>}
          </div>
          {isProtocol && <div class="border border-slate-200 bg-white p-5 shadow-sm md:p-6"><TechnicalLabel>Verification Flow</TechnicalLabel><div class="grid gap-2 text-sm font-semibold text-[var(--aionsi-navy)] sm:grid-cols-2">{['Protocol','Environment','Stimulus','Checking','Coverage','Regression','Closure'].map((item, index) => <div class="flex items-center gap-3 border border-slate-100 bg-[var(--aionsi-surface-alt)] px-4 py-3"><span class="text-[10px] font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span><span>{item}</span></div>)}</div></div>}
        </div>
      </Container>
    </Section>

    {isProtocol ? (
      <>
        <Section class="py-12 md:py-14 lg:py-16"><Container><div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div><TechnicalLabel>Engineering Pressure</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Protocol verification engagements begin with an engineering constraint.</h2></div><div class="grid gap-5 text-lg leading-8 text-slate-600 md:grid-cols-2"><p class="border-l-2 border-[var(--aionsi-orange)] pl-5">A milestone is at risk. A new interface needs verification. Coverage is not closing fast enough. Existing environments are being rebuilt.</p><p class="border-l border-slate-200 pl-5">Or multiple programs require additional verification capacity and scalable external execution.</p></div></div></Container></Section>

        <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-14 lg:py-16"><Container><div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between"><div><TechnicalLabel>Engineering Conversion Matrix</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Choose the problem. Follow the path to engagement.</h2></div><p class="max-w-xl text-sm leading-6 text-slate-500">Each scenario preserves the evidence-before-claims boundary and routes only to an engagement model supported by the approved conversion matrix.</p></div><div class="mt-8"><ConversionMatrix scenarios={protocolConversionScenarios} /></div></Container></Section>

        <Section class="py-12 md:py-14 lg:py-16"><Container><div class="grid gap-10 lg:grid-cols-[.65fr_1.35fr] lg:items-start"><div><TechnicalLabel>Technical Scope</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">From interface stimulus to verification closure.</h2><p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">AionSi can contribute protocol-aware verification infrastructure across environment development, checking, coverage, regression and closure.</p></div><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{[['Protocols','PCIe · USB · DDR · AMBA'],['Environment','SystemVerilog · UVM · reusable agents'],['Stimulus','Sequencers · drivers · BFMs · scenarios'],['Checking','Scoreboards · predictors · assertions'],['Analysis','Functional/code coverage · error injection'],['Closure','Regression · debug · coverage closure']].map(([title, detail]) => <div class="border border-slate-200 bg-white p-5"><h3 class="font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{detail}</p></div>)}</div></div></Container></Section>

        <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-14 lg:py-16"><Container><div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div><TechnicalLabel>Engineering Evidence</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Evidence before claims.</h2><p class="mt-4 max-w-md text-slate-600">Technical proof points should establish credibility before the discussion moves to scope, milestones or team size.</p></div><div class="grid gap-4 md:grid-cols-2">{(capability.evidence ?? []).slice(0, 4).map((item, index) => <a href={item.href ?? '#'} class="group border border-slate-200 bg-white p-6 transition duration-300 hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)] hover:shadow-[0_14px_40px_rgba(2,11,39,.06)]"><div class="flex items-start justify-between gap-4"><span class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span><span class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">{item.type}</span></div><h3 class="mt-6 text-lg font-semibold leading-7 text-[var(--aionsi-navy)]">{item.title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{item.description}</p><div class="mt-6 text-sm font-semibold text-[var(--aionsi-navy)]">Technical evidence <span class="ml-1 text-[var(--aionsi-blue)]">→</span></div></a>)}</div></div></Container></Section>

        <Section class="py-12 md:py-14 lg:py-16"><Container><div class="grid gap-8 lg:grid-cols-[.65fr_1.35fr] lg:items-start"><div><TechnicalLabel>Account Expansion Path</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Start focused. Expand with the program.</h2><p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">The first engagement does not need to be an ODC. AionSi can enter through a focused engineering need and expand as scope, trust and program requirements grow.</p></div><div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">{[['01','Specialist','Targeted protocol engineering capacity'],['02','Workstream','Defined scope with milestones and closure'],['03','Project','Bounded verification package or deliverable'],['04','ODC','Dedicated team aligned to the customer roadmap, methodology and governance']].map(([number,title,description]) => <div class="border border-slate-200 bg-white p-5"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{number}</span><h3 class="mt-3 text-lg font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{description}</p></div>)}</div></div></Container></Section>

        <Section class="bg-[var(--aionsi-deep-navy)] py-14 md:py-16 lg:py-18 text-white"><Container><div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center"><div class="max-w-4xl"><TechnicalLabel>Engineering Discovery</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">Bring the verification problem. Let's scope it together.</h2><p class="mt-4 text-base leading-7 text-white/70 md:text-lg md:leading-8">Tell us what is being verified, where the program is constrained and what needs to close. AionSi can map the requirement to the appropriate engineering team and engagement model.</p></div><Button href="/contact">Discuss Your Verification Requirement</Button></div></Container></Section>
      </>
    ) : (
      <>
        <Section class="py-14 md:py-18 lg:py-20"><Container><div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:items-start"><div><TechnicalLabel>Engineering Scope</TechnicalLabel><h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Where this capability contributes.</h2></div><div class="border-l border-slate-200 pl-6 text-lg leading-8 text-slate-600 md:pl-8"><p>{capability.description}</p><p class="mt-4">Detailed engineering scope, methodologies and program evidence are presented from AionSi's approved technical source material.</p></div></div></Container></Section>
        <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18 lg:py-20"><Container><div class="grid gap-6 md:grid-cols-2"><div class="border border-slate-200 bg-white p-7 md:p-8"><TechnicalLabel>Technology / Methodology</TechnicalLabel><div class="mt-5 flex flex-wrap gap-2">{capability.technologies?.map((technology) => <span class="border border-slate-200 px-3 py-2 text-sm text-slate-600">{technology}</span>)}</div></div><div class="border border-slate-200 bg-white p-7 md:p-8"><TechnicalLabel>Engineering Outcome</TechnicalLabel><p class="mt-5 text-xl font-semibold leading-8 text-[var(--aionsi-navy)]">{capability.outcome ?? 'Engineering outcome will be defined from the approved technical evidence.'}</p></div></div></Container></Section>
        <Section class="py-14 md:py-18 lg:py-20"><Container><div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div><TechnicalLabel>Engineering Evidence</TechnicalLabel><h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Evidence before claims.</h2></div><div class="border border-slate-200 p-7 md:p-9"><p class="text-lg leading-8 text-slate-600">Approved whitepapers, technical case studies, architectures, methodologies and other engineering proof points will be added here as the evidence library is completed.</p></div></div></Container></Section>
        <Section class="bg-[var(--aionsi-deep-navy)] py-16 md:py-20 lg:py-22 text-white"><Container class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center"><div><TechnicalLabel>Engineering Engagement</TechnicalLabel><h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Need engineering capacity in {capability.title}?</h2><p class="mt-4 max-w-3xl text-lg leading-8 text-white/70">Bring the engineering problem, program stage or capacity requirement. We can connect it to the appropriate AionSi team.</p></div><Button href="/contact">Talk to Our Engineering Team</Button></Container></Section>
      </>
    )}
  </main>
  <Footer />
</BaseLayout>
