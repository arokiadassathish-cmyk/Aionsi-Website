---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { capabilities } from '../../data/capabilities';
import { protocolConversionScenarios } from '../../data/conversionMatrix';
import ConversionMatrix from '../../components/conversion/ConversionMatrix.astro';

export function getStaticPaths() {
  return capabilities.map((capability) => ({
    params: { slug: capability.slug },
    props: { capability },
  }));
}

const { capability } = Astro.props;
const pageTitle = `${capability.title} | AionSi`;
const pageDescription = `${capability.description} Explore AionSi engineering scope, methodology, evidence and engineering outcomes.`;
const isProtocol = capability.slug === 'protocol-verification';
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    {isProtocol ? (
      <>
        <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-16 lg:py-20">
          <Container>
            <div class="grid gap-8 lg:grid-cols-[1fr_.74fr] lg:items-center lg:gap-12">
              <div>
                <div class="flex items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]"><span>{capability.number}</span><span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span><span>ENGINEERING CAPABILITY</span></div>
                <h1 class="mt-6 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">{capability.title}</h1>
                <p class="mt-4 max-w-3xl text-xl font-semibold tracking-[.02em] text-[var(--aionsi-blue)] md:text-2xl">De-risk complex interfaces. Accelerate verification closure.</p>
                <p class="mt-5 max-w-4xl text-xl leading-9 text-slate-600 md:text-2xl">Verification engineering for high-speed interfaces and memory protocols across IP, subsystem and SoC programs.</p>
                <p class="mt-3 max-w-4xl text-base leading-7 text-slate-500 md:text-lg">From environment development and stimulus through checking, coverage, debug and closure.</p>
                <div class="mt-7 flex flex-wrap gap-2">{capability.technologies?.map((technology) => <span class="border border-slate-200 bg-white px-3 py-2 text-xs font-semibold tracking-[.04em] text-slate-600">{technology}</span>)}</div>
                <div class="mt-7"><Button href="/contact">Discuss Your Verification Requirement</Button></div>
              </div>
              <div class="border border-slate-200 bg-white p-5 shadow-sm md:p-6"><TechnicalLabel>Verification Flow</TechnicalLabel><div class="mt-5 grid gap-2 text-sm font-semibold text-[var(--aionsi-navy)] sm:grid-cols-2">{['Interface specification','UVM environment','Stimulus & scenarios','Checking & assertions','Coverage & regression','Debug & closure'].map((item, index) => <div class="flex items-center gap-3 border border-slate-100 bg-[var(--aionsi-surface-alt)] px-4 py-3"><span class="text-[10px] font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index + 1).padStart(2,'0')}</span><span>{item}</span></div>)}</div></div>
            </div>
          </Container>
        </Section>

        <Section class="py-10 md:py-12 lg:py-14"><Container><div class="grid gap-7 lg:grid-cols-[.72fr_1.28fr] lg:items-start"><div><TechnicalLabel>Engineering Pressure</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Verification pressure usually appears in a few predictable places.</h2></div><div class="grid gap-4 sm:grid-cols-2"><div class="border-l-2 border-[var(--aionsi-orange)] pl-5 text-lg leading-8 text-slate-600">Capacity constraints, new interface introduction and milestone risk.</div><div class="border-l border-slate-200 pl-5 text-lg leading-8 text-slate-600">Coverage gaps, environment reuse needs and scalable external execution.</div></div></div></Container></Section>

        <Section class="bg-[var(--aionsi-surface-alt)] py-10 md:py-12 lg:py-14"><Container><div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between"><div><TechnicalLabel>Engineering Conversion</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Choose the problem. Follow the path to engagement.</h2></div><p class="max-w-xl text-sm leading-6 text-slate-500">Select the engineering situation closest to your program to see the corresponding scope, delivery model and expansion path.</p></div><div class="mt-7"><ConversionMatrix scenarios={protocolConversionScenarios} /></div></Container></Section>

        <Section class="py-10 md:py-12 lg:py-14"><Container><div class="grid gap-8 lg:grid-cols-[.62fr_1.38fr] lg:items-start"><div><TechnicalLabel>Technical Scope</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">From interface stimulus to verification closure.</h2><p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">AionSi can contribute protocol-aware verification infrastructure across environment development, stimulus, checking, coverage, debug, regression and closure.</p></div><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{[['Protocols','PCIe · USB · DDR · HBM · AMBA/AXI'],['Environment','SystemVerilog · UVM · reusable agents'],['Stimulus','Sequencers · drivers · BFMs · scenarios'],['Checking','Scoreboards · predictors · assertions'],['Analysis','Functional/code coverage · error injection'],['Closure','Regression · debug · coverage closure']].map(([title, detail]) => <div class="border border-slate-200 bg-white p-5"><h3 class="font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{detail}</p></div>)}</div></div></Container></Section>

        <Section class="bg-[var(--aionsi-deep-navy)] py-10 md:py-12 lg:py-14 text-white"><Container><div class="grid gap-7 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div><TechnicalLabel>Engineering Evidence</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">Technical proof before commercial scope.</h2><p class="mt-4 max-w-md text-white/70">Explore the approved technical material that supports the verification capability represented on this page.</p></div><div class="grid gap-4 md:grid-cols-2">{(capability.evidence ?? []).slice(0,4).map((item, index) => <a href={item.href ?? '#'} class="group border border-white/10 bg-white p-6 text-[var(--aionsi-navy)] transition duration-300 hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)] hover:shadow-[0_14px_40px_rgba(2,11,39,.12)]"><div class="flex items-start justify-between gap-4"><span class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><span class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">Technical Whitepaper</span></div><h3 class="mt-5 text-lg font-semibold leading-7">{item.title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{item.description}</p><div class="mt-5 text-sm font-semibold">View Technical Evidence <span class="ml-1 text-[var(--aionsi-blue)]">→</span></div></a>)}</div></div></Container></Section>

        <Section class="py-10 md:py-12 lg:py-14"><Container><div class="grid gap-7 lg:grid-cols-[.62fr_1.38fr] lg:items-start"><div><TechnicalLabel>Account Expansion Path</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Start focused. Expand with the program.</h2><p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">The first engagement does not need to be an ODC. AionSi can enter through a focused engineering need and expand as scope, trust and program requirements grow.</p></div><div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">{[['01','Specialist','Targeted protocol engineering capacity'],['02','Workstream','Defined scope with milestones and closure'],['03','Project','Bounded verification package or deliverable'],['04','ODC','Dedicated team aligned to the customer roadmap']].map(([number,title,description]) => <div class="border border-slate-200 bg-white p-5"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{number}</span><h3 class="mt-3 text-lg font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{description}</p></div>)}</div></div></Container></Section>

        <Section class="bg-[var(--aionsi-deep-navy)] py-10 md:py-12 lg:py-14 text-white"><Container><div class="grid gap-7 lg:grid-cols-[1fr_auto] lg:items-center"><div class="max-w-4xl"><TechnicalLabel>Engineering Discovery</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">Bring the verification problem. Start the engineering discussion.</h2><p class="mt-4 text-base leading-7 text-white/70 md:text-lg md:leading-8">Share the interface, verification stage, current bottleneck and required engineering capacity. We can map the requirement to the appropriate AionSi engineering model.</p></div><Button href="/contact">Discuss Your Verification Requirement</Button></div></Container></Section>
      </>
    ) : (
      <>
        <Section class="bg-[var(--aionsi-surface-alt)] py-20 md:py-24 lg:py-26"><Container><div class="max-w-5xl"><div class="flex items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]"><span>{capability.number}</span><span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span><span>ENGINEERING CAPABILITY</span></div><h1 class="mt-6 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">{capability.title}</h1><p class="mt-5 max-w-4xl text-xl leading-9 text-slate-600 md:text-2xl">{capability.description}</p><div class="mt-8 flex flex-wrap gap-2">{capability.technologies?.map((technology) => <span class="border border-slate-200 bg-white px-3 py-2 text-xs font-semibold tracking-[.04em] text-slate-600">{technology}</span>)}</div></div></Container></Section>
        <Section class="py-14 md:py-18 lg:py-20"><Container><div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:items-start"><div><TechnicalLabel>Engineering Scope</TechnicalLabel><h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Where this capability contributes.</h2></div><div class="border-l border-slate-200 pl-6 text-lg leading-8 text-slate-600 md:pl-8"><p>{capability.description}</p><p class="mt-4">Detailed engineering scope, methodologies and program evidence are presented from AionSi's approved technical source material.</p></div></div></Container></Section>
        <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18 lg:py-20"><Container><div class="grid gap-6 md:grid-cols-2"><div class="border border-slate-200 bg-white p-7 md:p-8"><TechnicalLabel>Technology / Methodology</TechnicalLabel><div class="mt-5 flex flex-wrap gap-2">{capability.technologies?.map((technology) => <span class="border border-slate-200 px-3 py-2 text-sm text-slate-600">{technology}</span>)}</div></div><div class="border border-slate-200 bg-white p-7 md:p-8"><TechnicalLabel>Engineering Outcome</TechnicalLabel><p class="mt-5 text-xl font-semibold leading-8 text-[var(--aionsi-navy)]">{capability.outcome ?? 'Engineering outcome will be defined from the approved technical evidence.'}</p></div></div></Container></Section>
        {capability.evidence?.length ? <Section class="py-16 md:py-20 lg:py-24"><Container><div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div><TechnicalLabel>Engineering Evidence</TechnicalLabel><h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Evidence before claims.</h2><p class="mt-4 max-w-md text-slate-600">Technical evidence drawn from approved AionSi engineering source material.</p></div><div class="grid gap-4 md:grid-cols-2">{capability.evidence.map((item,index) => item.href ? <a href={item.href} class="group border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)] hover:shadow-[0_14px_40px_rgba(2,11,39,.06)]"><div class="flex items-start justify-between gap-4"><span class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><span class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">{item.type}</span></div><h3 class="mt-6 text-lg font-semibold leading-7 text-[var(--aionsi-navy)]">{item.title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{item.description}</p><div class="mt-6 text-sm font-semibold text-[var(--aionsi-navy)]">Technical evidence <span class="ml-1 text-[var(--aionsi-blue)]">→</span></div></a> : <article class="border border-slate-200 bg-white p-6"><h3 class="text-lg font-semibold text-[var(--aionsi-navy)]">{item.title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{item.description}</p></article>)}</div></div></Container></Section> : <Section><Container><div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:items-start"><div><TechnicalLabel>Engineering Evidence</TechnicalLabel><h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Evidence before claims.</h2></div><div class="border border-slate-200 p-7 md:p-9"><p class="text-lg leading-8 text-slate-600">Approved whitepapers, technical case studies, architectures, methodologies and other engineering proof points will be added here as the evidence library is completed.</p></div></div></Container></Section>}
        <Section class="bg-[var(--aionsi-deep-navy)] py-16 md:py-20 lg:py-22 text-white"><Container class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center"><div><TechnicalLabel>Engineering Engagement</TechnicalLabel><h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Need engineering capacity in {capability.title}?</h2><p class="mt-4 max-w-3xl text-lg leading-8 text-white/70">Bring the engineering problem, program stage or capacity requirement. We can connect it to the appropriate AionSi team.</p></div><Button href="/contact">Talk to Our Engineering Team</Button></Container></Section>
      </>
    )}
  </main>
  <Footer />
</BaseLayout>
