---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { capabilities } from '../../data/capabilities';

export function getStaticPaths() {
  return capabilities.map((capability) => ({
    params: { slug: capability.slug },
    props: { capability },
  }));
}

const { capability } = Astro.props;
const pageTitle = `${capability.title} | AionSi`;
const pageDescription = `${capability.description} Explore AionSi engineering scope, methodology, evidence and engineering outcomes.`;
const isProtocol = capability.slug === 'protocol-verification';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-20 md:py-24 lg:py-26">
      <Container>
        <div class="max-w-5xl">
          <div class="flex items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]">
            <span>{capability.number}</span>
            <span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span>
            <span>ENGINEERING CAPABILITY</span>
          </div>
          <h1 class="mt-6 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">{capability.title}</h1>
          {isProtocol && <p class="mt-3 text-lg font-semibold tracking-[.04em] text-[var(--aionsi-blue)] md:text-xl">High-Speed Interface &amp; Memory Protocol Verification</p>}
          <p class="mt-5 max-w-4xl text-xl leading-9 text-slate-600 md:text-2xl">{capability.description}</p>
          <div class="mt-8 flex flex-wrap gap-2">
            {capability.technologies?.map((technology) => (
              <span class="border border-slate-200 bg-white px-3 py-2 text-xs font-semibold tracking-[.04em] text-slate-600">{technology}</span>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    {isProtocol ? (
      <>
        <Section class="py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
              <div>
                <TechnicalLabel>Engineering Challenge</TechnicalLabel>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Complex interfaces require more than functional stimulus.</h2>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Protocol compliance</h3><p class="mt-2 text-sm leading-6 text-slate-600">Specification-driven checks for transactions, sequencing, state behavior and interface rules.</p></div>
                <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Corner-case behavior</h3><p class="mt-2 text-sm leading-6 text-slate-600">Stress, recovery, invalid traffic, boundary conditions and error scenarios.</p></div>
                <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Interoperability</h3><p class="mt-2 text-sm leading-6 text-slate-600">Verification of complex interface interactions with reusable protocol-aware environments.</p></div>
                <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Coverage closure</h3><p class="mt-2 text-sm leading-6 text-slate-600">Meaningful functional, assertion and scenario coverage backed by regression and debug.</p></div>
              </div>
            </div>
          </Container>
        </Section>

        <Section class="bg-[var(--aionsi-deep-navy)] py-14 md:py-16 lg:py-20 text-white">
          <Container>
            <div class="grid gap-8 lg:grid-cols-[.4fr_1.6fr] lg:items-center">
              <div>
                <TechnicalLabel>Reference Architecture</TechnicalLabel>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">Reusable protocol verification architecture.</h2>
                <p class="mt-4 text-lg leading-8 text-white/70">A reusable UVM structure connecting protocol stimulus, agents, monitoring, checking, coverage and regression analysis across block, subsystem and SoC programs.</p>
                <div class="mt-5 grid gap-2 text-sm text-white/70 sm:grid-cols-2">
                  <div class="border border-white/10 bg-white/5 px-4 py-3">Stimulus → DUT interaction</div>
                  <div class="border border-white/10 bg-white/5 px-4 py-3">Protocol agents → monitors</div>
                  <div class="border border-white/10 bg-white/5 px-4 py-3">Scoreboard + predictor</div>
                  <div class="border border-white/10 bg-white/5 px-4 py-3">Assertions + coverage</div>
                </div>
              </div>
              <figure class="border border-white/15 bg-white p-2 shadow-2xl shadow-black/10">
                <div class="flex min-h-64 items-center justify-center bg-slate-50 md:min-h-80">
                  <div class="w-full p-8 text-center md:p-14">
                    <div class="text-sm font-semibold uppercase tracking-[.2em] text-[var(--aionsi-blue)]">Protocol Verification Flow</div>
                    <div class="mt-8 grid gap-3 sm:grid-cols-5">
                      {['UVM Test','Protocol Agents','DUT','Scoreboard','Coverage + SVA'].map((item, index) => (
                        <div class="border border-slate-200 bg-white p-4 text-sm font-semibold text-[var(--aionsi-navy)]">
                          <span class="block text-[10px] tracking-[.16em] text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span>
                          <span class="mt-2 block">{item}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
                <figcaption class="px-2 pb-1 pt-3 text-xs leading-5 text-slate-500">Reference methodology. Protocol-specific architecture is represented through the evidence set below.</figcaption>
              </figure>
            </div>
          </Container>
        </Section>

        <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-6 md:grid-cols-2">
              <div class="border border-slate-200 bg-white p-7 md:p-8">
                <TechnicalLabel>Verification Methodology</TechnicalLabel>
                <div class="mt-6 flex flex-wrap items-center gap-2 text-xs font-semibold tracking-[.05em] text-[var(--aionsi-navy)]">
                  {['Plan','Model','Stimulate','Monitor','Check','Measure','Close'].map((stage, index) => (
                    <div class="flex items-center gap-2">
                      <div class="border border-blue-200 bg-[var(--aionsi-surface-alt)] px-3 py-2">{String(index + 1).padStart(2, '0')} {stage}</div>
                      {index < 6 && <span class="text-slate-300">→</span>}
                    </div>
                  ))}
                </div>
                <div class="mt-6 grid gap-3 sm:grid-cols-2">
                  {['Protocol modeling and scenario planning','Reusable UVM agents, drivers and monitors','Assertions and protocol checkers','Scoreboard, predictor and reference models','Error injection and corner-case scenarios','Functional, assertion and cross coverage','Regression, debug and closure'].map((item) => (
                    <div class="border border-slate-200 bg-white p-4 text-sm font-medium leading-6 text-[var(--aionsi-navy)]">{item}</div>
                  ))}
                </div>
              </div>
              <div class="border border-slate-200 bg-white p-7 md:p-8">
                <TechnicalLabel>Protocol Scope</TechnicalLabel>
                <div class="mt-6 grid gap-3 sm:grid-cols-2">
                  {[
                    ['PCIe 5/6','TLP/DLLP, replay, flow control, error handling and protocol closure.'],
                    ['USB 3.0 / USB4','Packet layer, link management, recovery, flow control and compliance scenarios.'],
                    ['DDR5 / LPDDR6','Memory interface, timing compliance, command sequencing, DFI/protocol checks and synchronization.'],
                    ['HBM4e','Multi-channel memory interface, training, calibration, PHY timing and reliability validation.'],
                    ['AMBA / AXI','Reusable master/slave verification environments and transaction checking.'],
                    ['UFS / MIPI / Ethernet','Protocol capability areas within the broader high-speed interface portfolio.'],
                  ].map(([title, desc]) => (
                    <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5"><h3 class="font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p></div>
                  ))}
                </div>
                <p class="mt-5 text-xs leading-6 text-slate-500">Technology positioning is separated from detailed case-study claims; deeper evidence is linked below where approved source material is available.</p>
              </div>
            </div>
          </Container>
        </Section>

        <Section class="py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
              <div class="lg:sticky lg:top-28">
                <TechnicalLabel>Engineering Evidence</TechnicalLabel>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Evidence before claims.</h2>
                <p class="mt-4 max-w-md text-slate-600">Protocol evidence is organized from the AionSi engineering portfolio and the approved corporate capability flyer.</p>
              </div>
              <div class="grid gap-4 md:grid-cols-2">
                {capability.evidence?.map((item, index) => (
                  item.href ? (
                    <a href={item.href} class="group border border-slate-200 bg-white p-6 transition duration-300 hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)] hover:shadow-[0_14px_40px_rgba(2,11,39,.06)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--aionsi-blue)] focus-visible:ring-offset-2">
                      <div class="flex items-start justify-between gap-4"><span class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span><span class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">{item.type}</span></div>
                      <h3 class="mt-6 text-lg font-semibold leading-7 text-[var(--aionsi-navy)]">{item.title}</h3>
                      <p class="mt-3 text-sm leading-6 text-slate-600">{item.description}</p>
                      <div class="mt-6 text-sm font-semibold text-[var(--aionsi-navy)]">Technical evidence <span class="ml-1 text-[var(--aionsi-blue)]">→</span></div>
                    </a>
                  ) : (
                    <article class="border border-slate-200 bg-white p-6"><div class="flex items-start justify-between gap-4"><span class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span><span class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">{item.type}</span></div><h3 class="mt-6 text-lg font-semibold leading-7 text-[var(--aionsi-navy)]">{item.title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{item.description}</p></article>
                  )
                ))}
              </div>
            </div>
          </Container>
        </Section>

        <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-10 lg:grid-cols-2">
              <div>
                <TechnicalLabel>Verification Depth</TechnicalLabel>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">From protocol rules to system closure.</h2>
              </div>
              <div class="grid gap-3 sm:grid-cols-2">
                {['Protocol compliance','Functional correctness','Error injection & recovery','Assertions & checkers','Coverage & regression','Block → subsystem → SoC scaling'].map((item, index) => (
                  <div class="border border-slate-200 bg-white p-5"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span><h3 class="mt-3 font-semibold text-[var(--aionsi-navy)]">{item}</h3></div>
                ))}
              </div>
            </div>
          </Container>
        </Section>

        <Section class="py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
              <div>
                <TechnicalLabel>Engineering Delivery</TechnicalLabel>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Start with the protocol need. Scale with the program.</h2>
                <p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">AionSi can contribute as specialist engineering capacity, a managed verification workstream, a scoped project or a dedicated engineering ODC.</p>
              </div>
              <div class="grid gap-3 sm:grid-cols-2">
                {['Specialist protocol verification','Managed verification workstream','Project / turnkey delivery','Dedicated engineering ODC'].map((item, index) => (
                  <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-6"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</span><h3 class="mt-3 font-semibold text-[var(--aionsi-navy)]">{item}</h3></div>
                ))}
              </div>
            </div>
          </Container>
        </Section>
      </>
    ) : (
      <>
        <Section class="py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:items-start">
              <div><TechnicalLabel>Engineering Scope</TechnicalLabel><h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Where this capability contributes.</h2></div>
              <div class="border-l border-slate-200 pl-6 text-lg leading-8 text-slate-600 md:pl-8"><p>{capability.description}</p><p class="mt-4">Detailed engineering scope, methodologies and program evidence are presented from AionSi's approved technical source material.</p></div>
            </div>
          </Container>
        </Section>

        <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {capability.technologies?.map((technology) => (
                <div class="border border-slate-200 bg-white p-7"><h3 class="font-semibold text-[var(--aionsi-navy)]">{technology}</h3><p class="mt-2 text-sm leading-6 text-slate-600">Engineering scope and implementation support around {technology} programs.</p></div>
              ))}
            </div>
          </Container>
        </Section>

        <Section class="py-14 md:py-18 lg:py-20">
          <Container>
            <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
              <div><TechnicalLabel>Engineering Outcomes</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Engineering outcomes aligned to defined programs.</h2></div>
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Execution confidence</h3><p class="mt-2 text-sm leading-6 text-slate-600">Defined workstreams with clear scope, milestones and deliverables.</p></div>
                <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Reusable engineering</h3><p class="mt-2 text-sm leading-6 text-slate-600">Methodologies and engineering assets that can extend across programs.</p></div>
                <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Verification closure</h3><p class="mt-2 text-sm leading-6 text-slate-600">Coverage, debug, regression and sign-off activities aligned to project objectives.</p></div>
                <div class="border border-slate-200 bg-white p-6"><h3 class="font-semibold text-[var(--aionsi-navy)]">Scalable delivery</h3><p class="mt-2 text-sm leading-6 text-slate-600">Specialist capacity, managed workstreams and dedicated engineering teams.</p></div>
              </div>
            </div>
          </Container>
        </Section>
      </>
    )}

    <Section class="bg-[var(--aionsi-deep-navy)] py-16 md:py-20 lg:py-24 text-white">
      <Container>
        <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <TechnicalLabel>Engineering Engagement</TechnicalLabel>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">Need engineering capacity in {capability.title}?</h2>
            <p class="mt-4 max-w-2xl text-lg leading-8 text-white/70">Bring the engineering problem, program stage or capacity requirement. We can connect it to the appropriate AionSi team.</p>
          </div>
          <Button href="/contact">Talk to Our Engineering Team</Button>
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
