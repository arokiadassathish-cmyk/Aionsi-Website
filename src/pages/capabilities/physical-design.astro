---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { physicalDesignScope } from '../../data/physicalDesign';
import { capabilityScenarios } from '../../data/capabilityScenarios';

const scenarios = capabilityScenarios['physical-design'];
---
<BaseLayout title="Physical Design | AionSi" description={physicalDesignScope.hero.description}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-16 lg:py-20">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[1fr_.74fr] lg:items-center lg:gap-12">
          <div>
            <div class="flex items-center gap-4 text-xs font-semibold tracking-[.2em] text-[var(--aionsi-blue)]">
              <span>03</span><span class="h-px w-10 bg-[var(--aionsi-blue)]/40"></span><span>ENGINEERING CAPABILITY</span>
            </div>
            <h1 class="mt-6 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">{physicalDesignScope.hero.title}</h1>
            <p class="mt-4 max-w-4xl text-xl font-semibold text-[var(--aionsi-blue)] md:text-2xl">Signoff-ready physical implementation</p>
            <p class="mt-5 max-w-4xl text-xl leading-9 text-slate-600 md:text-2xl">{physicalDesignScope.hero.description}</p>
            <div class="mt-7 flex flex-wrap gap-2">
              {physicalDesignScope.technologies.map((item) => <span class="border border-slate-200 bg-white px-3 py-2 text-xs font-semibold tracking-[.04em] text-slate-600">{item}</span>)}
            </div>
            <Button href="/contact">Discuss Your Engineering Requirement</Button>
          </div>
          <div class="border border-slate-200 bg-white p-6 shadow-sm md:p-7">
            <TechnicalLabel>Engineering Flow</TechnicalLabel>
            <div class="mt-5 grid gap-3 sm:grid-cols-2">
              {physicalDesignScope.flow.map(([number, title, desc]) => (
                <div class="border border-slate-100 bg-[var(--aionsi-surface-alt)] px-4 py-4 text-sm font-semibold text-[var(--aionsi-navy)]">
                  <span class="mr-3 text-[10px] font-semibold tracking-[.14em] text-[var(--aionsi-blue)]">{number}</span>{title}
                  <div class="mt-2 text-sm font-normal leading-6 text-slate-600">{desc}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section class="py-10 md:py-12 lg:py-14">
      <Container>
        <div class="grid gap-7 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div><TechnicalLabel>Customer Situations</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Start with the engineering problem.</h2><p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">Choose the situation closest to your program to see the engineering impact, AionSi contribution and appropriate engagement path.</p></div>
          <div class="grid gap-3">
            {scenarios.map((scenario, index) => (
              <details class="group border border-slate-200 bg-white p-5 shadow-sm">
                <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <div class="grid gap-4 lg:grid-cols-[auto_1fr_auto] lg:items-start">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[var(--aionsi-blue)]/30 text-xs font-semibold text-[var(--aionsi-blue)]">{String(index + 1).padStart(2,'0')}</div>
                    <div><div class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">Customer situation</div><h3 class="mt-1 text-base font-semibold leading-6 text-[var(--aionsi-navy)] md:text-lg">{scenario.situation}</h3></div>
                    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[.12em] text-[var(--aionsi-blue)]"><span>{scenario.engagement}</span><span class="transition-transform group-open:rotate-180">↓</span></div>
                  </div>
                </summary>
                <div class="mt-6 border-t border-slate-100 pt-6">
                  <div class="grid gap-4 md:grid-cols-3">
                    <div class="border border-slate-100 bg-[var(--aionsi-surface-alt)] p-4"><div class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">Engineering impact</div><p class="mt-2 text-sm leading-6 text-slate-600">{scenario.impact}</p></div>
                    <div class="border border-slate-100 bg-[var(--aionsi-surface-alt)] p-4"><div class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">AionSi contribution</div><p class="mt-2 text-sm leading-6 text-slate-600">{scenario.contribution}</p></div>
                    <div class="border border-slate-100 bg-[var(--aionsi-surface-alt)] p-4"><div class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">Engagement model</div><p class="mt-2 text-sm leading-6 text-slate-600">{scenario.engagement}</p></div>
                  </div>
                  <a href="/contact" class="mt-5 inline-flex items-center text-sm font-semibold text-[var(--aionsi-blue)] hover:underline">Discuss Your Engineering Requirement →</a>
                </div>
              </details>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-6 md:grid-cols-2">
          <div class="border border-slate-200 bg-white p-7 md:p-8"><TechnicalLabel>Technology / Methodology</TechnicalLabel><div class="mt-5 flex flex-wrap gap-2">{physicalDesignScope.technologies.map((technology) => <span class="border border-slate-200 px-3 py-2 text-sm text-slate-600">{technology}</span>)}</div></div>
          <div class="border border-slate-200 bg-white p-7 md:p-8"><TechnicalLabel>Engineering Outcome</TechnicalLabel><div class="mt-5 space-y-3">{physicalDesignScope.outcomes.map((item, index) => <div class="flex items-start gap-3 text-sm font-medium text-[var(--aionsi-navy)]"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[var(--aionsi-blue)]/30 text-[10px] font-semibold text-[var(--aionsi-blue)]">{String(index + 1).padStart(2,'0')}</span><span>{item}</span></div>)}</div></div>
        </div>
      </Container>
    </Section>

    {physicalDesignScope.evidence?.length ? <Section class="py-14 md:py-16 lg:py-20"><Container><div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div class="lg:sticky lg:top-28"><TechnicalLabel>Engineering Evidence</TechnicalLabel><h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Evidence before claims.</h2><p class="mt-4 max-w-md text-slate-600">Explore approved technical material supporting the engineering capability represented on this page.</p></div><div class="grid gap-4 md:grid-cols-2">{physicalDesignScope.evidence.map((item, index) => <a href={item.href} class="group border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)] hover:shadow-[0_14px_40px_rgba(2,11,39,.06)]"><div class="flex items-start justify-between gap-4"><span class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{String(index+1).padStart(2,'0')}</span><span class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">{item.type}</span></div><h3 class="mt-5 text-lg font-semibold leading-7 text-[var(--aionsi-navy)]">{item.title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{item.description}</p><div class="mt-5 text-sm font-semibold text-[var(--aionsi-navy)]">Technical evidence →</div></a>)}</div></div></Container></Section> : null}

    <Section class="py-12 md:py-14 lg:py-16">
      <Container>
        <div class="grid gap-6 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
          <div><TechnicalLabel>Engagement Model</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Start focused. Expand with the program.</h2><p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">AionSi can enter through a focused engineering need and scale as scope, trust and roadmap requirements grow.</p></div>
          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">{[['01','Specialist Engineering','Targeted engineering capacity'],['02','Managed Workstream','Defined scope with milestones and closure'],['03','Project / Turnkey','Bounded engineering deliverable'],['04','Dedicated Engineering ODC','Team aligned to the customer roadmap']].map(([number,title,description]) => <div class="border border-slate-200 bg-white p-5"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{number}</span><h3 class="mt-3 text-lg font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{description}</p></div>)}</div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] py-12 md:py-14 lg:py-16 text-white"><Container><div class="grid gap-7 lg:grid-cols-[1fr_auto] lg:items-center"><div class="max-w-4xl"><TechnicalLabel>Engineering Discovery</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">Bring the engineering problem.</h2><p class="mt-4 text-base leading-7 text-white/70 md:text-lg md:leading-8">Share the program stage, bottleneck and required engineering capacity. We can map the requirement to the appropriate AionSi engineering model.</p></div><Button href="/contact">Discuss Your Engineering Requirement</Button></div></Container></Section>
  </main>
  <Footer />
</BaseLayout>
