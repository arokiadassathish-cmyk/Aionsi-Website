---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import EngineeringCard from '../../components/capabilities/EngineeringCard.astro';
import Button from '../../components/global/Button.astro';
import { capabilities } from '../../data/capabilities';
---
<BaseLayout title="Semiconductor Engineering Capabilities | AionSi" description="Semiconductor engineering capabilities across RTL design, design verification, physical design, DFT, protocol verification and SoC/IP engineering." canonical="https://aionsi.com/capabilities">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-16 lg:py-20">
      <Container>
        <div class="max-w-4xl">
          <TechnicalLabel>Engineering Capabilities</TechnicalLabel>
          <h1 class="mt-5 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Semiconductor engineering from IP to Silicon.</h1>
          <p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">Explore AionSi engineering capabilities from RTL development through verification, physical implementation, DFT, protocol verification and SoC/IP engineering.</p>
        </div>
      </Container>
    </Section>
    <Section class="py-12 md:py-16 lg:py-20">
      <Container>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {capabilities.map((capability) => (
            <EngineeringCard number={capability.number} title={capability.title} description={capability.description} technologies={capability.technologies?.join(' · ')} outcome={capability.outcome} href={`/capabilities/${capability.slug}`} />
          ))}
        </div>
      </Container>
    </Section>
    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-16 lg:py-20">
      <Container class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
        <div>
          <TechnicalLabel>DELIVERY MODELS</TechnicalLabel>
          <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Put the right engineering ownership around the capability.</h2>
          <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">From a focused specialist requirement to a dedicated engineering organization, AionSi can align scope, ownership and scale to the program.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <a href="/solutions/extended-engineering" class="border border-slate-200 bg-white p-6 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">01</div><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">Extended Engineering</h3><p class="mt-3 text-sm leading-6 text-slate-600">Add specialist capacity to an existing engineering organization.</p></a>
          <a href="/solutions/dedicated-engineering" class="border border-slate-200 bg-white p-6 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">02</div><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">Dedicated Engineering</h3><p class="mt-3 text-sm leading-6 text-slate-600">Build dedicated engineering capacity around a roadmap or workstream.</p></a>
          <a href="/solutions/project-engineering" class="border border-slate-200 bg-white p-6 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">03</div><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">Project Engineering</h3><p class="mt-3 text-sm leading-6 text-slate-600">Take ownership of defined scope, milestones and deliverables.</p></a>
          <a href="/solutions/odc" class="border border-slate-200 bg-white p-6 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">04</div><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">Engineering ODC</h3><p class="mt-3 text-sm leading-6 text-slate-600">Build a governed engineering organization with scalable capacity.</p></a>
        </div>
      </Container>
    </Section>
    <Section class="bg-[var(--aionsi-deep-navy)] py-12 text-white md:py-16">
      <Container class="text-center">
        <TechnicalLabel>ENGINEERING EVIDENCE</TechnicalLabel>
        <h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">See representative engineering experience before you start the conversation.</h2>
        <p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Review approved examples across Physical Design, Design Verification and Protocol Verification.</p>
        <div class="mt-9 flex flex-wrap justify-center gap-4"><Button href="/proof">Explore Engineering Evidence</Button><Button href="/contact" variant="secondary">Discuss Your Engineering Requirement</Button></div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
