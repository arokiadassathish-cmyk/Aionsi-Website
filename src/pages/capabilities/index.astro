---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import EngineeringCard from '../../components/capabilities/EngineeringCard.astro';
import { capabilities } from '../../data/capabilities';
---
<BaseLayout title="Engineering Capabilities | AionSi" description="AionSi engineering capabilities across RTL Design, Design Verification, Physical Design, DFT, Protocol Verification and SoC & IP Engineering.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <div class="max-w-4xl">
          <TechnicalLabel>Engineering Capabilities</TechnicalLabel>
          <h1 class="mt-5 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Engineering depth across the silicon lifecycle.</h1>
          <p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">Explore AionSi engineering capabilities from RTL development through verification, physical implementation, DFT, protocol verification and SoC integration.</p>
        </div>
      </Container>
    </Section>

    <Section>
      <Container>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {capabilities.map((capability) => (
            <EngineeringCard
              number={capability.number}
              title={capability.title}
              description={capability.description}
              technologies={capability.technologies?.join(' · ')}
              outcome={capability.outcome}
              href={`/capabilities/${capability.slug}`}
            />
          ))}
        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
