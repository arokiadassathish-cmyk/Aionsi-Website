---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
---

<BaseLayout
  title="Semiconductor Engineering Capabilities | AionSi"
  description="Explore AionSi semiconductor engineering capabilities across RTL design, design verification, physical design, DFT, protocol verification and SoC/IP engineering."
  canonical="https://aionsi.com/capabilities/seo"
>
  <Header theme="light" />
  <main>
    <Section class="pt-36">
      <Container>
        <TechnicalLabel>Semiconductor Engineering</TechnicalLabel>
        <h1 class="mt-4 max-w-5xl text-5xl font-semibold tracking-tight md:text-6xl">Engineering capability across the silicon lifecycle.</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">AionSi supports semiconductor teams across RTL design, verification, physical design, DFT, protocol verification and SoC/IP engineering with evidence-led execution models.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/capabilities/design-verification" class="rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold">Design Verification</a>
          <a href="/capabilities/physical-design" class="rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold">Physical Design</a>
          <a href="/capabilities/rtl-design" class="rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold">RTL Design</a>
          <a href="/capabilities/dft" class="rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold">DFT</a>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>High-Intent Engineering Areas</TechnicalLabel>
        <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {[
            ['RTL Design', '/capabilities/rtl-design', 'Microarchitecture-aligned RTL development for complex semiconductor programs.'],
            ['Design Verification', '/capabilities/design-verification', 'SystemVerilog, UVM, coverage, debug and subsystem/SoC verification.'],
            ['Physical Design', '/capabilities/physical-design', 'Implementation, timing closure and signoff-oriented physical design execution.'],
            ['DFT', '/capabilities/dft', 'Scan, ATPG and test-oriented engineering support across the silicon lifecycle.'],
            ['Protocol Verification', '/capabilities/protocol-verification', 'Verification support for high-speed and system-level protocol environments.'],
            ['SoC & IP Engineering', '/capabilities/soc-ip-engineering', 'Integration, verification and engineering ownership for SoC/IP programs.'],
          ].map(([title, href, text]) => (
            <a href={href} class="border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:border-[var(--aionsi-blue)]">
              <h2 class="text-2xl font-semibold">{title}</h2>
              <p class="mt-3 text-sm leading-6 text-slate-600">{text}</p>
              <div class="mt-7 text-sm font-semibold text-[var(--aionsi-navy)]">Explore capability →</div>
            </a>
          ))}
        </div>
      </Container>
    </Section>

    <Section>
      <Container class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
        <div>
          <TechnicalLabel>Engineering Evidence</TechnicalLabel>
          <h2 class="text-4xl font-semibold tracking-tight md:text-5xl">See representative engineering experience.</h2>
          <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Review evidence-backed engineering experience across physical design, verification, protocols and SoC/IP programs.</p>
        </div>
        <div class="flex flex-wrap gap-4">
          <Button href="/evidence">Explore Engineering Evidence</Button>
          <a href="/experience" class="inline-flex items-center rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold">Representative Experience →</a>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white">
      <Container class="text-center">
        <TechnicalLabel>Engineering Requirement</TechnicalLabel>
        <h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-5xl">Bring us the semiconductor problem you need to accelerate.</h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/70">We can map the requirement to the appropriate AionSi engineering capability and delivery model.</p>
        <div class="mt-9"><Button href="/contact">Talk to Our Engineering Team</Button></div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
