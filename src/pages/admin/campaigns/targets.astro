---
import { parseConfiguredTargetAccounts } from '../../../data/configuredTargetAccounts';
import { targetAccounts } from '../../../data/targetAccounts';

export const prerender = false;

const raw = process.env.AIONSI_DAILY_TARGETS_JSON;
let configured = [];
let configurationError = '';

try {
  configured = parseConfiguredTargetAccounts(raw);
} catch (error) {
  configurationError = error instanceof Error ? error.message : 'Target configuration could not be read.';
}

const configuredBySlug = new Map(configured.map((target) => [target.slug, target]));
const rows = targetAccounts.map((account) => {
  const target = configuredBySlug.get(account.slug);
  return {
    ...account,
    configured: Boolean(target),
    priority: target?.priority,
    contactCount: target?.contactIds?.length ?? 0,
    domain: target?.domain,
  };
});

const configuredCount = rows.filter((row) => row.configured).length;
const configuredRows = rows.filter((row) => row.configured);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>AionSi Agent — Target Configuration</title>
  <meta name="robots" content="noindex,nofollow" />
</head>
<body>
  <main class="shell">
    <header>
      <div>
        <span class="eyebrow">AIONSI AGENT</span>
        <h1>Target configuration</h1>
        <p>Deployment campaign universe matched against the public AionSi Target Accounts registry.</p>
      </div>
      <a class="back" href="/admin/campaigns">← Campaign Control</a>
    </header>

    <section class="notice">
      <strong>Safe configuration view</strong>
      <span>HubSpot company IDs, contact IDs, API keys and other secrets are intentionally not displayed.</span>
    </section>

    {configurationError ? (
      <section class="error">
        <strong>Configuration unavailable</strong>
        <p>{configurationError}</p>
      </section>
    ) : (
      <>
        <section class="stats">
          <article><span>Configured targets</span><strong>{configuredCount}</strong><small>From AIONSI_DAILY_TARGETS_JSON</small></article>
          <article><span>Public registry</span><strong>{targetAccounts.length}</strong><small>Accounts on /target-accounts</small></article>
          <article><span>Unconfigured registry accounts</span><strong>{targetAccounts.length - configuredCount}</strong><small>Not in today's campaign universe</small></article>
          <article><span>Daily cap</span><strong>{Number(process.env.AIONSI_DAILY_MAX_TARGETS || 25)}</strong><small>Maximum processed per run</small></article>
        </section>

        <section class="panel">
          <div class="panel-head">
            <div><span class="kicker">ACTUAL CAMPAIGN UNIVERSE</span><h2>Configured companies</h2></div>
            <span class="badge">{configuredCount} configured</span>
          </div>
          {configuredRows.length ? (
            <div class="table-wrap">
              <table>
                <thead><tr><th>Company</th><th>Slug</th><th>Domain</th><th>Contacts</th><th>Priority</th><th>Registry</th></tr></thead>
                <tbody>
                  {configuredRows.map((row) => (
                    <tr>
                      <td><strong>{row.name}</strong><small>{row.category}</small></td>
                      <td><code>{row.slug}</code></td>
                      <td>{row.domain || '—'}</td>
                      <td>{row.contactCount}</td>
                      <td>{row.priority ?? '—'}</td>
                      <td><span class="ok">✓ Valid</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : <div class="empty">No deployment targets are configured.</div>}
        </section>

        <section class="panel">
          <div class="panel-head">
            <div><span class="kicker">REGISTRY COVERAGE</span><h2>All public target accounts</h2></div>
            <span class="muted">Configured rows are marked</span>
          </div>
          <div class="chips">
            {rows.map((row) => <span class:list={{ chip: true, configured: row.configured }}>{row.configured ? '✓ ' : ''}{row.name}</span>)}
          </div>
        </section>
      </>
    )}

    <footer>Internal agent control surface · Configuration is read-only · Live Apollo execution remains separately gated.</footer>
  </main>
  <style>
    :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:#e8edf5;background:#071018}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at 80% 0%,#122b3c 0,transparent 35%),#071018}.shell{width:min(1400px,calc(100% - 48px));margin:0 auto;padding:36px 0 54px}header{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;margin-bottom:24px}.eyebrow,.kicker{color:#6ee7d2;font-size:11px;font-weight:800;letter-spacing:.18em}h1{margin:8px 0 6px;font-size:42px;letter-spacing:-.04em}h2{margin:5px 0 0;font-size:20px}p{color:#8e9aaa;line-height:1.55}.back{border:1px solid #2a3a49;background:#0d1a26;color:#dce5ee;border-radius:9px;padding:10px 14px;text-decoration:none}.notice,.error,.panel,.stats article{border:1px solid #1b2b39;background:rgba(10,22,33,.92);border-radius:14px}.notice{padding:16px 18px;margin-bottom:18px}.notice strong{display:block;margin-bottom:4px}.notice span{color:#8fa5b5;font-size:12px}.error{padding:20px;border-color:#5b3434}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}.stats article{padding:18px}.stats span,.stats small,.muted{display:block;color:#758596;font-size:11px}.stats strong{display:block;font-size:30px;margin:6px 0 2px}.panel{padding:20px;margin-bottom:18px}.panel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:18px}.badge,.ok{border:1px solid #1d625c;background:#0d2628;color:#6ee7d2;border-radius:999px;padding:7px 10px;font-size:11px;font-weight:700}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:760px}th,td{text-align:left;padding:13px 10px;border-bottom:1px solid #1b2b39;font-size:12px}th{color:#758596;font-size:10px;letter-spacing:.08em;text-transform:uppercase}td strong{display:block;font-size:13px}td small{display:block;color:#758596;margin-top:3px}code{color:#a9c6d7}.empty{padding:28px;color:#758596;text-align:center}.chips{display:flex;flex-wrap:wrap;gap:8px}.chip{padding:8px 11px;border:1px solid #263747;border-radius:999px;color:#8493a1;background:#0b1823;font-size:11px}.chip.configured{border-color:#1d625c;background:#0d2628;color:#6ee7d2}footer{color:#5f7080;font-size:11px;text-align:center;padding-top:10px}@media(max-width:800px){.shell{width:min(100% - 28px,1400px)}header{flex-direction:column}.stats{grid-template-columns:repeat(2,1fr)}h1{font-size:34px}}@media(max-width:500px){.stats{grid-template-columns:1fr}}
  </style>
</body>
</html>
