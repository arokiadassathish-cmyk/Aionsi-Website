---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/global/Header.astro';
import Footer from '../../../components/global/Footer.astro';
import Container from '../../../components/global/Container.astro';
import Section from '../../../components/global/Section.astro';
import TechnicalLabel from '../../../components/global/TechnicalLabel.astro';
import { hasGalleryAdminSession } from '../../../lib/galleryAdmin';

if (!hasGalleryAdminSession(Astro)) return Astro.redirect('/admin/gallery/login');
---
<BaseLayout title="Gallery Manager | AionSi" description="Private AionSi event gallery management area.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-16 md:py-20 lg:py-24"><Container><TechnicalLabel>PRIVATE GALLERY MANAGER</TechnicalLabel><h1 class="mt-4 max-w-5xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Manage event media without editing website code.</h1><p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">Create and manage event metadata, then upload photos, videos and cover images through the authenticated workflow.</p></Container></Section>
    <Section><Container><div class="grid gap-6 lg:grid-cols-2"><div class="border border-slate-200 bg-white p-8"><TechnicalLabel>EVENT MANAGEMENT</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold text-[var(--aionsi-navy)]">Create an event</h2><div class="mt-6 grid gap-4"><label class="text-sm font-semibold text-slate-700">Event title<input class="mt-2 w-full rounded border border-slate-300 px-4 py-3" placeholder="e.g. DVCon India 2026" /></label><label class="text-sm font-semibold text-slate-700">Category<select class="mt-2 w-full rounded border border-slate-300 px-4 py-3"><option>Conference</option><option>Exhibition</option><option>Technical Event</option><option>Company Event</option></select></label><div class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-semibold text-slate-700">Date<input type="date" class="mt-2 w-full rounded border border-slate-300 px-4 py-3" /></label><label class="text-sm font-semibold text-slate-700">Location<input class="mt-2 w-full rounded border border-slate-300 px-4 py-3" placeholder="Bengaluru, India" /></label></div><label class="text-sm font-semibold text-slate-700">Description<textarea class="mt-2 min-h-32 w-full rounded border border-slate-300 px-4 py-3" placeholder="Describe the event and AionSi participation."></textarea></label><button type="button" class="w-fit rounded-full bg-[var(--aionsi-orange)] px-5 py-3 text-sm font-semibold text-white">Save draft</button></div></div><div class="border border-slate-200 bg-white p-8"><TechnicalLabel>MEDIA WORKFLOW</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold text-[var(--aionsi-navy)]">Upload media</h2><div class="mt-6 grid gap-5"><label class="text-sm font-semibold text-slate-700">Photos<input type="file" accept="image/jpeg,image/png,image/webp" multiple class="mt-2 block w-full rounded border border-slate-300 p-3" /></label><p class="text-xs leading-6 text-slate-500">Photos will be written to persistent Hostinger media storage after upload API configuration.</p><label class="text-sm font-semibold text-slate-700">Videos<input type="file" accept="video/mp4,video/webm" multiple class="mt-2 block w-full rounded border border-slate-300 p-3" /></label><p class="text-xs leading-6 text-slate-500">Large videos remain outside GitHub and are stored in persistent media storage.</p><label class="text-sm font-semibold text-slate-700">Cover image<input type="file" accept="image/jpeg,image/png,image/webp" class="mt-2 block w-full rounded border border-slate-300 p-3" /></label><div class="rounded border border-blue-200 bg-blue-50 p-4 text-sm leading-6 text-blue-900">Authentication is active. Media upload/publish endpoints will be enabled after the Hostinger storage path is configured and write-tested.</div><button id="logout" type="button" class="w-fit rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700">Sign out</button></div></div></div></Container></Section>
  </main>
  <Footer />
  <script>
    document.querySelector('#logout')?.addEventListener('click', async () => {
      await fetch('/api/gallery/auth/logout', { method: 'POST' });
      window.location.href = '/admin/gallery/login';
    });
  </script>
</BaseLayout>
