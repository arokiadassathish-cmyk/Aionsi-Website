---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/global/Header.astro';
import Footer from '../../../components/global/Footer.astro';
import Container from '../../../components/global/Container.astro';
import Section from '../../../components/global/Section.astro';
import TechnicalLabel from '../../../components/global/TechnicalLabel.astro';
import { hasGalleryAdminSession } from '../../../lib/galleryAdmin';

if (!hasGalleryAdminSession(Astro)) return Astro.redirect('/admin/gallery/login');
---
<BaseLayout title="Gallery Manager | AionSi" description="Private AionSi event gallery management area.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-16 md:py-20 lg:py-24"><Container><TechnicalLabel>PRIVATE GALLERY MANAGER</TechnicalLabel><h1 class="mt-4 max-w-5xl text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Manage event media without editing website code.</h1><p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">Create an event, upload photos and videos to persistent Hostinger storage, choose a cover image, then publish when ready.</p></Container></Section>
    <Section><Container><div id="status" class="mb-6 hidden rounded border p-4 text-sm"></div><div class="grid gap-6 lg:grid-cols-2">
      <div class="border border-slate-200 bg-white p-8"><TechnicalLabel>EVENT MANAGEMENT</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold text-[var(--aionsi-navy)]">Create an event</h2><form id="event-form" class="mt-6 grid gap-4"><label class="text-sm font-semibold text-slate-700">Event title<input id="title" required class="mt-2 w-full rounded border border-slate-300 px-4 py-3" placeholder="e.g. DVCon India 2026" /></label><label class="text-sm font-semibold text-slate-700">Category<select id="category" class="mt-2 w-full rounded border border-slate-300 px-4 py-3"><option>Conference</option><option>Exhibition</option><option>Technical Event</option><option>Company Event</option></select></label><div class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-semibold text-slate-700">Date<input id="date" type="date" required class="mt-2 w-full rounded border border-slate-300 px-4 py-3" /></label><label class="text-sm font-semibold text-slate-700">Location<input id="location" required class="mt-2 w-full rounded border border-slate-300 px-4 py-3" placeholder="Bengaluru, India" /></label></div><label class="text-sm font-semibold text-slate-700">Description<textarea id="description" required class="mt-2 min-h-32 w-full rounded border border-slate-300 px-4 py-3" placeholder="Describe the event and AionSi participation."></textarea></label><button type="submit" class="w-fit rounded-full bg-[var(--aionsi-orange)] px-5 py-3 text-sm font-semibold text-white">Create draft event</button></form><div class="mt-8 border-t border-slate-200 pt-6"><label class="text-sm font-semibold text-slate-700">Current event<select id="event-select" class="mt-2 w-full rounded border border-slate-300 px-4 py-3"><option value="">Create an event first</option></select></label><div class="mt-4 flex flex-wrap gap-3"><button id="publish" type="button" class="rounded-full bg-[var(--aionsi-blue)] px-5 py-3 text-sm font-semibold text-white disabled:opacity-40" disabled>Publish selected event</button><a id="view-event" class="hidden rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700" target="_blank">View public gallery</a></div></div></div>
      <div class="border border-slate-200 bg-white p-8"><TechnicalLabel>MEDIA WORKFLOW</TechnicalLabel><h2 class="mt-3 text-3xl font-semibold text-[var(--aionsi-navy)]">Upload media</h2><div class="mt-6 grid gap-5"><label class="text-sm font-semibold text-slate-700">Photos<input id="photos" type="file" accept="image/jpeg,image/png,image/webp" multiple class="mt-2 block w-full rounded border border-slate-300 p-3" /></label><button id="upload-photos" type="button" class="w-fit rounded-full border border-[var(--aionsi-blue)] px-5 py-3 text-sm font-semibold text-[var(--aionsi-blue)] disabled:opacity-40" disabled>Upload photos</button><p class="text-xs leading-6 text-slate-500">JPG, PNG and WebP. Maximum 10 MB per image.</p><label class="text-sm font-semibold text-slate-700">Videos<input id="videos" type="file" accept="video/mp4,video/webm" multiple class="mt-2 block w-full rounded border border-slate-300 p-3" /></label><button id="upload-videos" type="button" class="w-fit rounded-full border border-[var(--aionsi-blue)] px-5 py-3 text-sm font-semibold text-[var(--aionsi-blue)] disabled:opacity-40" disabled>Upload videos</button><p class="text-xs leading-6 text-slate-500">MP4 or WebM. Maximum 250 MB per video.</p><label class="text-sm font-semibold text-slate-700">Cover image<input id="cover" type="file" accept="image/jpeg,image/png,image/webp" class="mt-2 block w-full rounded border border-slate-300 p-3" /></label><button id="upload-cover" type="button" class="w-fit rounded-full border border-[var(--aionsi-blue)] px-5 py-3 text-sm font-semibold text-[var(--aionsi-blue)] disabled:opacity-40" disabled>Set cover image</button><div class="rounded border border-green-200 bg-green-50 p-4 text-sm leading-6 text-green-900">Hostinger storage is writable and configured. Uploaded media stays outside GitHub and persists across website redeployments.</div><button id="logout" type="button" class="w-fit rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700">Sign out</button></div></div>
    </div></Container></Section>
  </main>
  <Footer />
  <script>
    const statusBox = document.querySelector('#status');
    const select = document.querySelector('#event-select');
    const publish = document.querySelector('#publish');
    const view = document.querySelector('#view-event');
    const buttons = [document.querySelector('#upload-photos'), document.querySelector('#upload-videos'), document.querySelector('#upload-cover')];
    let events = [];
    const status = (message, ok = true) => { statusBox.textContent = message; statusBox.className = `mb-6 rounded border p-4 text-sm ${ok ? 'border-green-200 bg-green-50 text-green-900' : 'border-red-200 bg-red-50 text-red-900'}`; };
    const refresh = async () => { const response = await fetch('/api/gallery/events'); const data = await response.json(); if (!response.ok) throw new Error(data.error || 'Unable to load events.'); events = data.events || []; select.innerHTML = events.length ? events.map((event) => `<option value="${event.slug}">${event.title} — ${event.published ? 'Published' : 'Draft'}</option>`).join('') : '<option value="">Create an event first</option>'; updateControls(); };
    const selected = () => events.find((event) => event.slug === select.value);
    const updateControls = () => { const has = Boolean(select.value); buttons.forEach((button) => button.disabled = !has); publish.disabled = !has || Boolean(selected()?.published); if (has) { view.href = `/gallery/${select.value}`; view.classList.remove('hidden'); } else view.classList.add('hidden'); };
    document.querySelector('#event-form').addEventListener('submit', async (event) => { event.preventDefault(); try { const body = { title: document.querySelector('#title').value, category: document.querySelector('#category').value, date: document.querySelector('#date').value, location: document.querySelector('#location').value, description: document.querySelector('#description').value }; const response = await fetch('/api/gallery/events', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }); const data = await response.json(); if (!response.ok) throw new Error(data.error); await refresh(); select.value = data.event.slug; updateControls(); status(`Draft created: ${data.event.title}`); } catch (error) { status(error.message || 'Unable to create event.', false); } });
    const upload = async (inputId, kind) => { if (!select.value) return status('Select an event first.', false); const input = document.querySelector(inputId); if (!input.files.length) return status('Select at least one file.', false); const form = new FormData(); form.append('eventSlug', select.value); form.append('kind', kind); [...input.files].forEach((file) => form.append('files', file)); const response = await fetch('/api/gallery/upload', { method: 'POST', body: form }); const data = await response.json(); if (!response.ok) throw new Error(data.error || 'Upload failed.'); await refresh(); status(`${data.files.length} file${data.files.length === 1 ? '' : 's'} uploaded successfully.`); input.value = ''; };
    document.querySelector('#upload-photos').addEventListener('click', () => upload('#photos', 'media').catch((error) => status(error.message, false)));
    document.querySelector('#upload-videos').addEventListener('click', () => upload('#videos', 'media').catch((error) => status(error.message, false)));
    document.querySelector('#upload-cover').addEventListener('click', () => upload('#cover', 'cover').catch((error) => status(error.message, false)));
    publish.addEventListener('click', async () => { try { const response = await fetch('/api/gallery/events', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ slug: select.value, published: true }) }); const data = await response.json(); if (!response.ok) throw new Error(data.error); await refresh(); select.value = data.event.slug; updateControls(); status(`Published: ${data.event.title}`); } catch (error) { status(error.message || 'Unable to publish event.', false); } });
    select.addEventListener('change', updateControls);
    document.querySelector('#logout').addEventListener('click', async () => { await fetch('/api/gallery/auth/logout', { method: 'POST' }); window.location.href = '/admin/gallery/login'; });
    refresh().catch((error) => status(error.message || 'Unable to load gallery events.', false));
  </script>
</BaseLayout>
