---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Container from '../components/global/Container.astro';
import Section from '../components/global/Section.astro';
import TechnicalLabel from '../components/global/TechnicalLabel.astro';
import Button from '../components/global/Button.astro';
---
<BaseLayout title="Automotive SoC Verification & Engineering | AionSi" description="AionSi engineering support for automotive SoC verification, validation and silicon execution — built for complex ADAS and autonomous-driving programs.">
  <Header />
  <main>
    <section class="relative overflow-hidden bg-[var(--aionsi-deep-navy)] py-20 text-white md:py-28">
      <div class="absolute inset-0 opacity-30" style="background:radial-gradient(circle at 80% 20%, rgba(39,148,255,.35), transparent 35%), radial-gradient(circle at 20% 80%, rgba(255,122,24,.18), transparent 30%)"></div>
      <Container class="relative">
        <div class="max-w-5xl">
          <TechnicalLabel>AIonsi × AUTOMOTIVE SILICON</TechnicalLabel>
          <h1 class="mt-5 text-5xl font-semibold leading-[1.02] tracking-tight md:text-7xl">Accelerate the verification of safety-critical automotive silicon.</h1>
          <p class="mt-7 max-w-3xl text-xl leading-9 text-white/70 md:text-2xl">AionSi helps semiconductor teams add specialist engineering capacity across SoC Design Verification, subsystem verification, validation and silicon execution — without compromising engineering ownership.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <Button href="#conversation">Discuss an Engineering Bottleneck</Button>
            <a href="#capabilities" class="inline-flex items-center rounded-md border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/50">Explore Capabilities ↓</a>
          </div>
        </div>
        <div class="mt-14 grid max-w-4xl gap-3 sm:grid-cols-3">
          {[
            ['SoC DV','SystemVerilog • UVM • Coverage'],
            ['Automotive','ADAS • Sensor Fusion • Safety'],
            ['ODC Scale','Pilot • Workstream • Dedicated'],
          ].map(([title,desc]) => <div class="border border-white/10 bg-white/5 p-5 backdrop-blur"><div class="text-lg font-semibold">{title}</div><div class="mt-2 text-sm text-white/55">{desc}</div></div>)}
        </div>
      </Container>
    </section>

    <Section>
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr]">
          <div><TechnicalLabel>THE ENGINEERING CHALLENGE</TechnicalLabel><h2 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Complex automotive silicon creates verification pressure at every milestone.</h2></div>
          <div class="grid gap-4 md:grid-cols-2">
            {[
              ['Coverage closure','Large SoCs require sustained regression, coverage and assertion discipline as integration expands.'],
              ['Interface complexity','High-speed interfaces and heterogeneous subsystems increase verification dependencies and debug load.'],
              ['Safety & quality','Automotive programs demand traceability, disciplined verification and evidence-based sign-off.'],
              ['Schedule pressure','Specialist bottlenecks can delay milestones even when the core engineering team is highly capable.'],
            ].map(([title,desc],i) => <article class="border border-slate-200 bg-white p-6 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">0{i+1}</span><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{desc}</p></article>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section id="capabilities" class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>WHERE AIONSI CAN PLUG IN</TechnicalLabel>
        <h2 class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Specialist execution, aligned to the existing silicon team.</h2>
        <div class="mt-9 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {[
            ['01','SoC Design Verification','SystemVerilog, UVM, assertions, functional coverage, constrained-random verification and regression ownership.'],
            ['02','Subsystem & IP Verification','Protocol, memory, interconnect and accelerator-subsystem verification with reusable environments and scoreboards.'],
            ['03','Validation & Debug','Test planning, failure triage, root-cause analysis and structured debug across pre-silicon and post-silicon stages.'],
            ['04','Automotive Silicon','Engineering support for ADAS-oriented compute, perception and sensor-processing silicon with quality-first execution.'],
            ['05','Verification Acceleration','Add focused specialists to remove a bottleneck instead of replacing the customer's engineering organization.'],
            ['06','Dedicated ODC','Convert a successful pilot into a governed engineering pod with defined ownership, metrics and scaling.'],
          ].map(([num,title,desc]) => <article class="border border-slate-200 bg-white p-6 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-blue)]">{num}</span><h3 class="mt-3 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{desc}</p></article>)}
        </div>
      </Container>
    </Section>

    <Section>
      <Container>
        <div class="grid gap-10 lg:grid-cols-[1.1fr_.9fr] lg:items-center">
          <div>
            <TechnicalLabel>A LOW-RISK ENGAGEMENT MODEL</TechnicalLabel>
            <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Start with one measurable engineering problem.</h2>
            <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">The objective is not to sell a large team on day one. We propose a bounded workstream, agree acceptance criteria, demonstrate execution and scale only when the engineering case is proven.</p>
          </div>
          <div class="space-y-3">
            {[
              ['01','Technical discovery','Identify the bottleneck, stage, interfaces and success metric.'],
              ['02','NDA + scope','Align on technical context, tools, deliverables and governance.'],
              ['03','Pilot workstream','Deploy a focused engineering pod against a defined milestone.'],
              ['04','Scale to ODC','Expand capacity around proven workflows and customer priorities.'],
            ].map(([num,title,desc]) => <div class="flex gap-4 border border-slate-200 bg-white p-5 shadow-sm"><span class="text-xs font-semibold tracking-[.16em] text-[var(--aionsi-orange)]">{num}</span><div><h3 class="font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-1 text-sm leading-6 text-slate-600">{desc}</p></div></div>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
          <div><TechnicalLabel>WHY AIONSI</TechnicalLabel><h2 class="mt-4 text-3xl font-semibold md:text-5xl">Engineering depth before headcount.</h2><p class="mt-5 text-lg leading-8 text-white/65">We position around the technical outcome: remove a bottleneck, improve execution velocity and create a scalable engineering extension.</p></div>
          <div class="grid gap-4 sm:grid-cols-2">
            {['Specialist semiconductor engineering','Evidence-led technical discussions','Flexible pilot-to-ODC model','Security-conscious delivery','India engineering scale with global collaboration','Transparent milestone-based governance'].map((item,i) => <div class="border border-white/10 bg-white/5 p-5"><span class="text-xs font-semibold text-[var(--aionsi-orange)]">0{i+1}</span><p class="mt-3 font-medium">{item}</p></div>)}
          </div>
        </div>
      </Container>
    </Section>

    <section id="conversation" class="bg-[var(--aionsi-surface-alt)] py-16 md:py-24">
      <Container>
        <div class="mx-auto max-w-4xl border border-slate-200 bg-white p-7 shadow-sm md:p-10">
          <TechnicalLabel>ENGINEERING CONVERSATION</TechnicalLabel>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Have a verification or validation bottleneck?</h2>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">Share the engineering area you are evaluating. AionSi will respond with a focused capability match rather than a generic services pitch.</p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <a href="mailto:business@aionsi.com?subject=Mobileye%20Engineering%20Conversation" class="rounded-md bg-[var(--aionsi-orange)] px-6 py-4 text-center font-semibold text-white transition hover:opacity-90">Start a Technical Conversation</a>
            <a href="/contact" class="rounded-md border border-slate-300 px-6 py-4 text-center font-semibold text-[var(--aionsi-navy)] transition hover:border-slate-500">Use AionSi Contact Form</a>
          </div>
          <p class="mt-5 text-xs leading-5 text-slate-500">This page is an AionSi engineering outreach page. It is not an endorsement, partnership announcement or representation of a relationship with Mobileye.</p>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
</BaseLayout>
