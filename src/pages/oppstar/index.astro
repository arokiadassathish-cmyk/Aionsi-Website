---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
---
<BaseLayout title="Semiconductor Engineering Services for Oppstar | AionSi" description="AionSi complements Oppstar with focused semiconductor engineering capacity across RTL, Design Verification, Physical Design, DFT, SoC Integration and project engineering.">
  <Header /><main>
    <Section class="bg-[var(--aionsi-surface-alt)] py-14 md:py-20 lg:py-24"><Container><div class="grid gap-12 lg:grid-cols-[1.08fr_.72fr] lg:items-center"><div><TechnicalLabel>OPPSTAR × AIONSI</TechnicalLabel><h1 class="mt-4 max-w-5xl text-5xl font-semibold leading-[1.02] tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Engineering capacity for complex semiconductor programs.</h1><p class="mt-7 max-w-3xl text-xl leading-9 text-slate-600 md:text-2xl">Extend engineering execution capacity with focused AionSi teams aligned to defined work packages, milestones and technical ownership.</p><div class="mt-9 flex flex-wrap gap-4"><Button href="/contact">Discuss an Engineering Requirement</Button><a href="/capabilities" class="inline-flex items-center justify-center border border-slate-300 px-6 py-3 text-sm font-semibold text-[var(--aionsi-navy)]">Explore Capabilities</a></div></div><div class="border border-slate-200 bg-white p-7 shadow-sm"><TechnicalLabel>PARTNERSHIP MODEL</TechnicalLabel><h2 class="mt-4 text-2xl font-semibold text-[var(--aionsi-navy)]">Add execution capacity without disrupting the core team.</h2><p class="mt-4 text-base leading-7 text-slate-600">Start with a defined engineering requirement and scale the team as the program demands.</p><div class="mt-7 grid grid-cols-2 gap-3 text-sm font-semibold text-[var(--aionsi-navy)]"><div class="border border-slate-200 p-4">Defined scope</div><div class="border border-slate-200 p-4">Technical ownership</div><div class="border border-slate-200 p-4">Milestone driven</div><div class="border border-slate-200 p-4">Scalable teams</div></div></div></div></Container></Section>
    <Section class="py-12 md:py-18"><Container><TechnicalLabel>ENGINEERING COVERAGE</TechnicalLabel><div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"><div class="border border-slate-200 p-7"><h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">RTL & SoC Integration</h3><p class="mt-3 text-sm leading-6 text-slate-600">RTL development, integration and implementation support.</p></div><div class="border border-slate-200 p-7"><h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">Design Verification</h3><p class="mt-3 text-sm leading-6 text-slate-600">IP, subsystem and SoC verification, UVM, coverage closure, regressions and debug.</p></div><div class="border border-slate-200 p-7"><h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">Physical Design</h3><p class="mt-3 text-sm leading-6 text-slate-600">Synthesis, STA, physical implementation, timing closure, ECO and signoff support.</p></div><div class="border border-slate-200 p-7"><h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">DFT</h3><p class="mt-3 text-sm leading-6 text-slate-600">DFT implementation, scan, ATPG, memory test and closure support.</p></div><div class="border border-slate-200 p-7"><h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">System & Embedded</h3><p class="mt-3 text-sm leading-6 text-slate-600">FPGA prototyping, firmware, drivers, board bring-up and system integration.</p></div><div class="border border-slate-200 p-7"><h3 class="text-xl font-semibold text-[var(--aionsi-navy)]">Engineering Automation</h3><p class="mt-3 text-sm leading-6 text-slate-600">Flow automation and engineering productivity improvements.</p></div></div></Container></Section>
    <Section class="bg-[var(--aionsi-surface-alt)] py-12 md:py-18"><Container><div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr]"><div><TechnicalLabel>DELIVERY MODEL</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">From requirement to delivered work package.</h2></div><div class="grid gap-3">{['Understand — clarify objective, constraints and bottleneck.','Define — agree scope, skills, tools, milestones and ownership.','Build — assemble engineers around the requirement.','Execute — work against milestones and engineering KPIs.','Validate & Handoff — close deliverables and transition ownership.'].map((item, i) => <div class="border-b border-slate-200 py-5"><span class="mr-5 font-semibold text-[var(--aionsi-orange)]">0{i+1}</span><span class="text-sm leading-6 text-slate-700">{item}</span></div>)}</div></div></Container></Section>
    <Section class="py-12 md:py-18"><Container><TechnicalLabel>ENGAGEMENT OPTIONS</TechnicalLabel><div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-4">{[['Extended Engineering','Add specialist capacity to an existing team.'],['Dedicated Team','Build a focused team around a longer-running program.'],['Project Engineering','AionSi owns a defined engineering work package.'],['Engineering ODC','Create scalable offshore engineering capacity.']].map(([title,text]) => <div class="border border-slate-200 p-6"><h3 class="text-lg font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{text}</p></div>)}</div></Container></Section>
    <Section class="bg-[var(--aionsi-deep-navy)] py-14 text-white md:py-20"><Container><div class="mx-auto max-w-4xl text-center"><TechnicalLabel>START WITH THE REQUIREMENT</TechnicalLabel><h2 class="mt-4 text-4xl font-semibold tracking-tight md:text-6xl">Have an engineering requirement?</h2><p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/70">Share the project stage, engineering discipline, required skills and target milestone. We will come prepared with a relevant engineering approach.</p><div class="mt-8"><Button href="/contact">Discuss Your Requirement</Button></div></div></Container></Section>
  </main><Footer />
</BaseLayout>
