---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { solutions } from '../../data/solutions';
---
<BaseLayout title="Engineering Solutions | AionSi" description="Semiconductor engineering engagement models from extended engineering and project delivery to dedicated engineering and ODC.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)]"><Container><TechnicalLabel>ENGINEERING SOLUTIONS</TechnicalLabel><div class="grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-end"><div><h1 class="text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Choose the engineering model that fits the program.</h1><p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">From a specialist bottleneck to a dedicated engineering organization, AionSi structures delivery around scope, ownership, milestones and scale.</p></div><div class="border border-slate-200 bg-white p-7"><TechnicalLabel>ENGAGEMENT PATH</TechnicalLabel><div class="mt-5 text-sm uppercase tracking-[.14em] text-slate-500">Specialist → Workstream → Project → ODC</div><p class="mt-4 text-base leading-7 text-[var(--aionsi-navy)]">Start with the level of ownership your program needs and scale the engagement as requirements expand.</p></div></div></Container></Section>
    <Section><Container><TechnicalLabel>SOLUTIONS</TechnicalLabel><div class="mt-8 grid gap-5 md:grid-cols-2">{solutions.map((solution) => <a href={`/solutions/${solution.slug}`} class="border border-slate-200 bg-white p-8 transition hover:border-[var(--aionsi-blue)]"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">{solution.number}</div><h2 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{solution.title}</h2><p class="mt-4 text-base leading-7 text-slate-600">{solution.summary}</p><div class="mt-8 text-sm font-semibold text-[var(--aionsi-navy)]">Explore Solution →</div></a>)}</div></Container></Section>
    <Section class="bg-[var(--aionsi-surface-alt)]"><Container class="grid gap-8 lg:grid-cols-[.8fr_1.2fr]"><div><TechnicalLabel>OWNERSHIP MODEL</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Match responsibility to the program need.</h2><p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Use delivery structure as an engineering decision: define the scope, assign ownership, validate the fit and scale deliberately.</p></div><div class="grid gap-4 sm:grid-cols-2"><div class="border border-slate-200 bg-white p-6"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">01</div><div class="mt-3 font-semibold text-[var(--aionsi-navy)]">Specialist support</div><p class="mt-2 text-sm leading-6 text-slate-600">Target a technical gap or constrained workstream.</p></div><div class="border border-slate-200 bg-white p-6"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">02</div><div class="mt-3 font-semibold text-[var(--aionsi-navy)]">Managed workstream</div><p class="mt-2 text-sm leading-6 text-slate-600">Define milestones and shared technical ownership.</p></div><div class="border border-slate-200 bg-white p-6"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">03</div><div class="mt-3 font-semibold text-[var(--aionsi-navy)]">Project delivery</div><p class="mt-2 text-sm leading-6 text-slate-600">Assign bounded scope and measurable deliverables.</p></div><div class="border border-slate-200 bg-white p-6"><div class="text-xs tracking-[.16em] text-[var(--aionsi-blue)]">04</div><div class="mt-3 font-semibold text-[var(--aionsi-navy)]">ODC</div><p class="mt-2 text-sm leading-6 text-slate-600">Build sustained engineering capacity around the roadmap.</p></div></div></Container></Section>
    <Section class="bg-[var(--aionsi-deep-navy)] text-white"><Container class="text-center"><TechnicalLabel>ENGINEERING DISCOVERY</TechnicalLabel><h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Start with the problem you need to solve.</h2><p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Share the engineering bottleneck, program stage, required expertise and target timeline. We can map it to the right delivery model.</p><div class="mt-9"><Button href="/contact">Discuss Your Engineering Requirement</Button></div></Container></Section>
  </main>
  <Footer />
</BaseLayout>
