---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
---
<BaseLayout title="ODC | AionSi" description="Dedicated semiconductor engineering organization aligned to your roadmap, governance and scalable delivery needs.">
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <div class="grid gap-12 lg:grid-cols-[1fr_.85fr] lg:items-center">
          <div class="max-w-4xl">
            <TechnicalLabel>ENGINEERING SOLUTION</TechnicalLabel>
            <h1 class="mt-5 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">Build an Engineering ODC.</h1>
            <p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">A dedicated semiconductor engineering organization aligned to your roadmap, governance model, technical requirements and scale-up plan.</p>
            <div class="mt-8"><Button href="/contact">Discuss Your ODC Requirement</Button></div>
          </div>
          <div class="border border-slate-200 bg-white p-7 shadow-sm">
            <div class="mb-6 h-1 w-12 bg-[var(--aionsi-orange)]"></div>
            <TechnicalLabel>ODC DELIVERY MODEL</TechnicalLabel>
            <div class="mt-5 grid gap-3 sm:grid-cols-2">
              {['Program Scope','Engineering Leadership','Integrated Delivery','Scalable Capacity'].map((item,index) => (
                <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5">
                  <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">0{index+1}</div>
                  <div class="mt-3 text-base font-semibold text-[var(--aionsi-navy)]">{item}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section>
      <Container>
        <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
          <div>
            <div class="mb-5 h-1 w-12 bg-[var(--aionsi-orange)]"></div>
            <h2 class="text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">How the ODC is built.</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Move from an identified capability need to a governed engineering organization that can expand with the semiconductor roadmap.</p>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {[
              ['01','Define','Program scope, capability mix, milestones and governance expectations'],
              ['02','Build','Technical leadership and dedicated engineering capacity around the roadmap'],
              ['03','Integrate','Customer tools, methodology, security and engineering workflows'],
              ['04','Operate','Milestone-driven execution, reporting, quality and ownership'],
              ['05','Scale','Add engineering capacity as programs, interfaces and roadmap demand grow'],
            ].map(([step,title,description]) => (
              <div class="border border-slate-200 bg-white p-6">
                <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{step}</div>
                <h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3>
                <p class="mt-3 text-sm leading-6 text-slate-600">{description}</p>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
          <div>
            <div class="mb-5 h-1 w-12 bg-[var(--aionsi-orange)]"></div>
            <h2 class="text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Build the engineering depth around the roadmap.</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">An ODC can combine the disciplines required for an integrated semiconductor program rather than operating as a collection of isolated resources.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {[
              ['RTL Design','Block, subsystem and SoC RTL engineering'],
              ['Design Verification','Coverage-driven block, subsystem and SoC verification'],
              ['Physical Design','Implementation, timing closure and sign-off'],
              ['DFT','Design-for-test architecture and implementation'],
              ['Protocol Verification','Interface-focused verification across complex protocols'],
              ['SoC & IP Engineering','IP integration, subsystem development and SoC engineering'],
            ].map(([title,description],index) => (
              <a href={`/capabilities/${['rtl-design','design-verification','physical-design','dft','protocol-verification','soc-ip'][index]}`} class="border border-slate-200 bg-white p-6 transition hover:border-[var(--aionsi-blue)]">
                <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">0{index+1}</div>
                <div class="mt-4 text-lg font-semibold text-[var(--aionsi-navy)]">{title}</div>
                <p class="mt-3 text-sm leading-6 text-slate-600">{description}</p>
                <div class="mt-6 text-sm font-semibold text-[var(--aionsi-navy)]">Explore →</div>
              </a>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <Section>
      <Container>
        <div class="mb-8">
          <div class="mb-5 h-1 w-12 bg-[var(--aionsi-orange)]"></div>
          <h2 class="text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Why an ODC model.</h2>
        </div>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {[
            ['01','Dedicated ownership','A defined engineering organization aligned to program goals and milestones'],
            ['02','Technical continuity','Knowledge, tooling and engineering workflows remain aligned to the roadmap'],
            ['03','Scalable capacity','Team capacity can grow as new blocks, interfaces and silicon programs emerge'],
            ['04','Program governance','Milestone-focused delivery, reporting and engineering accountability'],
          ].map(([number,title,description]) => (
            <div class="border border-slate-200 bg-white p-6">
              <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{number}</div>
              <h3 class="mt-4 text-lg font-semibold text-[var(--aionsi-navy)]">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-slate-600">{description}</p>
            </div>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-start">
          <div>
            <div class="mb-5 h-1 w-12 bg-[var(--aionsi-orange)]"></div>
            <h2 class="text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Representative engineering scale.</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Approved AionSi scale indicators provide context for the breadth of an ODC relationship.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
            {[
              ['30+','Production Tape-Out Programs'],
              ['270+','Engineers in 2026'],
              ['5+','Delivery Centers'],
              ['8+','Pre-Silicon Domains'],
              ['15+','Global Customers'],
            ].map(([value,title]) => (
              <div class="border border-slate-200 bg-white p-6">
                <div class="text-3xl font-semibold text-[var(--aionsi-blue)]">{value}</div>
                <h3 class="mt-3 text-sm font-semibold text-[var(--aionsi-navy)]">{title}</h3>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white">
      <Container class="text-center">
        <div class="mx-auto mb-6 h-1 w-12 bg-[var(--aionsi-orange)]"></div>
        <h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">Build an engineering organization around your silicon roadmap.</h2>
        <p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Share your program scope, engineering disciplines, target milestones and required scale. We will map the requirement to an appropriate AionSi ODC model.</p>
        <div class="mt-9"><Button href="/contact">Discuss Your ODC Requirement</Button></div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
