---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { solutions } from '../../data/solutions';
import ExtendedEngineeringDetails from '../../components/solutions/ExtendedEngineeringDetails.astro';

export const prerender = true;

export function getStaticPaths() {
  return solutions.map((solution) => ({ params: { slug: solution.slug }, props: { solution } }));
}

const { solution } = Astro.props;
const isExtendedEngineering = solution.slug === 'extended-engineering';
---
<BaseLayout title={`${solution.title} | AionSi`} description={solution.summary}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>ENGINEERING SOLUTION</TechnicalLabel>
        <div class="grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
          <div>
            <div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">{solution.number}</div>
            <h1 class="mt-5 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">{solution.title}</h1>
            <p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">{solution.summary}</p>
            <div class="mt-8"><Button href="/contact">{solution.ctaLabel}</Button></div>
          </div>
          <div class="border border-slate-200 bg-white p-7">
            <TechnicalLabel>BEST FIT</TechnicalLabel>
            <div class="mt-5 grid gap-3 sm:grid-cols-2">
              {solution.idealFor.map((item) => <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5 text-sm leading-6 text-[var(--aionsi-navy)]">{item}</div>)}
            </div>
          </div>
        </div>
      </Container>
    </Section>

    {isExtendedEngineering && <Section><Container><ExtendedEngineeringDetails /></Container></Section>}

    <Section>
      <Container>
        <TechnicalLabel>OWNERSHIP MODEL</TechnicalLabel>
        <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
          <div>
            <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">{solution.ownership}</h2>
            <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">{solution.ownershipSummary}</p>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {solution.engagement.map((step, index) => <div class="border border-slate-200 bg-white p-7"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</div><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">{step}</h3></div>)}
          </div>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>ENGAGEMENT OPTIONS</TechnicalLabel>
        <div class="mt-8 grid gap-5 md:grid-cols-2">
          {solutions.map((option) => (
            <a href={`/solutions/${option.slug}`} class={`block border border-slate-200 bg-white p-7 transition hover:border-[var(--aionsi-blue)] ${option.slug === solution.slug ? 'ring-1 ring-[var(--aionsi-blue)]' : ''}`}>
              <div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">{option.number}</div>
              <h3 class="mt-4 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{option.title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-600">{option.summary}</p>
              <div class="mt-6 text-sm font-semibold text-[var(--aionsi-navy)]">Explore →</div>
            </a>
          ))}
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-surface-alt)]">
      <Container>
        <TechnicalLabel>ENGINEERING OUTCOME</TechnicalLabel>
        <div class="mt-8 border border-slate-200 bg-white p-8 md:p-10">
          <h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">{solution.outcome}</h2>
          <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">The delivery structure can begin at the level of ownership the program requires and expand as the roadmap, scope and capacity needs evolve.</p>
        </div>
      </Container>
    </Section>

    <Section class="bg-[var(--aionsi-deep-navy)] text-white">
      <Container class="text-center">
        <TechnicalLabel>ENGINEERING DISCOVERY</TechnicalLabel>
        <h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">{solution.ctaLabel}</h2>
        <p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Share the program stage, engineering challenge, required capability and expected timeline. We can map the requirement to the most appropriate AionSi engineering model.</p>
        <div class="mt-9"><Button href="/contact">{solution.ctaLabel}</Button></div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
