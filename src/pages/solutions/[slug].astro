---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { solutions } from '../../data/solutions';

export const prerender = true;

export function getStaticPaths() {
  return solutions.map((solution) => ({ params: { slug: solution.slug }, props: { solution } }));
}

const { solution } = Astro.props;
const isExtendedEngineering = solution.slug === 'extended-engineering';
const solutionCards = solutions.map((item) => ({ title: item.title, description: item.summary, href: `/solutions/${item.slug}` }));
const capabilities = ['IP / RTL Engineering','Design Verification','Protocol Verification','DFT','Physical Design','SoC Integration','AI-assisted Verification'];
const ownership = [
  ['Extended Engineering','Add specialist capacity to an existing engineering organization.'],
  ['Dedicated Engineering','Build dedicated engineering capacity around a roadmap or workstream.'],
  ['Project Engineering','Take ownership of defined scope, milestones and deliverables.'],
  ['Engineering ODC','Build a governed engineering organization with scalable capacity.'],
];
const engagementSteps = solution.slug === 'extended-engineering'
  ? ['Assess requirement','Map capability','Build engineering pod','Integrate with customer team','Execute with governance','Scale as needed']
  : solution.slug === 'dedicated-engineering'
    ? ['Define roadmap','Assemble engineering team','Integrate workflows','Establish governance','Execute milestones','Scale ownership']
    : solution.slug === 'odc'
      ? ['Define operating model','Build organization','Integrate governance','Operate delivery','Measure outcomes','Scale capacity']
      : ['Scope technical requirement','Plan milestones','Assign ownership','Execute work package','Validate deliverables','Complete handoff'];
const intro = solution.slug === 'extended-engineering'
  ? "Extend an existing semiconductor engineering organization with focused capability across the silicon lifecycle while preserving the customer's technical ownership."
  : solution.slug === 'dedicated-engineering'
    ? 'Build a dedicated semiconductor engineering team around a defined roadmap, workstream or capability with clear technical ownership.'
    : solution.slug === 'odc'
      ? 'Build a governed semiconductor engineering organization aligned to the roadmap, operating model and long-term capacity requirements.'
      : 'Engage AionSi around a defined semiconductor engineering scope with milestones, deliverables and technical ownership.';
---
<BaseLayout title={`${solution.title} | AionSi`} description={solution.summary}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)]"><Container><TechnicalLabel>ENGINEERING SOLUTION</TechnicalLabel><div class="grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center"><div><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">{solution.number}</div><h1 class="mt-5 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">{solution.title}</h1><p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">{solution.summary}</p><div class="mt-8"><Button href="/contact">Discuss an Engineering Requirement</Button></div></div><div class="border border-slate-200 bg-white p-7"><TechnicalLabel>BEST FIT</TechnicalLabel><div class="mt-5 grid gap-3 sm:grid-cols-2">{solution.idealFor.map((item) => <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5 text-sm leading-6 text-[var(--aionsi-navy)]">{item}</div>)}</div></div></div></Container></Section>
    <Section><Container><div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><TechnicalLabel>ENGINEERING CONTEXT</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">{solution.slug === 'extended-engineering' ? 'Extend capability without disrupting technical ownership.' : solution.slug === 'dedicated-engineering' ? 'Build dedicated capacity around the roadmap.' : solution.slug === 'odc' ? 'Create a governed engineering organization for scale.' : 'Deliver defined scope with measurable ownership.'}</h2><p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">{intro}</p></div><div><div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">WHERE AIONSI CAN CONTRIBUTE</div><div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{capabilities.map((item) => <div class="border border-slate-200 bg-white p-5 text-sm font-semibold text-[var(--aionsi-navy)]">{item}</div>)}</div></div></div></Container></Section>
    <Section class="bg-[var(--aionsi-surface-alt)]"><Container><div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><TechnicalLabel>ENGAGEMENT MODEL</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">A delivery path built around ownership.</h2></div><div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{engagementSteps.map((step,index) => <div class="border border-slate-200 bg-white p-7"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">0{index + 1}</div><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">{step}</h3></div>)}</div></div></Container></Section>
    <Section><Container><div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><TechnicalLabel>OWNERSHIP OPTIONS</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Put the right engineering ownership around the capability.</h2><p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">From a focused specialist requirement to a dedicated engineering organization, AionSi can align scope, ownership and scale to the program.</p></div><div class="grid gap-4 md:grid-cols-2">{ownership.map(([title,description],index) => <a href={`/solutions/${solutions[index]?.slug ?? solution.slug}`} class={`border p-7 transition hover:border-[var(--aionsi-blue)] ${solutions[index]?.slug === solution.slug ? 'border-[var(--aionsi-blue)] bg-[var(--aionsi-surface-alt)]' : 'border-slate-200 bg-white'}`}><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">0{index + 1}</div><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">{title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{description}</p></a>)}</div></div></Container></Section>
    {isExtendedEngineering && <Section class="bg-[var(--aionsi-surface-alt)]"><Container><div class="border border-slate-200 bg-white p-8 md:p-10"><h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Representative semiconductor engineering capability across the silicon lifecycle.</h2><div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{capabilities.map((item) => <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5 text-sm font-semibold text-[var(--aionsi-navy)]">{item}</div>)}</div></div></Container></Section>}
    <Section class="bg-[var(--aionsi-deep-navy)] text-white"><Container class="text-center"><TechnicalLabel>ENGINEERING DISCOVERY</TechnicalLabel><h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">{solution.ctaLabel}</h2><p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Share the program stage, engineering challenge, required capability and expected timeline. We can map the requirement to an appropriate AionSi engagement model.</p><div class="mt-9"><Button href="/contact">{solution.ctaLabel}</Button></div></Container></Section>
  </main>
  <Footer />
</BaseLayout>
