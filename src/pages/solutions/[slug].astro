---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Container from '../../components/global/Container.astro';
import Section from '../../components/global/Section.astro';
import TechnicalLabel from '../../components/global/TechnicalLabel.astro';
import Button from '../../components/global/Button.astro';
import { solutions, getSolution } from '../../data/solutions';

export function getStaticPaths() {
  return solutions.map((solution) => ({ params: { slug: solution.slug }, props: { solution } }));
}

const { solution: suppliedSolution } = Astro.props;
const solution = suppliedSolution ?? getSolution(Astro.params.slug ?? '');
if (!solution) throw new Error(`Unknown solution slug: ${Astro.params.slug}`);
---
<BaseLayout title={`${solution.title} | AionSi`} description={solution.summary}>
  <Header />
  <main>
    <Section class="bg-[var(--aionsi-surface-alt)]"><Container><TechnicalLabel>ENGINEERING SOLUTION</TechnicalLabel><div class="grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center"><div><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">{solution.number}</div><h1 class="mt-5 text-5xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-7xl">{solution.title}</h1><p class="mt-6 max-w-3xl text-xl leading-9 text-slate-600">{solution.summary}</p></div><div class="border border-slate-200 bg-white p-7"><TechnicalLabel>BEST FIT</TechnicalLabel><div class="mt-5 grid gap-3 sm:grid-cols-2">{solution.idealFor.map((item) => <div class="border border-slate-200 bg-[var(--aionsi-surface-alt)] p-5 text-sm leading-6 text-[var(--aionsi-navy)]">{item}</div>)}</div></div></div></Container></Section>
    <Section><Container class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><TechnicalLabel>ENGAGEMENT MODEL</TechnicalLabel><h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">A delivery path built around ownership.</h2></div><div class="grid gap-4 md:grid-cols-2">{solution.engagement.map((step,index) => <div class="border border-slate-200 bg-white p-7"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">0{index+1}</div><h3 class="mt-4 text-xl font-semibold text-[var(--aionsi-navy)]">{step}</h3></div>)}</div></Container></Section>
    <Section class="bg-[var(--aionsi-surface-alt)]"><Container><TechnicalLabel>ENGINEERING OUTCOME</TechnicalLabel><div class="mt-8 border border-slate-200 bg-white p-8 md:p-10"><h2 class="text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">{solution.outcome}</h2><p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">The delivery model can begin with a defined requirement and expand as the engineering roadmap, scope and capacity needs evolve.</p></div></Container></Section>
    <Section class="bg-[var(--aionsi-deep-navy)] text-white"><Container class="text-center"><TechnicalLabel>ENGINEERING DISCOVERY</TechnicalLabel><h2 class="mx-auto max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">{solution.ctaLabel}</h2><p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-white/70">Share the program stage, engineering challenge, required capability and expected timeline. We can map the requirement to an appropriate AionSi engagement model.</p><div class="mt-9"><Button href="/contact">{solution.ctaLabel}</Button></div></Container></Section>
  </main><Footer />
</BaseLayout>
