---
const capabilities = [
  { number: '01', title: 'RTL Design', description: 'RTL engineering across block, subsystem and SoC development.', technologies: 'SystemVerilog · RTL · SoC' },
  { number: '02', title: 'Design Verification', description: 'Verification expertise across block, subsystem and SoC levels.', technologies: 'SystemVerilog · UVM · Coverage · Assertions' },
  { number: '03', title: 'Physical Design', description: 'Physical implementation expertise across complex silicon programs.', technologies: 'Floorplanning · Placement · CTS · Routing' },
  { number: '04', title: 'DFT', description: 'Design-for-test engineering integrated into the silicon lifecycle.', technologies: 'Test Architecture · Scan · ATPG' },
  { number: '05', title: 'Protocol Verification', description: 'Protocol-focused verification for complex semiconductor interfaces.', technologies: 'PCIe · USB · DDR · AMBA' },
  { number: '06', title: 'SoC & IP Engineering', description: 'Engineering support from IP integration through SoC development.', technologies: 'IP · Subsystem · SoC Integration' },
];
---

<section class="relative overflow-hidden bg-[var(--aionsi-surface-alt)] py-20 sm:py-24" aria-labelledby="capabilities-title">
  <div class="pointer-events-none absolute inset-0 opacity-50" aria-hidden="true" style="background-image:linear-gradient(rgba(22,119,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(22,119,255,.06) 1px,transparent 1px);background-size:56px 56px;"></div>
  <div class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
    <div class="grid gap-8 lg:grid-cols-[.85fr_1.15fr] lg:items-end">
      <div>
        <div class="text-xs font-semibold uppercase tracking-[.2em] text-[var(--aionsi-orange)]">Engineering Capabilities</div>
        <h2 id="capabilities-title" class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Engineering depth where silicon complexity matters.</h2>
      </div>
      <div class="flex gap-3 lg:justify-end">
        <a href="/capabilities" class="inline-flex items-center border border-slate-300 px-5 py-3 text-sm font-semibold text-[var(--aionsi-navy)] transition hover:-translate-y-0.5 hover:border-[var(--aionsi-blue)] hover:text-[var(--aionsi-blue)]">View all capabilities <span class="ml-2">→</span></a>
      </div>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {capabilities.map((capability) => (
        <a href="/capabilities" class="group relative overflow-hidden border border-slate-200 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-[var(--aionsi-blue)] hover:shadow-[0_18px_50px_rgba(2,11,39,.08)]">
          <div class="absolute inset-x-0 top-0 h-px bg-[var(--aionsi-blue)] opacity-0 transition-opacity group-hover:opacity-100"></div>
          <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{capability.number}</div>
          <h3 class="mt-6 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{capability.title}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">{capability.description}</p>
          <div class="mt-7 flex items-center justify-between border-t border-slate-100 pt-4">
            <span class="text-[10px] font-semibold uppercase tracking-[.14em] text-slate-400">{capability.technologies}</span>
            <span class="text-slate-300 transition group-hover:translate-x-1 group-hover:text-[var(--aionsi-blue)]">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
