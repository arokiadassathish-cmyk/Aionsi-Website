---
const capabilities = [
  {
    number: '01',
    title: 'RTL Design',
    description: 'RTL engineering across block, subsystem and SoC development.',
    technologies: 'Verilog · SystemVerilog · RTL Design',
    outcome: 'Production-ready RTL',
  },
  {
    number: '02',
    title: 'Design Verification',
    description: 'Verification expertise across block, subsystem and SoC levels.',
    technologies: 'SystemVerilog · UVM · Coverage · Assertions',
    outcome: 'Coverage-closed, signoff-ready verification',
  },
  {
    number: '03',
    title: 'Physical Design',
    description: 'Physical implementation expertise across complex silicon programs.',
    technologies: '',
    outcome: '',
  },
  {
    number: '04',
    title: 'DFT',
    description: 'Design-for-test engineering integrated into the silicon lifecycle.',
    technologies: 'Test Architecture · Scan · ATPG',
    outcome: 'Manufacturing-test readiness',
  },
  {
    number: '05',
    title: 'Protocol Verification',
    description: 'Protocol-focused verification for complex semiconductor interfaces.',
    technologies: 'PCIe · USB · DDR · AMBA',
    outcome: 'Protocol-compliant, coverage-driven verification',
  },
  {
    number: '06',
    title: 'SoC & IP Engineering',
    description: 'Engineering across IP integration, subsystem development and SoC integration.',
    technologies: 'IP · Subsystem · SoC Integration',
    outcome: 'Integration-ready IP, subsystem and SoC delivery',
  },
];
---

<section class="relative overflow-hidden bg-[var(--aionsi-surface-alt)] py-16 sm:py-20 lg:py-24" aria-labelledby="capabilities-title">
  <div class="pointer-events-none absolute inset-0 opacity-50" aria-hidden="true" style="background-image:linear-gradient(rgba(22,119,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(22,119,255,.06) 1px,transparent 1px);background-size:56px 56px;"></div>

  <div class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
    <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <div class="h-px w-10 bg-[var(--aionsi-orange)]"></div>
        <div class="mt-5 text-xs font-semibold uppercase tracking-[.2em] text-[var(--aionsi-orange)]">Engineering Capabilities</div>
        <h2 id="capabilities-title" class="mt-3 max-w-4xl text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] sm:text-5xl lg:text-6xl">Engineering depth across the silicon lifecycle.</h2>
        <p class="mt-5 max-w-4xl text-base leading-7 text-slate-600 sm:text-lg">
          From RTL design through verification, physical implementation, DFT, protocol verification and SoC integration—AionSi engineering capabilities are built around complex silicon programs.
        </p>
      </div>

      <a href="/capabilities" class="inline-flex items-center text-sm font-semibold text-[var(--aionsi-navy)] transition hover:translate-x-1 hover:text-[var(--aionsi-blue)] lg:mb-1">
        Explore the full engineering portfolio <span class="ml-2">→</span>
      </a>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:mt-12 lg:grid-cols-3 lg:gap-5">
      {capabilities.map((capability) => (
        <a
          href="/capabilities"
          class="group relative overflow-hidden border border-slate-200 bg-white p-5 transition duration-300 hover:-translate-y-1 hover:border-[var(--aionsi-blue)] hover:shadow-[0_18px_50px_rgba(2,11,39,.08)] sm:p-7"
        >
          <div class="absolute inset-x-0 top-0 h-px bg-[var(--aionsi-blue)] opacity-0 transition-opacity group-hover:opacity-100"></div>

          <div class="flex items-start justify-between gap-4">
            <div class="text-xs font-semibold tracking-[.18em] text-[var(--aionsi-blue)]">{capability.number}</div>
            <div class="h-px w-12 bg-slate-200 transition-all duration-300 group-hover:w-16 group-hover:bg-[var(--aionsi-blue)]"></div>
          </div>

          <h3 class="mt-7 text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{capability.title}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">{capability.description}</p>

          {capability.technologies && (
            <div class="mt-5">
              <div class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">Technology / Methodology</div>
              <p class="mt-2 text-sm leading-6 text-slate-500">{capability.technologies}</p>
            </div>
          )}

          {capability.outcome && (
            <div class="mt-5 border-t border-slate-100 pt-4">
              <div class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">Engineering Outcome</div>
              <p class="mt-2 text-sm font-semibold leading-6 text-[var(--aionsi-navy)]">{capability.outcome}</p>
            </div>
          )}

          {capability.title === 'Physical Design' && (
            <div class="mt-5 border-t border-slate-100 pt-4">
              <div class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">Engineering Evidence</div>
              <p class="mt-2 text-sm leading-6 text-slate-500">Detailed implementation methodology will be added as the engineering documentation is released.</p>
            </div>
          )}

          <div class="mt-5 inline-flex items-center text-sm font-semibold text-[var(--aionsi-navy)] transition group-hover:text-[var(--aionsi-blue)]">
            Explore <span class="ml-2 transition-transform group-hover:translate-x-1">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
