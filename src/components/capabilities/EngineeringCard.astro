---
interface Props { number: string; title: string; description: string; technologies?: string; href?: string; }
const { number, title, description, technologies, href = '#' } = Astro.props;
---
<a href={href} class="group relative block overflow-hidden border border-slate-200 bg-white p-7 transition-all duration-500 hover:-translate-y-1 hover:border-[var(--aionsi-blue)]"><div class="mb-10 text-xs font-semibold tracking-[0.2em] text-[var(--aionsi-blue)]">{number}</div><h3 class="text-2xl font-semibold tracking-tight">{title}</h3><p class="mt-4 text-base leading-7 text-slate-600">{description}</p>{technologies && <div class="mt-8 text-sm text-slate-500">{technologies}</div>}<div class="mt-8 text-sm font-semibold">Explore <span class="transition-transform group-hover:translate-x-1 inline-block">→</span></div></a>
