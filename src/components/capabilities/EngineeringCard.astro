---
interface Props {
  number: string;
  title: string;
  description: string;
  technologies?: string;
  outcome?: string;
  href?: string;
}
const { number, title, description, technologies, outcome, href = '#' } = Astro.props;
---
<a href={href} class="group relative block overflow-hidden border border-slate-200 bg-white p-7 transition-all duration-500 hover:-translate-y-1 hover:border-[var(--aionsi-blue)] md:p-8">
  <div class="mb-8 flex items-center justify-between">
    <div class="text-xs font-semibold tracking-[0.2em] text-[var(--aionsi-blue)]">{number}</div>
    <span class="h-px w-10 bg-slate-200 transition-all duration-500 group-hover:w-16 group-hover:bg-[var(--aionsi-blue)]" aria-hidden="true"></span>
  </div>
  <h3 class="text-2xl font-semibold tracking-tight text-[var(--aionsi-navy)]">{title}</h3>
  <p class="mt-4 text-base leading-7 text-slate-600">{description}</p>

  {technologies && (
    <div class="mt-7">
      <div class="text-[10px] font-semibold tracking-[.18em] text-slate-400">TECHNOLOGY / METHODOLOGY</div>
      <div class="mt-2 text-sm leading-6 text-slate-500">{technologies}</div>
    </div>
  )}

  {outcome && (
    <div class="mt-7 border-t border-slate-100 pt-5">
      <div class="text-[10px] font-semibold tracking-[.18em] text-slate-400">ENGINEERING OUTCOME</div>
      <div class="mt-2 text-sm font-semibold leading-6 text-[var(--aionsi-navy)]">{outcome}</div>
    </div>
  )}

  <div class="mt-7 text-sm font-semibold text-[var(--aionsi-navy)]">Explore <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span></div>
</a>
