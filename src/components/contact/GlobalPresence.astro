---
const locations = [
  { country: 'USA', city: 'Silicon Valley' },
  { country: 'UK', city: 'London' },
  { country: 'SWEDEN', city: 'Stockholm' },
  { country: 'SPAIN', city: 'Barcelona' },
  { country: 'INDIA', city: 'Bengaluru' },
  { country: 'MALAYSIA', city: 'Kuala Lumpur' },
];
---

<section class="relative overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_24px_80px_rgba(2,11,39,.08)]">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_15%,rgba(37,99,235,.08),transparent_35%),linear-gradient(180deg,#fff_0%,#f8fbff_100%)]"></div>
  <div class="relative grid gap-8 p-7 md:p-10 lg:grid-cols-[.9fr_1.6fr] lg:items-center">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[.2em] text-[var(--aionsi-blue)]">OUR GLOBAL PRESENCE</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">6 countries. One engineering network.</h2>
      <p class="mt-4 max-w-xl text-base leading-7 text-slate-600">AionSi connects customer programs with engineering capability across the US, Europe, India and Malaysia.</p>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      {locations.map((location) => (
        <div class="rounded-2xl border border-slate-200 bg-white/90 p-4 shadow-sm backdrop-blur-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <div class="mb-3 h-1 w-8 bg-[var(--aionsi-orange)]"></div>
          <div class="text-sm font-bold tracking-wide text-[var(--aionsi-navy)]">{location.country}</div>
          <div class="mt-1 text-sm text-slate-500">{location.city}</div>
        </div>
      ))}
    </div>
  </div>
</section>
