---
interface Props { children: string; }
const { children } = Astro.props;
---
<div class="mb-5 flex items-center gap-3"><span class="h-[2px] w-8 bg-[var(--aionsi-orange)]" aria-hidden="true"></span><span class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--aionsi-blue)]">{children}</span></div>
