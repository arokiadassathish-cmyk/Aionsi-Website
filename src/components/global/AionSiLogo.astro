---
interface Props {
  class?: string;
  light?: boolean;
}
const { class: className = '', light = false } = Astro.props;
---
<a href="/" class={`inline-flex items-center ${className}`} aria-label="AionSi home">
  <span class="font-sans text-[2rem] font-semibold leading-none tracking-[-0.07em] sm:text-[2.2rem]" style={`color:${light ? '#ffffff' : 'var(--aionsi-blue)'}`}>
    A<span class="relative inline-block pl-[0.02em] pr-[0.01em]">i</span>onSi
  </span>
  <span class="sr-only">Driven by Commitment</span>
</a>
<style>
  a span:first-child::after {
    content: '';
    display: block;
    width: 1.1rem;
    height: 0.16rem;
    margin-top: 0.22rem;
    background: var(--aionsi-orange);
    opacity: .95;
  }
</style>
