---
interface Stage {
  kicker: string;
  name: string;
  focus: string;
  outcome: string;
  capabilities: string[];
}

interface Props {
  stages?: Stage[];
}

const defaultStages: Stage[] = [
  { kicker: 'Stage 01', name: 'IP / Architecture', focus: 'Define reusable IP and subsystem architecture.', outcome: 'Architecture aligned to the product requirement.', capabilities: ['IP architecture', 'Subsystem definition'] },
  { kicker: 'Stage 02', name: 'RTL Design', focus: 'Translate architecture into implementation-ready RTL.', outcome: 'Structured RTL ready for verification.', capabilities: ['RTL design', 'Microarchitecture'] },
  { kicker: 'Stage 03', name: 'Verification', focus: 'Drive functional confidence through reusable verification.', outcome: 'Coverage-driven verification closure.', capabilities: ['UVM verification', 'Assertions / coverage'] },
  { kicker: 'Stage 04', name: 'Physical Implementation', focus: 'Convert the design into a physically implementable SoC.', outcome: 'Timing, power and physical closure.', capabilities: ['Floorplan / placement', 'CTS / routing / sign-off'] },
  { kicker: 'Stage 05', name: 'DFT', focus: 'Build testability into the silicon implementation.', outcome: 'Production-oriented test readiness.', capabilities: ['DFT architecture', 'ATPG / scan'] },
  { kicker: 'Stage 06', name: 'SoC Integration', focus: 'Integrate IP, interfaces and verification across the SoC.', outcome: 'Integrated SoC ready for final validation.', capabilities: ['SoC integration', 'Subsystem verification'] },
  { kicker: 'Stage 07', name: 'Silicon', focus: 'Carry the engineering result through silicon readiness.', outcome: 'Engineering handoff aligned to silicon execution.', capabilities: ['Sign-off readiness', 'Silicon support'] },
];

const { stages = defaultStages } = Astro.props;
---
<div data-engineering-trace>
  <div class="overflow-x-auto pb-2" aria-label="Engineering lifecycle stages">
    <nav class="grid min-w-[980px] grid-cols-7 gap-2">
      {stages.map((stage, index) => (
        <button type="button" class={`group min-h-[92px] border p-4 text-left transition ${index === 0 ? 'border-[var(--aionsi-navy)] bg-[var(--aionsi-navy)] text-white' : 'border-slate-200 bg-white text-[var(--aionsi-navy)] hover:border-[var(--aionsi-blue)]'}`} data-stage-button data-stage-index={index}>
          <span class="flex items-center justify-between gap-2"><span class="text-[10px] font-semibold tracking-[.16em] opacity-60">{String(index + 1).padStart(2, '0')}</span><span aria-hidden="true">→</span></span>
          <span class="mt-3 block text-sm font-semibold leading-5">{stage.name}</span>
        </button>
      ))}
    </nav>
  </div>

  <article class="relative mt-4 overflow-hidden border border-[var(--aionsi-navy)] bg-[var(--aionsi-navy)] p-6 text-white md:p-9">
    <div class="absolute inset-y-0 right-0 w-1/2 opacity-20" aria-hidden="true" style="background-image:linear-gradient(90deg,transparent,rgba(22,119,255,.16)),linear-gradient(rgba(22,119,255,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(22,119,255,.12) 1px,transparent 1px);background-size:auto,28px 28px,28px 28px;"></div>
    <div class="relative">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="text-[10px] font-semibold tracking-[.18em] text-white/50" data-stage-kicker>{stages[0].kicker}</div>
        <div class="text-xs text-white/55"><span data-stage-count>Stage 01 of 07</span> · ← / → to navigate</div>
      </div>
      <h3 class="mt-3 text-2xl font-semibold tracking-tight md:text-3xl" data-stage-name>{stages[0].name}</h3>
      <p class="mt-3 max-w-3xl text-base leading-7 text-white/70" data-stage-focus>{stages[0].focus}</p>
      <div class="mt-6 border-l-2 border-[var(--aionsi-orange)] pl-4"><div class="text-[10px] font-semibold uppercase tracking-[.16em] text-white/45">Engineering outcome</div><p class="mt-2 text-sm font-medium leading-6 text-white/85" data-stage-outcome>{stages[0].outcome}</p></div>
      <div class="mt-7 grid gap-3 sm:grid-cols-2" data-stage-capabilities>{stages[0].capabilities.map((capability) => <div class="border border-white/10 bg-white/[.03] px-4 py-4 text-sm font-medium text-white/80">{capability}</div>)}</div>
    </div>
  </article>
</div>

<script is:inline define:vars={{ stages }}>
  const root = document.querySelector('[data-engineering-trace]');
  if (root) {
    const buttons = Array.from(root.querySelectorAll('[data-stage-button]'));
    const kicker = root.querySelector('[data-stage-kicker]');
    const name = root.querySelector('[data-stage-name]');
    const focus = root.querySelector('[data-stage-focus]');
    const outcome = root.querySelector('[data-stage-outcome]');
    const capabilities = root.querySelector('[data-stage-capabilities]');
    const count = root.querySelector('[data-stage-count]');
    let active = 0;

    const render = (index) => {
      active = (index + stages.length) % stages.length;
      const stage = stages[active];
      buttons.forEach((button, buttonIndex) => {
        button.classList.toggle('border-[var(--aionsi-navy)]', buttonIndex === active);
        button.classList.toggle('bg-[var(--aionsi-navy)]', buttonIndex === active);
        button.classList.toggle('text-white', buttonIndex === active);
        button.classList.toggle('border-slate-200', buttonIndex !== active);
        button.classList.toggle('bg-white', buttonIndex !== active);
        button.classList.toggle('text-[var(--aionsi-navy)]', buttonIndex !== active);
      });
      if (kicker) kicker.textContent = stage.kicker;
      if (name) name.textContent = stage.name;
      if (focus) focus.textContent = stage.focus;
      if (outcome) outcome.textContent = stage.outcome;
      if (capabilities) capabilities.innerHTML = stage.capabilities.map((capability) => `<div class="border border-white/10 bg-white/[.03] px-4 py-4 text-sm font-medium text-white/80">${capability}</div>`).join('');
      if (count) count.textContent = `Stage ${String(active + 1).padStart(2, '0')} of ${String(stages.length).padStart(2, '0')}`;
    };

    buttons.forEach((button, index) => button.addEventListener('click', () => render(index)));
    window.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') render(active + 1);
      if (event.key === 'ArrowLeft') render(active - 1);
    });
  }
</script>
