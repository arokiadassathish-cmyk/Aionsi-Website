---
interface Props {
  stages: Array<{
    kicker: string;
    name: string;
    focus: string;
    outcome: string;
    capabilities: string[];
  }>;
}

const { stages } = Astro.props;
---
<div data-engineering-trace>
  <div class="grid gap-5 lg:grid-cols-[.32fr_1.68fr]">
    <nav class="grid gap-2" aria-label="Engineering lifecycle stages">
      {stages.map((stage, index) => (
        <button type="button" class={`group flex items-center justify-between border p-4 text-left transition ${index === 0 ? 'border-[var(--aionsi-navy)] bg-[var(--aionsi-navy)] text-white' : 'border-slate-200 bg-white text-[var(--aionsi-navy)] hover:border-[var(--aionsi-blue)]'}`} data-stage-button data-stage-index={index}>
          <span><span class="block text-[10px] font-semibold tracking-[.16em] opacity-60">{String(index + 1).padStart(2, '0')}</span><span class="mt-1 block text-sm font-semibold">{stage.name}</span></span>
          <span aria-hidden="true">→</span>
        </button>
      ))}
    </nav>

    <article class="relative overflow-hidden border border-[var(--aionsi-navy)] bg-[var(--aionsi-navy)] p-6 text-white md:p-9">
      <div class="absolute inset-y-0 right-0 w-1/2 opacity-20" aria-hidden="true" style="background-image:linear-gradient(90deg,transparent,rgba(22,119,255,.16)),linear-gradient(rgba(22,119,255,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(22,119,255,.12) 1px,transparent 1px);background-size:auto,28px 28px,28px 28px;"></div>
      <div class="relative">
        <div class="text-[10px] font-semibold tracking-[.18em] text-white/50">AIONSI ENGINEERING FOCUS</div>
        <div class="mt-4" data-stage-name>{stages[0].name}</div>
        <div class="mt-2 text-sm text-white/65" data-stage-focus>{stages[0].focus}</div>
        <div class="mt-4 text-base font-semibold text-[var(--aionsi-orange)]" data-stage-outcome>{stages[0].outcome}</div>
        <div class="mt-6 grid gap-3 sm:grid-cols-2" data-stage-capabilities>{stages[0].capabilities.map((capability) => <div class="border border-white/10 bg-white/[.03] px-4 py-4 text-sm font-medium text-white/80">{capability}</div>)}</div>
        <div class="mt-6 flex items-center justify-between gap-4 border-t border-white/10 pt-5 text-xs text-white/55"><span data-stage-count>Stage 01 of {String(stages.length).padStart(2, '0')}</span><span>← / → to navigate</span></div>
      </div>
    </article>
  </div>
</div>

<script is:inline define:vars={{ stages }}>
  const root = document.querySelector('[data-engineering-trace]');
  if (root) {
    const buttons = Array.from(root.querySelectorAll('[data-stage-button]'));
    const name = root.querySelector('[data-stage-name]');
    const focus = root.querySelector('[data-stage-focus]');
    const outcome = root.querySelector('[data-stage-outcome]');
    const capabilities = root.querySelector('[data-stage-capabilities]');
    const count = root.querySelector('[data-stage-count]');
    let active = 0;

    const render = (index) => {
      active = (index + stages.length) % stages.length;
      const stage = stages[active];
      if (name) name.textContent = stage.name;
      if (focus) focus.textContent = stage.focus;
      if (outcome) outcome.textContent = stage.outcome;
      if (capabilities) capabilities.innerHTML = stage.capabilities.map((capability) => `<div class="border border-white/10 bg-white/[.03] px-4 py-4 text-sm font-medium text-white/80">${capability}</div>`).join('');
      if (count) count.textContent = `Stage ${String(active + 1).padStart(2, '0')} of ${String(stages.length).padStart(2, '0')}`;
      buttons.forEach((button, index) => {
        button.classList.toggle('border-[var(--aionsi-navy)]', index === active);
        button.classList.toggle('bg-[var(--aionsi-navy)]', index === active);
        button.classList.toggle('text-white', index === active);
        button.classList.toggle('border-slate-200', index !== active);
        button.classList.toggle('bg-white', index !== active);
        button.classList.toggle('text-[var(--aionsi-navy)]', index !== active);
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => render(Number(button.getAttribute('data-stage-index'))));
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') render(active + 1);
      if (event.key === 'ArrowLeft') render(active - 1);
    });
  }
</script>
