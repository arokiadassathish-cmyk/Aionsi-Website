---
import Container from '../global/Container.astro';
import Section from '../global/Section.astro';
import TechnicalLabel from '../global/TechnicalLabel.astro';
import { customerLogos } from '../../data/customers';
---

<Section class="bg-[var(--aionsi-surface-alt)]">
  <Container>
    <div class="grid gap-8 lg:grid-cols-[.9fr_1.1fr] lg:items-end">
      <div>
        <TechnicalLabel>Selected Customer Experience</TechnicalLabel>
        <h2 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-5xl">Engineering programs trusted across complex technology markets.</h2>
        <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">A concise view of organizations represented in AionSi's confirmed customer roster.</p>
      </div>
      <div class="lg:justify-self-end">
        <a href="/customers/" class="group inline-flex items-center gap-2 text-sm font-semibold text-[var(--aionsi-navy)]">
          View all customers <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>

    <div class="mt-10 grid gap-4 grid-cols-2 md:grid-cols-4 lg:grid-cols-4">
      {customerLogos.map((customer) => (
        <div class="flex min-h-24 items-center justify-center border border-slate-200 bg-white p-5 shadow-sm">
          {customer.logo ? (
            <img src={customer.logo} alt={customer.name} class="max-h-12 max-w-[85%] object-contain" loading="lazy" decoding="async" />
          ) : (
            <span class="text-center text-sm font-semibold text-slate-400">{customer.name}</span>
          )}
        </div>
      ))}
    </div>
  </Container>
</Section>
