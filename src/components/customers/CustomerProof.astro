---
import { customerLogos, customerStatement } from '../../data/customers';

interface Props {
  limit?: number;
}

const { limit = 8 } = Astro.props;
const visibleCustomers = customerLogos.slice(0, limit);
---

<section class="border-y border-slate-200 bg-white py-12 md:py-16" aria-labelledby="customer-proof-title">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <div class="text-xs font-semibold uppercase tracking-[.18em] text-[var(--aionsi-blue)]">CUSTOMER PROOF</div>
        <h2 id="customer-proof-title" class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-[var(--aionsi-navy)] md:text-4xl">Selected organizations supported by AionSi engineering.</h2>
        <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600">{customerStatement}</p>
      </div>
      <a href="/customers" class="inline-flex items-center text-sm font-semibold text-[var(--aionsi-navy)] hover:text-[var(--aionsi-blue)]">View customer relationships →</a>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4" data-customer-logo-grid>
      {visibleCustomers.map((customer) => (
        <div class="flex min-h-24 items-center justify-center border border-slate-200 bg-white px-4 py-4 sm:px-5">
          <img
            src={customer.logo}
            alt={customer.name}
            width="180"
            height="72"
            class="block h-12 w-full max-w-[180px] object-contain sm:max-h-14"
            loading="eager"
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>
</section>
