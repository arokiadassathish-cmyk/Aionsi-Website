<div class="space-y-10">
  <div>
    <p class="text-sm leading-7 text-slate-600">Extend an existing semiconductor engineering organization with focused capability across the silicon lifecycle while preserving the customer's technical ownership.</p>
  </div>
  <div>
    <div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">WHERE AIONSI CAN EXTEND YOUR TEAM</div>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {['IP / RTL Engineering','Design Verification','Protocol Verification','DFT','Physical Design','SoC Integration','AI-assisted Verification'].map((item) => <div class="border border-slate-200 bg-white p-5 text-sm font-semibold text-[var(--aionsi-navy)]">{item}</div>)}
    </div>
  </div>
  <div>
    <div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">HOW THE ENGAGEMENT WORKS</div>
    <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {['Assess requirement','Map capability','Build engineering pod','Integrate with customer team','Execute with governance','Scale as needed'].map((item,index) => <div class="border border-slate-200 bg-white p-6"><div class="text-xs tracking-[.18em] text-[var(--aionsi-blue)]">0{index + 1}</div><div class="mt-4 text-lg font-semibold text-[var(--aionsi-navy)]">{item}</div></div>)}
    </div>
  </div>
  <div>
    <div class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--aionsi-blue)]">ENGAGEMENT OPTIONS</div>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {[['Extended Engineering','Add specialist capacity to an existing team.','/solutions/extended-engineering'],['Dedicated Engineering','Build a dedicated engineering team around a defined roadmap.','/solutions/dedicated-engineering'],['Engineering ODC','Create a governed engineering organization for long-term scale.','/solutions/odc'],['Project Engineering','Deliver a defined technical scope with milestones and ownership.','/solutions/project-engineering']].map(([title,description,href]) => <a href={href} class="border border-slate-200 bg-white p-5 transition hover:border-[var(--aionsi-blue)]"><div class="text-base font-semibold text-[var(--aionsi-navy)]">{title}</div><p class="mt-2 text-sm leading-6 text-slate-600">{description}</p><span class="mt-4 inline-block text-sm font-semibold text-[var(--aionsi-navy)]">Explore →</span></a>)}
    </div>
