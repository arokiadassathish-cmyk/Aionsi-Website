---
import type { ConversionScenario } from '../../data/conversionMatrix';

interface Props { scenarios: ConversionScenario[]; }
const { scenarios } = Astro.props;
---
<div class="grid gap-4">
  {scenarios.map((scenario, index) => (
    <details class="group border border-slate-200 bg-white p-5 shadow-sm open:shadow-md">
      <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
        <div class="grid gap-4 lg:grid-cols-[auto_1fr_auto] lg:items-start lg:gap-6">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[var(--aionsi-blue)]/30 text-xs font-semibold text-[var(--aionsi-blue)]">{String(index + 1).padStart(2, '0')}</div>
          <div>
            <div class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">Customer situation</div>
            <h3 class="mt-1 text-base font-semibold leading-6 text-[var(--aionsi-navy)] md:text-lg">{scenario.situation}</h3>
          </div>
          <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[.12em] text-[var(--aionsi-blue)]"><span>{scenario.engagement}</span><span class="transition-transform group-open:rotate-180">↓</span></div>
        </div>
      </summary>
      <div class="mt-6 border-t border-slate-100 pt-6">
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          <div class="border border-slate-100 bg-[var(--aionsi-surface-alt)] p-4"><div class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">Engineering impact</div><p class="mt-2 text-sm leading-6 text-slate-600">{scenario.impact}</p></div>
          <div class="border border-slate-100 bg-[var(--aionsi-surface-alt)] p-4"><div class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">Why AionSi</div><p class="mt-2 text-sm leading-6 text-slate-600">{scenario.whyAionSi}</p></div>
          <div class="border border-slate-100 bg-[var(--aionsi-surface-alt)] p-4"><div class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">AionSi capability</div><p class="mt-2 text-sm leading-6 text-slate-600">{scenario.capability}</p></div>
          <div class="border border-slate-100 bg-[var(--aionsi-surface-alt)] p-4"><div class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">Potential workstream</div><p class="mt-2 text-sm leading-6 text-slate-600">{scenario.workstream}</p></div>
        </div>
        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <div class="border border-slate-200 p-5"><div class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">Evidence to surface</div><ul class="mt-3 space-y-2 text-sm leading-6 text-slate-600">{scenario.evidence.map((item) => <li class="flex gap-2"><span class="text-[var(--aionsi-blue)]">→</span><span>{item}</span></li>)}</ul></div>
          <div class="border border-slate-200 p-5"><div class="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-400">Expansion path</div><p class="mt-3 text-sm leading-6 text-slate-600">{scenario.expansion}</p><a href="/contact" class="mt-4 inline-flex items-center text-sm font-semibold text-[var(--aionsi-blue)] hover:underline">{scenario.cta} →</a></div>
        </div>
      </div>
    </details>
  ))}
</div>
