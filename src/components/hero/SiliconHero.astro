---
import Container from '../global/Container.astro';
import TechnicalLabel from '../global/TechnicalLabel.astro';
import Button from '../global/Button.astro';
---
<section class="relative isolate flex min-h-[calc(100svh-1px)] items-center overflow-hidden bg-[var(--aionsi-deep-navy)] text-white">
  <div class="absolute inset-0 opacity-25" aria-hidden="true">
    <div class="h-full w-full" style="background-image:linear-gradient(rgba(22,119,255,.28) 1px,transparent 1px),linear-gradient(90deg,rgba(22,119,255,.28) 1px,transparent 1px);background-size:56px 56px;"></div>
  </div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_72%_48%,rgba(22,119,255,.22),transparent_35%)]" aria-hidden="true"></div>
  <Container class="relative grid items-center gap-14 py-28 lg:grid-cols-[1.05fr_.95fr] lg:py-36">
    <div class="max-w-3xl">
      <TechnicalLabel>Semiconductor Engineering</TechnicalLabel>
      <h1 class="text-5xl font-semibold leading-[0.94] tracking-[-0.055em] sm:text-6xl lg:text-[6.35rem]">Engineering the Future of <span class="text-[var(--aionsi-electric-blue)]">Silicon.</span></h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-white/70 sm:text-xl">Semiconductor engineering from IP to Silicon.</p>
      <div class="mt-9 flex flex-wrap gap-4">
        <Button href="/contact">Talk to Our Engineering Team</Button>
        <Button href="/capabilities" variant="secondary">Explore Capabilities</Button>
      </div>
    </div>
    <div class="relative mx-auto aspect-square w-full max-w-[620px]" aria-label="AionSi semiconductor engineering visualization">
      <div class="absolute inset-[9%] rotate-[6deg] border border-[var(--aionsi-electric-blue)]/45 bg-white/[.025] shadow-[0_0_90px_rgba(22,119,255,.12)]"></div>
      <div class="absolute inset-[17%] -rotate-[4deg] border border-[var(--aionsi-blue)]/45 bg-[linear-gradient(135deg,rgba(22,119,255,.05),rgba(255,255,255,.015))]"></div>
      <div class="absolute inset-[27%] grid grid-cols-4 gap-2 rotate-[2deg] opacity-90">
        {Array.from({ length: 16 }).map((_, i) => <span class="border border-[var(--aionsi-electric-blue)]/35 bg-[var(--aionsi-electric-blue)]/[.025]" key={i}></span>)}
      </div>
      <div class="absolute left-1/2 top-1/2 h-28 w-28 -translate-x-1/2 -translate-y-1/2 border border-[var(--aionsi-orange)]/90 bg-[var(--aionsi-orange)]/[.03] shadow-[0_0_55px_rgba(244,81,30,.14)] sm:h-36 sm:w-36"></div>
      <div class="absolute left-[17%] top-[18%] h-px w-[66%] bg-gradient-to-r from-transparent via-[var(--aionsi-electric-blue)]/70 to-transparent"></div>
      <div class="absolute left-[17%] top-[78%] h-px w-[66%] bg-gradient-to-r from-transparent via-[var(--aionsi-electric-blue)]/70 to-transparent"></div>
      <div class="absolute left-[22%] top-[22%] text-[10px] tracking-[0.22em] text-white/45">SOC / ROUTING / VERIFY</div>
      <div class="absolute bottom-[15%] right-[18%] text-right text-[10px] tracking-[0.18em] text-white/45">PHYSICAL / DFT / SILICON</div>
    </div>
  </Container>
</section>
