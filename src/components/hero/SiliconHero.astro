---
import Container from '../global/Container.astro';
import TechnicalLabel from '../global/TechnicalLabel.astro';
import Button from '../global/Button.astro';
---
<section class="relative isolate overflow-hidden bg-[var(--aionsi-deep-navy)] text-white">
  <div class="absolute inset-0 opacity-15 lg:opacity-[0.18]" aria-hidden="true">
    <div class="h-full w-full" style="background-image:linear-gradient(rgba(22,119,255,.16) 1px,transparent 1px),linear-gradient(90deg,rgba(22,119,255,.16) 1px,transparent 1px);background-size:56px 56px;"></div>
  </div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_74%_44%,rgba(22,119,255,.15),transparent_32%)]" aria-hidden="true"></div>

  <Container class="relative grid min-h-[700px] items-center gap-10 pb-20 pt-28 sm:gap-14 sm:pb-24 sm:pt-32 lg:min-h-[calc(100svh-1px)] lg:grid-cols-[.94fr_1.06fr] lg:gap-12 lg:pb-20 lg:pt-24">
    <div class="max-w-3xl">
      <TechnicalLabel>Semiconductor Engineering</TechnicalLabel>
      <h1 class="max-w-4xl text-[3.05rem] font-semibold leading-[.93] tracking-[-0.06em] sm:text-[4.6rem] lg:text-[6.2rem]">Engineering the Future of <span class="text-[var(--aionsi-electric-blue)]">Silicon.</span></h1>
      <p class="mt-5 max-w-lg text-base leading-7 text-white/70 sm:mt-6 sm:text-lg sm:leading-8">Semiconductor engineering from IP to Silicon across RTL Design, Design Verification, Physical Design, DFT, Protocol Verification and SoC &amp; IP Engineering.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <Button href="/contact">Talk to Our Engineering Team</Button>
        <Button href="/capabilities" variant="secondary">Explore Capabilities</Button>
      </div>
      <div class="mt-8 flex flex-wrap gap-x-4 gap-y-2 text-[9px] font-semibold tracking-[.18em] text-white/40 sm:mt-9 sm:gap-x-5 sm:text-xs">
        <span>IP</span><span>SUBSYSTEM</span><span>SoC</span><span>VERIFICATION</span><span>PHYSICAL</span><span>DFT</span><span>SILICON</span>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-[640px] lg:justify-self-end" aria-label="AionSi semiconductor engineering hero visual">
      <div class="relative aspect-[4/3] overflow-hidden border border-white/10 bg-black/20 shadow-[0_0_100px_rgba(22,119,255,.10)] sm:aspect-[16/11] lg:aspect-[4/3]">
        <img src="/images/hero/aionsi-semiconductor-hero.jpg" alt="Macro photograph of a semiconductor chip on a circuit board" class="absolute inset-0 h-full w-full object-cover object-center brightness-[1.23] saturate-[1.04]" loading="eager" fetchpriority="high" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(2,11,39,.58)_0%,rgba(2,11,39,.20)_38%,rgba(2,11,39,.06)_72%,rgba(2,11,39,.22)_100%)]"></div>
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(2,11,39,.16)_0%,rgba(2,11,39,.01)_48%,rgba(2,11,39,.34)_100%)]"></div>
        <div class="absolute inset-0 bg-[rgba(7,20,61,.12)] mix-blend-multiply"></div>

        <svg class="absolute inset-0 h-full w-full opacity-66" viewBox="0 0 1000 750" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="aion-blue-line-final" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#1677FF" stop-opacity="0" />
              <stop offset="50%" stop-color="#1677FF" stop-opacity=".62" />
              <stop offset="100%" stop-color="#1677FF" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="aion-orange-line-final" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#F4511E" stop-opacity="0" />
              <stop offset="50%" stop-color="#F4511E" stop-opacity=".84" />
              <stop offset="100%" stop-color="#F4511E" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path d="M60 165 H300 V285 H470" fill="none" stroke="url(#aion-blue-line-final)" stroke-width="2" />
          <path d="M940 190 H710 V315 H530" fill="none" stroke="url(#aion-blue-line-final)" stroke-width="2" />
          <path d="M110 610 H355 V455 H490" fill="none" stroke="url(#aion-blue-line-final)" stroke-width="2" />
          <path d="M905 585 H690 V455 H535" fill="none" stroke="url(#aion-orange-line-final)" stroke-width="3" />
          <circle cx="470" cy="285" r="5" fill="#1677FF" />
          <circle cx="530" cy="315" r="5" fill="#1677FF" />
          <circle cx="490" cy="455" r="5" fill="#1677FF" />
          <circle cx="535" cy="455" r="6" fill="#F4511E" />
        </svg>

        <div class="absolute left-5 top-5 border border-white/15 bg-[var(--aionsi-deep-navy)]/62 px-3 py-2 backdrop-blur-sm sm:left-6 sm:top-6">
          <div class="text-[9px] font-semibold tracking-[.18em] text-white/60">SOC-01</div>
          <div class="mt-1 text-[9px] tracking-[.14em] text-[var(--aionsi-electric-blue)]">RTL · DV · PD · DFT</div>
        </div>

        <div class="absolute right-5 top-5 max-w-[42%] text-right sm:right-6 sm:top-6">
          <div class="text-[9px] font-semibold tracking-[.18em] text-white/65">SILICON ENGINEERING</div>
          <div class="mt-1 text-[9px] tracking-[.14em] text-white/50">PPA · COVERAGE · SIGNOFF</div>
        </div>

        <div class="absolute bottom-5 left-5 sm:bottom-6 sm:left-6">
          <div class="flex items-center gap-2 text-[9px] font-semibold tracking-[.16em] text-white/75">
            <span class="h-2 w-2 rounded-full bg-[var(--aionsi-orange)] shadow-[0_0_10px_rgba(244,81,30,.55)]"></span>
            ARCHITECTURE → VERIFY → IMPLEMENT
          </div>
        </div>

        <div class="absolute bottom-5 right-5 text-right sm:bottom-6 sm:right-6">
          <div class="text-[8px] tracking-[.15em] text-white/45">PCIe · DDR · SoC · DFT</div>
        </div>
      </div>
    </div>
  </Container>
</section>
