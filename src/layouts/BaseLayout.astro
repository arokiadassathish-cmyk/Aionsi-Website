---
import '../styles/global.css';
interface Props { title?: string; description?: string; canonical?: string; ogImage?: string; type?: string; robots?: string; }
const { title = 'AionSi | Semiconductor Engineering', description = 'Semiconductor engineering from IP to Silicon.', canonical, ogImage = '/favicon.svg', type = 'website', robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1' } = Astro.props;
const siteUrl = 'https://aionsi.com';
const seoTitles: Record<string, string> = {
  '/': 'Semiconductor Engineering from IP to Silicon | AionSi',
  '/evidence/risc-v-processor-core-family': 'RISC-V Processor Core Engineering | AionSi',
  '/evidence/amba-chi-axi-interconnect-fabrics': 'AMBA CHI & AXI Interconnect Engineering | AionSi',
  '/evidence/hbm2e-hbm3-memory-controllers': 'HBM2e & HBM3 Memory Controllers | AionSi',
  '/evidence/ddr4-ddr5-memory-controllers': 'DDR4 & DDR5 Memory Controller Engineering | AionSi',
  '/evidence/usb-3x-usb4-controllers': 'USB 3.x & USB4 Controller Engineering | AionSi',
  '/evidence/pcie-gen6-data-link-layer': 'PCIe Gen6 Data Link Layer Verification | AionSi',
  '/capabilities': 'Semiconductor Engineering Capabilities | AionSi',
  '/capabilities/rtl-design': 'RTL Design & SoC Engineering Services | AionSi',
  '/capabilities/design-verification': 'Design Verification Services | UVM, SoC & IP | AionSi',
  '/capabilities/physical-design': 'Physical Design & Signoff Services | AionSi',
  '/capabilities/dft': 'DFT & Semiconductor Test Engineering | AionSi',
  '/capabilities/analog-layout': 'Analog & Custom Layout Engineering | AionSi',
  '/capabilities/protocol-verification': 'Protocol Verification Services | PCIe, DDR, USB | AionSi',
  '/capabilities/soc-ip-engineering': 'SoC & IP Engineering Services | AionSi',
  '/solutions/dedicated-engineering': 'Dedicated Semiconductor Engineering Teams | AionSi',
  '/solutions/extended-engineering': 'Extended Semiconductor Engineering Teams | AionSi',
  '/solutions/odc': 'Semiconductor ODC | Dedicated Engineering Center | AionSi',
  '/solutions/project-engineering': 'Project-Based Semiconductor Engineering | AionSi',
  '/solutions/aiv': 'AI-Accelerated Verification Engineering | AionSi',
  '/contact': 'Contact AionSi | Semiconductor Engineering',
  '/careers': 'Semiconductor Engineering Careers | AionSi',
  '/insights': 'Semiconductor Engineering Insights | AionSi',
  '/insights/when-a-display-becomes-a-computing-platform': 'When a Display Becomes a Computing Platform | AionSi',
  '/news': 'AionSi News | Semiconductor Engineering',
  '/blogs': 'Semiconductor Engineering Blogs | AionSi',
  '/experience': 'Semiconductor Engineering Experience | AionSi',
  '/evidence': 'Semiconductor Engineering Evidence | AionSi',
  '/cadence': 'AionSi × Cadence | Semiconductor Engineering Capability',
  '/oppstar': 'AionSi × Oppstar | Semiconductor Engineering Capacity',
  '/greatasic': 'AionSi × GreatAsic | SoC Engineering Capacity',
  '/infinecs': 'AionSi × Infinecs | Semiconductor Engineering',
  '/panache': 'AionSi × Panache | Semiconductor Engineering',
  '/target-accounts': 'Semiconductor Target Accounts | AionSi',
  '/customers': 'Semiconductor Engineering Customers | AionSi',
  '/industries': 'Semiconductor Industry Engineering | AionSi',
  '/industries/semiconductor': 'Semiconductor Engineering Industry | AionSi',
  '/leadership': 'AionSi Leadership | Semiconductor Engineering',
  '/gallery': 'AionSi Events & Engineering Moments | Semiconductor',
  '/careers/apply': 'Apply to AionSi | Semiconductor Engineering Careers',
};
const routePath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const seoTitle = seoTitles[routePath] ?? title;
const seoDescriptions: Record<string, string> = {
  '/': 'Semiconductor engineering from IP to Silicon across RTL design, Design Verification, Physical Design, DFT, protocol verification and SoC engineering.',
  '/evidence/risc-v-processor-core-family': 'RISC-V processor-core engineering across embedded, edge-AI and multi-core configurations with formal and dynamic verification.',
  '/evidence/amba-chi-axi-interconnect-fabrics': 'AMBA CHI and AXI interconnect engineering for heterogeneous SoCs, coherency, QoS, topology and scalable integration.',
  '/evidence/hbm2e-hbm3-memory-controllers': 'HBM2e and HBM3 memory-controller engineering for AI, GPU and HPC systems, including scheduling, contention and integration.',
  '/evidence/ddr4-ddr5-memory-controllers': 'DDR4 and DDR5 memory-controller engineering across scheduling, refresh, ECC/RAS, timing and SoC integration.',
  '/evidence/usb-3x-usb4-controllers': 'USB 3.x and USB4 controller engineering across PHY, link, protocol, power delivery, error recovery and host or device integration.',
  '/evidence/pcie-gen6-data-link-layer': 'PCIe Gen6 Data Link Layer engineering covering link training, flow control, error recovery, power management and SoC integration.',
  '/capabilities': 'Explore AionSi semiconductor engineering capabilities across RTL design, Design Verification, Physical Design, DFT, protocol verification and SoC/IP engineering.',
  '/capabilities/rtl-design': 'RTL design and SoC engineering support from microarchitecture through integration, verification readiness and signoff-focused execution.',
  '/capabilities/design-verification': 'Design Verification engineering using SystemVerilog, UVM, assertions, coverage, regression, debug and IP, subsystem and SoC verification.',
  '/capabilities/physical-design': 'Physical Design engineering across synthesis, floorplanning, placement, CTS, routing, timing closure, ECOs and physical signoff.',
  '/capabilities/dft': 'DFT and semiconductor test engineering covering design-for-test implementation, verification, test readiness and signoff support.',
  '/capabilities/analog-layout': 'Analog and custom layout engineering support across layout implementation, physical verification and signoff-oriented execution.',
  '/capabilities/protocol-verification': 'Protocol verification engineering for PCIe, DDR, USB and other high-speed interfaces across IP, subsystem and SoC environments.',
  '/capabilities/soc-ip-engineering': 'SoC and IP engineering support across integration, verification, interfaces, memory, security and complex subsystem execution.',
  '/solutions/dedicated-engineering': 'Dedicated semiconductor engineering teams aligned to defined work packages, technical ownership, milestones and measurable delivery outcomes.',
  '/solutions/extended-engineering': 'Extend semiconductor engineering teams with focused AionSi capacity across verification, RTL, physical design, DFT and SoC engineering.',
  '/solutions/odc': 'Semiconductor ODC for dedicated engineering capacity, technical ownership, governance and scalable delivery.',
  '/solutions/project-engineering': 'Project-based semiconductor engineering for defined work packages with clear scope, milestones, technical ownership and acceptance criteria.',
  '/solutions/aiv': 'AI-accelerated verification engineering combining verification expertise, automation and repeatable execution to improve engineering productivity.',
  '/contact': 'Contact AionSi to discuss semiconductor engineering requirements across RTL, Design Verification, Physical Design, DFT, protocols and SoC/IP.',
  '/careers': 'Explore semiconductor engineering careers at AionSi across Design Verification, RTL, Physical Design, DFT and related engineering disciplines.',
  '/insights': 'Technical insights from AionSi on semiconductor engineering, verification, SoC architecture, interfaces, implementation and silicon execution.',
  '/insights/when-a-display-becomes-a-computing-platform': 'A technical perspective on how modern display platforms evolve into computing systems and the engineering implications across silicon and software.',
  '/news': 'AionSi news and updates covering semiconductor engineering, technology, partnerships, events and company developments.',
  '/blogs': 'Semiconductor engineering articles covering verification, protocols, SoC/IP, physical design, DFT and practical engineering execution.',
  '/experience': 'Representative AionSi semiconductor engineering experience across Design Verification, RTL, Physical Design, DFT, protocols and SoC engineering.',
  '/evidence': 'Engineering evidence from AionSi covering representative semiconductor projects, technologies, protocols and verification or implementation workstreams.',
  '/cadence': 'AionSi engineering capability across verification, SoC engineering, implementation and signoff for semiconductor engineering collaboration with Cadence.',
  '/oppstar': 'AionSi engineering capacity aligned to Oppstar across RTL, Design Verification, Physical Design, DFT, SoC integration and engineering automation.',
  '/greatasic': 'AionSi engineering capacity for advanced SoC programs across RTL, Design Verification, Physical Design, DFT, FPGA and engineering automation.',
  '/infinecs': 'AionSi semiconductor engineering capabilities aligned to Infinecs across Design Verification, RTL/SoC, Physical Design, STA/Synthesis and DFT.',
  '/panache': 'AionSi semiconductor engineering capability aligned to Panache across verification, RTL, physical design, DFT and SoC engineering.',
  '/target-accounts': 'AionSi semiconductor target accounts and engineering focus areas across product companies and opportunities for technical collaboration.',
  '/customers': 'Semiconductor and technology organizations supported through AionSi engineering engagements, capabilities and delivery models.',
  '/industries': 'Explore AionSi engineering capabilities across semiconductor and technology industry programs.',
  '/industries/semiconductor': 'Semiconductor engineering capabilities across RTL, verification, physical design, DFT, protocols and SoC execution.',
  '/leadership': 'Meet the AionSi leadership team guiding semiconductor engineering, delivery and technical growth.',
  '/gallery': 'AionSi events, engineering engagements and company moments across the semiconductor ecosystem.',
  '/careers/apply': 'Apply for semiconductor engineering opportunities at AionSi across verification, RTL, physical design, DFT and related disciplines.',
};
const seoDescription = seoDescriptions[routePath] ?? description;
const breadcrumbLabels: Record<string, string> = {
  '/capabilities': 'Capabilities',
  '/solutions': 'Solutions',
  '/contact': 'Contact',
  '/careers': 'Careers',
  '/insights': 'Insights',
  '/news': 'News',
  '/blogs': 'Blogs',
  '/experience': 'Experience',
  '/evidence': 'Evidence',
  '/cadence': 'Cadence',
  '/oppstar': 'Oppstar',
  '/greatasic': 'GreatAsic',
  '/infinecs': 'Infinecs',
  '/panache': 'Panache',
  '/target-accounts': 'Target Accounts',
};
const segmentLabels: Record<string, string> = {
  'rtl-design': 'RTL Design',
  'design-verification': 'Design Verification',
  'physical-design': 'Physical Design',
  'dft': 'DFT',
  'analog-layout': 'Analog Layout',
  'protocol-verification': 'Protocol Verification',
  'soc-ip-engineering': 'SoC & IP Engineering',
  'dedicated-engineering': 'Dedicated Engineering',
  'extended-engineering': 'Extended Engineering',
  'odc': 'Engineering ODC',
  'project-engineering': 'Project Engineering',
  'aiv': 'AI-Accelerated Verification',
};
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const breadcrumbItems = [{ name: 'Home', url: siteUrl }];
if (routePath !== '/') {
  const segments = routePath.split('/').filter(Boolean);
  let currentPath = '';
  segments.forEach((segment) => {
    currentPath += '/' + segment;
    breadcrumbItems.push({
      name: breadcrumbLabels[currentPath] ?? segmentLabels[segment] ?? segment.replace(/-/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()),
      url: new URL(currentPath, siteUrl).toString(),
    });
  });
}
const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seoTitle,
  description: seoDescription,
  url: canonicalUrl,
  isPartOf: { '@type': 'WebSite', name: 'AionSi', url: siteUrl },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url,
  })),
};

const ogImageUrl = new URL(ogImage, siteUrl).toString();
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'AionSi India Pvt. Ltd.',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: 'Semiconductor engineering services from IP to Silicon across RTL design, verification, physical design, DFT, protocol verification and SoC engineering.',
  email: 'mailto:dass.kishore@aionsi.com',
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AionSi',
  url: siteUrl,
  description: 'Semiconductor engineering from IP to Silicon.',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="AionSi" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={seoTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(webpageSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){window.dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaMeasurementId, { anonymize_ip: true });
          window.addEventListener('aionsi:analytics', (event) => {
            const detail = event?.detail || {};
            if (detail.name) gtag('event', detail.name, detail.params || {});
          });
          document.addEventListener('click', (event) => {
            const target = event.target instanceof Element ? event.target.closest('a') : null;
            if (!target) return;
            const href = target.getAttribute('href') || '';
            const text = (target.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 120);
            if (href.startsWith('mailto:')) gtag('event', 'contact_email_click', { link_text: text });
            else if (href.startsWith('tel:')) gtag('event', 'contact_phone_click', { link_text: text });
            else if (/\/contact\/?$/.test(href)) gtag('event', 'contact_page_click', { link_text: text });
            else if (/\/capabilities\//.test(href)) gtag('event', 'capability_click', { destination: href, link_text: text });
            else if (/\/evidence\//.test(href) || /\/experience\//.test(href)) gtag('event', 'engineering_evidence_click', { destination: href, link_text: text });
            else if (/\/insights\//.test(href) || /\/blogs\//.test(href)) gtag('event', 'content_click', { destination: href, link_text: text });
          });
          document.addEventListener('submit', (event) => {
            const form = event.target instanceof HTMLFormElement ? event.target : null;
            if (form) gtag('event', 'engineering_requirement_submit', { form_id: form.id || 'unknown' });
          });
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
