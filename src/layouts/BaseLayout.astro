---
import '../styles/global.css';
interface Props { title?: string; description?: string; canonical?: string; ogImage?: string; type?: string; robots?: string; }
const { title = 'AionSi | Semiconductor Engineering', description = 'Semiconductor engineering from IP to Silicon.', canonical, ogImage = '/favicon.svg', type = 'website', robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1' } = Astro.props;
const siteUrl = 'https://aionsi.com';
const seoTitles: Record<string, string> = {
  '/': 'Semiconductor Engineering from IP to Silicon | AionSi',
  '/capabilities': 'Semiconductor Engineering Capabilities | AionSi',
  '/capabilities/rtl-design': 'RTL Design & SoC Engineering Services | AionSi',
  '/capabilities/design-verification': 'Design Verification Services | UVM, SoC & IP | AionSi',
  '/capabilities/physical-design': 'Physical Design & Signoff Services | AionSi',
  '/capabilities/dft': 'DFT & Semiconductor Test Engineering | AionSi',
  '/capabilities/analog-layout': 'Analog & Custom Layout Engineering | AionSi',
  '/capabilities/protocol-verification': 'Protocol Verification Services | PCIe, DDR, USB | AionSi',
  '/capabilities/soc-ip-engineering': 'SoC & IP Engineering Services | AionSi',
  '/solutions/dedicated-engineering': 'Dedicated Semiconductor Engineering Teams | AionSi',
  '/solutions/extended-engineering': 'Extended Semiconductor Engineering Teams | AionSi',
  '/solutions/odc': 'Semiconductor Engineering ODC | Offshore Development Center | AionSi',
  '/solutions/project-engineering': 'Project-Based Semiconductor Engineering | AionSi',
  '/solutions/aiv': 'AI-Accelerated Verification Engineering | AionSi',
  '/contact': 'Contact AionSi | Semiconductor Engineering',
  '/careers': 'Semiconductor Engineering Careers | AionSi',
  '/insights': 'Semiconductor Engineering Insights | AionSi',
  '/insights/when-a-display-becomes-a-computing-platform': 'When a Display Becomes a Computing Platform | AionSi',
  '/news': 'AionSi News | Semiconductor Engineering',
  '/blogs': 'Semiconductor Engineering Blogs | AionSi',
  '/experience': 'Semiconductor Engineering Experience | AionSi',
  '/evidence': 'Semiconductor Engineering Evidence | AionSi',
  '/cadence': 'AionSi × Cadence | Semiconductor Engineering Capability',
  '/oppstar': 'AionSi × Oppstar | Semiconductor Engineering Capacity',
  '/greatasic': 'AionSi × GreatAsic | SoC Engineering Capacity',
  '/infinecs': 'AionSi × Infinecs | Semiconductor Engineering',
  '/panache': 'AionSi × Panache | Semiconductor Engineering',
  '/target-accounts': 'Semiconductor Target Accounts | AionSi',
};
const routePath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const seoTitle = seoTitles[routePath] ?? title;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'AionSi India Pvt. Ltd.',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: 'Semiconductor engineering services from IP to Silicon across RTL design, verification, physical design, DFT, protocol verification and SoC engineering.',
  email: 'mailto:dass.kishore@aionsi.com',
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AionSi',
  url: siteUrl,
  description: 'Semiconductor engineering from IP to Silicon.',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{seoTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="AionSi" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={seoTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){window.dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaMeasurementId, { anonymize_ip: true });
          window.addEventListener('aionsi:analytics', (event) => {
            const detail = event?.detail || {};
            if (detail.name) gtag('event', detail.name, detail.params || {});
          });
          document.addEventListener('click', (event) => {
            const target = event.target instanceof Element ? event.target.closest('a') : null;
            if (!target) return;
            const href = target.getAttribute('href') || '';
            const text = (target.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 120);
            if (href.startsWith('mailto:')) gtag('event', 'contact_email_click', { link_text: text });
            else if (href.startsWith('tel:')) gtag('event', 'contact_phone_click', { link_text: text });
            else if (/\/contact\/?$/.test(href)) gtag('event', 'contact_page_click', { link_text: text });
            else if (/\/capabilities\//.test(href)) gtag('event', 'capability_click', { destination: href, link_text: text });
            else if (/\/evidence\//.test(href) || /\/experience\//.test(href)) gtag('event', 'engineering_evidence_click', { destination: href, link_text: text });
            else if (/\/insights\//.test(href) || /\/blogs\//.test(href)) gtag('event', 'content_click', { destination: href, link_text: text });
          });
          document.addEventListener('submit', (event) => {
            const form = event.target instanceof HTMLFormElement ? event.target : null;
            if (form) gtag('event', 'engineering_requirement_submit', { form_id: form.id || 'unknown' });
          });
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
