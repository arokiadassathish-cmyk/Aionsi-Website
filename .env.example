# Zoho Recruit integration
# Keep these values in the deployment environment only. Never commit real tokens.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_RECRUIT_API_BASE_URL=https://recruit.zoho.in/recruit/v2

# Preferred production authentication: OAuth refresh token.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_RECRUIT_REFRESH_TOKEN=

# Optional fallback for controlled environments. Do not expose this client-side.
ZOHO_RECRUIT_ACCESS_TOKEN=

# Map the public role slug used by the AionSi Careers page to the Zoho Recruit Job Opening ID.
# Example:
# {"soc-dv-manager":"123456789012345678","dv-engineer":"123456789012345679"}
ZOHO_RECRUIT_JOB_OPENINGS_JSON={}
